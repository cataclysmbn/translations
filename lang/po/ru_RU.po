msgid_plural "soil"
msgstr[0] "грунт"
msgstr[1] "грунта"
msgstr[2] "грунта"
msgstr[3] "грунт"

#. ~ Description for {'str_sp': 'soil'}
#: data/json/items/chemicals_and_resources.json
