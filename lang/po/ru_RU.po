msgstr[1] "сиропа от кашля (без снотворного)"
msgstr[2] "сиропа от кашля (без снотворного)"
msgstr[3] "сироп от кашля (без снотворного)"

#. ~ Description for {'str_sp': 'non-drowsy cough syrup'}
#: data/json/items/comestibles/med.json
