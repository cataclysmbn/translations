msgstr[0] "самодельное взрывное устройство"
msgstr[1] "самодельных  взрывных устройства"
msgstr[2] "самодельных взрывных устройств"
msgstr[3] "самодельные взрывные устройства"

#. ~ Description for {'str': 'improvised demolition charge'}
#: data/json/items/tool/explosives.json
msgid ""
"This is a improvised demolition charge.  Use this item to light the fuse.  "
"You will, of course, need a lighter or matches in your inventory to do this."
"  20 seconds after lighting the fuse, this item will explode, so get away!"
msgstr ""
"Самодельное взрывное устройство. Активируйте, чтобы поджечь запал; "
"разумеется, для этого понадобится зажигалка или спички. Через 20 секунд "
"взорвётся, так что бросайте и бегите!"

#: data/json/items/tool/explosives.json
