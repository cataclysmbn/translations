msgid_plural "hedge trimmers (on)"
msgstr[0] "шпалерные ножницы (вкл.)"
msgstr[1] "шпалерных ножниц (вкл.)"
msgstr[2] "шпалерных ножниц (вкл.)"
msgstr[3] "шпалерные ножницы (вкл.)"

