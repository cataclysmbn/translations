msgid_plural "phantom vapes"
msgstr[0] "фантомный вейп"
msgstr[1] "фантомных вейпа"
msgstr[2] "фантомных вейпов"
msgstr[3] "фантомные вейпы"

#. ~ Description for phantom vape
#: data/json/items/comestibles/med.json
msgid "A fake item used for ecig addiction.  This is a bug if you have it."
msgstr ""
"Поддельный предмет, используемый для зависимости от электронных сигарет. "
"Если у вас есть этот предмет, это баг."

#: data/json/items/comestibles/med.json
