msgstr "«Г-где я? Почему мне так боль-ПЕРЕЗАГРУЗКА ЧЕРЕЗ 59 СЕКУНД»."

#: data/json/speech.json
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "«ЭТО УСТРОЙСТВО НЕИСПРАВНО. ПОЖАЛУЙСТА, СВЯЖИТЕСЬ С ДЕЖУРНЫМ»."

#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "«Не могу… дышать…»"

#: data/json/speech.json
msgid "\"This cannot continue.\""
msgstr "«Так больше нельзя»."

#: data/json/speech.json
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "«ПОЛЬЗОВАТЕЛЬСКИЙ ПАРОЛЬ НЕ РАСПОЗНАН.»"

#: data/json/speech.json
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr "«Ты не видел моего друга? У него вчера была операция… или позавчера…»"

#: data/json/speech.json
msgid "\"Is it done?  Am I perfect now?\""
msgstr "«Готово? Я теперь совершенен?»"

#: data/json/speech.json
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "«Я сделал, что ты просил. Пожалуйста, отпусти меня!»"

#: data/json/speech.json
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "«Я не могу… но так надо. Как это рассчитать?»"

#: data/json/speech.json
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "«Это всё сон. Это должен быть сон»."

#: data/json/speech.json
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "«Теперь это моя жизнь… Теперь это моя жизнь… Теперь это моя жизнь…»"

#: data/json/speech.json
msgid "\"Wanna go home…\""
msgstr "«Я хочу домой…»"

#: data/json/speech.json
msgid "screams of pain."
msgstr "крики боли."

#: data/json/speech.json
msgid "muffled sobbing."
msgstr "приглушённые рыдания."

#: data/json/speech.json
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr ""
"«Ты мне соврал! Посмотри, что ты наделал!» и следом электронный голос «ТЫ ЗА"
" ЭТО ЗАПЛАТИШЬ!»"

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr "мягкий электронный голос «Подойдите сюда. Я вас осмотрю»."

