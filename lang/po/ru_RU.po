msgstr "Лестничный пролёт, ведущий вверх."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "manhole"
msgstr "люк"

#. ~ Description for manhole
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid ""
"This is a manhole.  The heavy iron cover lies over an entrance to the "
"underworld of hidden tunnels beneath the streets where sewage and rain water"
" frolic freely."
msgstr ""
"Отверстие канализационного люка. Тяжёлая железная крышка таит под собой "
"подземный мир спрятанных туннелей, где свободно резвятся стоки и дождевая "
"вода."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
#: data/json/items/generic.json
msgid "manhole cover"
msgid_plural "manhole covers"
msgstr[0] "крышка люка"
msgstr[1] "крышки люка"
msgstr[2] "крышек люка"
msgstr[3] "крышка люка"

#. ~ Description for manhole cover
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "Just a manhole cover."
msgstr "Просто крышка люка."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "You lift the manhole cover."
msgstr "Вы поднимаете крышку люка."

#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "You pry, but cannot lift the manhole cover."
msgstr "Вы пытаетесь открыть люк, но у вас не получается."

