msgid "Hello there."
msgstr "Привет."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Okay, no sudden movements..."
msgstr "Ладно, не делай резких движений…"

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Keep your distance!"
msgstr "Не подходи ближе!"

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "<drop_it>"
msgstr "<drop_it>"

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "This is my territory, <name_b>."
msgstr "Это моя территория, <name_b>."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Calm down.  I'm not going to hurt you."
msgstr "Успокойся. Я не причиню тебе зла."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Screw you, no."
msgstr "Иди на хрен, нет."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "<hands_up>"
msgstr "<hands_up>"

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "&Put hands up."
msgstr "&Поднять руки."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "*drops his weapon."
msgstr "*бросает своё оружие."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "*drops_her_weapon."
msgstr "*бросает_своё_оружие."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Now get out of here"
msgstr "А теперь убирайся."

#: data/json/npcs/TALK_COMMON_GREET.json
msgid "Now get out of here, before I kill you."
msgstr "Теперь убирайся отсюда, если жизнь дорога."

#: data/json/npcs/TALK_COMMON_GREET.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_APPRENTICE.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_SHRIKE_ROGUE.json
msgid "Okay, I'm going."
msgstr "Ладно, я иду."

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/robofac/NPC_ROBOFAC_MERC_1.json
msgid "About that job…"
msgstr "По поводу работы…"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "About one of those jobs…"
msgstr "По поводу одного из этих заданий…"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "What's the matter?"
msgstr "Что случилось?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I don't care."
msgstr "Мне всё равно."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I don't have any jobs for you."
msgstr "У меня нет работы для тебя."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I don't have any more jobs for you."
msgstr "У меня больше нет для тебя работы."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I have other jobs for you.  Want to hear about them?"
msgstr "У меня для тебя есть и другая работа. Хочешь послушать?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I have more jobs for you.  Want to hear about them?"
msgstr "У меня для тебя есть ещё работа. Хочешь послушать?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I have a job for you.  Want to hear about it?"
msgstr "У меня есть для тебя работа. Хочешь услышать детали?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I just have one job for you.  Want to hear about it?"
msgstr "У меня есть работа для тебя. Хочешь послушать?"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/TALK_COMMON_OTHER.json data/json/npcs/godco/cook.json
#: data/json/npcs/godco/foodguard.json
