msgid_plural "nasal helms"
msgstr[0] "норманнский шлем"
msgstr[1] "норманнских шлема"
msgstr[2] "норманнских шлемов"
msgstr[3] "норманнский шлем"

#. ~ Description for {'str': 'nasal helm'}
#: data/json/items/armor/helmets.json
msgid ""
