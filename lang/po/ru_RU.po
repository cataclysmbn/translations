msgstr[0] "фрисби"
msgstr[1] "фрисби"
msgstr[2] "фрисби"
msgstr[3] "фрисби"

#. ~ Description for {'str': 'frisbee'}
#: data/json/items/ranged/throwing.json
msgid "A plastic frisbee made for outdoor games."
msgstr "Фрисби из пластика для игр на свежем воздухе."

#: data/json/items/ranged/throwing.json
msgid "net"
