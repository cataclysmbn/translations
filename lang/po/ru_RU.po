msgid_plural "pool cues"
msgstr[0] "бильярдный кий"
msgstr[1] "бильярдных кия"
msgstr[2] "бильярдных киёв"
msgstr[3] "бильярдный кий"

#. ~ Description for {'str': 'pool cue'}
#: data/json/items/melee/bludgeons.json
msgid ""
"A hard-wood stick designed for hitting colorful balls around a felt table.  "
"Truly, the coolest of sports."
msgstr ""
"Палка из твёрдых пород дерева, предназначена для удара по цветным шарам в "
"зоне бильярдного стола. Действительно, самый классный вид спорта."

#: data/json/items/melee/bludgeons.json
