#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_SHRIKE_SPLINTER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_AUX_MAGE.json
#: data/mods/Arcana_BN/npcs/TALK_CF_DEACON.json
#: data/mods/Arcana_BN/npcs/TALK_CF_GM.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_REP.json
#: data/mods/Arcana_BN/npcs/TALK_FREE_MERCHANT_STOCKS.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
#: data/mods/Arcana_BN/npcs/TALK_MAGE_HUNTER.json
#: data/mods/Arcana_BN/npcs/TALK_MERCHANT_CF_AUX.json
#: data/mods/Arcana_BN/npcs/TALK_OLD_GUARD_REP.json
#: data/mods/Arcana_BN/npcs/TALK_SCIENCE_REP.json
#: data/mods/Arcana_BN/npcs/TALK_SHRIKE_MERCHANT.json src/npctalk.cpp
msgid "Oh, okay."
msgstr "Ох, ладно."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Never mind, I'm not interested."
msgstr "Неважно, мне не интересно."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "You're not working on anything for me now."
msgstr "Ты сейчас на меня не работаешь."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Which job?"
msgstr "Какое задание?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "What about it?"
msgstr "Что насчёт него?"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/robofac/NPC_ROBOFAC_INTERCOM.json
#: data/mods/Arcana_BN/npcs/TALK_ROBOFAC_INTERCOM.json
msgid "I'll do it!"
msgstr "Я это сделаю!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Not a problem."
msgstr "Нет проблем."

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/robofac/NPC_ROBOFAC_INTERCOM.json
#: data/mods/Arcana_BN/npcs/TALK_ROBOFAC_INTERCOM.json
msgid "Got any advice?"
msgstr "Что-нибудь посоветуешь?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Can you share some equipment?"
msgstr "Можешь поделиться каким-нибудь снаряжением?"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/robofac/NPC_ROBOFAC_INTERCOM.json
#: data/mods/Arcana_BN/npcs/TALK_ROBOFAC_INTERCOM.json
msgid "I'll be back soon!"
msgstr "Я скоро вернусь!"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/lumberyard/TALK_lumbermill_logger.json
msgid "Sounds good, thanks."
msgstr "Хорошо, спасибо."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Sounds good.  Bye!"
msgstr "Хорошо. Пока!"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
msgid "I'm sorry."
msgstr "Прости."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Whatever.  Bye."
msgstr "Неважно. Пока."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I'm sorry…  I failed."
msgstr "Прости… Мой косяк."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Not yet."
msgstr "Работаю над этим."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I killed him."
msgstr "Убийство совершено."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I killed it."
msgstr "Зачистка завершена."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "No.  I'll get back to it, bye!"
msgstr "Нет. Пойду займусь делом, пока!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Yup!  Here it is!"
msgstr "Ага! Вот оно!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "We're here!"
msgstr "Мы здесь!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Here I am."
msgstr "Вот и я."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I talked to them."
msgstr "Мы поговорили."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Here it is!"
msgstr "Вот оно!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Justice has been served."
msgstr "Справедливость восторжествовала."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I killed them.  All of them."
msgstr "Они убиты. Все они убиты."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I brought 'em."
msgstr "Всё при мне."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I've taken care of it"
msgstr "Дело сделано…"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid ""
"I found it, but I'm keeping it, and I'll find you another one.  Let's talk "
"about something else."
msgstr ""
"Оно у меня, но пока попридержу, а тебе найду ещё. Давай поговорим о чём-"
"нибудь другом."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I found it, but I'm keeping it, and I'll find you another one.  Bye!"
msgstr "Оно у меня, но пока попридержу, а тебе найду ещё. До встречи!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Mission success!"
msgstr "Миссия выполнена!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment."
msgstr "Приятно было помочь. Оплаты не надо."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "How about some items as payment?"
msgstr "Как насчёт каких-нибудь предметов в качестве оплаты?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Maybe you can teach me something as payment?"
msgstr "Может, ты сможешь обучить меня чему-нибудь в качестве оплаты?"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Glad to help.  I need no payment.  Bye!"
msgstr "Приятно было помочь. Мне не нужна оплата. Пока!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Glad to help."
msgstr "Приятно было помочь."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Glad to help.  Bye!"
msgstr "Приятно было помочь. Пока!"

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Well, um, sorry."
msgstr "Ну… эмм… прости."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "I'm sorry.  I did what I could."
msgstr "Прости. Было сделано всё, что в моих силах."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Sure, here you go!"
msgstr "Конечно, бери!"

#: data/json/npcs/TALK_COMMON_MISSION.json
#: data/json/npcs/homeless/TALK_homeless_broker.json
#: data/json/npcs/isherwood_farm/NPC_Carlos_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/necropolis/NPC_Old_Guard_Captain.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_SHRIKE_SPLINTER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_REP.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
#: data/mods/Arcana_BN/npcs/TALK_MAGE_HUNTER.json
#: data/mods/Arcana_BN/npcs/TALK_OLD_GUARD_NEC_CPT.json
#: data/mods/DinoMod/NPC/NC_BO_BARONYX.json
msgid "Thank you."
msgstr "Спасибо."

#: data/json/npcs/TALK_COMMON_MISSION.json
msgid "Thanks, bye."
msgstr "Спасибо, пока."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Well, I guess it's just us."
msgstr "Что ж, похоже только ты да я."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "At least we've got shelter."
msgstr "По крайней мере у нас есть убежище."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
msgid "What should we do now?"
msgstr "Что нам теперь делать?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Any tips?"
msgstr "Дашь совет?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Want to travel with me?"
msgstr "Хочешь пойти со мной?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Want to share some useful items with me?"
msgstr "Не поделишься со мной полезными вещами?"

#: data/json/npcs/TALK_COMMON_OTHER.json data/json/npcs/holdouts/Mr_Lapin.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard_generic.json
#: data/json/npcs/refugee_center/surface_staff/NPC_labguard1_docmission.json
#: data/json/npcs/refugee_center/surface_staff/NPC_labguard2_docmission.json
#: data/json/npcs/refugee_center/surface_staff/NPC_old_guard_doctor.json
#: data/json/npcs/refugee_center/surface_staff/NPC_scavenger_docmission.json
#: data/json/npcs/refugee_center/surface_staff/NPC_scientist_docmission.json
#: data/json/npcs/refugee_center/surface_staff/NPC_scientistquestgiver_docmission.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_arsonist.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_scavenger_mercenary.json
#: data/json/npcs/robofac/ROBOFAC_SURFACE_FREEMERCHANT.json
#: data/mods/Arcana_BN/npcs/TALK_CF_AUX_MAGE.json
#: data/mods/Arcana_BN/npcs/TALK_CF_AUX_MERC.json
#: data/mods/Arcana_BN/npcs/TALK_CF_DEACON.json
#: data/mods/Arcana_BN/npcs/TALK_CF_GM.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_REP.json
#: data/mods/Arcana_BN/npcs/TALK_CF_SEEKER.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
#: data/mods/Arcana_BN/npcs/TALK_MAGE_HUNTER.json
#: data/mods/Arcana_BN/npcs/TALK_MERCHANT_CF_AUX.json
#: data/mods/Arcana_BN/npcs/TALK_SHRIKE_MERCHANT.json
msgid "Well, bye."
msgstr "Ладно, пока."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "Я не знаю. Искать припасы и других выживших, полагаю."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "Возможно, нам стоит начать баррикадировать это место."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid ""
"I suppose getting a car up and running should really be useful if we have to"
" disappear quickly from here."
msgstr ""
"Думаю, хорошо бы найти машину в исправном состоянии и с топливом, если "
"придётся быстро отсюда свалить."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid ""
"We could look for one of those farms out here.  They can provide plenty of "
"food and aren't close to the cities."
msgstr ""
"Мы могли бы отправиться на одну из ферм. Там можно обеспечить себя едой, и "
"они на достаточном удалении от городов."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid ""
"We should probably stay away from those cities, even if there's plenty of "
"useful stuff there."
msgstr ""
"Наверное, стоит держаться от городов подальше, хоть там и полно полезных "
"вещей."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Hmm, okay."
msgstr "Хмм, ладно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Thanks!"
msgstr "Спасибо!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Focus on the road, mate!"
msgstr "Смотри на дорогу, бро!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I must focus on the road!"
msgstr "Мне надо смотреть на дорогу!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'm too thirsty, give me something to drink."
msgstr "Меня мучает жажда, дай мне чего-нибудь попить."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'm too hungry, give me something to eat."
msgstr "Меня голод мучает, дай мне чего-нибудь поесть."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'm too tired, let me rest first."
msgstr "Меня прям вырубает, дай мне сначала отдохнуть."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Nothing comes to my mind now.  Ask me later perhaps?"
msgstr "Ничего на ум не приходит. Может позже спросишь?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I have some reason for not telling you."
msgstr "У меня есть причины не рассказывать тебе об этом."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Ah, okay."
msgstr "Ну, ладно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Not until I get some antibiotics..."
msgstr "Не раньше, чем я получу антибиотики…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You asked me recently; ask again later."
msgstr "Мы об этом недавно уже говорили; спроси снова попозже."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "И с чего мне идти с тобой?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "Понятно. Я достану антибиотики."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "Да, точно. Я спрошу позже."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "Со мной ты будешь в безопасности."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "С тобой я буду в безопасности."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "Я убью тебя если ты не сделаешь этого."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#: data/json/npcs/cabin_chemist/cabin_chemist.json
#: data/json/npcs/scrap_trader/scrap_trader.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/smart_house_remotes/main.lua data/mods/teleportation_mod/main.lua
#: src/iuse.cpp
msgid "Nevermind."
msgstr "Забудь."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "Точно, я с тобой!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Awesome!"
msgstr "Шикарно!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "Ладно, пошли!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Yeah… I don't think so."
msgstr "Да? Я так не думаю."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/mods/Arcana_BN/npcs/TALK_ROBOFAC_INTERCOM.json
msgid "What is it?"
msgstr "В чём дело?"

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/isherwood_farm/NPC_Barry_Isherwood.json
msgid "How much further?"
msgstr "Далеко ещё?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'd like to lead for a while."
msgstr "Я не против стать лидером на какое-то время."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Step aside.  I'm leader now."
msgstr "В сторону. Теперь я лидер."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Alright.  You can lead now."
msgstr "Хорошо. Можешь вести."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Good.  Something else…"
msgstr "Хорошо. Что-нибудь ещё…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Alright, let's go."
msgstr "Да, пошли."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, okay."
msgstr "Ладно, ладно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Alright, let's begin."
msgstr "Хорошо, приступим."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Sounds good."
msgstr "Хорошо."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay.  Lead the way."
msgstr "Ладно. Веди меня."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "No, we'll be okay here."
msgstr "Нет, здесь мы будем в порядке."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "On second thought, never mind."
msgstr "А впрочем, неважно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I can't train you properly while you're operating a vehicle!"
msgstr "Я не могу полноценно обучать тебя, пока ты за рулём!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I can't train you properly while I'm operating a vehicle!"
msgstr "Я не могу тебя учить, когда я за рулём!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Give it some time, I'll show you something new later..."
msgstr "Дай мне немного времени, и я тебе покажу что-то новое…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I have some reason for denying you training."
msgstr "У меня есть причины не учить тебя."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Not a bloody chance, I'm going to get left behind!"
msgstr "Без шансов, я сматываю удочки!"

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Fine."
msgstr "Хорошо."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "Я на посту."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I need you to come with me."
msgstr "Следуй за мной."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "See you around."
msgstr "Увидимся."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I really don't feel comfortable doing so..."
msgstr "Мне действительно это неудобно…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'll give you some space."
msgstr "Я дам тебе немного пространства."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'd prefer to keep that to myself."
msgstr "Мне лучше держать это при себе."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I understand…"
msgstr "Я понимаю…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You just asked me for stuff; ask later."
msgstr "Мы уже говорили о снаряжении; спроси попозже."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Why should I share my equipment with you?"
msgstr "И с чего мне делиться с тобой своим имуществом?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid ""
"These aren't enough to finish the job, you want me to succeed, don't you…"
msgstr ""
"Этого недостаточно, чтобы довести дело до конца, ты же хочешь, чтобы у меня "
"все получилось, не так ли…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "Ладно, хорошо."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Because I'm holding a thermal detonator!"
msgstr "Потому что у меня в руке термальный детонатор!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "Потому что мы друзья!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
msgstr "Ну, я же тебе помогаю…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "Я всё верну обратно!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "Отдавай по-хорошему!"

#: data/json/npcs/TALK_COMMON_OTHER.json src/npctalk.cpp
msgid "Eh, never mind."
msgstr "Эх, неважно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "Не бери в голову. И так справлюсь. Пока."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/mods/Arcana_BN/npcs/TALK_EVAC_MERCHANT.json
#: data/mods/Arcana_BN/npcs/TALK_MAGE_HUNTER.json
msgid "Okay, here you go."
msgstr "Ладно, держи."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/cabin_chemist/chemist_missions.json
#: data/json/npcs/scrap_trader/scrap_trader_missions.json
#: data/mods/Arcana_BN/npcs/TALK_CF_DEACON.json
msgid "Thank you!"
msgstr "Спасибо!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Thanks!  But can I have some more?"
msgstr "Спасибо! А могу ли я получить ещё?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Thanks, see you later!"
msgstr "Спасибо, позже увидимся!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You picked up something that does not belong to you..."
msgstr "У тебя есть кое-что, что тебе не принадлежит…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "Ладно, ладно, это просто недоразумение. Извини, я это брошу."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "Нет, теперь это моё. Только попробуй отобрать."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "Слушай, мне правда очень нужно. Пожалуйста, дай."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "Что, вот это? Ты ошибся, это другое."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Прошу прощения. Слушай, я уже бросаю, лады?"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "Не пытайся заговорить мне зубы, бросай сейчас же."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, I'm dropping it…"
msgstr "Хорошо, я бросаю…"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Забирай, но только на этот раз. Никому не говори."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/necropolis/NPC_Old_Guard_Commo.json
#: data/json/npcs/prepper/TALK_NPC_prepper.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_shopkeep.json
#: data/json/npcs/refugee_center/surface_staff/NPC_scientistquestgiver_docmission.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "Thanks."
msgstr "Спасибо."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Right… I don't want any trouble."
msgstr "Верно… Мне не нужны неприятности."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Smart choice."
msgstr "Разумный выбор."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "<no>."
msgstr "<no>."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, okay, sorry."
msgstr "Ладно, ладно, извини."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay, fine, bye."
msgstr "Ладно, хорошо, пока."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Okay"
msgstr "Ладно."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid ""
"I'm willing to pay <topic_item_price> per batch for a total of "
"<topic_item_your_total_price>."
msgstr ""
"Я могу заплатить <topic_item_price> за штуку, всего "
"<topic_item_your_total_price>."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Works for me."
msgstr "Сойдёт."

#: data/json/npcs/TALK_COMMON_OTHER.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_woodcutter1.json
#: data/mods/Arcana_BN/npcs/TALK_CF_GM.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/Arcana_BN/npcs/TALK_EVAC_MERCHANT.json
#: data/mods/Arcana_BN/npcs/TALK_RANCH_CROP_OVERSEER.json
#: data/mods/Arcana_BN/npcs/TALK_RANCH_FOREMAN.json
msgid "Maybe later."
msgstr "Может позже."

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "Pleasure doing business!"
msgstr "Приятно иметь с тобой дело!"

#: data/json/npcs/TALK_COMMON_OTHER.json
msgid "You might be seeing more of me…"
msgstr "Думаю, мы ещё встретимся…"

#: data/json/npcs/TALK_CYBORG_1.json
msgid "Hey again. *kzzz*"
msgstr "Снова привет. *жжж*"

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"I… I'm free. *Zzzt* I'm actually free! *bzzz* Look, you're the first person "
"I've seen in a long time."
msgstr ""
"Я… Свобода. *Жжжт* Действительно, свобода! *бжжж* Слушай, ты первое разумное"
" существо, которое я вижу за долгое время."

#: data/json/npcs/TALK_CYBORG_1.json data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Hey.  Let's chat for a second."
msgstr "Эй, давай немножко поболтаем."

#: data/json/npcs/TALK_CYBORG_1.json
msgid "That's because I saved you.  Listen, I could use your help…"
msgstr ""
"Твоё спасение, да моими усилиями. Слушай, мне б не помешала твоя помощь…"

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"Big fucking deal.  Do what I say or I'll shove that chip back where it "
"belongs."
msgstr "Ну охуеть теперь. Делай, что я скажу, или я запихну тот чип обратно."

#: data/json/npcs/TALK_CYBORG_1.json
msgid "Sorry, I'm nobody.  Enjoy your freedom, I guess."
msgstr "Прости, я никто. Наслаждайся своей свободой, или типа того."

#: data/json/npcs/TALK_CYBORG_1.json
msgid "*buzz* Great! So what happens now?"
msgstr "*жжж* Отлично! Что дальше?"

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Come with me.  We can help each other out."
msgstr "Пойдём со мной. Мы оба выиграем от этого."

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "We both go our separate ways.  Enjoy your freedom."
msgstr "Наши пути расходятся. Наслаждайся свободой."

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"...Wait. *BEEP* Why do I believe you? *ZZZT* You could be just as bad as "
"them!"
msgstr ""
"…Погоди. *БИИП*. Почему мне стоит тебе верить? *ЗЗЗТ* Ты можешь быть такой "
"же паскудой, как эти!"

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"I wouldn't have pulled your chip out if I didn't want you to think for "
"yourself."
msgstr ""
"Твой чип остался бы на своём месте, если бы мне не хотелось, чтобы у тебя "
"появилось самостоятельное мышление."

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"I could be, but honestly, you're in no condition to make it out there. "
"Trusting me is your only real option for survival."
msgstr ""

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"For all you know, I am.  I'm being nice for now.  You'd better hope that it "
"lasts."
msgstr ""

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Forget it.  Enjoy your freedom."
msgstr "Забудь. Наслаждайся свободой."

#: data/json/npcs/TALK_CYBORG_1.json
msgid ""
"Okay, okay, *BUZZ* I'm sorry! Don't hurt me again! Anything but the chip!"
msgstr ""
"Ладно, ладно, *ЖЖЖ* прости! Не делай мне больно! Что угодно, только не чип!"

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Follow me and do my bidding, then."
msgstr "Тогда иди за мной и выполняй мои приказы."

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Get out of my sight."
msgstr "Уйди с глаз моих."

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "No, *I'm* sorry, I didn't mean that.  Go do what you want."
msgstr "Нет, *ты* прости, мне не стоило это говорить. Иди, делай что хочешь."

#: data/json/npcs/TALK_CYBORG_1.json
msgid "...kill… *ZTZTZT* …you!"
msgstr "…убить… *ЗЖЗЖЗЖЗ* …тебя!"

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Run while you still can!"
msgstr "Беги, пока можешь!"

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Not if I kill you first!"
msgstr "Только если я не убью тебя раньше!"

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "I'm sorry!  I shouldn't have said that!"
msgstr "Прости! Мне не стоило так говорить!"

#: data/json/npcs/TALK_CYBORG_1.json
msgid "Yeah, *beeeeep* I don't think so.  Bye."
msgstr "Ага, *биииииип* я так не думаю. Пока."

#: data/json/npcs/TALK_CYBORG_1.json
#: data/mods/Aftershock/npcs/Backgrounds/talk_cyborg_abomination.json
msgid "Suit yourself."
msgstr "Как знаешь."

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid ""
"Are you sure?  This doesn't seem like a particularly safe place for small "
"talk..."
msgstr "Думаешь? Непохоже, чтобы тут было особенно безопасно, чтобы болтать…"

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid "It's fine, we've got a moment."
msgstr "Всё хорошо, у нас есть минутка."

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid "Good point, let's find a more appropriate place."
msgstr "Точно, давай найдём место получше."

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid "You're right.  Forget I said anything, let's get moving."
msgstr "Твоя правда. Забудь мои слова, давай идти дальше."

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid "What did you want to talk about?"
msgstr "О чём тебе хотелось поговорить?"

#: data/json/npcs/TALK_FRIEND_CONVERSATION.json
msgid "Actually, never mind."
msgstr "Вообще-то забудь."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Yes, friend?"
msgstr "Да, дружище?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Your travels be fruitful, friend."
msgstr "Да принесут твои поиски плоды, друг."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "May you find your peace, traveler."
msgstr "Да найдёшь ты мир, странник."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "We might have lost everything, but hope remains."
msgstr "Может, мы и потеряли всё, но у нас осталась надежда."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "May the earth flourish beneath our paths."
msgstr "Пусть земля цветёт под нашими путями."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Unity of spirit, of mind, and body..."
msgstr "Единство духа, разума и тела…"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Look for the bonds which define you, and act in accord."
msgstr "Взгляни на связи, что тебя определяют, и действуй в согласии с ними."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid ""
"I don't know what kind of heresy you are spreading, but I'm putting an end "
"to it!"
msgstr "Не знаю, что там за ересь ты несёшь, но я положу этому конец!"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "This place is dangerous, what are you doing here?"
msgstr "Здесь опасное место, что ты тут делаешь?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#: data/json/npcs/cabin_chemist/cabin_chemist.json
#: data/json/npcs/godco/cook.json data/json/npcs/godco/foodguard.json
#: data/json/npcs/homeless/TALK_homeless_survivor.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_broker.json
#: data/json/npcs/refugee_center/surface_staff/NPC_old_guard_doctor.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_scavenger_mercenary.json
#: data/json/npcs/robofac/NPC_ROBOFAC_MERC_1.json
#: data/mods/Aftershock/npcs/cyrus_whately.json
#: data/mods/Aftershock/npcs/milly_whately_dialogue.json
#: data/mods/Aftershock/npcs/prepnet_dialogue.json
#: data/mods/Aftershock/npcs/whately_dialogue.json
#: data/mods/Aftershock/npcs/whately_generic_dialogue.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_APPRENTICE.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_SHRIKE_ROGUE.json
#: data/mods/Arcana_BN/npcs/TALK_BLOOD_MAGE_SHRIKE_SPLINTER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_AUX_MAGE.json
#: data/mods/Arcana_BN/npcs/TALK_CF_AUX_MERC.json
#: data/mods/Arcana_BN/npcs/TALK_CF_DEACON.json
#: data/mods/Arcana_BN/npcs/TALK_CF_GM.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_REP.json
#: data/mods/Arcana_BN/npcs/TALK_CF_SEEKER.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
#: data/mods/Arcana_BN/npcs/TALK_MERCHANT_CF_AUX.json
#: data/mods/Arcana_BN/npcs/TALK_SHRIKE_MERCHANT.json
msgid "Who are you?"
msgstr "Кто ты?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid ""
"Dangerous?  It may look different, but this land cares and provides for us."
"  We are celebrating with a feast, in fact.  Do you care to join us?"
msgstr ""
"Опасное? Оно отличается на вид, но эта земля заботится о нас и даёт нам "
"пищу. На самом деле мы празднуем, и у нас пир. Хочешь присоединиться?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Well, sure."
msgstr "Ну, хорошо."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "I'd… rather not."
msgstr "Я… Пожалуй, воздержусь."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "I'm sorry…  I have places to be."
msgstr "Прости… Мне надо кое-куда."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid ""
"I'm a priest or guide of a sort.  I sing the hymns along my companions so "
"that we may learn to live in unity, both with each other and with our ailing"
" world."
msgstr ""
"Я как бы жрец или наставник. Я пою гимны вместе со своими товарищами, чтобы "
"учиться жить в единстве и друг с другом, и с нашим захворавшим миром."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
#: data/json/npcs/homeless/TALK_homeless_broker.json
#: data/json/npcs/homeless/TALK_homeless_group_survivors.json
#: data/json/npcs/robofac/NPC_ROBOFAC_MERC_1.json
#: data/mods/Arcana_BN/npcs/TALK_CF_GM.json
#: data/mods/Arcana_BN/npcs/TALK_CF_PURIFIER.json
#: data/mods/Arcana_BN/npcs/TALK_CF_REP.json
#: data/mods/Arcana_BN/npcs/TALK_HERMIT.json
#: data/mods/Arcana_BN/npcs/TALK_OLD_GUARD_NEC_COMMO.json
msgid "Alright."
msgstr "Ясно."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Can I join you?"
msgstr "Могу я присоединиться к вам?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Understood.  Can I join you?"
msgstr "Понятно. Могу я присоединиться к вам?"

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Well, I gotta go."
msgstr "Что ж, мне пора."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Oh, but you already have."
msgstr "О, но ты уже."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Yes… yes I have."
msgstr "Да… Да, я уже."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Join us then, eat from this meal with us."
msgstr "Тогда иди к нам, отведай с нами эту пищу."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "[Take marloss berry] Thank you."
msgstr "[Взять ягоду Марло] Спасибо."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "I have changed my mind, thank you."
msgstr "Пожалуй, лучше всё-таки нет, спасибо."

#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "I'm joining no stinking cult!  Take your berry and shove it!"
msgstr ""
"Я не собираюсь вступать в сраную секту! Засуньте себе эту ягоду куда "
"подальше!"

#: data/json/npcs/TALK_NC_FARMER.json
msgid "Are you one of them?"
msgstr "Ты один из них?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid "One of who?"
msgstr "Один из них?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"My thoughts exactly.  We have a lot in common, we should travel together!"
msgstr ""
"Точно так же думаю. У нас много общего, нам стоит путешествовать вместе!"

#: data/json/npcs/TALK_NC_FARMER.json
msgid "A daring trader?  Yes.  Let's trade items."
msgstr "Из храбрых торговцев? Точно. Давай поторгуем."

#: data/json/npcs/TALK_NC_FARMER.json
msgid "I don't have time for this."
msgstr "У меня нет на это времени."

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"Hey, you're alive!  Me too.  Been a long while since I've had a "
"conversation.  Uh, with someone else.  Um."
msgstr ""
"Эй, всё ещё живой! Я тоже. Давненько ни с кем не говорил. Ээ, ни с кем "
"другим. Хм."

#: data/json/npcs/TALK_NC_FARMER.json
msgid "It's not safe here anymore, you need to move on."
msgstr "Здесь больше не безопасно, тебе стоит убраться."

#: data/json/npcs/TALK_NC_FARMER.json
msgid "How did you make it?"
msgstr "Как тебе удалось это пережить?"

#: data/json/npcs/TALK_NC_FARMER.json data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "What did you do before the Cataclysm?"
msgstr "Кем ты был до Катаклизма?"

#: data/json/npcs/TALK_NC_FARMER.json
#: data/json/npcs/isherwood_farm/NPC_Eddie_Isherwood.json
#: data/json/npcs/isherwood_farm/NPC_Jack_Isherwood.json
msgid "Have anything to trade?"
msgstr "Есть что-нибудь на продажу?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"I heard it's bad in the cities, back when the radio was still working.  Some"
" of those things came through here.  I want to stay out in the country if I "
"can stay safe."
msgstr ""
"Когда ещё работало радио, я слышал, что в городах дела совсем плохи. Кое-что"
" из этих штук добралось и сюда. Я предпочту сидеть в глуши, тут безопаснее."

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"One of the nice things about the country life is the troubles of the world "
"take a little longer to reach you, and some don't get you at all.  We didn't"
" see any dead the first day, but we heard all kinds of crazy things on the "
"news."
msgstr ""
"Один из плюсов жизни на за городом — большинству неприятностей нужно больше "
"времени, чтобы добраться до тебя, а некоторые вообще обходят стороной. В "
"первые дни мы не ни одного ходячего мертвеца, но чего только не наслушались "
"в новостях."

#: data/json/npcs/TALK_NC_FARMER.json data/json/npcs/TALK_SURVIVOR_CHEF.json
#: data/json/npcs/Backgrounds/hunter_2.json
#: data/json/npcs/Backgrounds/rural_1.json
#: data/json/npcs/Backgrounds/rural_2.json
#: data/mods/Aftershock/npcs/Backgrounds/BGRS_migo_2.json
#: data/mods/Aftershock/npcs/Backgrounds/BGRS_migo_3.json
msgid "What happened next?"
msgstr "Что было дальше?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"Come a little closer, I don't want to make too much noise.  You smell much "
"nicer than what I'm used to.  Someone in trouble banged on the door that "
"night, she said she was desperate, she had a baby, her home had burned down "
"and her drugs were gone and there were monsters in the streets.  We figured "
"she was on drugs, but we couldn't turn them away so we gave them food and "
"let them stay in the barn."
msgstr ""
"Подойди поближе, я не хочу шуметь. Ты пахнешь намного приятнее, чем я привык"
" ощущать. Той ночью кто-то постучался в дверь, она сказала, что была в "
"отчаянии, у нее был ребёнок, её дом сгорел, её наркотики исчезли, и на "
"улицах были монстры. Мы подумали, что она на наркотиках, но мы не могли их "
"прогнать, поэтому мы дали им поесть и позволили им остаться в амбаре."

#: data/json/npcs/TALK_NC_FARMER.json
msgid "That's decent, was she all right?"
msgstr "Достойный поступок, с ней всё было в порядке?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"She was not all right.  I don't know what happened, if she was already "
"turning or if something got in and got her, but she and the baby didn't make"
" it.  We lost some more people trying to figure that out, it was horrible."
msgstr ""
"С ней всё было не в порядке. Не знаю, что произошло, может она уже "
"обращалась, или ей что-то овладело, но она и ребёнок не выжили. И мы "
"потеряли ещё несколько человек, пытаясь разобраться с этим, просто кошмар."

#: data/json/npcs/TALK_NC_FARMER.json
msgid "Are you all right?"
msgstr "Ты в порядке?"

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"I'm a lot better now, I've been hunkering down here.  Something came by in "
"the night screaming and crying, sounded just like that woman.  Maybe a "
"ghost, I don't know.  It's good to have company again.  You're not a ghost, "
"right?  On second thought, don't tell me if you are, I probably don't want "
"to know."
msgstr ""
"Теперь получше. Я тут отсиживался. Что-то приходило ночью, кричало и "
"плакало, совсем как женщина. Может призрак какой, не знаю. Хорошо снова быть"
" рядом с живым человеком. Ты же не призрак, да? С другой стороны, лучше не "
"говори мне ничего — вероятно, я не хочу этого знать."

#: data/json/npcs/TALK_NC_FARMER.json
msgid ""
"I grew up on the farm, I don't know much about ghosts and goblins,  but I've"
" spent a lot of time growing food and I work hard.  It's better in the "
"country, cleaner.  Not as dangerous.  I hope."
msgstr ""
"Я вырос на ферме, мало знаю о призраках и гоблинах, но много работал, "
"выращивал еду. За городом лучше, чище. Не так опасно. Я надеюсь."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "Hey, I didn't expect to live long enough to see another living human!"
msgstr ""
"Эй, я и не думал прожить столько, чтобы успеть увидеть ещё одного живого "
"человека!"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "I've been here since shit went down.  Just my luck I had to work."
msgstr ""
"Я тут сижу с тех пор, как навалилось всё дерьмо. Мне повезло, что у меня "
"была работа."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "How are you alive?"
msgstr "Как тебе удалось выжить?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"Well, the dishwasher made a break for it three days after things got weird."
"  He was ripped to shreds before he made it to the street.  I figure this "
"place has gotta be safer than my apartment, and at least I've got all this "
"food here."
msgstr ""
"Ну, посудомойщик сбежал отсюда через три дня, как начались странности. Не "
"успел дойти до улицы, как его порвали на куски. Я смекнул, что тут мне "
"безопаснее, чем в квартире, и у меня хотя бы есть куча еды."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"I… um… hid.  I was in the kitchen, preparing another masterpiece when I "
"heard glass shattering followed by screaming.  I ran over to the serving "
"window to see what happened, assuming a guest had fallen and broke "
"something.  What I witnessed was the most awful thing I've ever seen.  I'm "
"not even sure I could go over it again."
msgstr ""
"Я… Э… Спрятался. Я готовил очередной шедевр на кухне, когда услышал "
"разбивающееся стекло и крики. Я подбежал к окну выдачи посмотреть, что "
"случилось, я думал, гость упал и что-то сломал. Но увиденное было самой "
"ужасной вещью во всей моей жизни. Я даже не уверен, смогу ли это описать."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"Some lunatic covered in a film of goo, black as oil, had fallen through one "
"of the large glass windows.  There were glass shards stuck in its head and "
"neck.  I thought the poor guy, girl-thing-whatever was dead.  People began "
"to crowd around it, some were taking pictures."
msgstr ""
"Какой-то псих, покрытый слоем чёрной, как нефть, слизи, упал сквозь большое "
"стеклянное окно. Осколки стекла застряли в его шее и голове. Я думал, что "
"бедный парень, девушка, что бы там ни было мертво. Люди собрались в толпу "
"вокруг него, некоторые фотографировали."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "Horrible.  Did you get any pictures yourself?"
msgstr "Кошмарно. Ты сам сделал какие-нибудь снимки?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"No!  I figured the thing dead until it started writhing and spazzing out for"
" a moment.  Everyone jumped back, a few screamed, and one curious stranger "
"stepped in closer, kneeling a little… it attacked him!"
msgstr ""
"Неа! Я думал, что он мёртв, пока он внезапно не начал корчиться и "
"извиваться. Все отпрянули назад, кто-то закричал, и один любопытный подошёл "
"ближе и немного наклонился… Оно напало на него!"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "What'd you do?"
msgstr "Что ты сделал?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"I ran to the back of the kitchen and hid as best I could.  People outside "
"were screaming and I could hear them running.  Suddenly I heard more glass "
"shatter and something skitter out of the restaurant.  I waited a moment and "
"then went and checked the dining area.  Both the stranger and the thing were"
" gone.  People were running in the streets, some even had guns so I locked "
"all the doors and blocked the windows with what I could and barricaded "
"myself in here."
msgstr ""
"Я отбежал в заднюю часть кухни и спрятался как только мог. Народ кричал, и я"
" слышал, как они убегали. Внезапно я услышал, как снова разбилось стекло, и "
"что-то выпрыгнуло из ресторана. Я немного подождал, вышел и осмотрел зал. И "
"любопытный, и нечто исчезли. По улицам бегали люди, кто-то даже с пушками, "
"так что я запер все двери и закрыл окна, чем мог, и забаррикадировался "
"внутри."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid "Crazy, so you have been here ever since?"
msgstr "С ума сойти, так ты тут сидишь с тех пор?"

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"Yeah, it was awhile before it was quiet again.  I heard all kinds of sounds:"
" explosions, jets flying by, helicopters, screaming, and rapid gunfire.  I "
"swear I even heard what sounded like a freaking tank drive by at one time!  "
"I've been hiding here since."
msgstr ""
"Ага, прошло немного времени, прежде чем всё затихло. Я слышал что угодно: "
"взрывы, пролетающие самолёты, вертолёты, вопли и частую стрельбу. Клянусь, я"
" разок даже слышал что-то похожее на сраный танк! С тех пор я тут прячусь."

#: data/json/npcs/TALK_SURVIVOR_CHEF.json
msgid ""
"I've been a cook since forever, this wasn't the best joint, but management "
"was cool."
msgstr ""
"Я всю жизнь работал тут поваром, не самое лучшее заведение, но начальство "
"классное."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Greetings friend, it's nice to see you."
msgstr "Привет, дружище, приятно увидеться."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "So you're back… Explain yourself!"
msgstr "Так ты вернулся… Объяснись!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "What sorcery is this?"
msgstr "Что это за магия?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Welcome home Foodkid!"
msgstr "Привет, Поешь-ка-младший!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Still here?  Take your time, it's rough out there."
msgstr "Всё ещё тут? Не спеши, снаружи сурово."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Greeting citizen, what brings you to the FoodLair?"
msgstr "Здравствуй, гражданин, что привело тебя в Дом Поешь-ки?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Greetings…  Foodperson?"
msgstr "Привет… Поешь-ка?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I am you but from an alternate reality."
msgstr "Я — это ты, но из альтернативной реальности."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I am Foodperson, who are YOU?"
msgstr "Я Поешь-ка, а кто ТЫ?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "There is only one real Foodperson!"
msgstr "Есть только один настоящий Поешь-ка!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I am the REAL Foodperson!"
msgstr "Я НАСТОЯЩИЙ Поешь-ка!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Nevermind me, I'm just going to leave."
msgstr "Не обращай внимания, я уже ухожу."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Indeed it is I! The one and only FOODPERSON!"
msgstr "И это, конечно же, Я! Единственный и неповторимый ПОЕШЬ-КА!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Wow!  Such an honor to meet you in person!"
msgstr "Ого! Такая честь лично тебя встретить!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Are you joking?  Foodperson is not real, it's a restaurant mascot!"
msgstr "Ты шутишь? Поешь-ка ненастоящий, это просто ресторанный маскот!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"The great Foodperson in the flesh!  Such an honor to finally meet you in "
"person!"
msgstr "Великий Поешь-ка во плоти! Такая честь наконец лично вас увидеть!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Ah…  Well, nice to meet you Foodperson."
msgstr "Э… Ладно, приятно познакомиться, Поешь-ка."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Do not mock me, for my strength is quite real!  Get out of here now!"
msgstr ""
"Не дразни меня, для своих сил я довольно настоящий! Немедленно убирайся!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Sheesh, ok, calm down, I'm leaving!"
msgstr "Тише, успокойся, хорошо, я ухожу!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Forgive me, I didn't mean to disrespect you."
msgstr "Прости, я не хотел проявить неуважение."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Oh yeah?  Show me what you can do!"
msgstr "Да ладно? Покажи, что ты можешь!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "A common mistake, but I can assure you that I'm very real!"
msgstr "Типичная ошибка, но я могу убедить тебя, что я самый настоящий!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Sure, whatever."
msgstr "Ну хорошо, как скажешь."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Ok…  I believe you."
msgstr "Хорошо… я тебе верю."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Anyway, do you need something?"
msgstr "Кстати, нужно ли тебе что-нибудь?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Are you interested in some trading?"
msgstr "Не хочешь ли поторговать?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Let's trade?"
msgstr "Поторгуем?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I'm looking for a place to stay."
msgstr "Я ищу себе место для жилья."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I want to get stronger.  Please teach me."
msgstr "Я хочу стать сильнее. Пожалуйста, научи меня."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Please share your knowledge."
msgstr "Пожалуйста, поделись своим знанием."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I'm building up a team, people with special abilities."
msgstr "Я набираю команду людей с особыми способностями."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Can you tell me again about this sidekick offer?"
msgstr "Повтори, пожалуйста, про предложение стать помощником?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Alright, I thought about this, what do you say about we team up?"
msgstr "Ясно, я об этом думал, что скажешь насчёт объединиться?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I'm good, bye."
msgstr "У меня всё отлично, пока."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I already have everything I need here in the FoodLair!"
msgstr "В Доме Поешь-ки уже есть всё, что мне нужно!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Alright let's see what you've got."
msgstr "Итак, давай посмотрим, чего ты стоишь."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "You're not ready for this."
msgstr "Ты к этому не готов."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "But I am worthy!"
msgstr "Но я достоин!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I can teach you a few tricks."
msgstr "Я могу научить тебя паре штучек."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "This is no place for a civilian.  You should go to the refugee center."
msgstr "Гражданским тут не место. Тебе нужно идти в центр беженцев."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Damn!"
msgstr "Чёрт!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Well…  You seem like a decent sort, I might have an offer for you."
msgstr "Ну…  Ты вроде подходишь, у меня к тебе есть предложение."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Sorry but I work alone."
msgstr "Прости, но я работаю в одиночку."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "We could really use your help!"
msgstr "Нам очень пригодится твоя помощь!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "What about: you prove your worth and join me as my sidekick?"
msgstr ""
"Как насчёт такого: ты доказываешь, что чего-то стоишь, и присоединяешься ко "
"мне как помощник?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "That sounds great!"
msgstr "Звучит классно!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Ok…"
msgstr "Хорошо…"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
#: data/mods/Arcana_BN/npcs/TALK_OLD_GUARD_NEC_COMMO.json
msgid "I need to think about it."
msgstr "Мне надо подумать."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Huh…  No thanks."
msgstr "Хех… Нет уж, спасибо."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "There's other things I'd like to discuss."
msgstr "Давай поговорим о чём-то ещё."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Alright bye."
msgstr "Понятно, пока."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "The way you talk, the way you move…  You're…  You're me?  But how?"
msgstr "То, как ты говоришь, как двигаешься… Ты… Ты — это я? Но как?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"I…  I don't know.  It probably has something to do with <the_cataclysm>!  "
"What do you say we team up to find out?"
msgstr ""
"Я… Я не знаю. Наверно, это всё <the_cataclysm>! Что скажешь, если мы "
"объединимся и выясним?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"It might have something to do with <the_cataclysm>, mind if I stay here "
"while we try to figure this out?"
msgstr ""
"Наверно, это всё <the_cataclysm>, не против, если я побуду здесь, пока мы не"
" разберёмся?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "This can't be true, you're trying to trick me!"
msgstr "Это неправда, ты пытаешься меня обмануть!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I need time to think."
msgstr "Мне надо подумать."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Wha…  But.  But…  How?"
msgstr "Что… Но. Но… Как?"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"No time to explain, the world is at an end and we must join forces to save "
"it!"
msgstr ""
"Нет времени объяснять, миру настал конец, и нам нужно объединиться и спасти "
"его!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"The Cataclysm weakened the space-time continuum, I accidentally fell through"
" a tear in reality and ended up here.  I will need access to your resources "
"to keep fighting."
msgstr ""
"Катаклизм ослабил континуум пространства-времени, я случайно попал в разрыв "
"в реальности и очутился здесь. Мне нужны твои запасы, чтобы сражаться."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"I am the ultimate Foodperson, I travel the multiverse consuming powers from "
"all the Foodpersons.  And now I've come for you!"
msgstr ""
"Я абсолютный Поешь-ка, я путешествую по мультивселенной и поглощаю силы "
"каждого Поешь-ки. А теперь я пришёл и за тобой!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Can't tell you now.  In due time all will be revealed."
msgstr "Сейчас я не могу сказать. Всё разъяснится в должное время."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Of course, whatever you need…  Foodperson."
msgstr "Конечно, как скажешь… Поешь-ка."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Thank you Foodperson!  It's good to know I have a friend here."
msgstr "Спасибо, Поешь-ка! Приятно знать, что у меня есть друг."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid ""
"It's crazy out there, it's going to be a tough journey but I'm with you!"
msgstr ""
"Снаружи творится чёрт знает что, путешествие будет непростое, но я с тобой!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Let's go, we have a world to save!"
msgstr "Идём же, нам надо спасать мир!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "There can be only one!"
msgstr "Останется только один!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I AM THE ONE!"
msgstr "И ЭТО Я!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "Wow calm down, it's just a prank bro."
msgstr "Эй-эй, успокойся, бро, я просто шучу."

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "WAIT!  There might be another way!"
msgstr "СТОЙ! Должен быть другой способ!"

#: data/json/npcs/TALK_TRUE_FOODPERSON.json
msgid "I don't want to fight you.  I'm leaving."
msgstr "Я не хочу с тобой драться. Я ухожу."

