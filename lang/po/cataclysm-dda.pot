msgstr[0] "denatured alcohol"
msgstr[1] "denatured alcohols"

#. ~ Description for denatured alcohol
#: lang/json/AMMO_from_json.py
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr "A high-strength ethanol solution mixed with methanol to make it toxic to drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for use in alcohol-burning stoves and as a solvent."

