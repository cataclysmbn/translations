#. ~ Use action descriptions for tuba.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You play a marching tune on your tuba."
msgstr "You play a marching tune on your tuba."

#. ~ Description for tuba
#: lang/json/TOOL_ARMOR_from_json.py
