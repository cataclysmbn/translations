msgstr "This is a combination of two Dark Age conflict-resolution classics, the broadsword and the torch.  Use to light it up and show those heathen zombies who's Lord around here."

#: lang/json/TOOL_from_json.py
msgid "firebrand (on)"
msgid_plural "firebrands (on)"
