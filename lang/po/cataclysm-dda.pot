msgid_plural "inactive mininuke hacks"
msgstr[0] "inactive mininuke hack"
msgstr[1] "inactive mininuke hacks"

#. ~ Use action friendly_msg for inactive mininuke hack.
#: lang/json/TOOL_from_json.py
