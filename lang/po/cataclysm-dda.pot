msgid_plural "water purifiers"
msgstr[0] "water purifier"
msgstr[1] "water purifiers"

#. ~ Description for water purifier
#: lang/json/TOOL_from_json.py
msgid ""
"This is a battery-powered device designed to purify drinking water.  Using "
"this item on a container full of water will purify the contents.  It could "
"be useful for water taken from uncertain sources like a river, as it may be "
"non-potable."
msgstr "This is a battery-powered device designed to purify drinking water.  Using this item on a container full of water will purify the contents.  It could be useful for water taken from uncertain sources like a river, as it may be non-potable."

#: lang/json/TOOL_from_json.py
msgid "Doppler Radar Turbo 2000"
msgid_plural "Doppler Radar Turbo 2000s"
msgstr[0] "Doppler Radar Turbo 2000"
msgstr[1] "Doppler Radar Turbo 2000s"

#. ~ Description for Doppler Radar Turbo 2000
#: lang/json/TOOL_from_json.py
msgid ""
"A briefcase with built-in laptop that looks like it's from the 80s.  Its "
"vintage monochrome monitor displays a plethora of meteorological data.  No "
"sign of the FLDSMDFR, however."
msgstr "A briefcase with built-in laptop that looks like it's from the 80s.  Its vintage monochrome monitor displays a plethora of meteorological data.  No sign of the FLDSMDFR, however."

#: lang/json/TOOL_from_json.py
msgid "welder"
msgid_plural "welders"
msgstr[0] "welder"
msgstr[1] "welders"

#. ~ Description for welder
#: lang/json/TOOL_from_json.py
msgid ""
"This is a battery powered tool for welding metal pieces together.  It is an "
"indispensable tool for construction or repair."
msgstr "This is a battery powered tool for welding metal pieces together.  It is an indispensable tool for construction or repair."

#: lang/json/TOOL_from_json.py
msgid "makeshift welder"
msgid_plural "makeshift welders"
msgstr[0] "makeshift welder"
msgstr[1] "makeshift welders"

#. ~ Description for makeshift welder
#: lang/json/TOOL_from_json.py
msgid ""
"This crude welder has been fashioned from a bundle of copper wire, scrap "
"metal, and complete disregard for personal safety.  While it's not as "
"efficient as a factory welder, it will serve in a pinch."
msgstr "This crude welder has been fashioned from a bundle of copper wire, scrap metal, and complete disregard for personal safety.  While it's not as efficient as a factory welder, it will serve in a pinch."

#: lang/json/TOOL_from_json.py
msgid "wooden smoother"
msgid_plural "wooden smoothers"
msgstr[0] "wooden smoother"
msgstr[1] "wooden smoothers"

#. ~ Description for wooden smoother
#: lang/json/TOOL_from_json.py
msgid ""
"This large makeshift tool is used in smoothing concrete or mortar in "
"construction projects.  You could also use it as an improvised head-basher."
msgstr "This large makeshift tool is used in smoothing concrete or mortar in construction projects.  You could also use it as an improvised head-basher."

#: lang/json/TOOL_from_json.py
msgid "wool staple"
msgid_plural "wool staples"
msgstr[0] "wool staple"
msgstr[1] "wool staples"

#. ~ Description for wool staple
#: lang/json/TOOL_from_json.py
msgid ""
"The natural cluster of wool fibres.  Could be processed to the felt patches "
"or yarns."
msgstr "The natural cluster of wool fibres.  Could be processed to the felt patches or yarns."

#: lang/json/TOOL_from_json.py
msgid "wrapped radiation badge"
msgid_plural "wrapped radiation badges"
msgstr[0] "wrapped radiation badge"
msgstr[1] "wrapped radiation badges"

#. ~ Use action msg for wrapped radiation badge.
#: lang/json/TOOL_from_json.py
msgid ""
"You remove the badge from its wrapper, exposing it to ambient radiation."
msgstr "You remove the badge from its wrapper, exposing it to ambient radiation."

#. ~ Description for wrapped radiation badge
#: lang/json/TOOL_from_json.py
