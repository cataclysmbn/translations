#: lang/json/AMMO_from_json.py
msgid "battery"
msgid_plural "batteries"
msgstr[0] "battery"
msgstr[1] "batteries"

#. ~ Description for battery
#: lang/json/AMMO_from_json.py
msgid ""
"A set of universal batteries.  Used to charge almost any electronic device."
msgstr "A set of universal batteries.  Used to charge almost any electronic device."

#: lang/json/AMMO_from_json.py
msgid "aluminum foil"
msgid_plural "aluminum foil"
msgstr[0] "aluminum foil"
msgstr[1] "aluminum foil"

#. ~ Description for aluminum foil
#: lang/json/AMMO_from_json.py
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr "A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made of tin in the past."

#: lang/json/AMMO_from_json.py
msgid "cent"
msgid_plural "cents"
msgstr[0] "cent"
msgstr[1] "cents"

#. ~ Description for cent
#. ~ Description for placeholder ammunition
#. ~ Description for software
#: lang/json/AMMO_from_json.py lang/json/GENERIC_from_json.py
msgid "IF YOU ARE SEEING THIS IT IS A BUG."
msgstr "IF YOU ARE SEEING THIS IT IS A BUG."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "thread"
msgid_plural "threads"
msgstr[0] "thread"
msgstr[1] "threads"

#. ~ Description for thread
#: lang/json/AMMO_from_json.py
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr "A small quantity of thread that could be used to refill a sewing kit."

#: lang/json/AMMO_from_json.py
msgid "sinew"
msgid_plural "sinews"
msgstr[0] "sinew"
msgstr[1] "sinews"

#. ~ Description for sinew
#: lang/json/AMMO_from_json.py
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "A tough sinew cut from a corpse, usable as thread."

#: lang/json/AMMO_from_json.py
msgid "plant fiber"
msgid_plural "plant fibers"
msgstr[0] "plant fiber"
msgstr[1] "plant fibers"

#. ~ Description for plant fiber
#: lang/json/AMMO_from_json.py
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr "Tough thin fiber, taken from a plant.  Can be used as thread."

#: lang/json/AMMO_from_json.py
msgid "yarn"
msgid_plural "yarn"
msgstr[0] "yarn"
msgstr[1] "yarn"

#. ~ Description for yarn
#: lang/json/AMMO_from_json.py
msgid "Wool yarn, could be used to knit wool clothing."
msgstr "Wool yarn, could be used to knit wool clothing."

#: lang/json/AMMO_from_json.py
msgid "soap bar"
msgid_plural "soap bars"
msgstr[0] "soap bar"
msgstr[1] "soap bars"

#. ~ Description for soap bar
#: lang/json/AMMO_from_json.py
msgid "A cleansing agent made into bars."
msgstr "A cleansing agent made into bars."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "duct tape"
msgid_plural "duct tapes"
msgstr[0] "duct tape"
msgstr[1] "duct tapes"

#. ~ Description for duct tape
#: lang/json/AMMO_from_json.py
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr "A roll of incredibly strong tape.  Its uses are innumerable."

#: lang/json/AMMO_from_json.py
msgid "rolling paper"
msgid_plural "rolling papers"
msgstr[0] "rolling paper"
msgstr[1] "rolling papers"

#. ~ Description for rolling paper
#: lang/json/AMMO_from_json.py
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "These are thin paper strips intended for the rolling of cigarettes."

#: lang/json/AMMO_from_json.py
msgid "copper wire"
msgid_plural "copper wires"
msgstr[0] "copper wire"
msgstr[1] "copper wires"

#. ~ Description for copper wire
#: lang/json/AMMO_from_json.py
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr "Plastic jacketed copper cable of the type used in small electronics."

#: lang/json/AMMO_from_json.py
msgid "plutonium cell"
msgid_plural "plutonium cells"
msgstr[0] "plutonium cell"
msgstr[1] "plutonium cells"

#. ~ Description for plutonium cell
#: lang/json/AMMO_from_json.py
msgid ""
"A nuclear-powered battery.  Used to charge advanced and rare electronics."
msgstr "A nuclear-powered battery.  Used to charge advanced and rare electronics."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "plutonium slurry"
msgid_plural "plutonium slurry"
msgstr[0] "plutonium slurry"
msgstr[1] "plutonium slurry"

#. ~ Description for plutonium slurry
#. ~ Description for watery plutonium slurry
#: lang/json/AMMO_from_json.py
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr "Highly radioactive slurry.  It is probably best to get far away from this."

#: lang/json/AMMO_from_json.py
msgid "watery plutonium slurry"
msgid_plural "watery plutonium slurry"
msgstr[0] "watery plutonium slurry"
msgstr[1] "watery plutonium slurry"

#: lang/json/AMMO_from_json.py
msgid "pebble"
msgid_plural "pebbles"
msgstr[0] "pebble"
msgstr[1] "pebbles"

#. ~ Description for pebble
#: lang/json/AMMO_from_json.py
msgid "A handful of pebbles, useful as ammunition for slings or slingshots."
msgstr "A handful of pebbles, useful as ammunition for slings or slingshots."

#: lang/json/AMMO_from_json.py
msgid "marble"
msgid_plural "marbles"
msgstr[0] "marble"
msgstr[1] "marbles"

#. ~ Description for marble
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of glass marbles, useful as ammunition for slings or slingshots."
msgstr "A handful of glass marbles, useful as ammunition for slings or slingshots."

#: lang/json/AMMO_from_json.py
msgid "bearings"
msgid_plural "bearings"
msgstr[0] "bearings"
msgstr[1] "bearings"

#. ~ Description for bearings
#: lang/json/AMMO_from_json.py
msgid "A box of ball bearings, useful as ammunition for slings."
msgstr "A box of ball bearings, useful as ammunition for slings."

#: lang/json/AMMO_from_json.py
msgid "BB"
msgid_plural "BBs"
msgstr[0] "BB"
msgstr[1] "BBs"

#. ~ Description for BB
#: lang/json/AMMO_from_json.py
msgid "A box of small steel balls.  They deal virtually no damage."
msgstr "A box of small steel balls.  They deal virtually no damage."

#: lang/json/AMMO_from_json.py
msgid "feather"
msgid_plural "feathers"
msgstr[0] "feather"
msgstr[1] "feathers"

#. ~ Description for feather
#: lang/json/AMMO_from_json.py
msgid "Feathers from a bird.  Useful for fletching arrows"
msgstr "Feathers from a bird.  Useful for fletching arrows"

#: lang/json/AMMO_from_json.py
msgid "down feather"
msgid_plural "down feathers"
msgstr[0] "down feather"
msgstr[1] "down feathers"

#. ~ Description for down feather
#: lang/json/AMMO_from_json.py
msgid "fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr "fluffy down feathers from a bird.  Useful for making cozy bedclothes."

#: lang/json/AMMO_from_json.py
msgid "fusion pack"
msgid_plural "fusion packs"
msgstr[0] "fusion pack"
msgstr[1] "fusion packs"

#. ~ Description for fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil."
msgstr "In the middle of the 21st Century, military powers began to look towards energy based weapons.  The result was the standard fusion pack, capable of delivering bolts of superheated gas at near light speed with no recoil."

#: lang/json/AMMO_from_json.py
msgid "66mm HEAT"
msgid_plural "66mm HEATs"
msgstr[0] "66mm HEAT"
msgstr[1] "66mm HEATs"

#. ~ Description for 66mm HEAT
#: lang/json/AMMO_from_json.py
msgid ""
"A 60mm High Explosive Anti Tank round.  It could blow through up to two feet"
" of concrete."
msgstr "A 60mm High Explosive Anti Tank round.  It could blow through up to two feet of concrete."

#: lang/json/AMMO_from_json.py
msgid "120mm HEAT"
msgid_plural "120mm HEATs"
msgstr[0] "120mm HEAT"
msgstr[1] "120mm HEATs"

#. ~ Description for 120mm HEAT
#: lang/json/AMMO_from_json.py
msgid ""
"A 120mm High Explosive Anti Tank round.  It could ruin anyone's whole day."
msgstr "A 120mm High Explosive Anti Tank round.  It could ruin anyone's whole day."

#: lang/json/AMMO_from_json.py
msgid "hydrogen canister"
msgid_plural "hydrogen canisters"
msgstr[0] "hydrogen canister"
msgstr[1] "hydrogen canisters"

#. ~ Description for hydrogen canister
#: lang/json/AMMO_from_json.py
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated to plasma."
msgstr "A canister of pressurized hydrogen so heavily compressed it has turned solid.  With proper equipment, it could be heated to plasma."

#: lang/json/AMMO_from_json.py
msgid "unused .22 casing"
msgid_plural "unused .22 casings"
msgstr[0] "unused .22 casing"
msgstr[1] "unused .22 casings"

#. ~ Description for unused .22 casing
#: lang/json/AMMO_from_json.py
msgid ""
"An empty casing from a .22 round that hasn't been fired, and still has an "
"intact case with primer."
msgstr "An empty casing from a .22 round that hasn't been fired, and still has an intact case with primer."

#: lang/json/AMMO_from_json.py
