msgstr "Generic Guns"

#. ~ Description for Generic Guns
#: lang/json/MOD_INFO_from_json.py
msgid "Replaces guns and ammo with generic types."
msgstr "Replaces guns and ammo with generic types."

#: lang/json/MOD_INFO_from_json.py
msgid "Medieval and Historic Content"
msgstr "Medieval and Historic Content"

#. ~ Description for Medieval and Historic Content
#: lang/json/MOD_INFO_from_json.py
msgid "Assorted fun things for the wannabe knight, legionary, and more."
msgstr "Assorted fun things for the wannabe knight, legionary, and more."

#: lang/json/MOD_INFO_from_json.py
msgid "More Locations"
msgstr "More Locations"

#. ~ Description for More Locations
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds new Z-level buildings and dungeons.  Still unpolished.  Before "
"generating a world, you can remove subfolders to nix unwanted locations."
msgstr "Adds new Z-level buildings and dungeons.  Still unpolished.  Before generating a world, you can remove subfolders to nix unwanted locations."

#: lang/json/MOD_INFO_from_json.py
msgid "More Survival Tools"
msgstr "More Survival Tools"

#. ~ Description for More Survival Tools
#: lang/json/MOD_INFO_from_json.py
msgid ""
"For those who prefer being innawoods.  Adds several tools, various recipes "
"additions/tweaks, plus two new classes."
msgstr "For those who prefer being innawoods.  Adds several tools, various recipes additions/tweaks, plus two new classes."

#: lang/json/MOD_INFO_from_json.py
msgid "Mundane Zombies"
msgstr "Mundane Zombies"

#. ~ Description for Mundane Zombies
#: lang/json/MOD_INFO_from_json.py
msgid "Removes all special zombies from the game."
msgstr "Removes all special zombies from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "Mythological Replicas"
msgstr "Mythological Replicas"

#. ~ Description for Mythological Replicas
#: lang/json/MOD_INFO_from_json.py
msgid "Adds recipes for replicas of mythological weapons."
msgstr "Adds recipes for replicas of mythological weapons."

#: lang/json/MOD_INFO_from_json.py
msgid "No Acid Zombies"
msgstr "No Acid Zombies"

#. ~ Description for No Acid Zombies
#: lang/json/MOD_INFO_from_json.py
msgid "Removes all acid-based zombies from the game."
msgstr "Removes all acid-based zombies from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "No Explosive Zombies"
msgstr "No Explosive Zombies"

#. ~ Description for No Explosive Zombies
#: lang/json/MOD_INFO_from_json.py
msgid "Removes all explosion-based zombies from the game."
msgstr "Removes all explosion-based zombies from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "Perfect Reliability"
msgstr "Perfect Reliability"

#. ~ Description for Perfect Reliability
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Vehicle parts are perfectly reliable and never spawn with faults or develop "
"them during use"
msgstr "Vehicle parts are perfectly reliable and never spawn with faults or develop them during use"

#: lang/json/MOD_INFO_from_json.py
msgid "No Flaming Weapons"
msgstr "No Flaming Weapons"

#. ~ Description for No Flaming Weapons
#: lang/json/MOD_INFO_from_json.py
msgid "Removes flaming melee weapons."
msgstr "Removes flaming melee weapons."

#: lang/json/MOD_INFO_from_json.py
msgid "No Fungal Monsters"
msgstr "No Fungal Monsters"

#. ~ Description for No Fungal Monsters
#: lang/json/MOD_INFO_from_json.py
msgid "Removes fungal monsters and regions from the game."
msgstr "Removes fungal monsters and regions from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "No Medieval Items"
msgstr "No Medieval Items"

#. ~ Description for No Medieval Items
#: lang/json/MOD_INFO_from_json.py
msgid "Removes medieval weapons, armors, and specific books."
msgstr "Removes medieval weapons, armors, and specific books."

#: lang/json/MOD_INFO_from_json.py
msgid "Disable Mutagens"
msgstr "Disable Mutagens"

#. ~ Description for Disable Mutagens
#: lang/json/MOD_INFO_from_json.py
msgid "Removes mutagen items from the game."
msgstr "Removes mutagen items from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "Disable NPC Needs"
msgstr "Disable NPC Needs"

#. ~ Description for Disable NPC Needs
#: lang/json/MOD_INFO_from_json.py
msgid "Makes NPCs not require food, water or rest."
msgstr "Makes NPCs not require food, water or rest."

#: lang/json/MOD_INFO_from_json.py
msgid "No Antique Firearms"
msgstr "No Antique Firearms"

#. ~ Description for No Antique Firearms
#: lang/json/MOD_INFO_from_json.py
msgid "Removes all black powder and pre-Cold War firearms."
msgstr "Removes all black powder and pre-Cold War firearms."

#: lang/json/MOD_INFO_from_json.py
msgid "Disable Religious Texts"
msgstr "Disable Religious Texts"

#. ~ Description for Disable Religious Texts
#: lang/json/MOD_INFO_from_json.py
msgid "Removes religious text items from the game."
msgstr "Removes religious text items from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "Prevent Zombie Revivication"
msgstr "Prevent Zombie Revivication"

#. ~ Description for Prevent Zombie Revivication
#: lang/json/MOD_INFO_from_json.py
msgid "Disables zombie revival."
msgstr "Disables zombie revival."

#: lang/json/MOD_INFO_from_json.py
msgid "No Fictional Guns"
msgstr "No Fictional Guns"

#. ~ Description for No Fictional Guns
#: lang/json/MOD_INFO_from_json.py
msgid "Removes fictional conventional firearms and ammunition."
msgstr "Removes fictional conventional firearms and ammunition."

#: lang/json/MOD_INFO_from_json.py
msgid "No Survivor Armor"
msgstr "No Survivor Armor"

#. ~ Description for No Survivor Armor
#: lang/json/MOD_INFO_from_json.py
msgid "Removes survivor armor."
msgstr "Removes survivor armor."

#: lang/json/MOD_INFO_from_json.py
msgid "No Triffids"
msgstr "No Triffids"

#. ~ Description for No Triffids
#: lang/json/MOD_INFO_from_json.py
msgid "Removes triffids from the game."
msgstr "Removes triffids from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "No Zombie Animals"
msgstr "No Zombie Animals"

#. ~ Description for No Zombie Animals
#: lang/json/MOD_INFO_from_json.py
msgid "Removes zombie animals from the game."
msgstr "Removes zombie animals from the game."

#: lang/json/MOD_INFO_from_json.py
msgid "No Monsters"
msgstr "No Monsters"

#. ~ Description for No Monsters
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Removes all monsters from the game, save for those in the WILDLIFE category."
msgstr "Removes all monsters from the game, save for those in the WILDLIFE category."

#: lang/json/MOD_INFO_from_json.py
msgid "PKs Reimagining"
msgstr "PKs Reimagining"

#. ~ Description for PKs Reimagining
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds many new creatures and rebalances existing spawns to make the game more"
" challenging."
msgstr "Adds many new creatures and rebalances existing spawns to make the game more challenging."

#: lang/json/MOD_INFO_from_json.py
msgid "Classic Roguelike Classes"
msgstr "Classic Roguelike Classes"

#. ~ Description for Classic Roguelike Classes
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds a set of professions which correspond to classic Roguelike character "
"archetypes."
msgstr "Adds a set of professions which correspond to classic Roguelike character archetypes."

#: lang/json/MOD_INFO_from_json.py
msgid "Slow Zombies"
msgstr "Slow Zombies"

#. ~ Description for Slow Zombies
#: lang/json/MOD_INFO_from_json.py
msgid "Halves zombie speed."
msgstr "Halves zombie speed."

#: lang/json/MOD_INFO_from_json.py
msgid "StatsThroughSkills"
msgstr "StatsThroughSkills"

#. ~ Description for StatsThroughSkills
#: lang/json/MOD_INFO_from_json.py
msgid "Allows stats to raise naturally via skill progression."
msgstr "Allows stats to raise naturally via skill progression."

#: lang/json/MOD_INFO_from_json.py
msgid "Tanks and Other Vehicles"
msgstr "Tanks and Other Vehicles"

#. ~ Description for Tanks and Other Vehicles
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds a few armored fighting vehicles and other such things, requires Vehicle"
" Additions Pack."
msgstr "Adds a few armored fighting vehicles and other such things, requires Vehicle Additions Pack."

#: lang/json/MOD_INFO_from_json.py
msgid "Tough Zombies"
msgstr "Tough Zombies"

#. ~ Description for Tough Zombies
#: lang/json/MOD_INFO_from_json.py
msgid "Doubles zombie health."
msgstr "Doubles zombie health."

#: lang/json/MOD_INFO_from_json.py
msgid "Tall Buildings"
msgstr "Tall Buildings"

#. ~ Description for Tall Buildings
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Adds basic 3-D buildings.  For testing z-levels and those who want to play "
"with z-level buildings in their early state."
msgstr "Adds basic 3-D buildings.  For testing z-levels and those who want to play with z-level buildings in their early state."

#: lang/json/MOD_INFO_from_json.py
msgid "Zombie Nightvision"
msgstr "Zombie Nightvision"

#. ~ Description for Zombie Nightvision
#: lang/json/MOD_INFO_from_json.py
msgid "Gives all zombies perfect nightvision."
msgstr "Gives all zombies perfect nightvision."

#: lang/json/MOD_INFO_from_json.py
msgid "Vehicle Additions Pack"
msgstr "Vehicle Additions Pack"

#. ~ Description for Vehicle Additions Pack
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Please see the included PAQ.txt in the mod folder if you encounter any "
"issues."
msgstr "Please see the included PAQ.txt in the mod folder if you encounter any issues."

#: lang/json/MOD_INFO_from_json.py
msgid "More Craftables"
msgstr "More Craftables"

#. ~ Description for More Craftables
#: lang/json/MOD_INFO_from_json.py
msgid "Allows crafting of more improvised item variants"
msgstr "Allows crafting of more improvised item variants"

#: lang/json/MOD_INFO_from_json.py
msgid "More Classes and Scenarios"
msgstr "More Classes and Scenarios"

#. ~ Description for More Classes and Scenarios
#: lang/json/MOD_INFO_from_json.py
msgid "Adds classes and scenarios that are not balanced for the core game."
msgstr "Adds classes and scenarios that are not balanced for the core game."

#: lang/json/MOD_INFO_from_json.py
msgid "Necromancy"
msgstr "Necromancy"

#. ~ Description for Necromancy
#: lang/json/MOD_INFO_from_json.py
msgid "Adds the ability to revive creatures as minions."
msgstr "Adds the ability to revive creatures as minions."

#: lang/json/MOD_INFO_from_json.py
msgid "No Sci-Fi Equipment"
msgstr "No Sci-Fi Equipment"

#. ~ Description for No Sci-Fi Equipment
#: lang/json/MOD_INFO_from_json.py
msgid ""
"Removes far-future Sci-Fi items such as powered armor and energy weapons."
msgstr "Removes far-future Sci-Fi items such as powered armor and energy weapons."

#: lang/json/MOD_INFO_from_json.py
msgid "Simplified Nutrition"
msgstr "Simplified Nutrition"

#. ~ Description for Simplified Nutrition
#: lang/json/MOD_INFO_from_json.py
msgid "Disables vitamin requirements."
msgstr "Disables vitamin requirements."

#: lang/json/MOD_INFO_from_json.py
msgid "Extended Realistic Guns"
msgstr "Extended Realistic Guns"

#. ~ Description for Extended Realistic Guns
#: lang/json/MOD_INFO_from_json.py
msgid "Adds more overlapping ammo types and more real-world firearms."
msgstr "Adds more overlapping ammo types and more real-world firearms."

#: lang/json/MONSTER_from_json.py
msgid "Blinky"
msgid_plural "Blinkies"
msgstr[0] "Blinky"
msgstr[1] "Blinkies"

#. ~ Description for Blinky
#: lang/json/MONSTER_from_json.py
msgid "A strange three-eyed fish."
msgstr "A strange three-eyed fish."

#: lang/json/MONSTER_from_json.py
msgid "freshwater eel"
msgstr "freshwater eel"

#. ~ Description for freshwater eel
#: lang/json/MONSTER_from_json.py
msgid ""
"An American eel.  Used to be quite common in these parts until the dams were"
" built.  Guess they'll get a second chance now that they aren't running."
msgstr "An American eel.  Used to be quite common in these parts until the dams were built.  Guess they'll get a second chance now that they aren't running."

#: lang/json/MONSTER_from_json.py
msgid "bowfin"
msgstr "bowfin"

#. ~ Description for bowfin
#: lang/json/MONSTER_from_json.py
msgid ""
"A Bowfin.  These fish are related to gar but without the huge teeth, skin "
"rending scales, and aggression."
msgstr "A Bowfin.  These fish are related to gar but without the huge teeth, skin rending scales, and aggression."

#: lang/json/MONSTER_from_json.py
msgid "bullhead"
msgstr "bullhead"

#. ~ Description for bullhead
#: lang/json/MONSTER_from_json.py
msgid "A bullhead, a type of catfish.  Delicious battered and fried."
msgstr "A bullhead, a type of catfish.  Delicious battered and fried."

#: lang/json/MONSTER_from_json.py
msgid "trout"
msgstr "trout"

#. ~ Description for trout
#: lang/json/MONSTER_from_json.py
msgid ""
"A trout is a trout, without a doubt.  A fish made popular by father-son "
"fishing trips, Except for the part where you have to gut it."
msgstr "A trout is a trout, without a doubt.  A fish made popular by father-son fishing trips, Except for the part where you have to gut it."

#: lang/json/MONSTER_from_json.py
msgid "carp"
msgstr "carp"

#. ~ Description for carp
#: lang/json/MONSTER_from_json.py
msgid ""
"A golden-yellow common carp.  Some people think they don't taste great, but "
"you can't afford to be choosy in the cataclysm."
msgstr "A golden-yellow common carp.  Some people think they don't taste great, but you can't afford to be choosy in the cataclysm."

#: lang/json/MONSTER_from_json.py
msgid "pike"
msgstr "pike"

#. ~ Description for pike
#: lang/json/MONSTER_from_json.py
msgid ""
"A pike.  Pike can be a pretty aggressive fish, careful around those teeth."
msgstr "A pike.  Pike can be a pretty aggressive fish, careful around those teeth."

#: lang/json/MONSTER_from_json.py
msgid "bluegill"
msgstr "bluegill"

#. ~ Description for bluegill
#: lang/json/MONSTER_from_json.py
msgid ""
"A bluegill, An invasive species in Japan.  Commonly gutted and cooked whole."
msgstr "A bluegill, An invasive species in Japan.  Commonly gutted and cooked whole."

#: lang/json/MONSTER_from_json.py
msgid "smallmouth bass"
msgid_plural "smallmouth bass"
msgstr[0] "smallmouth bass"
msgstr[1] "smallmouth bass"

#. ~ Description for smallmouth bass
#: lang/json/MONSTER_from_json.py
msgid ""
"A Smallmouth bass.  Being intolerant to pollution in the water, smallmouth "
"bass are a good indicator of how clean it is.  Just because you see them "
"though, doesn't mean you can drink the water without boiling it first."
msgstr "A Smallmouth bass.  Being intolerant to pollution in the water, smallmouth bass are a good indicator of how clean it is.  Just because you see them though, doesn't mean you can drink the water without boiling it first."

#: lang/json/MONSTER_from_json.py
msgid "largemouth bass"
msgid_plural "largemouth bass"
msgstr[0] "largemouth bass"
msgstr[1] "largemouth bass"

#. ~ Description for largemouth bass
#: lang/json/MONSTER_from_json.py
msgid "A largemouth bass.  Very popular with sports fishermen."
msgstr "A largemouth bass.  Very popular with sports fishermen."

#: lang/json/MONSTER_from_json.py
msgid "striped bass"
msgid_plural "striped bass"
msgstr[0] "striped bass"
msgstr[1] "striped bass"

#. ~ Description for striped bass
#: lang/json/MONSTER_from_json.py
msgid ""
"A striped bass.  Mostly a salt water fish, they migrate to fresher water to "
"spawn."
msgstr "A striped bass.  Mostly a salt water fish, they migrate to fresher water to spawn."

#: lang/json/MONSTER_from_json.py
msgid "perch"
msgid_plural "perches"
msgstr[0] "perch"
msgstr[1] "perches"

#. ~ Description for perch
#: lang/json/MONSTER_from_json.py
msgid ""
"A small spritely perch.  A very bony fish, still got some tasty meat on it "
"though."
msgstr "A small spritely perch.  A very bony fish, still got some tasty meat on it though."

#: lang/json/MONSTER_from_json.py
msgid "salmon"
msgstr "salmon"

#. ~ Description for salmon
#: lang/json/MONSTER_from_json.py
msgid "A salmon.  A very fatty, nutricious fish.  Tastes great smoked."
msgstr "A salmon.  A very fatty, nutricious fish.  Tastes great smoked."

#: lang/json/MONSTER_from_json.py
msgid "sunfish"
msgid_plural "sunfish"
msgstr[0] "sunfish"
msgstr[1] "sunfish"

#. ~ Description for sunfish
#: lang/json/MONSTER_from_json.py
msgid ""
"A sunfish.  No, not the giant tropical thing.  This one is a small fish "
"related to bass or bluegill."
msgstr "A sunfish.  No, not the giant tropical thing.  This one is a small fish related to bass or bluegill."

#: lang/json/MONSTER_from_json.py
msgid "whitefish"
msgid_plural "whitefish"
msgstr[0] "whitefish"
msgstr[1] "whitefish"

#. ~ Description for whitefish
#: lang/json/MONSTER_from_json.py
msgid ""
"A whitefish, closely related to salmon.  One can assume they are just as "
"nice when cooked with smoke."
msgstr "A whitefish, closely related to salmon.  One can assume they are just as nice when cooked with smoke."

#: lang/json/MONSTER_from_json.py
msgid "pickerel"
msgid_plural "pickerel"
msgstr[0] "pickerel"
msgstr[1] "pickerel"

#. ~ Description for pickerel
#: lang/json/MONSTER_from_json.py
msgid "A pickerel.  It looks like a pike, but much smaller."
msgstr "A pickerel.  It looks like a pike, but much smaller."

#: lang/json/MONSTER_from_json.py
msgid "jawed terror"
msgstr "jawed terror"

#. ~ Description for jawed terror
#: lang/json/MONSTER_from_json.py
msgid ""
"A once aggressive and hungry bull shark, this jawed terror is now even more "
"aggressive, possibly thanks to its lack of a functioning brain."
msgstr "A once aggressive and hungry bull shark, this jawed terror is now even more aggressive, possibly thanks to its lack of a functioning brain."

#: lang/json/MONSTER_from_json.py
msgid "giant carp"
msgstr "giant carp"

#. ~ Description for giant carp
#: lang/json/MONSTER_from_json.py
msgid ""
"This thing seems like a carp, only swollen and very very angry.  Death is "
"the gift of the carp god."
msgstr "This thing seems like a carp, only swollen and very very angry.  Death is the gift of the carp god."

#: lang/json/MONSTER_from_json.py
msgid "giant salmon"
msgstr "giant salmon"

#. ~ Description for giant salmon
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated salmon, the same size as a large dog and quite dangerous to the "
"inexperienced angler."
msgstr "A mutated salmon, the same size as a large dog and quite dangerous to the inexperienced angler."

#: lang/json/MONSTER_from_json.py
msgid "Lobster"
msgstr "Lobster"

#. ~ Description for Lobster
#: lang/json/MONSTER_from_json.py
msgid ""
"These things were once considered pests not worth eating, then some "
"marketing genius started selling them to people as a delicacy and they took "
"off in popularity...  and price."
msgstr "These things were once considered pests not worth eating, then some marketing genius started selling them to people as a delicacy and they took off in popularity...  and price."

#: lang/json/MONSTER_from_json.py
msgid "Crayfish"
msgstr "Crayfish"

#. ~ Description for Crayfish
#: lang/json/MONSTER_from_json.py
msgid ""
"If you could get ahold of a bunch more of these, a hefty pot of boiling "
"water, and some spicy seasonings..."
msgstr "If you could get ahold of a bunch more of these, a hefty pot of boiling water, and some spicy seasonings..."

#: lang/json/MONSTER_from_json.py
msgid "debug monster"
msgstr "debug monster"

#. ~ Description for debug monster
#: lang/json/MONSTER_from_json.py
msgid "This monster exists only for testing purposes."
msgstr "This monster exists only for testing purposes."

#: lang/json/MONSTER_from_json.py
msgid "albino penguin"
msgstr "albino penguin"

#. ~ Description for albino penguin
#: lang/json/MONSTER_from_json.py
msgid ""
"Eight-feet-tall ghastly white penguins.  Placid unless otherwise provoked."
msgstr "Eight-feet-tall ghastly white penguins.  Placid unless otherwise provoked."

#: lang/json/MONSTER_from_json.py
msgid "alpha razorclaw"
msgstr "alpha razorclaw"

#. ~ Description for alpha razorclaw
#: lang/json/MONSTER_from_json.py
msgid ""
"A blood red, gigantic razorclaw.  Its sword like pincers serve as the "
"keepers of the nest."
msgstr "A blood red, gigantic razorclaw.  Its sword like pincers serve as the keepers of the nest."

#: lang/json/MONSTER_from_json.py
msgid "amigara horror"
msgstr "amigara horror"

#. ~ Description for amigara horror
#: lang/json/MONSTER_from_json.py
msgid ""
"A hellish, vaguely humanoid horror, two stories tall.  Its face is "
"grotesquely stretched out, its limbs deformed to unrecognizable outgrowths."
msgstr "A hellish, vaguely humanoid horror, two stories tall.  Its face is grotesquely stretched out, its limbs deformed to unrecognizable outgrowths."

#: lang/json/MONSTER_from_json.py
msgid "giant ant"
msgstr "giant ant"

#. ~ Description for giant ant
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous red ant covered in chitinous plates.  It possesses a pair of "
"wriggling antennae and vicious-looking mandibles."
msgstr "An enormous red ant covered in chitinous plates.  It possesses a pair of wriggling antennae and vicious-looking mandibles."

#: lang/json/MONSTER_from_json.py
msgid "fungal ant"
msgstr "fungal ant"

#. ~ Description for fungal ant
#: lang/json/MONSTER_from_json.py
msgid ""
"Pale, sickly gray in color, this giant ant's cracked exoskeleton is barely "
"held together by coils of fungus erupting from every joint in its body."
msgstr "Pale, sickly gray in color, this giant ant's cracked exoskeleton is barely held together by coils of fungus erupting from every joint in its body."

#: lang/json/MONSTER_from_json.py
msgid "ant larva"
msgstr "ant larva"

#. ~ Description for ant larva
#: lang/json/MONSTER_from_json.py
msgid ""
"A pulsating sausage of glistening white flesh, the size of a large cat.  On "
"one end is a set of squirming mouth parts."
msgstr "A pulsating sausage of glistening white flesh, the size of a large cat.  On one end is a set of squirming mouth parts."

#: lang/json/MONSTER_from_json.py
msgid "queen ant"
msgstr "queen ant"

#. ~ Description for queen ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A colossal red ant with a bulging, bloated thorax.  It moves slowly and "
"deliberately, tending to nearby eggs and continually laying more."
msgstr "A colossal red ant with a bulging, bloated thorax.  It moves slowly and deliberately, tending to nearby eggs and continually laying more."

#: lang/json/MONSTER_from_json.py
msgid "soldier ant"
msgstr "soldier ant"

#. ~ Description for soldier ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge and hairy red ant almost twice the size of other giant ants.  Bulging"
" pincers extend from its jaws."
msgstr "A huge and hairy red ant almost twice the size of other giant ants.  Bulging pincers extend from its jaws."

#: lang/json/MONSTER_from_json.py
msgid "bat"
msgstr "bat"

#. ~ Description for bat
#: lang/json/MONSTER_from_json.py
msgid ""
"One of the vesper bats, a family of winged insect-eating mammals.  It roosts"
" in caves and other hollows, and uses a form of echolocation to aerially "
"navigate through tricky terrain at rapid speeds."
msgstr "One of the vesper bats, a family of winged insect-eating mammals.  It roosts in caves and other hollows, and uses a form of echolocation to aerially navigate through tricky terrain at rapid speeds."

#: lang/json/MONSTER_from_json.py
msgid "bear"
msgstr "bear"

#. ~ Description for bear
#: lang/json/MONSTER_from_json.py
msgid ""
"The American black bear.  A large omnivorous scavenger, it has powerful "
"claws and jaws, and is an effective ambush hunter.  It can pose a "
"considerable threat, although most individuals are shy around humans."
msgstr "The American black bear.  A large omnivorous scavenger, it has powerful claws and jaws, and is an effective ambush hunter.  It can pose a considerable threat, although most individuals are shy around humans."

#: lang/json/MONSTER_from_json.py
msgid "Smoky bear"
msgstr "Smoky bear"

#. ~ Description for Smoky bear
#: lang/json/MONSTER_from_json.py
msgid ""
"A smoking husk is all that remains of this once proud bear.  Its black eyes "
"gaze at you with malice... and hunger."
msgstr "A smoking husk is all that remains of this once proud bear.  Its black eyes gaze at you with malice... and hunger."

#: lang/json/MONSTER_from_json.py
msgid "beaver"
msgstr "beaver"

#. ~ Description for beaver
#: lang/json/MONSTER_from_json.py
msgid ""
"The North American beaver, the continent's largest rodent.  Its paddle-"
"shaped tail helps ferry it through the water, and its prominent teeth can "
"chew through wood, which it uses to build dam-like nests in lakes and "
"streams."
msgstr "The North American beaver, the continent's largest rodent.  Its paddle-shaped tail helps ferry it through the water, and its prominent teeth can chew through wood, which it uses to build dam-like nests in lakes and streams."

#: lang/json/MONSTER_from_json.py
msgid "giant bee"
msgstr "giant bee"

#. ~ Description for giant bee
#: lang/json/MONSTER_from_json.py
msgid ""
"With a stinger the size of a kitchen knife, this dog-sized insect's black "
"and yellow markings warn you to leave it undisturbed."
msgstr "With a stinger the size of a kitchen knife, this dog-sized insect's black and yellow markings warn you to leave it undisturbed."

#: lang/json/MONSTER_from_json.py
msgid "scarred zombie"
msgstr "scarred zombie"

#. ~ Description for scarred zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A deformed human body, its skin has been transformed into one thick, "
"calloused envelope of scar tissue."
msgstr "A deformed human body, its skin has been transformed into one thick, calloused envelope of scar tissue."

#: lang/json/MONSTER_from_json.py
msgid "biollante"
msgstr "biollante"

#. ~ Description for biollante
#: lang/json/MONSTER_from_json.py
msgid ""
"A drooped, quivering plant with a thick stalk adorned by a purple flower.  "
"Its petals are closed, and pulsate ominously."
msgstr "A drooped, quivering plant with a thick stalk adorned by a purple flower.  Its petals are closed, and pulsate ominously."

#: lang/json/MONSTER_from_json.py
msgid "black rat"
msgstr "black rat"

#. ~ Description for black rat
#: lang/json/MONSTER_from_json.py
msgid ""
"The black rat, an omnivorous rodent with sheer black fur and a long, rough "
"tail.  Harbinger of pestilence, famine, and mange, it will sometimes swarm "
"over the dead or dying."
msgstr "The black rat, an omnivorous rodent with sheer black fur and a long, rough tail.  Harbinger of pestilence, famine, and mange, it will sometimes swarm over the dead or dying."

#: lang/json/MONSTER_from_json.py
msgid "blank body"
msgid_plural "blank bodies"
msgstr[0] "blank body"
msgstr[1] "blank bodies"

#. ~ Description for blank body
#: lang/json/MONSTER_from_json.py
msgid ""
"This looks like a human body, but its flesh is snow-white, and its face is "
"featureless save for a perfectly round mouth."
msgstr "This looks like a human body, but its flesh is snow-white, and its face is featureless save for a perfectly round mouth."

#: lang/json/MONSTER_from_json.py
msgid "blob"
msgstr "blob"

#. ~ Description for blob
#: lang/json/MONSTER_from_json.py
msgid ""
"A black blob of viscous goo, oozing across the ground like a glob of living "
"oil."
msgstr "A black blob of viscous goo, oozing across the ground like a glob of living oil."

#: lang/json/MONSTER_from_json.py
msgid "brain blob"
msgstr "brain blob"

#. ~ Description for brain blob
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic black blob of viscous goo, oozing across the ground like a glob "
"of living oil.  Other blobs seem to swarm around it."
msgstr "A gigantic black blob of viscous goo, oozing across the ground like a glob of living oil.  Other blobs seem to swarm around it."

#: lang/json/MONSTER_from_json.py
msgid "big blob"
msgstr "big blob"

#. ~ Description for big blob
#: lang/json/MONSTER_from_json.py
msgid ""
"A large black blob of viscous goo, oozing across the ground like a glob of "
"living oil."
msgstr "A large black blob of viscous goo, oozing across the ground like a glob of living oil."

#: lang/json/MONSTER_from_json.py
msgid "small blob"
msgstr "small blob"

#. ~ Description for small blob
#: lang/json/MONSTER_from_json.py
msgid ""
"A small black blob of viscous goo, oozing across the ground like a glob of "
"living oil."
msgstr "A small black blob of viscous goo, oozing across the ground like a glob of living oil."

#: lang/json/MONSTER_from_json.py
msgid "blood sacrifice"
msgstr "blood sacrifice"

#. ~ Description for blood sacrifice
#: lang/json/MONSTER_from_json.py
msgid ""
"A defiled human body, once living.  Tortured to death long ago, it remains "
"chained to the altar, the putrescent flays of its peeled skin quivering like"
" so much flotsam upon a murky pond."
msgstr "A defiled human body, once living.  Tortured to death long ago, it remains chained to the altar, the putrescent flays of its peeled skin quivering like so much flotsam upon a murky pond."

#: lang/json/MONSTER_from_json.py
msgid "bobcat"
msgstr "bobcat"

#. ~ Description for bobcat
#: lang/json/MONSTER_from_json.py
msgid ""
"A spotted wild cat living across much of North America.  It is not a serious"
" threat to humans, but it can be aggressive if not left alone."
msgstr "A spotted wild cat living across much of North America.  It is not a serious threat to humans, but it can be aggressive if not left alone."

#: lang/json/MONSTER_from_json.py
msgid "boomer"
msgstr "boomer"

#. ~ Description for boomer
#: lang/json/MONSTER_from_json.py
msgid ""
"A rotund human body, bloated beyond belief and layered in rolls of fat.  It "
"emits a horrible odor, and a putrid pink sludge dribbles from its mouth."
msgstr "A rotund human body, bloated beyond belief and layered in rolls of fat.  It emits a horrible odor, and a putrid pink sludge dribbles from its mouth."

#: lang/json/MONSTER_from_json.py
msgid "fungal boomer"
msgstr "fungal boomer"

#. ~ Description for fungal boomer
#: lang/json/MONSTER_from_json.py
msgid ""
"A rotund and bloated human body with pasty, fungus-ridden flesh.  Its mouth "
"drips with a frothing gray sludge."
msgstr "A rotund and bloated human body with pasty, fungus-ridden flesh.  Its mouth drips with a frothing gray sludge."

#: lang/json/MONSTER_from_json.py
msgid "huge boomer"
msgstr "huge boomer"

#. ~ Description for huge boomer
#: lang/json/MONSTER_from_json.py
msgid ""
"This boomer, normally swollen and ready to burst, has strengthened and "
"solidified.  The bile dribbling from its mouth also appears to have "
"changed..."
msgstr "This boomer, normally swollen and ready to burst, has strengthened and solidified.  The bile dribbling from its mouth also appears to have changed..."

#: lang/json/MONSTER_from_json.py
msgid "breather"
msgstr "breather"

#. ~ Description for breather
#: lang/json/MONSTER_from_json.py
msgid "A weird mass of immobile pink goo.  It seems to breathe."
msgstr "A weird mass of immobile pink goo.  It seems to breathe."

#: lang/json/MONSTER_from_json.py
msgid "broken cyborg"
msgstr "broken cyborg"

#. ~ Description for broken cyborg
#: lang/json/MONSTER_from_json.py
msgid ""
"A robot body with the head of a human.  All kinds of electronic wires and "
"devices are implanted in its head.  Patches of skin look diseased or "
"rotting.  This cyborg moves erratically and has a confused and deranged look"
" in its eyes."
msgstr "A robot body with the head of a human.  All kinds of electronic wires and devices are implanted in its head.  Patches of skin look diseased or rotting.  This cyborg moves erratically and has a confused and deranged look in its eyes."

#: lang/json/MONSTER_from_json.py
msgid "cat"
msgstr "cat"

#. ~ Description for cat
#: lang/json/MONSTER_from_json.py
msgid ""
"A small domesticated predator gone feral in the absence of human "
"stewardship.  Harried by the elements and the rigors of survival, it is "
"scruffy and skittish."
msgstr "A small domesticated predator gone feral in the absence of human stewardship.  Harried by the elements and the rigors of survival, it is scruffy and skittish."

#: lang/json/MONSTER_from_json.py
msgid "giant centipede"
msgstr "giant centipede"

#. ~ Description for giant centipede
#: lang/json/MONSTER_from_json.py
msgid ""
"A meter-long centipede with a menacing pair of pincers, moving swiftly on "
"dozens of spindly legs."
msgstr "A meter-long centipede with a menacing pair of pincers, moving swiftly on dozens of spindly legs."

#: lang/json/MONSTER_from_json.py
msgid "charred nightmare"
msgstr "charred nightmare"

#. ~ Description for charred nightmare
#: lang/json/MONSTER_from_json.py
msgid ""
"Intense radiation has spurred a unique form of necrosis and regeneration, it"
" is impossible to tell if this creature was ever human."
msgstr "Intense radiation has spurred a unique form of necrosis and regeneration, it is impossible to tell if this creature was ever human."

#: lang/json/MONSTER_from_json.py
msgid "chicken"
msgstr "chicken"

#. ~ Description for chicken
#: lang/json/MONSTER_from_json.py
msgid ""
"A domesticated descendant of junglefowl, it may still be the most numerous "
"bird in the world.  Before the Cataclysm, it was raised by humans as a "
"source of meat, eggs, and early morning wakeup calls."
msgstr "A domesticated descendant of junglefowl, it may still be the most numerous bird in the world.  Before the Cataclysm, it was raised by humans as a source of meat, eggs, and early morning wakeup calls."

#: lang/json/MONSTER_from_json.py
msgid "chicken walker"
msgstr "chicken walker"

#. ~ Description for chicken walker
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northrup ATSV, a massive, heavily-armed and armored robot walking on a "
"pair of reverse-jointed legs.  Armed with a 40mm anti-vehicle grenade "
"launcher, 5.56 anti-personnel gun, and the ability to electrify itself "
"against attackers, it is an effective automated sentry, though production "
"was limited due to a legal dispute."
msgstr "The Northrup ATSV, a massive, heavily-armed and armored robot walking on a pair of reverse-jointed legs.  Armed with a 40mm anti-vehicle grenade launcher, 5.56 anti-personnel gun, and the ability to electrify itself against attackers, it is an effective automated sentry, though production was limited due to a legal dispute."

#: lang/json/MONSTER_from_json.py
msgid "chipmunk"
msgstr "chipmunk"

#. ~ Description for chipmunk
#: lang/json/MONSTER_from_json.py
msgid ""
"The eastern chipmunk, a tiny omnivorous rodent with a characteristic striped"
" coat.  It spends much of the day patrolling its elaborate burrow and the "
"precious stores of foraged food within."
msgstr "The eastern chipmunk, a tiny omnivorous rodent with a characteristic striped coat.  It spends much of the day patrolling its elaborate burrow and the precious stores of foraged food within."

#: lang/json/MONSTER_from_json.py
msgid "C.H.U.D."
msgstr "C.H.U.D."

#. ~ Description for C.H.U.D.
#: lang/json/MONSTER_from_json.py
msgid ""
"The C.H.U.D.  or Cannibalistic Humanoid Underground Dweller.  A human being "
"turned pale and mad from years of underground isolation."
msgstr "The C.H.U.D.  or Cannibalistic Humanoid Underground Dweller.  A human being turned pale and mad from years of underground isolation."

#: lang/json/MONSTER_from_json.py
msgid "police bot"
msgstr "police bot"

#. ~ Description for police bot
#: lang/json/MONSTER_from_json.py
msgid ""
"One of the many models of armored law enforcement robots employed shortly "
"before the collapse of civilization.  Solar powered like many other robots, "
"it maintains its programmed pursuit of law and order, propelled on a trio of"
" omni wheels."
msgstr "One of the many models of armored law enforcement robots employed shortly before the collapse of civilization.  Solar powered like many other robots, it maintains its programmed pursuit of law and order, propelled on a trio of omni wheels."

#: lang/json/MONSTER_from_json.py
msgid "cougar"
msgstr "cougar"

#. ~ Description for cougar
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern cougar, a large feline predator.  Once thought extinct in this "
"region, conservation efforts were successful in restoring a thriving "
"population."
msgstr "The Eastern cougar, a large feline predator.  Once thought extinct in this region, conservation efforts were successful in restoring a thriving population."

#: lang/json/MONSTER_from_json.py
msgid "cow"
msgstr "cow"

#. ~ Description for cow
#: lang/json/MONSTER_from_json.py
msgid ""
"The domestic cow, a baleful, ruminating farm animal.  It is quite muscular, "
"and the males can have a violent streak to accompany their nasty-looking "
"horns."
msgstr "The domestic cow, a baleful, ruminating farm animal.  It is quite muscular, and the males can have a violent streak to accompany their nasty-looking horns."

#: lang/json/MONSTER_from_json.py
msgid "coyote"
msgstr "coyote"

#. ~ Description for coyote
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern coyote, also called the tweed wolf, is a territorial canine "
"descended from the offspring of gray wolves and true coyotes.  It is "
"intimidated by humans and other predators, but will fight if threatened."
msgstr "The Eastern coyote, also called the tweed wolf, is a territorial canine descended from the offspring of gray wolves and true coyotes.  It is intimidated by humans and other predators, but will fight if threatened."

#. ~ Description for coyote
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northeastern coyote, a widespread canine pack hunter.  More timid than a"
" wolf, it is an opportunistic feeder and prefers to hunt smaller and weaker "
"prey."
msgstr "The Northeastern coyote, a widespread canine pack hunter.  More timid than a wolf, it is an opportunistic feeder and prefers to hunt smaller and weaker prey."

#: lang/json/MONSTER_from_json.py
msgid "crawler"
msgstr "crawler"

#. ~ Description for crawler
#: lang/json/MONSTER_from_json.py
msgid ""
"A conglomeration of human parts fused together in a horrible mishmash of "
"function, slowly dragging its eldritch body across the ground."
msgstr "A conglomeration of human parts fused together in a horrible mishmash of function, slowly dragging its eldritch body across the ground."

#: lang/json/MONSTER_from_json.py
msgid "creeper hub"
msgstr "creeper hub"

#. ~ Description for creeper hub
#: lang/json/MONSTER_from_json.py
msgid ""
"A thick stalk, rooted to the ground.  It rapidly sprouts thorny vines in all"
" directions."
msgstr "A thick stalk, rooted to the ground.  It rapidly sprouts thorny vines in all directions."

#: lang/json/MONSTER_from_json.py
msgid "creeper vine"
msgstr "creeper vine"

#. ~ Description for creeper vine
#: lang/json/MONSTER_from_json.py
msgid "A thorny vine, twisting wildly as it grows with incredible speed."
msgstr "A thorny vine, twisting wildly as it grows with incredible speed."

#: lang/json/MONSTER_from_json.py
msgid "crow"
msgstr "crow"

#. ~ Description for crow
#: lang/json/MONSTER_from_json.py
msgid ""
"A small, elegant black bird, famous for its distinctive call.  An "
"intelligent bird, there is a glitter of mischief behind its eyes."
msgstr "A small, elegant black bird, famous for its distinctive call.  An intelligent bird, there is a glitter of mischief behind its eyes."

#: lang/json/MONSTER_from_json.py
msgid "dark wyrm"
msgstr "dark wyrm"

#. ~ Description for dark wyrm
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge mutated worm found deep underground.  It has a gaping round mouth "
"lined with dagger-like teeth, and its flesh is slick with bubbling blue "
"slime."
msgstr "A huge mutated worm found deep underground.  It has a gaping round mouth lined with dagger-like teeth, and its flesh is slick with bubbling blue slime."

#: lang/json/MONSTER_from_json.py
msgid "wraith"
msgstr "wraith"

#. ~ Description for wraith
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic shadow, chaotically changing in shape and volume , two piercing "
"orbs of light dominate what can only be described as its head."
msgstr "A gigantic shadow, chaotically changing in shape and volume , two piercing orbs of light dominate what can only be described as its head."

#: lang/json/MONSTER_from_json.py
msgid "deer"
msgstr "deer"

#. ~ Description for deer
#: lang/json/MONSTER_from_json.py
msgid ""
"The northern woodland white-tailed deer, a quick and strong grazing animal."
"  Favored prey of coyotes, wolves, and giant spider mutants."
msgstr "The northern woodland white-tailed deer, a quick and strong grazing animal.  Favored prey of coyotes, wolves, and giant spider mutants."

#: lang/json/MONSTER_from_json.py
msgid "dementia"
msgstr "dementia"

#. ~ Description for dementia
#: lang/json/MONSTER_from_json.py
msgid ""
"A crazed individual, the bloody scars on the side of its shaved head suggest"
" some sort of partial lobotomy"
msgstr "A crazed individual, the bloody scars on the side of its shaved head suggest some sort of partial lobotomy"

#: lang/json/MONSTER_from_json.py
msgid "dermatik"
msgstr "dermatik"

#. ~ Description for dermatik
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated wasp nearly the size of a cat, with a barbed ovipositor extruding "
"from the abdomen."
msgstr "A mutated wasp nearly the size of a cat, with a barbed ovipositor extruding from the abdomen."

#: lang/json/MONSTER_from_json.py
msgid "dermatik larva"
msgstr "dermatik larva"

#. ~ Description for dermatik larva
#: lang/json/MONSTER_from_json.py
msgid ""
"A fat white grub as big as a squirrel, with a pair of large, spadelike "
"mandibles."
msgstr "A fat white grub as big as a squirrel, with a pair of large, spadelike mandibles."

#: lang/json/MONSTER_from_json.py src/game.cpp
msgid "dog"
msgstr "dog"

#. ~ Description for dog
#: lang/json/MONSTER_from_json.py
msgid ""
"With mangy fur and hungry eyes, it's clear that this once domesticated dog "
"has gone feral."
msgstr "With mangy fur and hungry eyes, it's clear that this once domesticated dog has gone feral."

#: lang/json/MONSTER_from_json.py
msgid "skeletal dog"
msgstr "skeletal dog"

#. ~ Description for skeletal dog
#: lang/json/MONSTER_from_json.py
msgid ""
"This canines see-through thin, black veined and scab riddled skin, is "
"tightly compressed around its skeletal frame."
msgstr "This canines see-through thin, black veined and scab riddled skin, is tightly compressed around its skeletal frame."

#. ~ Description for dog
#: lang/json/MONSTER_from_json.py
msgid ""
"A domesticated mongrel of the canine persuasion.  In the absence of human "
"society, it has turned feral.  You feel a sudden urge to destroy it."
msgstr "A domesticated mongrel of the canine persuasion.  In the absence of human society, it has turned feral.  You feel a sudden urge to destroy it."

#: lang/json/MONSTER_from_json.py
msgid "Z-9"
msgstr "Z-9"

#. ~ Description for Z-9
#: lang/json/MONSTER_from_json.py
msgid ""
"A zombified version of one of the German shepherd dogs used in law "
"enforcement.  Its deformed body is encased in a protective Kevlar harness."
msgstr "A zombified version of one of the German shepherd dogs used in law enforcement.  Its deformed body is encased in a protective Kevlar harness."

#: lang/json/MONSTER_from_json.py
msgid "rot-weiler"
msgstr "rot-weiler"

#. ~ Description for rot-weiler
#: lang/json/MONSTER_from_json.py
msgid ""
"Acrid smell accompanies this corpse of canine.  Its whole body is covered in"
" chains of pulsing cysts and slime dribbling ulcers."
msgstr "Acrid smell accompanies this corpse of canine.  Its whole body is covered in chains of pulsing cysts and slime dribbling ulcers."

#: lang/json/MONSTER_from_json.py
msgid "giant dragonfly"
msgid_plural "giant dragonflies"
msgstr[0] "giant dragonfly"
msgstr[1] "giant dragonflies"

#. ~ Description for giant dragonfly
#: lang/json/MONSTER_from_json.py
msgid ""
"A ferocious mutant dragonfly as big as a cat, darting through the air with a"
" cluster of fangs for a mouth."
msgstr "A ferocious mutant dragonfly as big as a cat, darting through the air with a cluster of fangs for a mouth."

#: lang/json/MONSTER_from_json.py
msgid "duck"
msgstr "duck"

#. ~ Description for duck
#: lang/json/MONSTER_from_json.py
msgid ""
"A mallard duck, often seen around rivers and other bodies of water.  It "
"feeds primarily on insects, seeds, roots, and, pre-cataclysm, bread scraps."
msgstr "A mallard duck, often seen around rivers and other bodies of water.  It feeds primarily on insects, seeds, roots, and, pre-cataclysm, bread scraps."

#: lang/json/MONSTER_from_json.py
msgid "exploder"
msgstr "exploder"

#. ~ Description for exploder
#: lang/json/MONSTER_from_json.py
msgid ""
"A small, round turret which extends from the floor.  Two SMG barrels swivel "
"360 degrees."
msgstr "A small, round turret which extends from the floor.  Two SMG barrels swivel 360 degrees."

#: lang/json/MONSTER_from_json.py
msgid "eyebot"
msgstr "eyebot"

#. ~ Description for eyebot
#: lang/json/MONSTER_from_json.py
msgid ""
"A fusion-driven UAV largely comprised of a high-resolution camera lens, this"
" spheroid robot hovers above the ground, silent witness to the carnage and "
"mayhem around it."
msgstr "A fusion-driven UAV largely comprised of a high-resolution camera lens, this spheroid robot hovers above the ground, silent witness to the carnage and mayhem around it."

#: lang/json/MONSTER_from_json.py
msgid "flaming eye"
msgstr "flaming eye"

#. ~ Description for flaming eye
#: lang/json/MONSTER_from_json.py
msgid ""
"An eyeball the size of an easy chair, covered in rolling blue flames.  It "
"floats through the air, spinning slowly to draw its gaze in every direction."
msgstr "An eyeball the size of an easy chair, covered in rolling blue flames.  It floats through the air, spinning slowly to draw its gaze in every direction."

#: lang/json/MONSTER_from_json.py
msgid "flesh angel"
msgstr "flesh angel"

#. ~ Description for flesh angel
#: lang/json/MONSTER_from_json.py
msgid ""
"A tall and slender man lacking skin and any normalcy of countenance.  Wings "
"of muscle curl forth from its back and a third eye dominates the forehead."
msgstr "A tall and slender man lacking skin and any normalcy of countenance.  Wings of muscle curl forth from its back and a third eye dominates the forehead."

#: lang/json/MONSTER_from_json.py
msgid "giant fly"
msgid_plural "giant flies"
msgstr[0] "giant fly"
msgstr[1] "giant flies"

#. ~ Description for giant fly
#: lang/json/MONSTER_from_json.py
msgid ""
"A tremendous housefly the size of a small dog, predictably accompanied by a "
"loud, incessant buzzing sound."
msgstr "A tremendous housefly the size of a small dog, predictably accompanied by a loud, incessant buzzing sound."

#: lang/json/MONSTER_from_json.py
msgid "flying polyp"
msgstr "flying polyp"

#. ~ Description for flying polyp
#: lang/json/MONSTER_from_json.py
msgid ""
"An amorphous mound of twisting black flesh that flits through the air at "
"incredible speeds."
msgstr "An amorphous mound of twisting black flesh that flits through the air at incredible speeds."

#: lang/json/MONSTER_from_json.py
msgid "fox"
msgid_plural "foxes"
msgstr[0] "fox"
msgstr[1] "foxes"

#. ~ Description for fox
#: lang/json/MONSTER_from_json.py
msgid ""
"A small omnivorous canine with an almost cat-like manner.  It is a solitary "
"hunter, and one of the only canids able to climb trees."
msgstr "A small omnivorous canine with an almost cat-like manner.  It is a solitary hunter, and one of the only canids able to climb trees."

#. ~ Description for fox
#: lang/json/MONSTER_from_json.py
msgid ""
"The red fox, an omnivorous canine and largest of the true foxes, it is a "
"wily hunter with a combative, suspicious temperament."
msgstr "The red fox, an omnivorous canine and largest of the true foxes, it is a wily hunter with a combative, suspicious temperament."

#: lang/json/MONSTER_from_json.py
msgid "giant frog"
msgstr "giant frog"

#. ~ Description for giant frog
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated bullfrog taller than you are.  It stares with amber eyes as it "
"considers the easiest way to swallow you whole."
msgstr "A mutated bullfrog taller than you are.  It stares with amber eyes as it considers the easiest way to swallow you whole."

#: lang/json/MONSTER_from_json.py
msgid "fungal blossom"
msgstr "fungal blossom"

#. ~ Description for fungal blossom
#: lang/json/MONSTER_from_json.py
msgid ""
"A broad fungus, looking much like a glowing blue sunflower.  It appears to "
"emit finer spores than the typical fungal emission."
msgstr "A broad fungus, looking much like a glowing blue sunflower.  It appears to emit finer spores than the typical fungal emission."

#: lang/json/MONSTER_from_json.py
msgid "fungal fighter"
msgstr "fungal fighter"

#. ~ Description for fungal fighter
#: lang/json/MONSTER_from_json.py
msgid ""
"A stout woody plant that can dig through the ground and flick spines from "
"its branches.  The thorns carry a fungicidal compound with paralytic "
"effects."
msgstr "A stout woody plant that can dig through the ground and flick spines from its branches.  The thorns carry a fungicidal compound with paralytic effects."

#: lang/json/MONSTER_from_json.py
msgid "fungal hedgerow"
msgstr "fungal hedgerow"

#. ~ Description for fungal hedgerow
#: lang/json/MONSTER_from_json.py
msgid ""
"Looking at first glance like a dull gray privet, this \"hedge\" is really a "
"mass of barbed fungal tendrils, defending the fungal tower."
msgstr "Looking at first glance like a dull gray privet, this \"hedge\" is really a mass of barbed fungal tendrils, defending the fungal tower."

#: lang/json/MONSTER_from_json.py
msgid "fungal tendril"
msgstr "fungal tendril"

#. ~ Description for fungal tendril
#: lang/json/MONSTER_from_json.py
msgid "A long and delicate-looking tendril with a sharp tip."
msgstr "A long and delicate-looking tendril with a sharp tip."

#: lang/json/MONSTER_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "fungal wall"
msgstr "fungal wall"

#. ~ Description for fungal wall
#: lang/json/MONSTER_from_json.py
msgid ""
"A veritable wall of fungus, grown as a natural defense by the fungal spire."
"  New spores erupt from the surface every few seconds."
msgstr "A veritable wall of fungus, grown as a natural defense by the fungal spire.  New spores erupt from the surface every few seconds."

#: lang/json/MONSTER_from_json.py
msgid "fungaloid"
msgstr "fungaloid"

#. ~ Description for fungaloid
#: lang/json/MONSTER_from_json.py
msgid ""
"A pale white fungus, one meaty gray stalk supporting a bloom at the top.  "
"Spores are periodically expelled from its gills, and a few tendrils extend "
"from the base, allowing mobility and some basic means of defense."
msgstr "A pale white fungus, one meaty gray stalk supporting a bloom at the top.  Spores are periodically expelled from its gills, and a few tendrils extend from the base, allowing mobility and some basic means of defense."

#: lang/json/MONSTER_from_json.py
msgid "fungal spire"
msgstr "fungal spire"

#. ~ Description for fungal spire
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous fungal spire, towering over the ground.  It pulsates slowly, "
"continuously growing new defenses."
msgstr "An enormous fungal spire, towering over the ground.  It pulsates slowly, continuously growing new defenses."

#: lang/json/MONSTER_from_json.py
msgid "giant fungal blossom"
msgstr "giant fungal blossom"

#. ~ Description for giant fungal blossom
#: lang/json/MONSTER_from_json.py
msgid ""
"An immense fungal blossom, towering over its surroundings.  It pulses with a"
" soft blue glow, continuously pumping its spores into the air."
msgstr "An immense fungal blossom, towering over its surroundings.  It pulses with a soft blue glow, continuously pumping its spores into the air."

#: lang/json/MONSTER_from_json.py lang/json/overmap_terrain_from_json.py
msgid "fungal tower"
msgstr "fungal tower"

#. ~ Description for fungal tower
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous fungal tower.  On closer inspection, its cap is supported by "
"LOTS of fungal tendrils of various thicknesses, emerging from yet more "
"bristling tendrils at ground level.  Between this redundancy and their "
"noticeable movement creating frequent gaps, it's tough to get a solid shot "
"on the thing."
msgstr "An enormous fungal tower.  On closer inspection, its cap is supported by LOTS of fungal tendrils of various thicknesses, emerging from yet more bristling tendrils at ground level.  Between this redundancy and their noticeable movement creating frequent gaps, it's tough to get a solid shot on the thing."

#: lang/json/MONSTER_from_json.py
msgid "fungal sporeling"
msgstr "fungal sporeling"

#. ~ Description for fungal sporeling
#: lang/json/MONSTER_from_json.py
msgid ""
"A fungal stalk several feet in height.  Two vicious looking tendrils extend "
"from its thorned and leathery exterior, and it moves about faster than the "
"larger fungaloids."
msgstr "A fungal stalk several feet in height.  Two vicious looking tendrils extend from its thorned and leathery exterior, and it moves about faster than the larger fungaloids."

#: lang/json/MONSTER_from_json.py
msgid "amoebic mold"
msgstr "amoebic mold"

#. ~ Description for amoebic mold
#: lang/json/MONSTER_from_json.py
msgid ""
"A formless slime mold the size of a cow.  Crusty bits of cytoplasm fall away"
" as it oozes across the ground."
msgstr "A formless slime mold the size of a cow.  Crusty bits of cytoplasm fall away as it oozes across the ground."

#: lang/json/MONSTER_from_json.py
msgid "generator"
msgstr "generator"

#. ~ Description for generator
#: lang/json/MONSTER_from_json.py
msgid ""
"Your precious generator, noisily humming away.  Defend it at all costs!"
msgstr "Your precious generator, noisily humming away.  Defend it at all costs!"

#: lang/json/MONSTER_from_json.py
msgid "giant cockroach"
msgstr "giant cockroach"

#. ~ Description for giant cockroach
#: lang/json/MONSTER_from_json.py
msgid "A mutant cockroach the size of a small dog."
msgstr "A mutant cockroach the size of a small dog."

#: lang/json/MONSTER_from_json.py
msgid "giant cockroach nymph"
msgstr "giant cockroach nymph"

#. ~ Description for giant cockroach nymph
#: lang/json/MONSTER_from_json.py
msgid "A baby mutant cockroach about the size of a rat."
msgstr "A baby mutant cockroach about the size of a rat."

#: lang/json/MONSTER_from_json.py
msgid "giant crayfish"
msgstr "giant crayfish"

#. ~ Description for giant crayfish
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutant, terrestrial variety of the signal crayfish, this massive "
"crustacean resembles a humongous lobster."
msgstr "A mutant, terrestrial variety of the signal crayfish, this massive crustacean resembles a humongous lobster."

#: lang/json/MONSTER_from_json.py
msgid "gozu"
msgstr "gozu"

#. ~ Description for gozu
#: lang/json/MONSTER_from_json.py
msgid ""
"A monster with an obese human body and the head of a cow.  It treads slowly,"
" and milky white drool drips from its mouth."
msgstr "A monster with an obese human body and the head of a cow.  It treads slowly, and milky white drool drips from its mouth."

#: lang/json/MONSTER_from_json.py
msgid "graboid"
msgstr "graboid"

#. ~ Description for graboid
#: lang/json/MONSTER_from_json.py
msgid ""
"A monstrous beast with a tripartite mouth that opens to reveal hundreds of "
"writhing tongues with razor sharp edges.  It keeps most of its enormous body"
" hidden underground."
msgstr "A monstrous beast with a tripartite mouth that opens to reveal hundreds of writhing tongues with razor sharp edges.  It keeps most of its enormous body hidden underground."

#: lang/json/MONSTER_from_json.py
msgid "gracken"
msgstr "gracken"

#. ~ Description for gracken
#: lang/json/MONSTER_from_json.py
msgid ""
"A bizarre humanoid creature with a calculating stare.  Its twitching hands "
"move so fast they appear to be nothing but blurs."
msgstr "A bizarre humanoid creature with a calculating stare.  Its twitching hands move so fast they appear to be nothing but blurs."

#: lang/json/MONSTER_from_json.py
msgid "groundhog"
msgstr "groundhog"

#. ~ Description for groundhog
#: lang/json/MONSTER_from_json.py
msgid ""
"Also known as the woodchuck, this ground squirrel has no actual talent for "
"chucking wood."
msgstr "Also known as the woodchuck, this ground squirrel has no actual talent for chucking wood."

#: lang/json/MONSTER_from_json.py
msgid "half worm"
msgstr "half worm"

#. ~ Description for half worm
#: lang/json/MONSTER_from_json.py
msgid "A squiggling severed portion of a wounded giant worm."
msgstr "A squiggling severed portion of a wounded giant worm."

#: lang/json/MONSTER_from_json.py
msgid "your mother"
msgstr "your mother"

#. ~ Description for your mother
#: lang/json/MONSTER_from_json.py
msgid "Mom?"
msgstr "Mom?"

#: lang/json/MONSTER_from_json.py
msgid "evil multi-cooker"
msgstr "evil multi-cooker"

#. ~ Description for evil multi-cooker
#: lang/json/MONSTER_from_json.py
msgid "The multi-cooker's got a mind of its own!  Look out!!"
msgstr "The multi-cooker's got a mind of its own!  Look out!!"

#: lang/json/MONSTER_from_json.py
msgid "jackrabbit"
msgstr "jackrabbit"

#. ~ Description for jackrabbit
#: lang/json/MONSTER_from_json.py
msgid ""
"The snowshoe hare, a small grass-eater with a brown fur coat that changes to"
" white in the wintertime."
msgstr "The snowshoe hare, a small grass-eater with a brown fur coat that changes to white in the wintertime."

#: lang/json/MONSTER_from_json.py
msgid "cleaner bot"
msgstr "cleaner bot"

#. ~ Description for cleaner bot
#: lang/json/MONSTER_from_json.py
msgid ""
"The Ford Sanitron, a utility robot designed for cleaning up waste material "
"in hazardous conditions."
msgstr "The Ford Sanitron, a utility robot designed for cleaning up waste material in hazardous conditions."

#: lang/json/MONSTER_from_json.py
msgid "tentacle dog"
msgstr "tentacle dog"

#. ~ Description for tentacle dog
#: lang/json/MONSTER_from_json.py
msgid ""
"A dog's body with a mass of ropey, black tentacles reaching out from its "
"head."
msgstr "A dog's body with a mass of ropey, black tentacles reaching out from its head."

#: lang/json/MONSTER_from_json.py
msgid "homunculus"
msgid_plural "homunculuses"
msgstr[0] "homunculus"
msgstr[1] "homunculuses"

#. ~ Description for homunculus
#: lang/json/MONSTER_from_json.py
msgid ""
"A pale hairless man with an impressive athletic physique.  Its lidless eyes "
"are totally black, and seeping with blood."
msgstr "A pale hairless man with an impressive athletic physique.  Its lidless eyes are totally black, and seeping with blood."

#: lang/json/MONSTER_from_json.py
msgid "horse"
msgstr "horse"

#. ~ Description for horse
#: lang/json/MONSTER_from_json.py
msgid ""
"A hooved grazing mammal with a mane of hair, a sweeping tail, and powerful-"
"looking muscles."
msgstr "A hooved grazing mammal with a mane of hair, a sweeping tail, and powerful-looking muscles."

#: lang/json/MONSTER_from_json.py
msgid "human snail"
msgstr "human snail"

#. ~ Description for human snail
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous fleshy snail, with an oddly human face.  Eyestalks protrude from"
" where the eyes should be."
msgstr "An enormous fleshy snail, with an oddly human face.  Eyestalks protrude from where the eyes should be."

#: lang/json/MONSTER_from_json.py
msgid "hunting horror"
msgstr "hunting horror"

#. ~ Description for hunting horror
#: lang/json/MONSTER_from_json.py
msgid ""
"A man-sized worm-like creature that swoops around on bat-like wings.  Its "
"form dramatically shifts and changes from moment to moment, although its "
"gigantic eyes and teeth are always prominent."
msgstr "A man-sized worm-like creature that swoops around on bat-like wings.  Its form dramatically shifts and changes from moment to moment, although its gigantic eyes and teeth are always prominent."

#: lang/json/MONSTER_from_json.py
msgid "irradiated wanderer"
msgstr "irradiated wanderer"

#. ~ Description for irradiated wanderer
#: lang/json/MONSTER_from_json.py
msgid ""
"This rotting corpse seeps a glowing ooze from its lesions.  A strange "
"tattered jumpsuit marks it as an oddity across the wasteland."
msgstr "This rotting corpse seeps a glowing ooze from its lesions.  A strange tattered jumpsuit marks it as an oddity across the wasteland."

#: lang/json/MONSTER_from_json.py
msgid "jabberwock"
msgstr "jabberwock"

#. ~ Description for jabberwock
#: lang/json/MONSTER_from_json.py
msgid ""
"A putrid amalgamation of body parts from humans and other creatures have "
"fused together in this aberration of flesh.  The eyes of all the heads dart "
"about rapidly and the mouths form a chorus of groaning screams."
msgstr "A putrid amalgamation of body parts from humans and other creatures have fused together in this aberration of flesh.  The eyes of all the heads dart about rapidly and the mouths form a chorus of groaning screams."

#: lang/json/MONSTER_from_json.py
msgid "kreck"
msgstr "kreck"

#. ~ Description for kreck
#: lang/json/MONSTER_from_json.py
msgid ""
"A fat humanoid the size of a dog, with twisted red flesh and a distended "
"neck.  It scampers around, panting and grunting."
msgstr "A fat humanoid the size of a dog, with twisted red flesh and a distended neck.  It scampers around, panting and grunting."

#: lang/json/MONSTER_from_json.py
msgid "lemming"
msgstr "lemming"

#. ~ Description for lemming
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northern bog lemming, a small, predominantly vegetarian rodent that "
"spends its life in the murk of swamps and other wetlands.  Contrary to "
"popular belief, these creatures are not particularly hapless or suicidal, "
"but they can eat themselves into scarcity within a few generations."
msgstr "The Northern bog lemming, a small, predominantly vegetarian rodent that spends its life in the murk of swamps and other wetlands.  Contrary to popular belief, these creatures are not particularly hapless or suicidal, but they can eat themselves into scarcity within a few generations."

#: lang/json/MONSTER_from_json.py
msgid "mi-go"
msgstr "mi-go"

#. ~ Description for mi-go
#: lang/json/MONSTER_from_json.py
msgid ""
"A flexuous monstrosity seeming as a giant crab covered in writhing antennae,"
" clawed tentacles, and star-shaped growths, with a head like the insides of "
"a fish but for its dire utterance."
msgstr "A flexuous monstrosity seeming as a giant crab covered in writhing antennae, clawed tentacles, and star-shaped growths, with a head like the insides of a fish but for its dire utterance."

#: lang/json/MONSTER_from_json.py
msgid "mink"
msgstr "mink"

#. ~ Description for mink
#: lang/json/MONSTER_from_json.py
msgid ""
"The American mink, a partially-aquatic weasel, once factory-farmed for its "
"fur.  It is a capable fisher, but the presence of otters in these parts "
"makes it rely more on food from the land."
msgstr "The American mink, a partially-aquatic weasel, once factory-farmed for its fur.  It is a capable fisher, but the presence of otters in these parts makes it rely more on food from the land."

#: lang/json/MONSTER_from_json.py
msgid "miner bot"
msgstr "miner bot"

#. ~ Description for miner bot
#: lang/json/MONSTER_from_json.py
msgid ""
"A snake-like, segmented robot built to tunnel into the ground and detonate "
"landmines."
msgstr "A snake-like, segmented robot built to tunnel into the ground and detonate landmines."

#: lang/json/MONSTER_from_json.py
msgid "moose"
msgstr "moose"

#. ~ Description for moose
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern moose, the largest living species of deer.  The bulls are quite "
"ill-tempered, especially in the rutting season."
msgstr "The Eastern moose, the largest living species of deer.  The bulls are quite ill-tempered, especially in the rutting season."

#: lang/json/MONSTER_from_json.py
msgid "giant mosquito"
msgstr "giant mosquito"

#. ~ Description for giant mosquito
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous mutant mosquito, fluttering erratically.  Its face is dominated "
"by a long, spear-tipped proboscis."
msgstr "An enormous mutant mosquito, fluttering erratically.  Its face is dominated by a long, spear-tipped proboscis."

#: lang/json/MONSTER_from_json.py
msgid "muskrat"
msgstr "muskrat"

#. ~ Description for muskrat
#: lang/json/MONSTER_from_json.py
msgid ""
"A large omnivorous rodent with a thick furry pelt, found in wetlands across "
"the northern hemisphere.  It marks its territory with a musky odor for which"
" it is named."
msgstr "A large omnivorous rodent with a thick furry pelt, found in wetlands across the northern hemisphere.  It marks its territory with a musky odor for which it is named."

#: lang/json/MONSTER_from_json.py
msgid "cyclopean"
msgstr "cyclopean"

#. ~ Description for cyclopean
#: lang/json/MONSTER_from_json.py
msgid ""
"A relatively humanoid mutant with purple hair and a grapefruit-sized "
"bloodshot eye."
msgstr "A relatively humanoid mutant with purple hair and a grapefruit-sized bloodshot eye."

#: lang/json/MONSTER_from_json.py
msgid "opossum"
msgstr "opossum"

#. ~ Description for opossum
#: lang/json/MONSTER_from_json.py
msgid ""
"The Virginia opossum, a small omnivorous marsupial native to North America."
"  About the size of a cat, it is hardy and adaptive, and a fairly common "
"sight in urban areas."
msgstr "The Virginia opossum, a small omnivorous marsupial native to North America.  About the size of a cat, it is hardy and adaptive, and a fairly common sight in urban areas."

#: lang/json/MONSTER_from_json.py
msgid "otter"
msgstr "otter"

#. ~ Description for otter
#: lang/json/MONSTER_from_json.py
msgid ""
"The North American river otter is a shy water dwelling relative of the "
"weasel living in large families along the banks of streams.  It is an "
"excellent fisher and a resourceful survivor, using the abandoned dens of "
"beavers and other animals to raise its own young."
msgstr "The North American river otter is a shy water dwelling relative of the weasel living in large families along the banks of streams.  It is an excellent fisher and a resourceful survivor, using the abandoned dens of beavers and other animals to raise its own young."

#: lang/json/MONSTER_from_json.py
msgid "pig"
msgstr "pig"

#. ~ Description for pig
#: lang/json/MONSTER_from_json.py
msgid ""
"A domesticated omnivore descended from the wild boar, intelligent and "
"inquisitive.  Left to its own devices, it has gone feral."
msgstr "A domesticated omnivore descended from the wild boar, intelligent and inquisitive.  Left to its own devices, it has gone feral."

#: lang/json/MONSTER_from_json.py
msgid "slimespring"
msgstr "slimespring"

#. ~ Description for slimespring
#: lang/json/MONSTER_from_json.py
msgid "A familiar-looking blob of goo.  It sprouts the occasional eyestalk."
msgstr "A familiar-looking blob of goo.  It sprouts the occasional eyestalk."

#: lang/json/MONSTER_from_json.py
msgid "pregnant giant cockroach"
msgstr "pregnant giant cockroach"

#. ~ Description for pregnant giant cockroach
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutant cockroach the size of a small dog.  It's abdomen is heavily "
"swollen."
msgstr "A mutant cockroach the size of a small dog.  It's abdomen is heavily swollen."

#: lang/json/MONSTER_from_json.py
msgid "rabbit"
msgstr "rabbit"

#. ~ Description for rabbit
#: lang/json/MONSTER_from_json.py
msgid ""
"A small mammal with a cute wiggling nose, cotton tail, and made of delicious"
" flesh."
msgstr "A small mammal with a cute wiggling nose, cotton tail, and made of delicious flesh."

#: lang/json/MONSTER_from_json.py
msgid "raccoon"
msgstr "raccoon"

#. ~ Description for raccoon
#: lang/json/MONSTER_from_json.py
msgid ""
"A small mammal native to North America, distinctive for its dexterous paws "
"and facial markings.  It is resourceful and agile enough to open sealed "
"containers with its paws."
msgstr "A small mammal native to North America, distinctive for its dexterous paws and facial markings.  It is resourceful and agile enough to open sealed containers with its paws."

#: lang/json/MONSTER_from_json.py
msgid "rat king"
msgstr "rat king"

#. ~ Description for rat king
#: lang/json/MONSTER_from_json.py
msgid ""
"A towering swarm of mutated rats, their tails knotted together in a filthy "
"mass.  A fetid stench flows from its filthy presence."
msgstr "A towering swarm of mutated rats, their tails knotted together in a filthy mass.  A fetid stench flows from its filthy presence."

#: lang/json/MONSTER_from_json.py
msgid "rattlesnake"
msgstr "rattlesnake"

#. ~ Description for rattlesnake
#: lang/json/MONSTER_from_json.py
msgid ""
"The timber rattlesnake is the most venomous viper native to New England.  "
"Climatic changes have extended its range far into the north."
msgstr "The timber rattlesnake is the most venomous viper native to New England.  Climatic changes have extended its range far into the north."

#: lang/json/MONSTER_from_json.py
msgid "giant rattlesnake"
msgstr "giant rattlesnake"

#. ~ Description for giant rattlesnake
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated timber rattlesnake, about three times as large as the norm.  While"
" it isn't big enough to regard humans as potential prey, it is more "
"aggresive and dangerous compared to a normal rattler."
msgstr "A mutated timber rattlesnake, about three times as large as the norm.  While it isn't big enough to regard humans as potential prey, it is more aggresive and dangerous compared to a normal rattler."

#: lang/json/MONSTER_from_json.py
msgid "razorclaw"
msgstr "razorclaw"

#. ~ Description for razorclaw
#: lang/json/MONSTER_from_json.py
msgid ""
"A man-sized crustacean clad in an iron-like chitin, capable of emitting the "
"most horrible of shrieks.  Often spotted near shipwrecks or other dark damp "
"places, which it uses as nesting grounds."
msgstr "A man-sized crustacean clad in an iron-like chitin, capable of emitting the most horrible of shrieks.  Often spotted near shipwrecks or other dark damp places, which it uses as nesting grounds."

#: lang/json/MONSTER_from_json.py
msgid "riot control bot"
msgstr "riot control bot"

#. ~ Description for riot control bot
#: lang/json/MONSTER_from_json.py
msgid ""
"Nonviolent riot-control bot.  Designed to suppress riots and make mass "
"arrests of those participating.  Though its relaxation gas is by far its "
"best-known weapon, it carries a blinding flash and a low-powered stungun for"
" self-defense--in addition to its supply of electronic handcuffs."
msgstr "Nonviolent riot-control bot.  Designed to suppress riots and make mass arrests of those participating.  Though its relaxation gas is by far its best-known weapon, it carries a blinding flash and a low-powered stungun for self-defense--in addition to its supply of electronic handcuffs."

#: lang/json/MONSTER_from_json.py
msgid "seweranha"
msgstr "seweranha"

#. ~ Description for seweranha
#: lang/json/MONSTER_from_json.py
msgid ""
"A large mutant variety of carp.  It has shimmering green scales and a mouth "
"lined with three jagged rows of razor-sharp teeth."
msgstr "A large mutant variety of carp.  It has shimmering green scales and a mouth lined with three jagged rows of razor-sharp teeth."

#: lang/json/MONSTER_from_json.py
msgid "sewer rat"
msgstr "sewer rat"

#. ~ Description for sewer rat
#: lang/json/MONSTER_from_json.py
msgid ""
"A worm-tailed rodent with long whiskers and beady eyes.  The way it squeaks "
"makes it sound...  hungry."
msgstr "A worm-tailed rodent with long whiskers and beady eyes.  The way it squeaks makes it sound...  hungry."

#: lang/json/MONSTER_from_json.py
msgid "sewer snake"
msgstr "sewer snake"

#. ~ Description for sewer snake
#: lang/json/MONSTER_from_json.py
msgid ""
"An aggressive mutant variety of the worm snake, turned pale yellow from its "
"underground life.  It swarms beneath the ground and is named for its habit "
"of infesting sewer lines."
msgstr "An aggressive mutant variety of the worm snake, turned pale yellow from its underground life.  It swarms beneath the ground and is named for its habit of infesting sewer lines."

#: lang/json/MONSTER_from_json.py
msgid "shadow"
msgstr "shadow"

#. ~ Description for shadow
#: lang/json/MONSTER_from_json.py
msgid "A strange moving darkness, bringing with it the softest of whispers."
msgstr "A strange moving darkness, bringing with it the softest of whispers."

#: lang/json/MONSTER_from_json.py
msgid "shadow snake"
msgstr "shadow snake"

#. ~ Description for shadow snake
#: lang/json/MONSTER_from_json.py
msgid "A translucent black snake, long and fearsome looking."
msgstr "A translucent black snake, long and fearsome looking."

#: lang/json/MONSTER_from_json.py
msgid "sheep"
msgid_plural "sheep"
msgstr[0] "sheep"
msgstr[1] "sheep"

#. ~ Description for sheep
#: lang/json/MONSTER_from_json.py
msgid ""
"A timid, hooved grazing mammal, and one of the first animals ever "
"domesticated, its body is covered in a thick layer of wool, and the males "
"have long, spiralling horns."
msgstr "A timid, hooved grazing mammal, and one of the first animals ever domesticated, its body is covered in a thick layer of wool, and the males have long, spiralling horns."

#: lang/json/MONSTER_from_json.py
msgid "Shia LaBeouf"
msgid_plural "Shia LaBeouf"
msgstr[0] "Shia LaBeouf"
msgstr[1] "Shia LaBeouf"

#. ~ Description for Shia LaBeouf
#: lang/json/MONSTER_from_json.py
msgid ""
"Living in the woods, \n"
"killing for sport, \n"
"eating all the bodies, \n"
"actual cannibal Shia LaBeouf."
msgstr "Living in the woods, \nkilling for sport, \neating all the bodies, \nactual cannibal Shia LaBeouf."

#: lang/json/MONSTER_from_json.py
msgid "shoggoth"
msgstr "shoggoth"

#. ~ Description for shoggoth
#: lang/json/MONSTER_from_json.py
msgid ""
"A gargantuan protoplasmic blob, constantly reshaping, forming new pseudopods"
" seemingly at will.  All over its body are eyes that form and disappear.  It"
" looks at you with malice."
msgstr "A gargantuan protoplasmic blob, constantly reshaping, forming new pseudopods seemingly at will.  All over its body are eyes that form and disappear.  It looks at you with malice."

#: lang/json/MONSTER_from_json.py
msgid "skeleton"
msgstr "skeleton"

#. ~ Description for skeleton
#: lang/json/MONSTER_from_json.py
msgid ""
"With its skin so tight the cracked bones are visible beneath it, covered in "
"scar tissue and coils of scabbed black liquid and with eyes so deeply sunken"
" into its skull they are barely visible, it's a wonder this once-human "
"creature can move at all."
msgstr "With its skin so tight the cracked bones are visible beneath it, covered in scar tissue and coils of scabbed black liquid and with eyes so deeply sunken into its skull they are barely visible, it's a wonder this once-human creature can move at all."

#: lang/json/MONSTER_from_json.py
msgid "skitterbot"
msgstr "skitterbot"

#. ~ Description for skitterbot
#: lang/json/MONSTER_from_json.py
msgid ""
"A insectoid robot the size of a small dog, designed for home security.  "
"Armed with two close-range tazers, it can skate across the ground with great"
" speed."
msgstr "A insectoid robot the size of a small dog, designed for home security.  Armed with two close-range tazers, it can skate across the ground with great speed."

#: lang/json/MONSTER_from_json.py
msgid "sludge crawler"
msgstr "sludge crawler"

#. ~ Description for sludge crawler
#: lang/json/MONSTER_from_json.py
msgid ""
"A sluglike creature, eight feet long and the width of a refrigerator.  Its "
"black body glistens as it oozes its way along the ground.  Eye stalks "
"occasionally push their way out of the oily mass and look around."
msgstr "A sluglike creature, eight feet long and the width of a refrigerator.  Its black body glistens as it oozes its way along the ground.  Eye stalks occasionally push their way out of the oily mass and look around."

#: lang/json/MONSTER_from_json.py
msgid "giant slug"
msgstr "giant slug"

#. ~ Description for giant slug
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated leopard slug, as wide as a golf cart.  Venom dripping from its "
"fanged maw, it slithers ahead slowly, leaving a trail of glistening slime."
msgstr "A mutated leopard slug, as wide as a golf cart.  Venom dripping from its fanged maw, it slithers ahead slowly, leaving a trail of glistening slime."

#: lang/json/MONSTER_from_json.py
msgid "giant cellar spider"
msgstr "giant cellar spider"

#. ~ Description for giant cellar spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A twitchy mutant brown spider, with a relatively small body and spindly long"
" legs.  Its smaller brethren are known for being agile, and for preying upon"
" other spiders."
msgstr "A twitchy mutant brown spider, with a relatively small body and spindly long legs.  Its smaller brethren are known for being agile, and for preying upon other spiders."

#: lang/json/MONSTER_from_json.py
msgid "immature giant cellar spider"
msgstr "immature giant cellar spider"

#. ~ Description for immature giant cellar spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A newly-hatched giant cellar spider.  Too small to possess much venom, but "
"still quick and agile like an adult."
msgstr "A newly-hatched giant cellar spider.  Too small to possess much venom, but still quick and agile like an adult."

#: lang/json/MONSTER_from_json.py
msgid "giant jumping spider"
msgstr "giant jumping spider"

#. ~ Description for giant jumping spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A giant spider with big forelegs and two pairs of inquisitive-looking eyes."
"  It can leap quite quickly, even into the treetops."
msgstr "A giant spider with big forelegs and two pairs of inquisitive-looking eyes.  It can leap quite quickly, even into the treetops."

#: lang/json/MONSTER_from_json.py
msgid "giant trapdoor spider"
msgstr "giant trapdoor spider"

#. ~ Description for giant trapdoor spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic spider with a bulbous thorax.  It digs a deep underground burrow "
"that serves as a pit to trap unwary prey."
msgstr "A gigantic spider with a bulbous thorax.  It digs a deep underground burrow that serves as a pit to trap unwary prey."

#: lang/json/MONSTER_from_json.py
msgid "giant web spider"
msgstr "giant web spider"

#. ~ Description for giant web spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A giant mutated grass spider, it waits for prey to become ensnared in the "
"vast webs that it weaves between the trees."
msgstr "A giant mutated grass spider, it waits for prey to become ensnared in the vast webs that it weaves between the trees."

#: lang/json/MONSTER_from_json.py
msgid "immature giant web spider"
msgstr "immature giant web spider"

#. ~ Description for immature giant web spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A still immature giant grass spider.  Too young to be venomous, or to walk "
"proficiently for that matter"
msgstr "A still immature giant grass spider.  Too young to be venomous, or to walk proficiently for that matter"

#: lang/json/MONSTER_from_json.py
msgid "giant black widow"
msgstr "giant black widow"

#. ~ Description for giant black widow
#: lang/json/MONSTER_from_json.py
msgid ""
"A giant mutated black widow spider.  A highly venomous nightmare come to "
"life."
msgstr "A giant mutated black widow spider.  A highly venomous nightmare come to life."

#: lang/json/MONSTER_from_json.py
msgid "giant black widow spiderling"
msgstr "giant black widow spiderling"

#. ~ Description for giant black widow spiderling
#: lang/json/MONSTER_from_json.py
msgid ""
"The horrid spawn of a giant black widow spider.  Even as a newborn, this "
"foul creature knows only how to kill."
msgstr "The horrid spawn of a giant black widow spider.  Even as a newborn, this foul creature knows only how to kill."

#: lang/json/MONSTER_from_json.py
msgid "giant wolf spider"
msgstr "giant wolf spider"

#. ~ Description for giant wolf spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A wolf spider mutated to about thirty times its normal size, it moves "
"quickly and aggressively to catch and consume prey."
msgstr "A wolf spider mutated to about thirty times its normal size, it moves quickly and aggressively to catch and consume prey."

#: lang/json/MONSTER_from_json.py
msgid "spore cloud"
msgstr "spore cloud"

#. ~ Description for spore cloud
#: lang/json/MONSTER_from_json.py
msgid "A mass of spores the size of a balled fist, wafting around in the air."
msgstr "A mass of spores the size of a balled fist, wafting around in the air."

#: lang/json/MONSTER_from_json.py
msgid "squirrel"
msgstr "squirrel"

#. ~ Description for squirrel
#: lang/json/MONSTER_from_json.py
msgid ""
"A small granivorous rodent with a long bushy tail, often seen darting amid "
"the branches of trees.  A skittish varmint with an expression of unwavering "
"austerity, it is the mortal enemy of cat and dog alike."
msgstr "A small granivorous rodent with a long bushy tail, often seen darting amid the branches of trees.  A skittish varmint with an expression of unwavering austerity, it is the mortal enemy of cat and dog alike."

#. ~ Description for squirrel
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny opportunistic rodent with a long bushy tail.  The pine squirrel is "
"clever and cute, and hunted by nearly everything in the woods with a taste "
"for meat."
msgstr "A tiny opportunistic rodent with a long bushy tail.  The pine squirrel is clever and cute, and hunted by nearly everything in the woods with a taste for meat."

#: lang/json/MONSTER_from_json.py
msgid "tank drone"
msgstr "tank drone"

#. ~ Description for tank drone
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northrup Emancipator is the first and only automated tank ever produced,"
" made shortly after the split-up of Northrup Grumman.  Clad in depleted "
"uranium plating, and armed with advanced munitions and a 120-mm gun, it is "
"capable of delivering extraordinary firepower."
msgstr "The Northrup Emancipator is the first and only automated tank ever produced, made shortly after the split-up of Northrup Grumman.  Clad in depleted uranium plating, and armed with advanced munitions and a 120-mm gun, it is capable of delivering extraordinary firepower."

#: lang/json/MONSTER_from_json.py
msgid "thing"
msgstr "thing"

#. ~ Description for thing
#: lang/json/MONSTER_from_json.py
msgid ""
"An amorphous black creature, detaching and sprouting tentacles without any "
"apparent pause."
msgstr "An amorphous black creature, detaching and sprouting tentacles without any apparent pause."

#: lang/json/MONSTER_from_json.py
msgid "triffid"
msgstr "triffid"

#. ~ Description for triffid
#: lang/json/MONSTER_from_json.py
msgid ""
"A creeping animate plant, growing as tall as a moose.  It has a single bark-"
"covered stalk supporting a flowery head with a paralyzing sting concealed "
"within."
msgstr "A creeping animate plant, growing as tall as a moose.  It has a single bark-covered stalk supporting a flowery head with a paralyzing sting concealed within."

#: lang/json/MONSTER_from_json.py lang/json/overmap_terrain_from_json.py
msgid "triffid heart"
msgstr "triffid heart"

#. ~ Description for triffid heart
#: lang/json/MONSTER_from_json.py
msgid ""
"A knot of tubular roots, flowing with sap and beating like a heart.  Strands"
" of vascular tissue reach out to the surrounding root walls."
msgstr "A knot of tubular roots, flowing with sap and beating like a heart.  Strands of vascular tissue reach out to the surrounding root walls."

#: lang/json/MONSTER_from_json.py
msgid "triffid queen"
msgstr "triffid queen"

#. ~ Description for triffid queen
#: lang/json/MONSTER_from_json.py
msgid ""
"A ponderous and particularly arborescent triffid.  It has enormous red "
"petals surrounded by a haze of spores, and two thick barbed vines stick out "
"from the stems like wary harpoons."
msgstr "A ponderous and particularly arborescent triffid.  It has enormous red petals surrounded by a haze of spores, and two thick barbed vines stick out from the stems like wary harpoons."

#: lang/json/MONSTER_from_json.py
msgid "triffid sprout"
msgstr "triffid sprout"

#. ~ Description for triffid sprout
#: lang/json/MONSTER_from_json.py
msgid ""
"A small triffid, only a few feet tall.  It has not yet developed bark, but "
"its sting is still sharp and deadly."
msgstr "A small triffid, only a few feet tall.  It has not yet developed bark, but its sting is still sharp and deadly."

#: lang/json/MONSTER_from_json.py
msgid "tribot"
msgstr "tribot"

#. ~ Description for tribot
#: lang/json/MONSTER_from_json.py
msgid ""
"The Honda Regnal, a tall robot walking on three spidery legs.  For weapons, "
"it has a trio of spiked retractable cables and a flamethrower mounted on its"
" head."
msgstr "The Honda Regnal, a tall robot walking on three spidery legs.  For weapons, it has a trio of spiked retractable cables and a flamethrower mounted on its head."

#: lang/json/MONSTER_from_json.py
msgid "turkey"
msgstr "turkey"

#. ~ Description for turkey
#: lang/json/MONSTER_from_json.py
msgid ""
"A large and colorful game bird native to the forests of North America.  Its "
"head and beak are covered in fleshy protuberances."
msgstr "A large and colorful game bird native to the forests of North America.  Its head and beak are covered in fleshy protuberances."

#: lang/json/MONSTER_from_json.py
msgid "milspec searchlight"
msgstr "milspec searchlight"

#. ~ Description for milspec searchlight
#: lang/json/MONSTER_from_json.py
msgid ""
"Three high-powered searchlights with automated search AI and mounting, "
"continually seeking targets."
msgstr "Three high-powered searchlights with automated search AI and mounting, continually seeking targets."

#: lang/json/MONSTER_from_json.py
msgid "twisted body"
msgid_plural "twisted bodies"
msgstr[0] "twisted body"
msgstr[1] "twisted bodies"

#. ~ Description for twisted body
#: lang/json/MONSTER_from_json.py
msgid ""
"A human body, but with its limbs, neck, and hair impossibly twisted.  It "
"clambers around swiftly, making awful screeching sounds."
msgstr "A human body, but with its limbs, neck, and hair impossibly twisted.  It clambers around swiftly, making awful screeching sounds."

#: lang/json/MONSTER_from_json.py
msgid "vine beast"
msgstr "vine beast"

#. ~ Description for vine beast
#: lang/json/MONSTER_from_json.py
msgid ""
"An animated mass of roots and vines, creeping along the ground with alarming"
" speed.  The tangle is thick enough that the center from which they grow is "
"concealed."
msgstr "An animated mass of roots and vines, creeping along the ground with alarming speed.  The tangle is thick enough that the center from which they grow is concealed."

#: lang/json/MONSTER_from_json.py
msgid "vortex"
msgid_plural "vortexes"
msgstr[0] "vortex"
msgstr[1] "vortexes"

#. ~ Description for vortex
#: lang/json/MONSTER_from_json.py
msgid ""
"A twisting spot in the air, with some kind of morphing mass at its center."
msgstr "A twisting spot in the air, with some kind of morphing mass at its center."

#: lang/json/MONSTER_from_json.py
msgid "giant wasp"
msgstr "giant wasp"

#. ~ Description for giant wasp
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic slender-bodied wasp with an evil-looking stinger protruding from "
"its abdomen.  Its exoskeleton glowers with ominous red markings."
msgstr "A gigantic slender-bodied wasp with an evil-looking stinger protruding from its abdomen.  Its exoskeleton glowers with ominous red markings."

#: lang/json/MONSTER_from_json.py
msgid "weasel"
msgstr "weasel"

#. ~ Description for weasel
#: lang/json/MONSTER_from_json.py
msgid ""
"The long-tailed weasel, a small but ubiquitous predator whose range extends "
"across the continent.  It forms its den in small burrows, preferring to "
"occupy the nesting holes of its prey."
msgstr "The long-tailed weasel, a small but ubiquitous predator whose range extends across the continent.  It forms its den in small burrows, preferring to occupy the nesting holes of its prey."

#: lang/json/MONSTER_from_json.py
msgid "wolf"
msgid_plural "wolves"
msgstr[0] "wolf"
msgstr[1] "wolves"

#. ~ Description for wolf
#: lang/json/MONSTER_from_json.py
msgid ""
"A cunning pack predator, once extinct in the New England area, the wolf was "
"successfully reintroduced and their numbers reached record highs in the "
"decade before the cataclysm.  Lucky you."
msgstr "A cunning pack predator, once extinct in the New England area, the wolf was successfully reintroduced and their numbers reached record highs in the decade before the cataclysm.  Lucky you."

#: lang/json/MONSTER_from_json.py
msgid "giant worm"
msgstr "giant worm"

#. ~ Description for giant worm
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous, mutated creature that might once have been a nightcrawler.  It "
"possesses a large fanged mouth and a long slender body that comes up to your"
" shoulder, with even more surely hiding underground."
msgstr "An enormous, mutated creature that might once have been a nightcrawler.  It possesses a large fanged mouth and a long slender body that comes up to your shoulder, with even more surely hiding underground."

#: lang/json/MONSTER_from_json.py
msgid "yugg"
msgstr "yugg"

#. ~ Description for yugg
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous white flatworm that burrows beneath the earth.  Its mouth is "
"lined with pointed teeth, and it is covered in fine hairs which can be shed "
"and fired like darts."
msgstr "An enormous white flatworm that burrows beneath the earth.  Its mouth is lined with pointed teeth, and it is covered in fine hairs which can be shed and fired like darts."

#: lang/json/MONSTER_from_json.py
msgid "grim howler"
msgstr "grim howler"

#. ~ Description for grim howler
#: lang/json/MONSTER_from_json.py
msgid ""
"A zombified wolf.  Its mouth oozes with a black substance, coating the "
"vicious-looking white fangs."
msgstr "A zombified wolf.  Its mouth oozes with a black substance, coating the vicious-looking white fangs."

#: lang/json/MONSTER_from_json.py
msgid "zombear"
msgstr "zombear"

#. ~ Description for zombear
#: lang/json/MONSTER_from_json.py
msgid ""
"This black bear's eyes ooze with black fluid, and its flesh is torn and "
"scarred.  It shuffles as it walks."
msgstr "This black bear's eyes ooze with black fluid, and its flesh is torn and scarred.  It shuffles as it walks."

#: lang/json/MONSTER_from_json.py
msgid "zombie"
msgstr "zombie"

#. ~ Description for zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A human body, swaying as it moves, an unstoppable rage is visible in its "
"oily black eyes."
msgstr "A human body, swaying as it moves, an unstoppable rage is visible in its oily black eyes."

#: lang/json/MONSTER_from_json.py
msgid "acidic zombie"
msgstr "acidic zombie"

#. ~ Description for acidic zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A sickly-looking dead one.  Its skin looks especially thin, with a sticky, "
"yellow fluid flowing through the clearly visible veins."
msgstr "A sickly-looking dead one.  Its skin looks especially thin, with a sticky, yellow fluid flowing through the clearly visible veins."

#: lang/json/MONSTER_from_json.py
msgid "armored zombie"
msgstr "armored zombie"

#. ~ Description for armored zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Despite being encased in a what was once a nigh-impenetrable suit of power "
"armor, something still managed to kill this soldier."
msgstr "Despite being encased in a what was once a nigh-impenetrable suit of power armor, something still managed to kill this soldier."

#: lang/json/MONSTER_from_json.py
msgid "zombie bio-operator"
msgstr "zombie bio-operator"

#. ~ Description for zombie bio-operator
#: lang/json/MONSTER_from_json.py
msgid ""
"This armored and augmented soldier's bionics crackle with energy.  Worse, it"
" appears to remember its training."
msgstr "This armored and augmented soldier's bionics crackle with energy.  Worse, it appears to remember its training."

#: lang/json/MONSTER_from_json.py
msgid "slavering biter"
msgstr "slavering biter"

#. ~ Description for slavering biter
#: lang/json/MONSTER_from_json.py
msgid ""
"A distorted and swollen human body.  Its jaws have elongated into a "
"crocodile like snout, dripping with foul smelling saliva."
msgstr "A distorted and swollen human body.  Its jaws have elongated into a crocodile like snout, dripping with foul smelling saliva."

#: lang/json/MONSTER_from_json.py
msgid "zombie brute"
msgstr "zombie brute"

#. ~ Description for zombie brute
#: lang/json/MONSTER_from_json.py
msgid ""
"Its entire body bulges with distended muscles and swollen, festering wounds."
msgstr "Its entire body bulges with distended muscles and swollen, festering wounds."

#: lang/json/MONSTER_from_json.py
msgid "zombie wrestler"
msgstr "zombie wrestler"

#. ~ Description for zombie wrestler
#: lang/json/MONSTER_from_json.py
msgid ""
"A slab of festering muscle the size of a well-toned bodybuilder.  Seems "
"eager to strangle the life from you."
msgstr "A slab of festering muscle the size of a well-toned bodybuilder.  Seems eager to strangle the life from you."

#: lang/json/MONSTER_from_json.py
msgid "zombie nightstalker"
msgstr "zombie nightstalker"

#. ~ Description for zombie nightstalker
#: lang/json/MONSTER_from_json.py
msgid ""
"Somehow this brute hides in the dark like some kind of boogeyman.  Very "
"agile for such a large zombie."
msgstr "Somehow this brute hides in the dark like some kind of boogeyman.  Very agile for such a large zombie."

#: lang/json/MONSTER_from_json.py
msgid "shocker brute"
msgstr "shocker brute"

#. ~ Description for shocker brute
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge beast covered in visible scarring from what you can only guess was "
"'research'.  Being near it, you can hear a slight humming, like that of an "
"electrical transformer."
msgstr "A huge beast covered in visible scarring from what you can only guess was 'research'.  Being near it, you can hear a slight humming, like that of an electrical transformer."

#: lang/json/MONSTER_from_json.py
msgid "zombie cop"
msgstr "zombie cop"

#. ~ Description for zombie cop
#: lang/json/MONSTER_from_json.py
msgid ""
"A human body covered by a weather-beaten and badly damaged set of riot gear."
msgstr "A human body covered by a weather-beaten and badly damaged set of riot gear."

#: lang/json/MONSTER_from_json.py
msgid "corrosive zombie"
msgstr "corrosive zombie"

#. ~ Description for corrosive zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"This body has swollen to immense proportions, but still manages to hold "
"itself together with semi-congealed acid all over its bloated body.  It "
"clumsily moves around, but attacks with a large reserve of acid."
msgstr "This body has swollen to immense proportions, but still manages to hold itself together with semi-congealed acid all over its bloated body.  It clumsily moves around, but attacks with a large reserve of acid."

#: lang/json/MONSTER_from_json.py
msgid "crawling zombie"
msgstr "crawling zombie"

#. ~ Description for crawling zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"This human corpse drags itself along slowly with its arms.  Its legs are "
"damaged beyond repair."
msgstr "This human corpse drags itself along slowly with its arms.  Its legs are damaged beyond repair."

#: lang/json/MONSTER_from_json.py
msgid "zombie dancer"
msgstr "zombie dancer"

#. ~ Description for zombie dancer
#: lang/json/MONSTER_from_json.py
msgid ""
"The foulest stench is in the air, \n"
"The funk of forty thousand years, \n"
"And grisly ghouls from every tomb, \n"
"Are closing in to seal your doom!\n"
"\n"
"The dancer doesn't even notice you, it seems like something nearby is controlling it."
msgstr "The foulest stench is in the air, \nThe funk of forty thousand years, \nAnd grisly ghouls from every tomb, \nAre closing in to seal your doom!\n\nThe dancer doesn't even notice you, it seems like something nearby is controlling it."

#: lang/json/MONSTER_from_json.py
msgid "zombie dog"
msgstr "zombie dog"

#. ~ Description for zombie dog
#: lang/json/MONSTER_from_json.py
msgid ""
"The deformed, animated corpse of a canine, a sinewy beast which can easily "
"outpace its two-legged friends."
msgstr "The deformed, animated corpse of a canine, a sinewy beast which can easily outpace its two-legged friends."

#: lang/json/MONSTER_from_json.py
msgid "shocker zombie"
msgstr "shocker zombie"

#. ~ Description for shocker zombie
#: lang/json/MONSTER_from_json.py
msgid "A human body with pale blue flesh, crackling with electrical energy."
msgstr "A human body with pale blue flesh, crackling with electrical energy."

#: lang/json/MONSTER_from_json.py
msgid "fat zombie"
msgstr "fat zombie"

#. ~ Description for fat zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Stumbling as it moves, this corpse of an overweight human regards its "
"surroundings with an empty black gaze."
msgstr "Stumbling as it moves, this corpse of an overweight human regards its surroundings with an empty black gaze."

#: lang/json/MONSTER_from_json.py
msgid "fiend"
msgstr "fiend"

#. ~ Description for fiend
#: lang/json/MONSTER_from_json.py
msgid ""
"Charred zombie with bony plates, spikes and protursions.  Moves stiffly, but"
" swiftly."
msgstr "Charred zombie with bony plates, spikes and protursions.  Moves stiffly, but swiftly."

#: lang/json/MONSTER_from_json.py
msgid "firefighter zombie"
msgstr "firefighter zombie"

#. ~ Description for firefighter zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A decaying human body clad in tattered firefighting gear.  It staggers "
"aimlessly, reeking of smoke and decay."
msgstr "A decaying human body clad in tattered firefighting gear.  It staggers aimlessly, reeking of smoke and decay."

#: lang/json/MONSTER_from_json.py
msgid "fungal zombie"
msgstr "fungal zombie"

#. ~ Description for fungal zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Once human, fungal tendrils now sprout from its mouth, eyes, and other "
"orifices, holding together a shambling mass of mold-covered flesh."
msgstr "Once human, fungal tendrils now sprout from its mouth, eyes, and other orifices, holding together a shambling mass of mold-covered flesh."

#: lang/json/MONSTER_from_json.py
msgid "bloated zombie"
msgstr "bloated zombie"

#. ~ Description for bloated zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"With its gray skin swollen to near rupture with putrid gas, this cyst "
"covered zombie looks like it could violently burst under the slightest of "
"disturbances."
msgstr "With its gray skin swollen to near rupture with putrid gas, this cyst covered zombie looks like it could violently burst under the slightest of disturbances."

#: lang/json/MONSTER_from_json.py
msgid "grabber zombie"
msgstr "grabber zombie"

#. ~ Description for grabber zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A deformed human body, once living.  Its arms dangle from its sides like the"
" limbs of some skinless ape, mindlessly groping at their surroundings."
msgstr "A deformed human body, once living.  Its arms dangle from its sides like the limbs of some skinless ape, mindlessly groping at their surroundings."

#: lang/json/MONSTER_from_json.py
msgid "grappler zombie"
msgstr "grappler zombie"

#. ~ Description for grappler zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"An undead humanoid, its elongated arms drag along the ground as it moves.  "
"It looks to almost have a hunch from the swollen back and shoulder muscles "
"tearing though its skin."
msgstr "An undead humanoid, its elongated arms drag along the ground as it moves.  It looks to almost have a hunch from the swollen back and shoulder muscles tearing though its skin."

#: lang/json/MONSTER_from_json.py
msgid "hazmat zombie"
msgstr "hazmat zombie"

#. ~ Description for hazmat zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"This zombie's face and body is completely covered by a protective suit.  It "
"wanders around, unsteadily."
msgstr "This zombie's face and body is completely covered by a protective suit.  It wanders around, unsteadily."

#: lang/json/MONSTER_from_json.py
msgid "zombie hollow"
msgstr "zombie hollow"

#. ~ Description for zombie hollow
#: lang/json/MONSTER_from_json.py
msgid ""
"Black hollow eyes survey the surroundings as the zombie stretches and bends "
"in ways that whoever the original body belonged to never could.  The only "
"thing that seems solid, on this flexible black-veined body, is the rows of "
"sharp black teeth.  You get the feeling that the only human thing remaining "
"is the skin, worn as one would wear clothes."
msgstr "Black hollow eyes survey the surroundings as the zombie stretches and bends in ways that whoever the original body belonged to never could.  The only thing that seems solid, on this flexible black-veined body, is the rows of sharp black teeth.  You get the feeling that the only human thing remaining is the skin, worn as one would wear clothes."

#: lang/json/MONSTER_from_json.py
msgid "zombie hulk"
msgstr "zombie hulk"

#. ~ Description for zombie hulk
#: lang/json/MONSTER_from_json.py
msgid ""
"A human body now swollen to the size of six men, with arms as wide as a "
"trash can."
msgstr "A human body now swollen to the size of six men, with arms as wide as a trash can."

#: lang/json/MONSTER_from_json.py
msgid "feral hunter"
msgstr "feral hunter"

#. ~ Description for feral hunter
#: lang/json/MONSTER_from_json.py
msgid ""
"This once-human body is barely recognizable, scrambling about on all fours, "
"its nails and teeth both sharpened into dangerous looking spikes."
msgstr "This once-human body is barely recognizable, scrambling about on all fours, its nails and teeth both sharpened into dangerous looking spikes."

#: lang/json/MONSTER_from_json.py
msgid "Thriller"
msgstr "Thriller"

#. ~ Description for Thriller
#: lang/json/MONSTER_from_json.py
msgid ""
"And though you fight to stay alive, \n"
"Your body starts to shiver. \n"
"For no mere mortal can resist, \n"
"The evil of the thriller."
msgstr "And though you fight to stay alive, \nYour body starts to shiver. \nFor no mere mortal can resist, \nThe evil of the thriller."

#: lang/json/MONSTER_from_json.py
msgid "zombie snapper"
msgstr "zombie snapper"

#. ~ Description for zombie snapper
#: lang/json/MONSTER_from_json.py
msgid ""
"With a crocodile-like snout and rows of protuding teeth, this swimwear-clad "
"zombie lurks in the water."
msgstr "With a crocodile-like snout and rows of protuding teeth, this swimwear-clad zombie lurks in the water."

#: lang/json/MONSTER_from_json.py
msgid "zombie master"
msgstr "zombie master"

#. ~ Description for zombie master
#: lang/json/MONSTER_from_json.py
msgid ""
"Once human, its features have tightened, its lips pulled back into an "
"unnatural grin, revealing rows of blackened teeth beneath its large, "
"piercing eyes.  It stands tall and its movements are fluid and tightly "
"controlled.  A feeling of danger permeates the air around it, and the light "
"that falls on it seems somehow harsher and more glaring."
msgstr "Once human, its features have tightened, its lips pulled back into an unnatural grin, revealing rows of blackened teeth beneath its large, piercing eyes.  It stands tall and its movements are fluid and tightly controlled.  A feeling of danger permeates the air around it, and the light that falls on it seems somehow harsher and more glaring."

#: lang/json/MONSTER_from_json.py
msgid "zombie necromancer"
msgstr "zombie necromancer"

#. ~ Description for zombie necromancer
#: lang/json/MONSTER_from_json.py
msgid ""
"A twisted mockery of the human form, emaciated, with jet black skin and "
"glowing red eyes.  It is somehow painful to look at, awakening fears deep "
"within your psyche, and even the air around it seems more sinister, somehow "
"darker and more dangerous."
msgstr "A twisted mockery of the human form, emaciated, with jet black skin and glowing red eyes.  It is somehow painful to look at, awakening fears deep within your psyche, and even the air around it seems more sinister, somehow darker and more dangerous."

#: lang/json/MONSTER_from_json.py
msgid "festering boar"
msgstr "festering boar"

#. ~ Description for festering boar
#: lang/json/MONSTER_from_json.py
msgid ""
"A zombified omnivore descended from the wild boar.  Now it's got black goo "
"all over it, instead of mud."
msgstr "A zombified omnivore descended from the wild boar.  Now it's got black goo all over it, instead of mud."

#: lang/json/MONSTER_from_json.py
msgid "feral predator"
msgstr "feral predator"

#. ~ Description for feral predator
#: lang/json/MONSTER_from_json.py
msgid ""
"With its joints in odd places and angles, this humanoid creature prowls "
"across the landscape with surprising speed.  Its teeth and arms are "
"sharpened into fine points, and black ooze seeps out from cuts between its "
"muscles."
msgstr "With its joints in odd places and angles, this humanoid creature prowls across the landscape with surprising speed.  Its teeth and arms are sharpened into fine points, and black ooze seeps out from cuts between its muscles."

#: lang/json/MONSTER_from_json.py
msgid "decayed zombie"
msgstr "decayed zombie"

#. ~ Description for decayed zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A once-dead human corpse.  Its discolored swollen flesh is riddled with "
"festering wounds and open sores."
msgstr "A once-dead human corpse.  Its discolored swollen flesh is riddled with festering wounds and open sores."

#: lang/json/MONSTER_from_json.py
msgid "feral runner"
msgstr "feral runner"

#. ~ Description for feral runner
#: lang/json/MONSTER_from_json.py
msgid ""
"This recently-risen body moves quickly, darting its head back and forth and "
"gnawing at its hands."
msgstr "This recently-risen body moves quickly, darting its head back and forth and gnawing at its hands."

#: lang/json/MONSTER_from_json.py
msgid "zombie scientist"
msgstr "zombie scientist"

#. ~ Description for zombie scientist
#: lang/json/MONSTER_from_json.py
msgid ""
"Apart from the jet black eyes it would be easy to believe this scientist was"
" still alive.  Clad in a tattered lab coat, it looks to have some measure of"
" situational awareness and resourcefulness."
msgstr "Apart from the jet black eyes it would be easy to believe this scientist was still alive.  Clad in a tattered lab coat, it looks to have some measure of situational awareness and resourcefulness."

#: lang/json/MONSTER_from_json.py
msgid "scorched zombie"
msgstr "scorched zombie"

#. ~ Description for scorched zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Heavily burned zombie that still reeks of charred flesh.  Its flesh has "
"mended into a leathery shell."
msgstr "Heavily burned zombie that still reeks of charred flesh.  Its flesh has mended into a leathery shell."

#: lang/json/MONSTER_from_json.py
msgid "screecher zombie"
msgstr "screecher zombie"

#. ~ Description for screecher zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A thin corpse, its chest is swollen in what appears to be preparation.  A "
"thick black ooze drips from its open mouth."
msgstr "A thin corpse, its chest is swollen in what appears to be preparation.  A thick black ooze drips from its open mouth."

#: lang/json/MONSTER_from_json.py
msgid "shady zombie"
msgstr "shady zombie"

#. ~ Description for shady zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"An uncanny shadow envelops this creature, as if light itself were too "
"repulsed to touch it.  All you can make out is its shambling, human shaped "
"outline."
msgstr "An uncanny shadow envelops this creature, as if light itself were too repulsed to touch it.  All you can make out is its shambling, human shaped outline."

#: lang/json/MONSTER_from_json.py
msgid "shrieker zombie"
msgstr "shrieker zombie"

#. ~ Description for shrieker zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"An elongated human body with a swollen chest and a gaping hole where its jaw"
" used to be."
msgstr "An elongated human body with a swollen chest and a gaping hole where its jaw used to be."

#: lang/json/MONSTER_from_json.py
msgid "smoker zombie"
msgstr "smoker zombie"

#. ~ Description for smoker zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A blackened and twisted naked human body, strips of flesh hang from its "
"body, and it emits a constant haze of thick black smoke."
msgstr "A blackened and twisted naked human body, strips of flesh hang from its body, and it emits a constant haze of thick black smoke."

#: lang/json/MONSTER_from_json.py
msgid "zombie soldier"
msgstr "zombie soldier"

#. ~ Description for zombie soldier
#: lang/json/MONSTER_from_json.py
msgid ""
"Once a soldier, it is dressed head to toe in combat gear and carries itself "
"rather steadily for a zombie."
msgstr "Once a soldier, it is dressed head to toe in combat gear and carries itself rather steadily for a zombie."

#: lang/json/MONSTER_from_json.py
msgid "spitter zombie"
msgstr "spitter zombie"

#. ~ Description for spitter zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A hunched human body with its eyes pushed up into its forehead and drooping "
"cheeks, most of its face is occupied by a puckered mouth.  Its stomach is "
"swollen and nearly translucent, with a sickly yellow tint."
msgstr "A hunched human body with its eyes pushed up into its forehead and drooping cheeks, most of its face is occupied by a puckered mouth.  Its stomach is swollen and nearly translucent, with a sickly yellow tint."

#: lang/json/MONSTER_from_json.py
msgid "survivor zombie"
msgstr "survivor zombie"

#. ~ Description for survivor zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Still wearing the tattered remnants of improvised armor and weaponry, it is "
"plain to see that this zombie was once a survivor like you."
msgstr "Still wearing the tattered remnants of improvised armor and weaponry, it is plain to see that this zombie was once a survivor like you."

#: lang/json/MONSTER_from_json.py
msgid "swimmer zombie"
msgstr "swimmer zombie"

#. ~ Description for swimmer zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A slick and glistening human body.  Its hands and feet are webbed, and it is"
" clad in swimwear."
msgstr "A slick and glistening human body.  Its hands and feet are webbed, and it is clad in swimwear."

#: lang/json/MONSTER_from_json.py
msgid "zombie technician"
msgstr "zombie technician"

#. ~ Description for zombie technician
#: lang/json/MONSTER_from_json.py
msgid ""
"Still wearing its work clothes and hardhat, this zombie likely used to work "
"on power lines or other electrical equipment."
msgstr "Still wearing its work clothes and hardhat, this zombie likely used to work on power lines or other electrical equipment."

#: lang/json/MONSTER_from_json.py
msgid "tough zombie"
msgstr "tough zombie"

#. ~ Description for tough zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Once an athletic human, now a brutal monster.  Its facial features are "
"twisted into an expression of pure rage."
msgstr "Once an athletic human, now a brutal monster.  Its facial features are twisted into an expression of pure rage."

#: lang/json/MONSTER_from_json.py
msgid "antlered horror"
msgstr "antlered horror"

#. ~ Description for antlered horror
#: lang/json/MONSTER_from_json.py
msgid ""
"This formerly-majestic moose has succumbed to the infection which is killing"
" the world.  Shiny green blowflies swarm the vast suppurated patches of "
"purulent flesh where its skin has sloughed away, and its remaining fur is "
"black and matted with necrotic discharge."
msgstr "This formerly-majestic moose has succumbed to the infection which is killing the world.  Shiny green blowflies swarm the vast suppurated patches of purulent flesh where its skin has sloughed away, and its remaining fur is black and matted with necrotic discharge."

#: lang/json/MONSTER_from_json.py
msgid "decayed pouncer"
msgstr "decayed pouncer"

#. ~ Description for decayed pouncer
#: lang/json/MONSTER_from_json.py
msgid ""
"An otherwise normal-looking cougar, except that its hind legs are swollen, "
"and its eyes bulge with black goo."
msgstr "An otherwise normal-looking cougar, except that its hind legs are swollen, and its eyes bulge with black goo."

#: lang/json/MONSTER_from_json.py
msgid "security bot"
msgstr "security bot"

#. ~ Description for security bot
#: lang/json/MONSTER_from_json.py
msgid ""
"The Northrop Watchman X-1 is a production series of heavily armored combat "
"robots.  Initially designed for military patrol and escort service, it rolls"
" on a set of hydraulic treads and is armed with a 9x19mm SMG."
msgstr "The Northrop Watchman X-1 is a production series of heavily armored combat robots.  Initially designed for military patrol and escort service, it rolls on a set of hydraulic treads and is armed with a 9x19mm SMG."

#: lang/json/MONSTER_from_json.py
msgid "turret"
msgstr "turret"

#. ~ Description for turret
#: lang/json/MONSTER_from_json.py
msgid ""
"The General Atomics TX-1 Guardian, a small, pill-shaped automated gun turret"
" using state of the art ATR systems to dynamically reorient itself to new "
"friends and enemies alike.  The two SMG barrels can swivel a full 360 "
"degrees."
msgstr "The General Atomics TX-1 Guardian, a small, pill-shaped automated gun turret using state of the art ATR systems to dynamically reorient itself to new friends and enemies alike.  The two SMG barrels can swivel a full 360 degrees."

#: lang/json/MONSTER_from_json.py
msgid "autonomous drone"
msgstr "autonomous drone"

#: lang/json/MONSTER_from_json.py
msgid "EMP hack"
msgstr "EMP hack"

#. ~ Description for EMP hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this fist-sized robot appears to have an EMP "
"grenade inside."
msgstr "An automated kamikaze drone, this fist-sized robot appears to have an EMP grenade inside."

#: lang/json/MONSTER_from_json.py
msgid "C-4 hack"
msgstr "C-4 hack"

#. ~ Description for C-4 hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this fist-sized robot appears to have some C-4 "
"inside."
msgstr "An automated kamikaze drone, this fist-sized robot appears to have some C-4 inside."

#: lang/json/MONSTER_from_json.py
msgid "flashbang hack"
msgstr "flashbang hack"

#. ~ Description for flashbang hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this fist-sized robot appears to have a "
"flashbang inside."
msgstr "An automated kamikaze drone, this fist-sized robot appears to have a flashbang inside."

#: lang/json/MONSTER_from_json.py
msgid "tear gas hack"
msgstr "tear gas hack"

#. ~ Description for tear gas hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this fist-sized robot appears to have a tear "
"gas canister inside."
msgstr "An automated kamikaze drone, this fist-sized robot appears to have a tear gas canister inside."

#: lang/json/MONSTER_from_json.py
msgid "grenade hack"
msgstr "grenade hack"

#. ~ Description for grenade hack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this fist-sized robot appears to have a grenade"
" inside."
msgstr "An automated kamikaze drone, this fist-sized robot appears to have a grenade inside."

#: lang/json/MONSTER_from_json.py
msgid "manhack"
msgstr "manhack"

#. ~ Description for manhack
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated anti-personnel drone, a fist-sized robot surrounded by whirring"
" blades."
msgstr "An automated anti-personnel drone, a fist-sized robot surrounded by whirring blades."

#: lang/json/MONSTER_from_json.py
msgid "mininuke hack"
msgstr "mininuke hack"

#. ~ Description for mininuke hack
#: lang/json/MONSTER_from_json.py
msgid ""
"Twice as large as a normal manhack, this flying drone appears to have a "
"mininuke inside.  If this is targeting you...  Run."
msgstr "Twice as large as a normal manhack, this flying drone appears to have a mininuke inside.  If this is targeting you...  Run."

#: lang/json/MONSTER_from_json.py
msgid "laser turret"
msgstr "laser turret"

#. ~ Description for laser turret
#: lang/json/MONSTER_from_json.py
msgid ""
"The TX-5LR Cerberus is an upgrade to its predecessors.  It features a state "
"of the art revolving laser cannon system with three barrels that charge from"
" solar cells embedded in its hull."
msgstr "The TX-5LR Cerberus is an upgrade to its predecessors.  It features a state of the art revolving laser cannon system with three barrels that charge from solar cells embedded in its hull."

#: lang/json/MONSTER_from_json.py
msgid "antimateriel turret"
msgstr "antimateriel turret"

#. ~ Description for antimateriel turret
#: lang/json/MONSTER_from_json.py
msgid ""
"Leadworks LLC's T-107A1 Interdictor, an automated .50BMG antimateriel rifle."
"  Credited with forestalling countless car-bombing attempts, it has always "
"been kept under extremely tight control, so as to itself maintain extremely "
"tight control of its area.  And then the Cataclysm struck."
msgstr "Leadworks LLC's T-107A1 Interdictor, an automated .50BMG antimateriel rifle.  Credited with forestalling countless car-bombing attempts, it has always been kept under extremely tight control, so as to itself maintain extremely tight control of its area.  And then the Cataclysm struck."

#: lang/json/MONSTER_from_json.py
msgid "milspec turret"
msgstr "milspec turret"

#. ~ Description for milspec turret
#: lang/json/MONSTER_from_json.py
msgid ""
"Leadworks LLC's T-4A1 Sentry.  It features improved firmware over General "
"Atomics' TX-1 9mm model and an automated M4 carbine."
msgstr "Leadworks LLC's T-4A1 Sentry.  It features improved firmware over General Atomics' TX-1 9mm model and an automated M4 carbine."

#: lang/json/MONSTER_from_json.py
msgid "centipede"
msgstr "centipede"

#. ~ Description for centipede
#: lang/json/MONSTER_from_json.py
msgid ""
"A predatory segmented arthropod with dozens of legs and a venomous bite."
msgstr "A predatory segmented arthropod with dozens of legs and a venomous bite."

#: lang/json/MONSTER_from_json.py
msgid "deer mouse"
msgstr "deer mouse"

#. ~ Description for deer mouse
#: lang/json/MONSTER_from_json.py
msgid ""
"The white-footed mouse, a prolific rodent with a white underbelly and a long"
" fuzzy tail.  A common sight in fields, forests, and research centers."
msgstr "The white-footed mouse, a prolific rodent with a white underbelly and a long fuzzy tail.  A common sight in fields, forests, and research centers."

#: lang/json/MONSTER_from_json.py
msgid "dragonfly"
msgid_plural "dragonflies"
msgstr[0] "dragonfly"
msgstr[1] "dragonflies"

#. ~ Description for dragonfly
#: lang/json/MONSTER_from_json.py
msgid ""
"A thin-bodied insectoid predator with a large wingspan and big compound "
"eyes."
msgstr "A thin-bodied insectoid predator with a large wingspan and big compound eyes."

#: lang/json/MONSTER_from_json.py
msgid "bull frog"
msgstr "bull frog"

#. ~ Description for bull frog
#: lang/json/MONSTER_from_json.py
msgid ""
"The American bullfrog, in its natural habitat.  It feeds on insects, mice, "
"lizards and any other living thing it can stuff down its gullet."
msgstr "The American bullfrog, in its natural habitat.  It feeds on insects, mice, lizards and any other living thing it can stuff down its gullet."

#: lang/json/MONSTER_from_json.py
msgid "mosquito"
msgstr "mosquito"

#. ~ Description for mosquito
#: lang/json/MONSTER_from_json.py
msgid ""
"A blood-sucking fly with a needle-like proboscis.  Its bite leaves behind "
"itchy welts and can easily spread disease."
msgstr "A blood-sucking fly with a needle-like proboscis.  Its bite leaves behind itchy welts and can easily spread disease."

#: lang/json/MONSTER_from_json.py
msgid "shrew"
msgstr "shrew"

#. ~ Description for shrew
#: lang/json/MONSTER_from_json.py
msgid ""
"The masked shrew, a mouse-like creature with a pointed, whiskery snout.  It "
"digs tunnels into the ground in search of bugs to eat."
msgstr "The masked shrew, a mouse-like creature with a pointed, whiskery snout.  It digs tunnels into the ground in search of bugs to eat."

#: lang/json/MONSTER_from_json.py
msgid "slug"
msgstr "slug"

#. ~ Description for slug
#: lang/json/MONSTER_from_json.py
msgid ""
"The leopard slug, an omnivorous gastropod.  It consumes decaying matter as "
"well as planted crops, and will attack and eat other slugs that cross its "
"path."
msgstr "The leopard slug, an omnivorous gastropod.  It consumes decaying matter as well as planted crops, and will attack and eat other slugs that cross its path."

#: lang/json/MONSTER_from_json.py
msgid "jumping spider"
msgstr "jumping spider"

#. ~ Description for jumping spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A little spider with elongated forelegs.  It does not build extensive webs, "
"but leaps very quickly, appearing to move instantaneously from one spot to "
"another."
msgstr "A little spider with elongated forelegs.  It does not build extensive webs, but leaps very quickly, appearing to move instantaneously from one spot to another."

#: lang/json/MONSTER_from_json.py
msgid "trapdoor spider"
msgstr "trapdoor spider"

#. ~ Description for trapdoor spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A midsized spider with a bulbous thorax.  It creates a subterranean nest and"
" lies in wait for prey to draw close enough for capture."
msgstr "A midsized spider with a bulbous thorax.  It creates a subterranean nest and lies in wait for prey to draw close enough for capture."

#: lang/json/MONSTER_from_json.py
msgid "black widow spider"
msgstr "black widow spider"

#. ~ Description for black widow spider
#: lang/json/MONSTER_from_json.py
msgid ""
"An infamous spider with a characteristic red hourglass marking on its black "
"carapace, known for its highly toxic bite."
msgstr "An infamous spider with a characteristic red hourglass marking on its black carapace, known for its highly toxic bite."

#: lang/json/MONSTER_from_json.py
msgid "wolf spider"
msgstr "wolf spider"

#. ~ Description for wolf spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A fairly large spider which tracks and catches prey through agility and "
"stealth.  Its bite can be irritating even to large animals."
msgstr "A fairly large spider which tracks and catches prey through agility and stealth.  Its bite can be irritating even to large animals."

#: lang/json/MONSTER_from_json.py
msgid "wasp"
msgstr "wasp"

#. ~ Description for wasp
#: lang/json/MONSTER_from_json.py
msgid ""
"A slender-bodied flying insect, with a painful sting.  They can be somewhat "
"aggressive if disturbed."
msgstr "A slender-bodied flying insect, with a painful sting.  They can be somewhat aggressive if disturbed."

#: lang/json/MONSTER_from_json.py
msgid "anklebiter"
msgstr "anklebiter"

#. ~ Description for anklebiter
#: lang/json/MONSTER_from_json.py
msgid ""
"This horrifying little mutated wretch looks to have once been a child, but "
"its massive gaping jaws are now far more suggestive of a predatory beast."
msgstr "This horrifying little mutated wretch looks to have once been a child, but its massive gaping jaws are now far more suggestive of a predatory beast."

#: lang/json/MONSTER_from_json.py
msgid "zombie child"
msgid_plural "zombie children"
msgstr[0] "zombie child"
msgstr[1] "zombie children"

#. ~ Description for zombie child
#: lang/json/MONSTER_from_json.py
msgid ""
"It was only a child, and little is different about it now aside from the "
"hungry look in its eyes.  You'd be hard pressed to not feel like you were "
"killing an actual child by putting it down."
msgstr "It was only a child, and little is different about it now aside from the hungry look in its eyes.  You'd be hard pressed to not feel like you were killing an actual child by putting it down."

#: lang/json/MONSTER_from_json.py
msgid "zombie kinderling"
msgid_plural "zombie kinderlings"
msgstr[0] "zombie kinderling"
msgstr[1] "zombie kinderlings"

#. ~ Description for zombie kinderling
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny charred body, jumping and kicked and flailing around in a mockery of "
"playground exercise.  It does not need a face for you to feel bad about "
"killing it."
msgstr "A tiny charred body, jumping and kicked and flailing around in a mockery of playground exercise.  It does not need a face for you to feel bad about killing it."

#: lang/json/MONSTER_from_json.py
msgid "creepy crawler"
msgstr "creepy crawler"

#. ~ Description for creepy crawler
#: lang/json/MONSTER_from_json.py
msgid ""
"What was once a child is now a mutant beast with blackened skin and massive "
"eyes.  This abomination's vile form makes mockery of its human origin."
msgstr "What was once a child is now a mutant beast with blackened skin and massive eyes.  This abomination's vile form makes mockery of its human origin."

#: lang/json/MONSTER_from_json.py
msgid "shriekling"
msgstr "shriekling"

#. ~ Description for shriekling
#: lang/json/MONSTER_from_json.py
msgid ""
"This heavily mutated child zombie twitches and flails its limbs in painful "
"looking spasms as it runs about."
msgstr "This heavily mutated child zombie twitches and flails its limbs in painful looking spasms as it runs about."

#: lang/json/MONSTER_from_json.py
msgid "snotgobbler"
msgstr "snotgobbler"

#. ~ Description for snotgobbler
#: lang/json/MONSTER_from_json.py
msgid ""
"This swollen, gooey looking mutant child looks bad, even for a zombie.  "
"Maybe that's why it seems to want a hug so badly."
msgstr "This swollen, gooey looking mutant child looks bad, even for a zombie.  Maybe that's why it seems to want a hug so badly."

#: lang/json/MONSTER_from_json.py
msgid "sproglodyte"
msgstr "sproglodyte"

#. ~ Description for sproglodyte
#: lang/json/MONSTER_from_json.py
msgid ""
"This crouching child-mutant's face is dominated by a pair of huge black eyes"
" and its fingertips end in sharp claws."
msgstr "This crouching child-mutant's face is dominated by a pair of huge black eyes and its fingertips end in sharp claws."

#: lang/json/MONSTER_from_json.py
msgid "howling waif"
msgstr "howling waif"

#. ~ Description for howling waif
#: lang/json/MONSTER_from_json.py
msgid ""
"Undeath has not been kind to the children of the apocalypse.  This one is "
"little more than a reanimated membrane of skin stretched across tiny brittle"
" bones."
msgstr "Undeath has not been kind to the children of the apocalypse.  This one is little more than a reanimated membrane of skin stretched across tiny brittle bones."

#: lang/json/MONSTER_from_json.py
msgid "zombie grenadier"
msgstr "zombie grenadier"

#. ~ Description for zombie grenadier
#: lang/json/MONSTER_from_json.py
msgid ""
"Once a soldier, it is dressed head to toe in combat gear.  Its hands "
"constantly fumble at its many pouches."
msgstr "Once a soldier, it is dressed head to toe in combat gear.  Its hands constantly fumble at its many pouches."

#: lang/json/MONSTER_from_json.py
msgid "zombie elite grenadier"
msgstr "zombie elite grenadier"

#. ~ Description for zombie elite grenadier
#: lang/json/MONSTER_from_json.py
msgid ""
"Once a soldier, it is dressed head to toe in combat gear and wearing a MOLLE"
" pack.  Its hands quickly open and close its many pouches."
msgstr "Once a soldier, it is dressed head to toe in combat gear and wearing a MOLLE pack.  Its hands quickly open and close its many pouches."

#: lang/json/MONSTER_from_json.py
msgid "old animatronic fox"
msgstr "old animatronic fox"

#. ~ Description for old animatronic fox
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic fox, nearly twice your size.  Its teeth and claws look"
" quite sharp.  Its right hand is replaced with a hook.  It looks heavily "
"worn and degraded."
msgstr "A bipedal animatronic fox, nearly twice your size.  Its teeth and claws look quite sharp.  Its right hand is replaced with a hook.  It looks heavily worn and degraded."

#: lang/json/MONSTER_from_json.py
msgid "new animatronic fox"
msgstr "new animatronic fox"

#. ~ Description for new animatronic fox
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic fox, nearly twice your size.  Its teeth and claws look"
" quite sharp.  Its outer layer is made of reinforced plastic.  It looks to "
"be high tech, and in good shape."
msgstr "A bipedal animatronic fox, nearly twice your size.  Its teeth and claws look quite sharp.  Its outer layer is made of reinforced plastic.  It looks to be high tech, and in good shape."

#: lang/json/MONSTER_from_json.py
msgid "wrecked animatronic fox"
msgstr "wrecked animatronic fox"

#. ~ Description for wrecked animatronic fox
#: lang/json/MONSTER_from_json.py
msgid ""
"A wrecked animatronic fox, laying in a pile on the ground.  Its teeth and "
"claws still look quite sharp.  It's able to crawl around and climb on the "
"ceiling."
msgstr "A wrecked animatronic fox, laying in a pile on the ground.  Its teeth and claws still look quite sharp.  It's able to crawl around and climb on the ceiling."

#: lang/json/MONSTER_from_json.py
msgid "new animatronic bunny"
msgstr "new animatronic bunny"

#. ~ Description for new animatronic bunny
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic bunny, nearly twice your size.  Its actually quite "
"cute, even though it's trying to kill you.  Its outer layer is made of "
"reinforced plastic.  It looks to be high tech, and in good shape."
msgstr "A bipedal animatronic bunny, nearly twice your size.  Its actually quite cute, even though it's trying to kill you.  Its outer layer is made of reinforced plastic.  It looks to be high tech, and in good shape."

#: lang/json/MONSTER_from_json.py
msgid "old animatronic bunny"
msgstr "old animatronic bunny"

#. ~ Description for old animatronic bunny
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic bunny, nearly twice your size.  Its face has been torn"
" clear off, though the sockets for it's eyes still exist.  It looks heavily "
"worn and degraded."
msgstr "A bipedal animatronic bunny, nearly twice your size.  Its face has been torn clear off, though the sockets for it's eyes still exist.  It looks heavily worn and degraded."

#: lang/json/MONSTER_from_json.py
msgid "old animatronic chicken"
msgstr "old animatronic chicken"

#. ~ Description for old animatronic chicken
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic chicken, nearly twice your size.  It's wearing a bib "
"that reads 'Let's Eat!'.  Though it is a robot, it stinks like death."
msgstr "A bipedal animatronic chicken, nearly twice your size.  It's wearing a bib that reads 'Let's Eat!'.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "new animatronic chicken"
msgstr "new animatronic chicken"

#. ~ Description for new animatronic chicken
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic chicken, nearly twice your size.  It's wearing a bib "
"that reads 'Let's Party!'.  She oddly has a curvaceous figure.  Its outer "
"layer is made of reinforced plastic.  It looks to be high tech, and in good "
"shape."
msgstr "A bipedal animatronic chicken, nearly twice your size.  It's wearing a bib that reads 'Let's Party!'.  She oddly has a curvaceous figure.  Its outer layer is made of reinforced plastic.  It looks to be high tech, and in good shape."

#: lang/json/MONSTER_from_json.py
msgid "old animatronic bear"
msgstr "old animatronic bear"

#. ~ Description for old animatronic bear
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic bear, nearly twice your size.  It's holding a "
"microphone, and wearing a top hat.  Though it is a robot, it stinks like "
"death.  It looks heavily worn and degraded."
msgstr "A bipedal animatronic bear, nearly twice your size.  It's holding a microphone, and wearing a top hat.  Though it is a robot, it stinks like death.  It looks heavily worn and degraded."

#: lang/json/MONSTER_from_json.py
msgid "new animatronic bear"
msgstr "new animatronic bear"

#. ~ Description for new animatronic bear
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic bear, nearly twice your size.  It's holding a "
"microphone, and wearing a top hat.  Its outer layer is made of reinforced "
"plastic.  It looks to be high tech, and in good shape."
msgstr "A bipedal animatronic bear, nearly twice your size.  It's holding a microphone, and wearing a top hat.  Its outer layer is made of reinforced plastic.  It looks to be high tech, and in good shape."

#: lang/json/MONSTER_from_json.py
msgid "animatronic bat"
msgstr "animatronic bat"

#. ~ Description for animatronic bat
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic bat, nearly twice your size.  It might have been cute "
"once, but has fallen into disrepair.  Though it is a robot, it stinks like "
"death."
msgstr "A bipedal animatronic bat, nearly twice your size.  It might have been cute once, but has fallen into disrepair.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic beaver"
msgstr "animatronic beaver"

#. ~ Description for animatronic beaver
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic beaver, nearly twice your size.  Its buck teeth look "
"far more sharp than they should be.  Though it is a robot, it stinks like "
"death."
msgstr "A bipedal animatronic beaver, nearly twice your size.  Its buck teeth look far more sharp than they should be.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic cat"
msgstr "animatronic cat"

#. ~ Description for animatronic cat
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic cat, nearly twice your size.  Its claws are extremely "
"sharp.  Though it is a robot, it stinks like death."
msgstr "A bipedal animatronic cat, nearly twice your size.  Its claws are extremely sharp.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic chipmunk"
msgstr "animatronic chipmunk"

#. ~ Description for animatronic chipmunk
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic chipmunk, nearly twice your size.  You might call it "
"cute if it wasn't charging you down right now.  Though it is a robot, it "
"stinks like death."
msgstr "A bipedal animatronic chipmunk, nearly twice your size.  You might call it cute if it wasn't charging you down right now.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic cow"
msgstr "animatronic cow"

#. ~ Description for animatronic cow
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic cow, nearly twice your size.  Its voice-box is broken,"
" making it emit shrill, eerie moos.  Though it is a robot, it stinks like "
"death."
msgstr "A bipedal animatronic cow, nearly twice your size.  Its voice-box is broken, making it emit shrill, eerie moos.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic coyote"
msgstr "animatronic coyote"

#. ~ Description for animatronic coyote
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic coyote, nearly twice your size.  Its head twitches "
"about faster than seems possible.  Though it is a robot, it stinks like "
"death."
msgstr "A bipedal animatronic coyote, nearly twice your size.  Its head twitches about faster than seems possible.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic deer"
msgstr "animatronic deer"

#. ~ Description for animatronic deer
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic deer, nearly twice your size.  The hunter becomes the "
"hunted.  Though it is a robot, it stinks like death."
msgstr "A bipedal animatronic deer, nearly twice your size.  The hunter becomes the hunted.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic horse"
msgstr "animatronic horse"

#. ~ Description for animatronic horse
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic horse, nearly twice your size.  It's amazing.  Though "
"it is a robot, it stinks like death."
msgstr "A bipedal animatronic horse, nearly twice your size.  It's amazing.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic pig"
msgstr "animatronic pig"

#. ~ Description for animatronic pig
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic pig, nearly twice your size.  Little piggy go home, "
"little piggy no no.  Though it is a robot, it stinks like death."
msgstr "A bipedal animatronic pig, nearly twice your size.  Little piggy go home, little piggy no no.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic sheep"
msgid_plural "animatronic sheep"
msgstr[0] "animatronic sheep"
msgstr[1] "animatronic sheep"

#. ~ Description for animatronic sheep
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic sheep, nearly twice your size.  Its wool is mangy and "
"gross.  Though it is a robot, it stinks like death."
msgstr "A bipedal animatronic sheep, nearly twice your size.  Its wool is mangy and gross.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic squirrel"
msgstr "animatronic squirrel"

#. ~ Description for animatronic squirrel
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic squirrel, nearly twice your size.  Judging by its "
"sharp teeth, you hope it does not like nuts.  Though it is a robot, it "
"stinks like death."
msgstr "A bipedal animatronic squirrel, nearly twice your size.  Judging by its sharp teeth, you hope it does not like nuts.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "animatronic child"
msgstr "animatronic child"

#. ~ Description for animatronic child
#: lang/json/MONSTER_from_json.py
msgid ""
"An animatronic child.  It looks like it's annoying as hell.  Though it is a "
"robot, it stinks like death."
msgstr "An animatronic child.  It looks like it's annoying as hell.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "marionette"
msgstr "marionette"

#. ~ Description for marionette
#: lang/json/MONSTER_from_json.py
msgid ""
"A marionette able to move itself around.  There are no strings on him "
"however."
msgstr "A marionette able to move itself around.  There are no strings on him however."

#: lang/json/MONSTER_from_json.py
msgid "animatronic wolf"
msgstr "animatronic wolf"

#. ~ Description for animatronic wolf
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal animatronic wolf, nearly twice your size.  If the animal "
"counterpart was scary, this robot is terrifying.  Though it is a robot, it "
"stinks like death."
msgstr "A bipedal animatronic wolf, nearly twice your size.  If the animal counterpart was scary, this robot is terrifying.  Though it is a robot, it stinks like death."

#: lang/json/MONSTER_from_json.py
msgid "spirit of fire"
msgid_plural "spirits of fire"
msgstr[0] "spirit of fire"
msgstr[1] "spirits of fire"

#. ~ Description for spirit of fire
#: lang/json/MONSTER_from_json.py
msgid ""
"A massive animated conflagration, crackling like burning logs as it moves."
msgstr "A massive animated conflagration, crackling like burning logs as it moves."

#: lang/json/MONSTER_from_json.py
msgid "moruboru"
msgstr "moruboru"

#. ~ Description for moruboru
#: lang/json/MONSTER_from_json.py
msgid ""
"A large plantlike creature with a gaping, toothy maw and numerous vines.  A "
"hideous smell permeates the air around it."
msgstr "A large plantlike creature with a gaping, toothy maw and numerous vines.  A hideous smell permeates the air around it."

#: lang/json/MONSTER_from_json.py
msgid "archon"
msgstr "archon"

#. ~ Description for archon
#: lang/json/MONSTER_from_json.py
msgid ""
"A tall, robed figure twisted into a mockery of the human form, brandishing a"
" strange golden talisman.  You feel an otherworldly presence about it."
msgstr "A tall, robed figure twisted into a mockery of the human form, brandishing a strange golden talisman.  You feel an otherworldly presence about it."

#: lang/json/MONSTER_from_json.py
msgid "dracolich"
msgstr "dracolich"

#. ~ Description for dracolich
#: lang/json/MONSTER_from_json.py
msgid ""
"A massive, reptilian creature with batlike wings.  Its body is withered and "
"rotten, large chunks of flesh stripped to the bone, and the membranes of its"
" wings are in tatters.  You wonder how such a large beast could fly in the "
"first place, let alone in that condition."
msgstr "A massive, reptilian creature with batlike wings.  Its body is withered and rotten, large chunks of flesh stripped to the bone, and the membranes of its wings are in tatters.  You wonder how such a large beast could fly in the first place, let alone in that condition."

#: lang/json/MONSTER_from_json.py
msgid "Compsognathus"
msgstr "Compsognathus"

#. ~ Description for Compsognathus
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal dinosaur about the size of a small cat.  Its teeth and claws look "
"quite sharp."
msgstr "A bipedal dinosaur about the size of a small cat.  Its teeth and claws look quite sharp."

#: lang/json/MONSTER_from_json.py
msgid "Gallimimus"
msgstr "Gallimimus"

#. ~ Description for Gallimimus
#: lang/json/MONSTER_from_json.py
msgid ""
"A feathered bipedal dinosaur, standing as tall as a human.  It looks "
"somewhat like a reptilian ostrich."
msgstr "A feathered bipedal dinosaur, standing as tall as a human.  It looks somewhat like a reptilian ostrich."

#: lang/json/MONSTER_from_json.py
msgid "Titanis"
msgstr "Titanis"

#. ~ Description for Titanis
#: lang/json/MONSTER_from_json.py
msgid ""
"It looks like a dodo, only much bigger, with longer, muscular legs and a "
"predatory gleam in its eyes."
msgstr "It looks like a dodo, only much bigger, with longer, muscular legs and a predatory gleam in its eyes."

#: lang/json/MONSTER_from_json.py
msgid "Spinosaurus"
msgstr "Spinosaurus"

#. ~ Description for Spinosaurus
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge dinosaur about the size of a small house, with a ferocious crocodile-"
"like head and a sail on its back."
msgstr "A huge dinosaur about the size of a small house, with a ferocious crocodile-like head and a sail on its back."

#: lang/json/MONSTER_from_json.py
msgid "Tyrannosaurus rex"
msgstr "Tyrannosaurus rex"

#. ~ Description for Tyrannosaurus rex
#: lang/json/MONSTER_from_json.py
msgid "Look at those TEETH!"
msgstr "Look at those TEETH!"

#: lang/json/MONSTER_from_json.py
msgid "Triceratops"
msgstr "Triceratops"

#. ~ Description for Triceratops
#: lang/json/MONSTER_from_json.py
msgid ""
"A massive rhino-like dinosaur with a bony crest from which three large horns"
" emerge."
msgstr "A massive rhino-like dinosaur with a bony crest from which three large horns emerge."

#: lang/json/MONSTER_from_json.py
msgid "Stegosaurus"
msgstr "Stegosaurus"

#. ~ Description for Stegosaurus
#: lang/json/MONSTER_from_json.py
msgid "A large quadruped dinosaur with plates on its back, and a spiked tail."
msgstr "A large quadruped dinosaur with plates on its back, and a spiked tail."

#: lang/json/MONSTER_from_json.py
msgid "Ankylosaurus"
msgstr "Ankylosaurus"

#. ~ Description for Ankylosaurus
#: lang/json/MONSTER_from_json.py
msgid ""
"This dinosaur looks like a giant prehistoric armadillo.  Its tail ends in a "
"massive spiked club of bone."
msgstr "This dinosaur looks like a giant prehistoric armadillo.  Its tail ends in a massive spiked club of bone."

#: lang/json/MONSTER_from_json.py
msgid "Allosaurus"
msgstr "Allosaurus"

#. ~ Description for Allosaurus
#: lang/json/MONSTER_from_json.py
msgid ""
"A large predatory bipedal dinosaur, with tiger-like stripes on its broad "
"back."
msgstr "A large predatory bipedal dinosaur, with tiger-like stripes on its broad back."

#: lang/json/MONSTER_from_json.py
msgid "Eoraptor"
msgstr "Eoraptor"

#. ~ Description for Eoraptor
#: lang/json/MONSTER_from_json.py
msgid ""
"A bipedal dinosaur about the size of a chicken.  It roots around the "
"undergrowth, scavenging on small animals and plants."
msgstr "A bipedal dinosaur about the size of a chicken.  It roots around the undergrowth, scavenging on small animals and plants."

#: lang/json/MONSTER_from_json.py
msgid "Velociraptor"
msgstr "Velociraptor"

#. ~ Description for Velociraptor
#: lang/json/MONSTER_from_json.py
msgid ""
"A small bipedal dinosaur covered with feathers.  Small, hooked claws emerge "
"from its feet and hands."
msgstr "A small bipedal dinosaur covered with feathers.  Small, hooked claws emerge from its feet and hands."

#: lang/json/MONSTER_from_json.py
msgid "Deinonychus"
msgstr "Deinonychus"

#. ~ Description for Deinonychus
#: lang/json/MONSTER_from_json.py
msgid ""
"A medium-sized bipedal dinosaur covered with feathers.  At the end of each "
"foot is a large sickle-like claw."
msgstr "A medium-sized bipedal dinosaur covered with feathers.  At the end of each foot is a large sickle-like claw."

#: lang/json/MONSTER_from_json.py
msgid "Utahraptor"
msgstr "Utahraptor"

#. ~ Description for Utahraptor
#: lang/json/MONSTER_from_json.py
msgid ""
"A large bipedal dinosaur with feathered arms, a long tail, and scythe-like "
"claws."
msgstr "A large bipedal dinosaur with feathered arms, a long tail, and scythe-like claws."

#: lang/json/MONSTER_from_json.py
msgid "Parasaurolophus"
msgstr "Parasaurolophus"

#. ~ Description for Parasaurolophus
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge mottled dinosaur with a blunt head crest.  It contentedly strips "
"leaves from a nearby shrub."
msgstr "A huge mottled dinosaur with a blunt head crest.  It contentedly strips leaves from a nearby shrub."

#: lang/json/MONSTER_from_json.py
msgid "Dimorphodon"
msgstr "Dimorphodon"

#. ~ Description for Dimorphodon
#: lang/json/MONSTER_from_json.py
msgid "A small flying reptile, circling overhead looking for prey."
msgstr "A small flying reptile, circling overhead looking for prey."

#: lang/json/MONSTER_from_json.py
msgid "Dilophosaurus"
msgstr "Dilophosaurus"

#. ~ Description for Dilophosaurus
#: lang/json/MONSTER_from_json.py
msgid "A medium dinosaur with a sticky green bile dripping from its teeth."
msgstr "A medium dinosaur with a sticky green bile dripping from its teeth."

#: lang/json/MONSTER_from_json.py
msgid "kwama"
msgstr "kwama"

#. ~ Description for kwama
#: lang/json/MONSTER_from_json.py
msgid ""
"You don't know what this thing is, but the ants treat it as one of their "
"own.  Its head looks like a maggot, completely devoid of pincers and with "
"three beady eyes staring in different directions.  While it typically "
"travels on its four limbs, it occasionally stands upon its hind limbs to "
"gaze about.  It claws clumsily with the three digits on each limb, and "
"rumors exist of it being capable of harnessing electricity for attack."
msgstr "You don't know what this thing is, but the ants treat it as one of their own.  Its head looks like a maggot, completely devoid of pincers and with three beady eyes staring in different directions.  While it typically travels on its four limbs, it occasionally stands upon its hind limbs to gaze about.  It claws clumsily with the three digits on each limb, and rumors exist of it being capable of harnessing electricity for attack."

#: lang/json/MONSTER_from_json.py
msgid "ant larvae"
msgstr "ant larvae"

#. ~ Description for ant larvae
#: lang/json/MONSTER_from_json.py
msgid ""
"A writhing mass of yellowing flesh, this little guy has developed a means of"
" expelling stomach contents if disturbed."
msgstr "A writhing mass of yellowing flesh, this little guy has developed a means of expelling stomach contents if disturbed."

#: lang/json/MONSTER_from_json.py
msgid "acidbomb hack"
msgstr "acidbomb hack"

#. ~ Description for acidbomb hack
#: lang/json/MONSTER_from_json.py
msgid "This manhack carries an acid bomb within its core."
msgstr "This manhack carries an acid bomb within its core."

#: lang/json/MONSTER_from_json.py
msgid ""
"A writhing mass of yellowing flesh, this little guy expels its stomach "
"contents if disturbed."
msgstr "A writhing mass of yellowing flesh, this little guy expels its stomach contents if disturbed."

#: lang/json/MONSTER_from_json.py
msgid "forager ant"
msgstr "forager ant"

#. ~ Description for forager ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A small giant ant with a carapace shell.  Is capable of a surprising range "
"of vocal expression for a bug, including ear-splitting wails."
msgstr "A small giant ant with a carapace shell.  Is capable of a surprising range of vocal expression for a bug, including ear-splitting wails."

#. ~ Description for giant ant
#: lang/json/MONSTER_from_json.py
msgid ""
"An enormous red ant covered in chitinous plates.  It possesses a pair of "
"wriggling antennae and vicious-looking mandibles.  This Earth native is "
"comfortably adapted to its new size."
msgstr "An enormous red ant covered in chitinous plates.  It possesses a pair of wriggling antennae and vicious-looking mandibles.  This Earth native is comfortably adapted to its new size."

#. ~ Description for soldier ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A huge and hairy red ant almost twice the size of other giant ants.  Bulging"
" pincers extend from its jaws.  This Earth native is comfortably adapted to "
"its new size."
msgstr "A huge and hairy red ant almost twice the size of other giant ants.  Bulging pincers extend from its jaws.  This Earth native is comfortably adapted to its new size."

#: lang/json/MONSTER_from_json.py
msgid "jack ant"
msgstr "jack ant"

#. ~ Description for jack ant
#: lang/json/MONSTER_from_json.py
msgid ""
"Somewhat smaller than other soldiers, this nimble ant jumps after prey and "
"drags them back to the hive for processing.  Its mandibles are the size of "
"its thorax, and secrete poison."
msgstr "Somewhat smaller than other soldiers, this nimble ant jumps after prey and drags them back to the hive for processing.  Its mandibles are the size of its thorax, and secrete poison."

#. ~ Description for jack ant
#: lang/json/MONSTER_from_json.py
msgid ""
"Somewhat smaller than other soldiers, this nimble ant jumps after prey and "
"drags them back to the hive for processing.  Its mandibles are the size of "
"its thorax, and secrete a slick-looking poison."
msgstr "Somewhat smaller than other soldiers, this nimble ant jumps after prey and drags them back to the hive for processing.  Its mandibles are the size of its thorax, and secrete a slick-looking poison."

#. ~ Description for queen ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A colossal red ant with a bulging, bloated thorax.  It moves slowly and "
"deliberately, tending to nearby eggs and continually laying more.  Its "
"antennae seem almost aesthetic, or at the least not used for sensing . . ."
msgstr "A colossal red ant with a bulging, bloated thorax.  It moves slowly and deliberately, tending to nearby eggs and continually laying more.  Its antennae seem almost aesthetic, or at the least not used for sensing . . ."

#: lang/json/MONSTER_from_json.py
msgid "young queen ant"
msgstr "young queen ant"

#. ~ Description for young queen ant
#: lang/json/MONSTER_from_json.py
msgid ""
"A fecund female ant.  It still bears its wings, and likely either s "
"preparing for or just completed its nuptial flight.  Its body is well-laden "
"with stores of nutrients for its future young."
msgstr "A fecund female ant.  It still bears its wings, and likely either s preparing for or just completed its nuptial flight.  Its body is well-laden with stores of nutrients for its future young."

#: lang/json/MONSTER_from_json.py
msgid "male ant"
msgstr "male ant"

#. ~ Description for male ant
#: lang/json/MONSTER_from_json.py
msgid ""
"The male giant ant, seen often during the spring and rarely anytime else.  "
"Spends its short life jockeying with other male ants for mating rights, only"
" actually mating once before death."
msgstr "The male giant ant, seen often during the spring and rarely anytime else.  Spends its short life jockeying with other male ants for mating rights, only actually mating once before death."

#: lang/json/MONSTER_from_json.py
msgid "imp"
msgstr "imp"

#. ~ Description for imp
#: lang/json/MONSTER_from_json.py
msgid ""
"This humanoid resembles a burnt cenobite.  It attacks with fire and claw, "
"and is the grunt of the demonic armies."
msgstr "This humanoid resembles a burnt cenobite.  It attacks with fire and claw, and is the grunt of the demonic armies."

#. ~ Description for imp
#: lang/json/MONSTER_from_json.py
msgid ""
"Even for an imp, this figure has blackened skin.  It attacks with fire and "
"claw, and leads its brethren into battle."
msgstr "Even for an imp, this figure has blackened skin.  It attacks with fire and claw, and leads its brethren into battle."

#: lang/json/MONSTER_from_json.py
msgid "demon"
msgstr "demon"

#. ~ Description for demon
#: lang/json/MONSTER_from_json.py
msgid ""
"A pink-skinned bipedal monster, with jaws that occupy a disproportionate "
"amount of its muscular body.  Melds into the shadows to ambush victims."
msgstr "A pink-skinned bipedal monster, with jaws that occupy a disproportionate amount of its muscular body.  Melds into the shadows to ambush victims."

#: lang/json/MONSTER_from_json.py
msgid "lost soul"
msgstr "lost soul"

#. ~ Description for lost soul
#: lang/json/MONSTER_from_json.py
msgid "A hovering skull in a halo of fire.  Very fast."
msgstr "A hovering skull in a halo of fire.  Very fast."

#: lang/json/MONSTER_from_json.py
msgid "revenant"
msgstr "revenant"

#. ~ Description for revenant
#: lang/json/MONSTER_from_json.py
msgid ""
"A gaunt figure with translucent flesh, this backbone of the demonic army "
"sports a salvo of homing rockets on each shoulder.  Its punch can crack "
"human bones."
msgstr "A gaunt figure with translucent flesh, this backbone of the demonic army sports a salvo of homing rockets on each shoulder.  Its punch can crack human bones."

#: lang/json/MONSTER_from_json.py
msgid "hell knight"
msgstr "hell knight"

#. ~ Description for hell knight
#: lang/json/MONSTER_from_json.py
msgid ""
"A towering monster vaguely reminiscent of a satyr.  As a member of the "
"ruling species of its domains, it is given administrative control.  Its "
"plasma blasts are deadly."
msgstr "A towering monster vaguely reminiscent of a satyr.  As a member of the ruling species of its domains, it is given administrative control.  Its plasma blasts are deadly."

#: lang/json/MONSTER_from_json.py
msgid "hell baron"
msgstr "hell baron"

#. ~ Description for hell baron
#: lang/json/MONSTER_from_json.py
msgid ""
"A towering monster vaguely reminiscent of a satyr.  A ranking member of the "
"ruling species of its domains, it is given command.  Its plasma blasts are "
"deadly."
msgstr "A towering monster vaguely reminiscent of a satyr.  A ranking member of the ruling species of its domains, it is given command.  Its plasma blasts are deadly."

#: lang/json/MONSTER_from_json.py
msgid "mancubus"
msgstr "mancubus"

#. ~ Description for mancubus
#: lang/json/MONSTER_from_json.py
msgid ""
"A corpulent, pig-faced monster; its arms have been forcibly replaced with "
"huge flame-cannons."
msgstr "A corpulent, pig-faced monster; its arms have been forcibly replaced with huge flame-cannons."

#: lang/json/MONSTER_from_json.py
msgid "cacodemon"
msgstr "cacodemon"

#. ~ Description for cacodemon
#: lang/json/MONSTER_from_json.py
msgid ""
"A dark red sphere with wicked teeth.  Its single eye lights up as it expels "
"plasma from its mouth."
msgstr "A dark red sphere with wicked teeth.  Its single eye lights up as it expels plasma from its mouth."

#: lang/json/MONSTER_from_json.py
msgid "arachnotron"
msgstr "arachnotron"

#. ~ Description for arachnotron
#: lang/json/MONSTER_from_json.py
msgid ""
"With metal girders supporting an encased brain, this lasgun-armed robot is "
"almost ripped directly from 80s sci-fi."
msgstr "With metal girders supporting an encased brain, this lasgun-armed robot is almost ripped directly from 80s sci-fi."

#: lang/json/MONSTER_from_json.py
msgid "cyberdemon"
msgstr "cyberdemon"

#. ~ Description for cyberdemon
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic humanoid with equally impressive machinery and bionics.  Affixed "
"to one arm is a barrel large enough for you to fit into."
msgstr "A gigantic humanoid with equally impressive machinery and bionics.  Affixed to one arm is a barrel large enough for you to fit into."

#: lang/json/MONSTER_from_json.py
msgid "churle"
msgstr "churle"

#. ~ Description for churle
#: lang/json/MONSTER_from_json.py
msgid ""
"A tortured slave; a living survivor, beaten, starved, wearing tattered rags "
"and wielding a crude weapon.  They look hungry enough to eat anything."
msgstr "A tortured slave; a living survivor, beaten, starved, wearing tattered rags and wielding a crude weapon.  They look hungry enough to eat anything."

#: lang/json/MONSTER_from_json.py
msgid "slave"
msgstr "slave"

#. ~ Description for slave
#: lang/json/MONSTER_from_json.py
msgid ""
"A servant of the damned.  This poor soul was spared from the horrors of the "
"demonic front line to be abused in the back.  Its tongue has been cut out."
msgstr "A servant of the damned.  This poor soul was spared from the horrors of the demonic front line to be abused in the back.  Its tongue has been cut out."

#: lang/json/MONSTER_from_json.py src/game.cpp
msgid "zombie slave"
msgstr "zombie slave"

#. ~ Description for zombie slave
#: lang/json/MONSTER_from_json.py
msgid ""
"A zombie, wearing gibbed green armor.  Pasted strands of flesh hang "
"uselessly where arms and a jawbone used to be."
msgstr "A zombie, wearing gibbed green armor.  Pasted strands of flesh hang uselessly where arms and a jawbone used to be."

#. ~ Description for lost soul
#: lang/json/MONSTER_from_json.py
msgid ""
"Fastened in place with metal spikes, chains, and nails, this flaming skull "
"is literally a living lamp."
msgstr "Fastened in place with metal spikes, chains, and nails, this flaming skull is literally a living lamp."

#: lang/json/MONSTER_from_json.py
msgid "mutilated zombie"
msgstr "mutilated zombie"

#. ~ Description for mutilated zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"All evidence indicates that this used to be a survivor, who was killed by "
"torture and body reanimated.  Its garments lack the weathered look of other "
"zombies but are mutilated none-the-less.  Although it struggles to free "
"itself, it is held fast with spikes, nails, and chains."
msgstr "All evidence indicates that this used to be a survivor, who was killed by torture and body reanimated.  Its garments lack the weathered look of other zombies but are mutilated none-the-less.  Although it struggles to free itself, it is held fast with spikes, nails, and chains."

#: lang/json/MONSTER_from_json.py
msgid "soul cube"
msgstr "soul cube"

#. ~ Description for soul cube
#: lang/json/MONSTER_from_json.py
msgid ""
"An unknown cube-shaped device of obviously alien origin, it flies forth with"
" singular purpose."
msgstr "An unknown cube-shaped device of obviously alien origin, it flies forth with singular purpose."

#: lang/json/MONSTER_from_json.py
msgid "vile"
msgstr "vile"

#. ~ Description for vile
#: lang/json/MONSTER_from_json.py
msgid ""
"A sickly yellow, elongated humanoid.  With almost complete control over its "
"own flames it attacks with pyrokinesis and breathes life into its fallen "
"allies."
msgstr "A sickly yellow, elongated humanoid.  With almost complete control over its own flames it attacks with pyrokinesis and breathes life into its fallen allies."

#: lang/json/MONSTER_from_json.py
msgid "archdemon"
msgstr "archdemon"

#. ~ Description for archdemon
#: lang/json/MONSTER_from_json.py
msgid ""
"A massive face cross-sectioned with large machinery; various tubes of "
"bubbling liquid bury themselves and reemerge from pustulating wounds.  Its "
"forehead has been removed, exposing a pulsating brain mass from which sound "
"emanates."
msgstr "A massive face cross-sectioned with large machinery; various tubes of bubbling liquid bury themselves and reemerge from pustulating wounds.  Its forehead has been removed, exposing a pulsating brain mass from which sound emanates."

#: lang/json/MONSTER_from_json.py
msgid "fungal boil"
msgstr "fungal boil"

#. ~ Description for fungal boil
#: lang/json/MONSTER_from_json.py
msgid "A quick-growing mass of spores, wafting around vague with purpose."
msgstr "A quick-growing mass of spores, wafting around vague with purpose."

#: lang/json/MONSTER_from_json.py
msgid "fungal cougar"
msgstr "fungal cougar"

#. ~ Description for fungal cougar
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern cougar, now an aspiring fungaloid.  Although it appears its "
"transformation has affected its agility some, it still bounds after targets "
"with savagery."
msgstr "The Eastern cougar, now an aspiring fungaloid.  Although it appears its transformation has affected its agility some, it still bounds after targets with savagery."

#. ~ Description for deer
#: lang/json/MONSTER_from_json.py
msgid ""
"A deer riddled with budding fungi.  Suicidally fast.  So fast you hardly "
"have time to recognize its affliction."
msgstr "A deer riddled with budding fungi.  Suicidally fast.  So fast you hardly have time to recognize its affliction."

#: lang/json/MONSTER_from_json.py
msgid "foose"
msgstr "foose"

#. ~ Description for foose
#: lang/json/MONSTER_from_json.py
msgid ""
"The 'foose' is an ill-tempered beast, fighting a battle it must inevitably "
"lose.  Occasionally it gives unearthly voice to its anguish."
msgstr "The 'foose' is an ill-tempered beast, fighting a battle it must inevitably lose.  Occasionally it gives unearthly voice to its anguish."

#. ~ Description for wolf
#: lang/json/MONSTER_from_json.py
msgid ""
"Whether wolf or dog, this canine is clearly sick.  The slavering of its "
"mouth is consistent, at least."
msgstr "Whether wolf or dog, this canine is clearly sick.  The slavering of its mouth is consistent, at least."

#: lang/json/MONSTER_from_json.py
msgid "fant"
msgstr "fant"

#. ~ Description for fant
#: lang/json/MONSTER_from_json.py
msgid ""
"Pale and sickly gray in color, it's hard to believe this ant is still alive,"
" much less moving to attack you."
msgstr "Pale and sickly gray in color, it's hard to believe this ant is still alive, much less moving to attack you."

#: lang/json/MONSTER_from_json.py
msgid "fungal tender"
msgstr "fungal tender"

#. ~ Description for fungal tender
#: lang/json/MONSTER_from_json.py
msgid ""
"A stout stalk of gray matter, this fungus pulls itself along with several "
"tipped tendrils.  Two of these tendrils are raised ominously when the "
"fungaloid finds a suitable host for its crop of spores."
msgstr "A stout stalk of gray matter, this fungus pulls itself along with several tipped tendrils.  Two of these tendrils are raised ominously when the fungaloid finds a suitable host for its crop of spores."

#: lang/json/MONSTER_from_json.py
msgid "infected tardigrade"
msgstr "infected tardigrade"

#. ~ Description for infected tardigrade
#: lang/json/MONSTER_from_json.py
msgid ""
"A giant water bear that is host to the fungal invasion.  Its body has "
"softened as a result of the infection, and its sensory tentacles have "
"lengthened significantly where fungal buds have formed.  Even as this gentle"
" beast ignores you the fungal tentacles seek new flesh to pollinate."
msgstr "A giant water bear that is host to the fungal invasion.  Its body has softened as a result of the infection, and its sensory tentacles have lengthened significantly where fungal buds have formed.  Even as this gentle beast ignores you the fungal tentacles seek new flesh to pollinate."

#: lang/json/MONSTER_from_json.py
msgid "fungal survivor"
msgstr "fungal survivor"

#. ~ Description for fungal survivor
#: lang/json/MONSTER_from_json.py
msgid ""
"An apparent survivor of the apocalypse, this individual has visibly active "
"fungal growth sprouting throughout their body.  Whatever individuality they "
"once held is completely subverted."
msgstr "An apparent survivor of the apocalypse, this individual has visibly active fungal growth sprouting throughout their body.  Whatever individuality they once held is completely subverted."

#: lang/json/MONSTER_from_json.py
msgid "infected survivor"
msgstr "infected survivor"

#. ~ Description for infected survivor
#: lang/json/MONSTER_from_json.py
msgid ""
"A survivor of the apocalypse, this individual is succumbing to their "
"infection; displaying paranoia, and incoherency.  Unpredictable and "
"terminally-ill, they will not respond to any attempts to communicate.  You "
"can't help but notice they still wear their armor and holster, despite the "
"fresh fungal budding that threatens to rip through it  . . ."
msgstr "A survivor of the apocalypse, this individual is succumbing to their infection; displaying paranoia, and incoherency.  Unpredictable and terminally-ill, they will not respond to any attempts to communicate.  You can't help but notice they still wear their armor and holster, despite the fresh fungal budding that threatens to rip through it  . . ."

#: lang/json/MONSTER_from_json.py
msgid "marloss man"
msgstr "marloss man"

#. ~ Description for marloss man
#: lang/json/MONSTER_from_json.py
msgid ""
"This survivor has willingly given their body to the fungus in some strange, "
"ill-described ritual.  As a result they have retained much of their "
"personality and hold unnatural abilities.  They don't seem interested in "
"talking to you; you cannot even discern their gender."
msgstr "This survivor has willingly given their body to the fungus in some strange, ill-described ritual.  As a result they have retained much of their personality and hold unnatural abilities.  They don't seem interested in talking to you; you cannot even discern their gender."

#: lang/json/MONSTER_from_json.py
msgid "fungal vinebeast"
msgstr "fungal vinebeast"

#. ~ Description for fungal vinebeast
#: lang/json/MONSTER_from_json.py
msgid ""
"A cluster of overgrown gray vines.  Most of its movements are sluggish and "
"reluctant, and most of its normally rapidly-growing vines now lie limp; "
"rupturing to release spores."
msgstr "A cluster of overgrown gray vines.  Most of its movements are sluggish and reluctant, and most of its normally rapidly-growing vines now lie limp; rupturing to release spores."

#: lang/json/MONSTER_from_json.py
msgid "fionaea"
msgstr "fionaea"

#. ~ Description for fionaea
#: lang/json/MONSTER_from_json.py
msgid ""
"Unlike its Triffid masters it lacks the anti-fungal compounds they possess."
"  Rendered crippled by the bulbous growths along its vines, this plant-"
"creature is large enough to suffer the growth and birth of man-sized walls "
"of fungus."
msgstr "Unlike its Triffid masters it lacks the anti-fungal compounds they possess.  Rendered crippled by the bulbous growths along its vines, this plant-creature is large enough to suffer the growth and birth of man-sized walls of fungus."

#: lang/json/MONSTER_from_json.py
msgid "fungal brood"
msgstr "fungal brood"

#. ~ Description for fungal brood
#: lang/json/MONSTER_from_json.py
msgid ""
"This plant's dry body is now host to moist fluid sacs that hang off "
"haphazardly; occasionally bursting into a cloud of haze."
msgstr "This plant's dry body is now host to moist fluid sacs that hang off haphazardly; occasionally bursting into a cloud of haze."

#: lang/json/MONSTER_from_json.py
msgid "fungal shocker"
msgstr "fungal shocker"

#. ~ Description for fungal shocker
#: lang/json/MONSTER_from_json.py
msgid ""
"A fungal Zombie with bionic implants, it uses its energy to harm others "
"despite the harm it can cause its own flesh."
msgstr "A fungal Zombie with bionic implants, it uses its energy to harm others despite the harm it can cause its own flesh."

#: lang/json/MONSTER_from_json.py
msgid "squig"
msgstr "squig"

#. ~ Description for squig
#: lang/json/MONSTER_from_json.py
msgid ""
"A large, astoundingly tough creature that used to be a dog or boar.  Its "
"massive maw takes up almost half its body.  Rows of teeth pushing older rows"
" forward; creating a jutting smile only made more terrifying by the beady "
"red eyes, socketed above behind the maw, looking down at its prey."
msgstr "A large, astoundingly tough creature that used to be a dog or boar.  Its massive maw takes up almost half its body.  Rows of teeth pushing older rows forward; creating a jutting smile only made more terrifying by the beady red eyes, socketed above behind the maw, looking down at its prey."

#: lang/json/MONSTER_from_json.py
msgid "tardigrade"
msgstr "tardigrade"

#. ~ Description for tardigrade
#: lang/json/MONSTER_from_json.py
msgid ""
"One of the most durable creatures in the world, the tardigrade has outlived "
"the dinosaurs and humanity both.  This is a plump and now moose-sized eight-"
"legged critter with a creviced shell with in-laid segments.  Along the "
"length of the shell pairs of sensory tentacles can be seen waving around.  "
"Although its clawed digits seem to be for grasping the tentacles, due to "
"their sheer size, lend themselves to flailing in defense."
msgstr "One of the most durable creatures in the world, the tardigrade has outlived the dinosaurs and humanity both.  This is a plump and now moose-sized eight-legged critter with a creviced shell with in-laid segments.  Along the length of the shell pairs of sensory tentacles can be seen waving around.  Although its clawed digits seem to be for grasping the tentacles, due to their sheer size, lend themselves to flailing in defense."

#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic spider with a bulbous thorax.  It digs an underground burrow that"
" serves as a pit to trap unwary prey."
msgstr "A gigantic spider with a bulbous thorax.  It digs an underground burrow that serves as a pit to trap unwary prey."

#: lang/json/MONSTER_from_json.py
msgid ""
"A still immature giant grass spider.  Too young to be truly venomous, or to "
"walk proficiently for that matter"
msgstr "A still immature giant grass spider.  Too young to be truly venomous, or to walk proficiently for that matter"

#: lang/json/MONSTER_from_json.py
msgid "huge wolf spider"
msgstr "huge wolf spider"

#. ~ Description for huge wolf spider
#: lang/json/MONSTER_from_json.py
msgid ""
"This wolf spider has grown to truly monstrous proportions.  Its venom is "
"relatively weak compared to its assault."
msgstr "This wolf spider has grown to truly monstrous proportions.  Its venom is relatively weak compared to its assault."

#: lang/json/MONSTER_from_json.py
msgid "large egg sack"
msgstr "large egg sack"

#. ~ Description for large egg sack
#: lang/json/MONSTER_from_json.py
msgid ""
"A large egg sack with periodically hatching eggs, and a few care-tenders.  "
"This one seems somehow more important than the rest."
msgstr "A large egg sack with periodically hatching eggs, and a few care-tenders.  This one seems somehow more important than the rest."

#: lang/json/MONSTER_from_json.py
msgid "egg sack"
msgstr "egg sack"

#. ~ Description for egg sack
#: lang/json/MONSTER_from_json.py
msgid "An egg sack with periodically hatching eggs."
msgstr "An egg sack with periodically hatching eggs."

#: lang/json/MONSTER_from_json.py
msgid "giant immature trapdoor spider"
msgstr "giant immature trapdoor spider"

#. ~ Description for giant immature trapdoor spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A small trapdoor spider.  Too small to hunt effectively on its own, the "
"loose commune of mutated trapdoor spiders offers limited protection from "
"predators, although it places the spider at increased risk of being "
"cannibalized."
msgstr "A small trapdoor spider.  Too small to hunt effectively on its own, the loose commune of mutated trapdoor spiders offers limited protection from predators, although it places the spider at increased risk of being cannibalized."

#: lang/json/MONSTER_from_json.py
msgid "alpha giant trapdoor spider"
msgstr "alpha giant trapdoor spider"

#. ~ Description for alpha giant trapdoor spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A large and heavily armored trapdoor spider.  Primarily found at the center "
"of larger congregations of trapdoor spiders that can keep it fed if food "
"becomes scarce."
msgstr "A large and heavily armored trapdoor spider.  Primarily found at the center of larger congregations of trapdoor spiders that can keep it fed if food becomes scarce."

#. ~ Description for giant trapdoor spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A gigantic, nimble spider with a bulbous thorax.  It digs a deep underground"
" burrow that serves as a pit from which to ambush unwary prey."
msgstr "A gigantic, nimble spider with a bulbous thorax.  It digs a deep underground burrow that serves as a pit from which to ambush unwary prey."

#. ~ Description for giant web spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A larger, more aggressive ambush predator, this web spider uses force to "
"catch its prey."
msgstr "A larger, more aggressive ambush predator, this web spider uses force to catch its prey."

#. ~ Description for giant web spider
#: lang/json/MONSTER_from_json.py
msgid ""
"This web spider uses long-lasting toxins to incapacitate stronger foes."
msgstr "This web spider uses long-lasting toxins to incapacitate stronger foes."

#. ~ Description for giant web spider
#: lang/json/MONSTER_from_json.py
msgid ""
"This web spider seems to have specialized to take down creatures infected "
"with fungal spores; a surely underutilized food source."
msgstr "This web spider seems to have specialized to take down creatures infected with fungal spores; a surely underutilized food source."

#: lang/json/MONSTER_from_json.py
msgid "medusa spider"
msgstr "medusa spider"

#. ~ Description for medusa spider
#: lang/json/MONSTER_from_json.py
msgid ""
"A spider the size of a large dog with slender forelegs and massive hind "
"legs.  From its maw corrosive saliva drips, and can be manipulated by its "
"agile limbs."
msgstr "A spider the size of a large dog with slender forelegs and massive hind legs.  From its maw corrosive saliva drips, and can be manipulated by its agile limbs."

#. ~ Description for giant bee
#: lang/json/MONSTER_from_json.py
msgid ""
"With a stinger the size of a kitchen knife, this dog-sized insect's black "
"and yellow markings warn you to leave it undisturbed.  Its fine coat of "
"bristles seems to attract electric charge."
msgstr "With a stinger the size of a kitchen knife, this dog-sized insect's black and yellow markings warn you to leave it undisturbed.  Its fine coat of bristles seems to attract electric charge."

#: lang/json/MONSTER_from_json.py
msgid "giant queen bee"
msgstr "giant queen bee"

#. ~ Description for giant queen bee
#: lang/json/MONSTER_from_json.py
msgid ""
"The queen bee, a typically unchallenged figure of dominance in bee society."
"  The fine coat of bristles along its abdomen seems to conduct electric "
"energy.  Without her, the hive would melt away, seeking death or a new "
"master."
msgstr "The queen bee, a typically unchallenged figure of dominance in bee society.  The fine coat of bristles along its abdomen seems to conduct electric energy.  Without her, the hive would melt away, seeking death or a new master."

#: lang/json/MONSTER_from_json.py
msgid "giant royal bee"
msgstr "giant royal bee"

#. ~ Description for giant royal bee
#: lang/json/MONSTER_from_json.py
msgid ""
"A fecund bee of unknown sex.  Although the queen potentially tolerates the "
"presence of other mating females within her hive, they are all her "
"offspring, and if conflict arises all but one will end up leaving"
msgstr "A fecund bee of unknown sex.  Although the queen potentially tolerates the presence of other mating females within her hive, they are all her offspring, and if conflict arises all but one will end up leaving"

#: lang/json/MONSTER_from_json.py
msgid "bee larvae"
msgstr "bee larvae"

#. ~ Description for bee larvae
#: lang/json/MONSTER_from_json.py
msgid ""
"A writhing mass of white flesh, this grub-like monster will mature based on "
"its diet; richer diets will result in a more noble caste."
msgstr "A writhing mass of white flesh, this grub-like monster will mature based on its diet; richer diets will result in a more noble caste."

#: lang/json/MONSTER_from_json.py lang/json/furniture_from_json.py
msgid "mannequin"
msgstr "mannequin"

#. ~ Description for mannequin
#: lang/json/MONSTER_from_json.py
msgid "It moves in spurts when you blink, or at least you think it does."
msgstr "It moves in spurts when you blink, or at least you think it does."

#. ~ Description for bear
#: lang/json/MONSTER_from_json.py
msgid ""
"The American black bear.  A large omnivorous scavenger, it has powerful "
"claws and jaws, and is an effective ambush hunter.  It can pose a "
"considerable threat, although most individuals are shy around humans.  This "
"one is confident in its stride."
msgstr "The American black bear.  A large omnivorous scavenger, it has powerful claws and jaws, and is an effective ambush hunter.  It can pose a considerable threat, although most individuals are shy around humans.  This one is confident in its stride."

#. ~ Description for bear
#: lang/json/MONSTER_from_json.py
msgid ""
"The American black bear.  A large omnivorous scavenger, it has powerful "
"claws and jaws, and is an effective ambush hunter.  It can pose a "
"considerable threat, although most individuals are shy around humans.  This "
"one has mottled fur and desperate, hungry eyes."
msgstr "The American black bear.  A large omnivorous scavenger, it has powerful claws and jaws, and is an effective ambush hunter.  It can pose a considerable threat, although most individuals are shy around humans.  This one has mottled fur and desperate, hungry eyes."

#. ~ Description for cougar
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern cougar, a large feline predator.  Once thought extinct in this "
"region, conservation efforts were successful in restoring a thriving "
"population.  This specimen is brimming with vigor."
msgstr "The Eastern cougar, a large feline predator.  Once thought extinct in this region, conservation efforts were successful in restoring a thriving population.  This specimen is brimming with vigor."

#. ~ Description for cougar
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern cougar, a large feline predator.  Once thought extinct in this "
"region, conservation efforts were successful in restoring a thriving "
"population.  Its eyes have a cloudy glaze to them."
msgstr "The Eastern cougar, a large feline predator.  Once thought extinct in this region, conservation efforts were successful in restoring a thriving population.  Its eyes have a cloudy glaze to them."

#: lang/json/MONSTER_from_json.py
msgid "large dog"
msgstr "large dog"

#. ~ Description for large dog
#: lang/json/MONSTER_from_json.py
msgid ""
"A large feral dog, with an equally impressive maw coated with stray saliva."
msgstr "A large feral dog, with an equally impressive maw coated with stray saliva."

#. ~ Description for moose
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern moose, the largest living species of deer.  The bulls are quite "
"ill-tempered, especially in the rutting season.  Its fur sheens with "
"majesty."
msgstr "The Eastern moose, the largest living species of deer.  The bulls are quite ill-tempered, especially in the rutting season.  Its fur sheens with majesty."

#. ~ Description for moose
#: lang/json/MONSTER_from_json.py
msgid ""
"The Eastern moose, the largest living species of deer.  The bulls are quite "
"ill-tempered, especially in the rutting season.  This one is clearly not the"
" aplha bull."
msgstr "The Eastern moose, the largest living species of deer.  The bulls are quite ill-tempered, especially in the rutting season.  This one is clearly not the aplha bull."

#: lang/json/MONSTER_from_json.py
msgid "skunk"
msgstr "skunk"

#. ~ Description for skunk
#: lang/json/MONSTER_from_json.py
msgid ""
"A small mammal with white stipped black fur that feeds on insects and fruit,"
" roots, and seeds.   Known to spray a foul smelling liquid if disturbed."
msgstr "A small mammal with white stipped black fur that feeds on insects and fruit, roots, and seeds.   Known to spray a foul smelling liquid if disturbed."

#: lang/json/MONSTER_from_json.py
msgid "goat"
msgstr "goat"

#. ~ Description for goat
#: lang/json/MONSTER_from_json.py
msgid ""
"A shaggy haired mammal with a clumsy grace and quiet nature.  Its grayish "
"white hair is motley in appearance and its horns are more for rutting and "
"courtship purposes than defense."
msgstr "A shaggy haired mammal with a clumsy grace and quiet nature.  Its grayish white hair is motley in appearance and its horns are more for rutting and courtship purposes than defense."

#: lang/json/MONSTER_from_json.py
msgid "sewer gator"
msgstr "sewer gator"

#. ~ Description for sewer gator
#: lang/json/MONSTER_from_json.py
msgid ""
"In the late 20th century there was an urban legend about pet alligators "
"getting flushed down the toilet and growing to adulthood in sewers.  This "
"large specimen doesn't look like it is used to humans as anything other than"
" a meal."
msgstr "In the late 20th century there was an urban legend about pet alligators getting flushed down the toilet and growing to adulthood in sewers.  This large specimen doesn't look like it is used to humans as anything other than a meal."

#: lang/json/MONSTER_from_json.py
msgid "elephant bear"
msgstr "elephant bear"

#. ~ Description for elephant bear
#: lang/json/MONSTER_from_json.py
msgid ""
"An absolutely enormous bear-like creature, with paws larger than your head."
"  A dedicated omnivore, it can sometimes decide to scavenge or attack "
"smaller animals; relying upon its thick hide to keep it safe."
msgstr "An absolutely enormous bear-like creature, with paws larger than your head.  A dedicated omnivore, it can sometimes decide to scavenge or attack smaller animals; relying upon its thick hide to keep it safe."

#. ~ Description for elephant bear
#: lang/json/MONSTER_from_json.py
msgid ""
"It appears that its megabear mating season.  It's probably best not to "
"disturb them.  Or get anywhere close them."
msgstr "It appears that its megabear mating season.  It's probably best not to disturb them.  Or get anywhere close them."

#: lang/json/MONSTER_from_json.py
msgid "juvenile elephant bear"
msgstr "juvenile elephant bear"

#. ~ Description for juvenile elephant bear
#: lang/json/MONSTER_from_json.py
msgid ""
"This young megabear hasn't yet developed the muscle or size of the adults, "
"but it would be mistake to think it was weak.  It may still be under its "
"mother's protection."
msgstr "This young megabear hasn't yet developed the muscle or size of the adults, but it would be mistake to think it was weak.  It may still be under its mother's protection."

#: lang/json/MONSTER_from_json.py
msgid "elephant bear cub"
msgstr "elephant bear cub"

#. ~ Description for elephant bear cub
#: lang/json/MONSTER_from_json.py
msgid ""
"A very young elephant bear, still too uncoordinated to walk proficently.  "
"With large eyes and bleating cries, this is the cutest car-sized thing that "
"ever would eat you."
msgstr "A very young elephant bear, still too uncoordinated to walk proficently.  With large eyes and bleating cries, this is the cutest car-sized thing that ever would eat you."

#: lang/json/MONSTER_from_json.py
msgid "dwarf coyote"
msgstr "dwarf coyote"

#. ~ Description for dwarf coyote
#: lang/json/MONSTER_from_json.py
msgid ""
"The downward pressure on the canines has produced smaller and more agile "
"versions.  These live in social communities and can be usually seen "
"tenaciously hunting for moles; dragging them out of their tunnels with paws "
"and elongated teeth.  It has also been known to aggressively raid "
"campgrounds."
msgstr "The downward pressure on the canines has produced smaller and more agile versions.  These live in social communities and can be usually seen tenaciously hunting for moles; dragging them out of their tunnels with paws and elongated teeth.  It has also been known to aggressively raid campgrounds."

#: lang/json/MONSTER_from_json.py
msgid ""
"A human body, but with its limbs impossibly twisted.  It clambers around "
"swiftly, making awful rasping moans."
msgstr "A human body, but with its limbs impossibly twisted.  It clambers around swiftly, making awful rasping moans."

#. ~ Description for jabberwock
#: lang/json/MONSTER_from_json.py
msgid ""
"A putrid amalgamation of body parts from humans and other creatures have "
"fused together in this aberration of flesh.  The eyes of all the heads dart "
"about rapidly and the mouths form a chorus of groaning screams.  Its coming "
"for you"
msgstr "A putrid amalgamation of body parts from humans and other creatures have fused together in this aberration of flesh.  The eyes of all the heads dart about rapidly and the mouths form a chorus of groaning screams.  Its coming for you"

#: lang/json/MONSTER_from_json.py
msgid "vampire bat"
msgstr "vampire bat"

#. ~ Description for vampire bat
#: lang/json/MONSTER_from_json.py
msgid ""
"A mutated bat with a narrow, proboscis-like snout.  After its pack stuns the"
" prey, it uses its teeth to gouge a hole into it and its slender tongue to "
"quickly lap up the resulting blood."
msgstr "A mutated bat with a narrow, proboscis-like snout.  After its pack stuns the prey, it uses its teeth to gouge a hole into it and its slender tongue to quickly lap up the resulting blood."

#: lang/json/MONSTER_from_json.py
msgid "scythed coyote"
msgstr "scythed coyote"

#. ~ Description for scythed coyote
#: lang/json/MONSTER_from_json.py
msgid ""
"It looks like a brown coyote with black streaks along its side.  Except "
"against either haunch rests a muscular folded limb terminating in a scythe-"
"like bony protrusion."
msgstr "It looks like a brown coyote with black streaks along its side.  Except against either haunch rests a muscular folded limb terminating in a scythe-like bony protrusion."

#: lang/json/MONSTER_from_json.py lang/json/TOOL_from_json.py
msgid "revenant rocket"
msgid_plural "revenant rockets"
msgstr[0] "revenant rocket"
msgstr[1] "revenant rockets"

#. ~ Description for revenant rocket
#: lang/json/MONSTER_from_json.py
msgid ""
"A revenant's homing missile, working its way towards you.  If only you could"
" disable it . . ."
msgstr "A revenant's homing missile, working its way towards you.  If only you could disable it . . ."

#: lang/json/MONSTER_from_json.py
msgid "firebomb hack"
msgstr "firebomb hack"

#. ~ Description for firebomb hack
#: lang/json/MONSTER_from_json.py
msgid "This manhack carries an incendiary explosive within its core."
msgstr "This manhack carries an incendiary explosive within its core."

#: lang/json/MONSTER_from_json.py
msgid "shock turret"
msgstr "shock turret"

#. ~ Description for shock turret
#: lang/json/MONSTER_from_json.py
msgid ""
"Taking the dense storage capacity of UPS to its logical conclusion, the PRD3"
" Mounted Shockcannon is a 'computer aided defense tool designed for repeling"
" crowds in a nonlethal manner'."
msgstr "Taking the dense storage capacity of UPS to its logical conclusion, the PRD3 Mounted Shockcannon is a 'computer aided defense tool designed for repeling crowds in a nonlethal manner'."

#: lang/json/MONSTER_from_json.py
msgid "crowned creeper"
msgstr "crowned creeper"

#. ~ Description for crowned creeper
#: lang/json/MONSTER_from_json.py
msgid ""
"A thick stalk with rapidly sprouting tendrils at the base and a 'crown' of "
"deep magenta pitchers at its head.  The pitchers taper into o-rings, "
"pointing at various angles away from the hub.  From the center of the crown "
"stems a single large, mace-like tentacle that flails around menacingly."
msgstr "A thick stalk with rapidly sprouting tendrils at the base and a 'crown' of deep magenta pitchers at its head.  The pitchers taper into o-rings, pointing at various angles away from the hub.  From the center of the crown stems a single large, mace-like tentacle that flails around menacingly."

#: lang/json/MONSTER_from_json.py
msgid "creeping grass"
msgstr "creeping grass"

#. ~ Description for creeping grass
#: lang/json/MONSTER_from_json.py
msgid ""
"A vine-like tendril that is rooted to the ground.  It flails about "
"constantly in a violent fashion for a time before disappearing into the "
"Earth."
msgstr "A vine-like tendril that is rooted to the ground.  It flails about constantly in a violent fashion for a time before disappearing into the Earth."

#: lang/json/MONSTER_from_json.py
msgid "glowing biollante"
msgstr "glowing biollante"

#. ~ Description for glowing biollante
#: lang/json/MONSTER_from_json.py
msgid ""
"A puckered flower is all that adorns the stalk of this biollante.  Beneath "
"its luminescent petals, something rigid appears to be moving, and consistent"
" wisps of gas can be seen escaping into the surrounding air."
msgstr "A puckered flower is all that adorns the stalk of this biollante.  Beneath its luminescent petals, something rigid appears to be moving, and consistent wisps of gas can be seen escaping into the surrounding air."

#. ~ Description for creeping grass
#: lang/json/MONSTER_from_json.py
msgid ""
"A vine-like tendril that is rooted to the ground.  This one is behaving "
"oddly."
msgstr "A vine-like tendril that is rooted to the ground.  This one is behaving oddly."

#: lang/json/MONSTER_from_json.py
msgid "creeping vine"
msgstr "creeping vine"

#. ~ Description for creeping vine
#: lang/json/MONSTER_from_json.py
msgid ""
"A long thorned length of line the width of your wrist found tunneling "
"through the shallow dirt.  Appears to act of its own accord."
msgstr "A long thorned length of line the width of your wrist found tunneling through the shallow dirt.  Appears to act of its own accord."

#. ~ Description for creeping vine
#: lang/json/MONSTER_from_json.py
msgid ""
"A long thorned length of line the width of your wrist found tunneling "
"through the shallow dirt.  Acts in a chaotic manner."
msgstr "A long thorned length of line the width of your wrist found tunneling through the shallow dirt.  Acts in a chaotic manner."

#: lang/json/MONSTER_from_json.py
msgid "slithering root"
msgstr "slithering root"

#. ~ Description for slithering root
#: lang/json/MONSTER_from_json.py
msgid ""
"A twisting cluster of roots, with 3 barbed vines curled limply around a "
"wildly cluster of smaller vines.  When disturbed, it can release several of "
"these vines."
msgstr "A twisting cluster of roots, with 3 barbed vines curled limply around a wildly cluster of smaller vines.  When disturbed, it can release several of these vines."

#. ~ Description for vine beast
#: lang/json/MONSTER_from_json.py
msgid ""
"An animated mass of roots and vines, creeping along the ground with alarming"
" speed.  The tangle is thick enough that the center from which they grow is "
"concealed.  This one looks tough."
msgstr "An animated mass of roots and vines, creeping along the ground with alarming speed.  The tangle is thick enough that the center from which they grow is concealed.  This one looks tough."

#: lang/json/MONSTER_from_json.py
msgid "tangala"
msgstr "tangala"

#. ~ Description for tangala
#: lang/json/MONSTER_from_json.py
msgid ""
"A walking mass of vines.  Its body concealed in writhing vines, this deadly "
"monster is a meter or so from being pocket-sized, but carries several deadly"
" toxins within it."
msgstr "A walking mass of vines.  Its body concealed in writhing vines, this deadly monster is a meter or so from being pocket-sized, but carries several deadly toxins within it."

#. ~ Description for triffid
#: lang/json/MONSTER_from_json.py
msgid ""
"A creeping animate plant, growing as tall as a moose.  It has a single bark-"
"covered stalk supporting a flowery head with a paralyzing sting concealed "
"within.  This one looks tough."
msgstr "A creeping animate plant, growing as tall as a moose.  It has a single bark-covered stalk supporting a flowery head with a paralyzing sting concealed within.  This one looks tough."

#: lang/json/MONSTER_from_json.py
msgid "blue aurora"
msgstr "blue aurora"

#. ~ Description for blue aurora
#: lang/json/MONSTER_from_json.py
msgid ""
"A massive slab of bark with faintly glowing flattened blue tendrils and "
"large brown cones instead of leaves.  It looks 'sort' of like a tree in that"
" the tendrils are thickest at the base of the monster and taper into thin, "
"densely packed slivers at the top.  Its actually almost beautiful at night, "
"where it can be seen from a distance pulsating among the tallest tree."
msgstr "A massive slab of bark with faintly glowing flattened blue tendrils and large brown cones instead of leaves.  It looks 'sort' of like a tree in that the tendrils are thickest at the base of the monster and taper into thin, densely packed slivers at the top.  Its actually almost beautiful at night, where it can be seen from a distance pulsating among the tallest tree."

#: lang/json/MONSTER_from_json.py
msgid "treunt"
msgstr "treunt"

#. ~ Description for treunt
#: lang/json/MONSTER_from_json.py
msgid ""
"A monster resembling a healthy young tree.  With a little effort, the "
"triffids seem to have produced a guardian that blends into the forest.  Its "
"poisonous barbs are visible upon close examination, but otherwise its not a "
"bad disguise."
msgstr "A monster resembling a healthy young tree.  With a little effort, the triffids seem to have produced a guardian that blends into the forest.  Its poisonous barbs are visible upon close examination, but otherwise its not a bad disguise."

#: lang/json/MONSTER_from_json.py
msgid "dionaea sprout"
msgstr "dionaea sprout"

#. ~ Description for dionaea sprout
#: lang/json/MONSTER_from_json.py
msgid ""
"An animate plant a little under 2 meters long, this juvenile still packs a "
"wallop with its fetid mouth."
msgstr "An animate plant a little under 2 meters long, this juvenile still packs a wallop with its fetid mouth."

#: lang/json/MONSTER_from_json.py
msgid "dionaea"
msgstr "dionaea"

#. ~ Description for dionaea
#: lang/json/MONSTER_from_json.py
msgid ""
"A rotund armored 'head' with a massive maw dominates this monster's form.  "
"Its head hangs low when its not in use, saving energy for its coordinated "
"slither along the ground."
msgstr "A rotund armored 'head' with a massive maw dominates this monster's form.  Its head hangs low when its not in use, saving energy for its coordinated slither along the ground."

#: lang/json/MONSTER_from_json.py
msgid "hissing brood"
msgstr "hissing brood"

#. ~ Description for hissing brood
#: lang/json/MONSTER_from_json.py
msgid ""
"a dried up shrub with rustling brown leaves adept at ambushes.  Highly "
"volatile and easily excited."
msgstr "a dried up shrub with rustling brown leaves adept at ambushes.  Highly volatile and easily excited."

#: lang/json/MONSTER_from_json.py
msgid "charged hissing brood"
msgstr "charged hissing brood"

#. ~ Description for charged hissing brood
#: lang/json/MONSTER_from_json.py
msgid ""
"Somehow this dessicated plant has become charged up with some lightning?  "
"Probably not good for nearby electronic devices. . ."
msgstr "Somehow this dessicated plant has become charged up with some lightning?  Probably not good for nearby electronic devices. . ."

#: lang/json/MONSTER_from_json.py
msgid "zombie horse"
msgstr "zombie horse"

#. ~ Description for zombie horse
#: lang/json/MONSTER_from_json.py
msgid ""
"This horse has a brackish liquid coating its bared teeth, as well as the "
"occasional oozing wounds breaking the otherwise glorious sheen of its hair."
"  Its hooves are fearsome weapons."
msgstr "This horse has a brackish liquid coating its bared teeth, as well as the occasional oozing wounds breaking the otherwise glorious sheen of its hair.  Its hooves are fearsome weapons."

#: lang/json/MONSTER_from_json.py
msgid "zombie chaser"
msgstr "zombie chaser"

#. ~ Description for zombie chaser
#: lang/json/MONSTER_from_json.py
msgid ""
"Its fur pulled taunt and dyed a faint green, this once-dog is now an "
"accomplished pack hunter."
msgstr "Its fur pulled taunt and dyed a faint green, this once-dog is now an accomplished pack hunter."

#: lang/json/MONSTER_from_json.py
msgid "hell hound"
msgstr "hell hound"

#. ~ Description for hell hound
#: lang/json/MONSTER_from_json.py
msgid ""
"Through its smoke you can make out a lithe, tightly wound frame.  From time "
"to time it emits a coarse, rumbling howl that sounds like it came from the "
"bowels of the Earth."
msgstr "Through its smoke you can make out a lithe, tightly wound frame.  From time to time it emits a coarse, rumbling howl that sounds like it came from the bowels of the Earth."

#: lang/json/MONSTER_from_json.py
msgid "zombie hunting dog"
msgstr "zombie hunting dog"

#. ~ Description for zombie hunting dog
#: lang/json/MONSTER_from_json.py
msgid ""
"This engorged dog sloshes audibly as it erratically leaps after new prey.  "
"Its rubbery body appears to both slow it down some and resist blunt trauma."
msgstr "This engorged dog sloshes audibly as it erratically leaps after new prey.  Its rubbery body appears to both slow it down some and resist blunt trauma."

#. ~ Description for zombie kinderling
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny, still-smoldering body, jumping and kicking and flailing around in a "
"mockery of playground exercise.  It does not need a face for you to feel bad"
" about killing it."
msgstr "A tiny, still-smoldering body, jumping and kicking and flailing around in a mockery of playground exercise.  It does not need a face for you to feel bad about killing it."

#. ~ Description for scorched zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Heavily burned zombie that still reeks of charred flesh.  Its skin has "
"hardened and cracked in several areas."
msgstr "Heavily burned zombie that still reeks of charred flesh.  Its skin has hardened and cracked in several areas."

#. ~ Description for fiend
#: lang/json/MONSTER_from_json.py
msgid ""
"Charred zombie with bony plates, spikes and protursions.  Moves stiffly "
"about."
msgstr "Charred zombie with bony plates, spikes and protursions.  Moves stiffly about."

#. ~ Description for scorched zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Heavily burned zombie that still reeks of charred flesh.  Its skin has "
"hardened and cracked in several areas.  From various wounds a faint "
"crackling can be seen."
msgstr "Heavily burned zombie that still reeks of charred flesh.  Its skin has hardened and cracked in several areas.  From various wounds a faint crackling can be seen."

#. ~ Description for fiend
#: lang/json/MONSTER_from_json.py
msgid ""
"Charred zombie with bony plates, spikes and protrusions.  Moves stiffly "
"about."
msgstr "Charred zombie with bony plates, spikes and protrusions.  Moves stiffly about."

#. ~ Description for fiend
#: lang/json/MONSTER_from_json.py
msgid ""
"Charred zombie with bony plates, spikes and protrusions.  Moves stiffly "
"about.  Occasionally small bursts of electricity arch from its hands."
msgstr "Charred zombie with bony plates, spikes and protrusions.  Moves stiffly about.  Occasionally small bursts of electricity arch from its hands."

#: lang/json/MONSTER_from_json.py
msgid "gutted zombie"
msgstr "gutted zombie"

#. ~ Description for gutted zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Burned to the point of near blob-exsanguination, this weak zombie is hardly "
"a threat to anything."
msgstr "Burned to the point of near blob-exsanguination, this weak zombie is hardly a threat to anything."

#. ~ Description for gutted zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"Burned to the point of blob-exsanguination, this weak zombie is hardly a "
"threat to anything."
msgstr "Burned to the point of blob-exsanguination, this weak zombie is hardly a threat to anything."

#: lang/json/MONSTER_from_json.py
msgid "zombie abomination"
msgstr "zombie abomination"

#. ~ Description for zombie abomination
#: lang/json/MONSTER_from_json.py
msgid ""
"An encrusted humanoid mass so blackened by fire only the simmering of the "
"liquid oozing from its wounds indicate damage.  Still seems capable of "
"supporting its horde despite it weakened state."
msgstr "An encrusted humanoid mass so blackened by fire only the simmering of the liquid oozing from its wounds indicate damage.  Still seems capable of supporting its horde despite it weakened state."

#. ~ Description for zombie abomination
#: lang/json/MONSTER_from_json.py
msgid ""
"An encrusted humanoid mass so blackened by fire only the simmering of the "
"liquid oozing from its wounds indicate damage.  Still seems capable of "
"controlling its horde despite it weakened state."
msgstr "An encrusted humanoid mass so blackened by fire only the simmering of the liquid oozing from its wounds indicate damage.  Still seems capable of controlling its horde despite it weakened state."

#: lang/json/MONSTER_from_json.py
msgid "burned child zombie"
msgstr "burned child zombie"

#. ~ Description for burned child zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A tiny, horribly charred body, jumping and kicked and flailing around in a "
"mockery of playground exercise.  It does not need a face for you to feel bad"
" about killing it."
msgstr "A tiny, horribly charred body, jumping and kicked and flailing around in a mockery of playground exercise.  It does not need a face for you to feel bad about killing it."

#: lang/json/MONSTER_from_json.py
msgid "hooved horror"
msgstr "hooved horror"

#. ~ Description for hooved horror
#: lang/json/MONSTER_from_json.py
msgid ""
"Blackened hooves adorn the charred limbs of this monstrous being.  It "
"lumbers after prey with horrifying  speed, snuffing them out with brutal "
"force."
msgstr "Blackened hooves adorn the charred limbs of this monstrous being.  It lumbers after prey with horrifying  speed, snuffing them out with brutal force."

#: lang/json/MONSTER_from_json.py
msgid "torrid beast"
msgstr "torrid beast"

#. ~ Description for torrid beast
#: lang/json/MONSTER_from_json.py
msgid ""
"A scorched, chaotic mass of flesh, squirming and writhing to slowly work its"
" way across the ground.  A couple of bony scythes have ruptured out of the "
"pile and wave around erratically as it nears."
msgstr "A scorched, chaotic mass of flesh, squirming and writhing to slowly work its way across the ground.  A couple of bony scythes have ruptured out of the pile and wave around erratically as it nears."

#: lang/json/MONSTER_from_json.py
msgid "putrid pile"
msgstr "putrid pile"

#. ~ Description for putrid pile
#: lang/json/MONSTER_from_json.py
msgid ""
"An appaling black mass of flowing crusted flesh, the liquid of this beast "
"seems to be more fleeing than flowing, such as rats on a sinking ship."
msgstr "An appaling black mass of flowing crusted flesh, the liquid of this beast seems to be more fleeing than flowing, such as rats on a sinking ship."

#: lang/json/MONSTER_from_json.py
msgid "putrified pile"
msgstr "putrified pile"

#. ~ Description for putrified pile
#: lang/json/MONSTER_from_json.py
msgid ""
"An appaling black mass of flowing crusted flesh, flailing helplessly about."
msgstr "An appaling black mass of flowing crusted flesh, flailing helplessly about."

#: lang/json/MONSTER_from_json.py
msgid "zombie megabear"
msgstr "zombie megabear"

#. ~ Description for zombie megabear
#: lang/json/MONSTER_from_json.py
msgid ""
"Although the elephant bears seem much more capable of avoiding death at the "
"hands of zombies, a few do fall.  Several humanoid zombies can fit into its "
"mere shadow."
msgstr "Although the elephant bears seem much more capable of avoiding death at the hands of zombies, a few do fall.  Several humanoid zombies can fit into its mere shadow."

#: lang/json/MONSTER_from_json.py
msgid "maimed zombie"
msgstr "maimed zombie"

#. ~ Description for maimed zombie
#: lang/json/MONSTER_from_json.py
msgid "A once-lame human, now a lame zombie."
msgstr "A once-lame human, now a lame zombie."

#: lang/json/MONSTER_from_json.py
msgid "blind zombie"
msgstr "blind zombie"

#. ~ Description for blind zombie
#: lang/json/MONSTER_from_json.py
msgid "A human corpse, filled with a blind rage."
msgstr "A human corpse, filled with a blind rage."

#: lang/json/MONSTER_from_json.py
msgid "Unseeing zombie"
msgstr "Unseeing zombie"

#. ~ Description for Unseeing zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A human corpse, filled with an uncanny agility.  Its pupilless, blind eyes "
"gaze blankly and belie its grace and other perceptions."
msgstr "A human corpse, filled with an uncanny agility.  Its pupilless, blind eyes gaze blankly and belie its grace and other perceptions."

#: lang/json/MONSTER_from_json.py
msgid "hungry zombie"
msgstr "hungry zombie"

#. ~ Description for hungry zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A human body that seems to have . . . tightened into something more "
"dangerous.  While it still stumbles around slowly, there is little doubt "
"about what it would do to you if you let it."
msgstr "A human body that seems to have . . . tightened into something more dangerous.  While it still stumbles around slowly, there is little doubt about what it would do to you if you let it."

#: lang/json/MONSTER_from_json.py
msgid "zombie nadir"
msgstr "zombie nadir"

#. ~ Description for zombie nadir
#: lang/json/MONSTER_from_json.py
msgid ""
"With empty black sockets this creature surveys its surroundings "
"deliberately.  As it scans, its body pulsates and contorts in a fashion that"
" should break most bones."
msgstr "With empty black sockets this creature surveys its surroundings deliberately.  As it scans, its body pulsates and contorts in a fashion that should break most bones."

#: lang/json/MONSTER_from_json.py
msgid "scabby zombie"
msgstr "scabby zombie"

#. ~ Description for scabby zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A deformed human body, its skin has been transformed into one thick, "
"calloused envelope of scar tissue.  Its tissues secrete an oozing liquid "
"that smells like poisonous death."
msgstr "A deformed human body, its skin has been transformed into one thick, calloused envelope of scar tissue.  Its tissues secrete an oozing liquid that smells like poisonous death."

#: lang/json/MONSTER_from_json.py
msgid "zombie scrapper"
msgstr "zombie scrapper"

#. ~ Description for zombie scrapper
#: lang/json/MONSTER_from_json.py
msgid ""
"Although it has the face of a child, its knuckles bear oozing calluses.  It "
"appears to take joy in combat, evident by a slick smile and a gleam in its "
"eye..."
msgstr "Although it has the face of a child, its knuckles bear oozing calluses.  It appears to take joy in combat, evident by a slick smile and a gleam in its eye..."

#: lang/json/MONSTER_from_json.py
msgid "zombie reaver"
msgstr "zombie reaver"

#. ~ Description for zombie reaver
#: lang/json/MONSTER_from_json.py
msgid ""
"Its face disfigured and scabbed over, this foul child-sized corpse has been "
"forged through constant combat, imbibing it with remarkable agility, speed, "
"and savage brutality.  It bears scars that indicate that this isn't the "
"first (or second) time it has died."
msgstr "Its face disfigured and scabbed over, this foul child-sized corpse has been forged through constant combat, imbibing it with remarkable agility, speed, and savage brutality.  It bears scars that indicate that this isn't the first (or second) time it has died."

#: lang/json/MONSTER_from_json.py
msgid "sparker zombie"
msgstr "sparker zombie"

#. ~ Description for sparker zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"As this zombie began to deform like the other zombies, its bionics have "
"become unstable and unreliable."
msgstr "As this zombie began to deform like the other zombies, its bionics have become unstable and unreliable."

#: lang/json/MONSTER_from_json.py
msgid ""
"A distorted human body with sleek muscles.  Its jaws have elongated into a "
"ursine-like snout, dripping with foul smelling saliva."
msgstr "A distorted human body with sleek muscles.  Its jaws have elongated into a ursine-like snout, dripping with foul smelling saliva."

#: lang/json/MONSTER_from_json.py
msgid "shadowed zombie"
msgstr "shadowed zombie"

#. ~ Description for shadowed zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A ropey humanoid figure with a shimmering silhouette, even in full light.  "
"It moves like a zombie, but you can tell nothing more than that."
msgstr "A ropey humanoid figure with a shimmering silhouette, even in full light.  It moves like a zombie, but you can tell nothing more than that."

#: lang/json/MONSTER_from_json.py
msgid "ethereal zombie"
msgstr "ethereal zombie"

#. ~ Description for ethereal zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"The permanent shadow around this gaunt figure makes it hard to make out.  "
"What you can see appears translucent and shimmering.  It is disoriented in "
"light, and actively avoids fire."
msgstr "The permanent shadow around this gaunt figure makes it hard to make out.  What you can see appears translucent and shimmering.  It is disoriented in light, and actively avoids fire."

#: lang/json/MONSTER_from_json.py
msgid "zombie lord"
msgstr "zombie lord"

#. ~ Description for zombie lord
#: lang/json/MONSTER_from_json.py
msgid ""
"Standing with erect back and mocking smile, this graceful zombie appears to "
"actually direct nearby zombies with glares and the twitching of its jagged "
"claws.  Its skin is a revolting shade of pink, and every once in a while it "
"stops what it is doing to excrete a few gooey, animate blobs."
msgstr "Standing with erect back and mocking smile, this graceful zombie appears to actually direct nearby zombies with glares and the twitching of its jagged claws.  Its skin is a revolting shade of pink, and every once in a while it stops what it is doing to excrete a few gooey, animate blobs."

#. ~ Description for swimmer zombie
#: lang/json/MONSTER_from_json.py
msgid "This web-footed swimmer sways in a restless but predatory manner."
msgstr "This web-footed swimmer sways in a restless but predatory manner."

#: lang/json/MONSTER_from_json.py
msgid "encrusted zombie"
msgstr "encrusted zombie"

#. ~ Description for encrusted zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"This zombie seems to be more comfortable in water than out.  Its skin has "
"hardened into a flaky chitinous layer, and its ponderous movements belie its"
" hostility."
msgstr "This zombie seems to be more comfortable in water than out.  Its skin has hardened into a flaky chitinous layer, and its ponderous movements belie its hostility."

#: lang/json/MONSTER_from_json.py
msgid "rotting zombie"
msgstr "rotting zombie"

#. ~ Description for rotting zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A corpse that rots even as it moves to kill.  Swarms of flies dart in and "
"out of this monsters many bloated and oozing wounds.."
msgstr "A corpse that rots even as it moves to kill.  Swarms of flies dart in and out of this monsters many bloated and oozing wounds.."

#: lang/json/MONSTER_from_json.py
msgid "zombie mangler"
msgstr "zombie mangler"

#. ~ Description for zombie mangler
#: lang/json/MONSTER_from_json.py
msgid ""
"Its skin stretched so tight as to have split in several places, this once-"
"human corpse bears bones jutting out at unnatural angles."
msgstr "Its skin stretched so tight as to have split in several places, this once-human corpse bears bones jutting out at unnatural angles."

#: lang/json/MONSTER_from_json.py
msgid "zombie husk"
msgstr "zombie husk"

#. ~ Description for zombie husk
#: lang/json/MONSTER_from_json.py
msgid ""
"So desiccated that it makes sounds like rustling leaves as it shuffles "
"aimlessly, this abomination is hardly more than a tanned hide pulled over a "
"bone frame.  What flesh it does have seems to be devoted to the perception "
"of prey; at which it launches itself at with abandon."
msgstr "So desiccated that it makes sounds like rustling leaves as it shuffles aimlessly, this abomination is hardly more than a tanned hide pulled over a bone frame.  What flesh it does have seems to be devoted to the perception of prey; at which it launches itself at with abandon."

#: lang/json/MONSTER_from_json.py
msgid "shambling zombie"
msgstr "shambling zombie"

#. ~ Description for shambling zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A prone body propped up on outstretched arms; with oozing cracks along its "
"fire-hardened skin.  Sticky sludge escapes from holes in its chest cavity "
"where the friction of crawling has torn through."
msgstr "A prone body propped up on outstretched arms; with oozing cracks along its fire-hardened skin.  Sticky sludge escapes from holes in its chest cavity where the friction of crawling has torn through."

#: lang/json/MONSTER_from_json.py
msgid "shambler"
msgstr "shambler"

#. ~ Description for shambler
#: lang/json/MONSTER_from_json.py
msgid ""
"A prone humanoidesque monster, engorged to the size of 3 men, that springs "
"forward with a sickening sucking sound.  As it consumes bodies and materials"
" from the ground it becomes stronger and produces several blobs."
msgstr "A prone humanoidesque monster, engorged to the size of 3 men, that springs forward with a sickening sucking sound.  As it consumes bodies and materials from the ground it becomes stronger and produces several blobs."

#: lang/json/MONSTER_from_json.py
msgid "zombie tank"
msgstr "zombie tank"

#. ~ Description for zombie tank
#: lang/json/MONSTER_from_json.py
msgid ""
"Rumored to be the conjoining of several bodies, the massive Zombie Tank is "
"perhaps the ultimate tool of destruction.  Making up for what it lacks in "
"skill with brutality, it is the wrecking ball of the zombie scourge."
msgstr "Rumored to be the conjoining of several bodies, the massive Zombie Tank is perhaps the ultimate tool of destruction.  Making up for what it lacks in skill with brutality, it is the wrecking ball of the zombie scourge."

#: lang/json/MONSTER_from_json.py
msgid "putrid zombie"
msgstr "putrid zombie"

#. ~ Description for putrid zombie
#: lang/json/MONSTER_from_json.py
msgid ""
"A fetid body with a featureless face that emits a noxious gas of unknown "
"makeup.  Its skin knots and reforms into putty-like globs as it walks and "
"attacks, and bullets seem to pass through its morphing form.  A glimmering "
"sludge drips from its open mouth."
msgstr "A fetid body with a featureless face that emits a noxious gas of unknown makeup.  Its skin knots and reforms into putty-like globs as it walks and attacks, and bullets seem to pass through its morphing form.  A glimmering sludge drips from its open mouth."

