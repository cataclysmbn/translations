"Albuterol inhaler.  Used in the treatment of bronchospasm, it is a lifeline "
"for people with asthma.  A mild stimulant, it may cause nervousness or "
"tremors."
msgstr "Albuterol inhaler.  Used in the treatment of bronchospasm, it is a lifeline for people with asthma.  A mild stimulant, it may cause nervousness or tremors."

#: lang/json/TOOL_from_json.py
msgid "bottle jack"
msgid_plural "bottle jacks"
msgstr[0] "bottle jack"
msgstr[1] "bottle jacks"

#. ~ Description for bottle jack
#: lang/json/TOOL_from_json.py
msgid "A portable hydraulic bottle jack used for lifting vehicles."
msgstr "A portable hydraulic bottle jack used for lifting vehicles."

#: lang/json/TOOL_from_json.py
msgid "makeshift jack"
msgid_plural "makeshift jacks"
msgstr[0] "makeshift jack"
msgstr[1] "makeshift jacks"

#. ~ Description for makeshift jack
#: lang/json/TOOL_from_json.py
msgid ""
"A poorly constructed improvised scissor jack used for lifting vehicles if "
"you're brave enough to use it."
msgstr "A poorly constructed improvised scissor jack used for lifting vehicles if you're brave enough to use it."

#: lang/json/TOOL_from_json.py
