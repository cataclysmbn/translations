msgid "flammenschwert (an)"
msgid_plural "flammenschwerter (an)"
msgstr[0] "flammenschwert (an)"
msgstr[1] "flammenschwerter (an)"

#. ~ Use action charges_extinguish_message for flammenschwert (an).
