msgid_plural "noise emitters (off)"
msgstr[0] "noise emitter (off)"
msgstr[1] "noise emitters (off)"

#. ~ Description for noise emitter (off)
#: lang/json/TOOL_from_json.py
msgid ""
"This device was constructed by 'enhancing' a radio with some amplifier "
"circuits.  It's completely lost its ability to pick up a station, but it's "
"nice and loud now.  It could be useful to distract zombies."
msgstr "This device was constructed by 'enhancing' a radio with some amplifier circuits.  It's completely lost its ability to pick up a station, but it's nice and loud now.  It could be useful to distract zombies."

#: lang/json/TOOL_from_json.py
msgid "noise emitter (on)"
msgid_plural "noise emitters (on)"
msgstr[0] "noise emitter (on)"
msgstr[1] "noise emitters (on)"

#. ~ Description for noise emitter (on)
#: lang/json/TOOL_from_json.py
msgid ""
"This device has been turned on and is emitting horrible sounds of radio "
"static.  Quick, get away from it before it draws zombies to you!"
msgstr "This device has been turned on and is emitting horrible sounds of radio static.  Quick, get away from it before it draws zombies to you!"

#: lang/json/TOOL_from_json.py
msgid "lamp oil cooker"
msgid_plural "lamp oil cookers"
msgstr[0] "lamp oil cooker"
msgstr[1] "lamp oil cookers"

#. ~ Description for lamp oil cooker
#: lang/json/TOOL_from_json.py
msgid ""
"This is a simple heater powered by lamp oil.  It is designed for cooking "
"food."
msgstr "This is a simple heater powered by lamp oil.  It is designed for cooking food."

