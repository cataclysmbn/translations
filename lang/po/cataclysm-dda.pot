msgid "active flare"
msgid_plural "active flares"
msgstr[0] "active flare"
msgstr[1] "active flares"

#. ~ Description for active flare
#: lang/json/TOOL_from_json.py
msgid ""
"This burning magnesium flare is producing light.  It will last for about a "
"half hour before burning out."
msgstr "This burning magnesium flare is producing light.  It will last for about a half hour before burning out."

#: lang/json/TOOL_from_json.py
msgid "heavy duty flashlight (off)"
msgid_plural "heavy duty flashlights (off)"
msgstr[0] "heavy duty flashlight (off)"
msgstr[1] "heavy duty flashlights (off)"

#. ~ Use action msg for heavy duty flashlight (off).
#: lang/json/TOOL_from_json.py
msgid "You turn the heavy duty flashlight on."
msgstr "You turn the heavy duty flashlight on."

#. ~ Use action need_charges_msg for heavy duty flashlight (off).
#: lang/json/TOOL_from_json.py
msgid "The heavy duty flashlight's batteries are dead."
msgstr "The heavy duty flashlight's batteries are dead."

#. ~ Description for heavy duty flashlight (off)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a heavy duty tubular aluminum LED flashlight as often used by "
"security guards.  Makes for a passable melee weapon.  Using this flashlight "
"will turn it on and provide light, assuming it is charged with batteries."
msgstr "This is a heavy duty tubular aluminum LED flashlight as often used by security guards.  Makes for a passable melee weapon.  Using this flashlight will turn it on and provide light, assuming it is charged with batteries."

#: lang/json/TOOL_from_json.py
msgid "heavy duty flashlight (on)"
msgid_plural "heavy duty flashlights (on)"
msgstr[0] "heavy duty flashlight (on)"
msgstr[1] "heavy duty flashlights (on)"

#. ~ Use action msg for heavy duty flashlight (on).
#: lang/json/TOOL_from_json.py
