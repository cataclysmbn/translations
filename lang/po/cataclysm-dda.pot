msgstr "A remote control for RC cars, with joystick to steer the car and colorful buttons that don't seem to do anything.  Perhaps they were for the deluxe model?"

#: lang/json/TOOL_from_json.py
msgid "rag"
msgid_plural "rags"
msgstr[0] "rag"
msgstr[1] "rags"

#. ~ Description for rag
#: lang/json/TOOL_from_json.py
msgid ""
"This is a largish piece of cloth, useful in crafting and possibly for "
"staunching bleeding."
msgstr "This is a largish piece of cloth, useful in crafting and possibly for staunching bleeding."

#. ~ Description for rapier
#: lang/json/TOOL_from_json.py
msgid ""
"This is a thin sword with an ornate hand guard.  It looks like the preferred"
" weapon of gentlemen and swashbucklers.  Light and quick, it makes any "
"battle a stylish battle."
msgstr "This is a thin sword with an ornate hand guard.  It looks like the preferred weapon of gentlemen and swashbucklers.  Light and quick, it makes any battle a stylish battle."

#: lang/json/TOOL_from_json.py
msgid "refillable lighter"
msgid_plural "refillable lighters"
msgstr[0] "refillable lighter"
msgstr[1] "refillable lighters"

#. ~ Use action msg for refillable lighter.
#: lang/json/TOOL_from_json.py
msgid "You flick the lighter."
msgstr "You flick the lighter."

#. ~ Use action need_charges_msg for refillable lighter.
#: lang/json/TOOL_from_json.py src/game.cpp src/gates.cpp src/gates.cpp
#: src/iexamine.cpp src/iexamine.cpp
msgid "Nothing happens."
msgstr "Nothing happens."

#. ~ Description for refillable lighter
#: lang/json/TOOL_from_json.py
msgid ""
"This is a lighter featuring a flip top cover and refuelable tank.  A lighter"
" must be carried to use various drugs, like cigarettes, or to light things "
"like Molotov cocktails.  You can also use a lighter to light nearby items on"
" fire."
msgstr "This is a lighter featuring a flip top cover and refuelable tank.  A lighter must be carried to use various drugs, like cigarettes, or to light things like Molotov cocktails.  You can also use a lighter to light nearby items on fire."

#: lang/json/TOOL_from_json.py
msgid "refillable lighter (lit)"
msgid_plural "refillable lighters (lit)"
msgstr[0] "refillable lighter (lit)"
msgstr[1] "refillable lighters (lit)"

#. ~ Use action msg for refillable lighter (lit).
#: lang/json/TOOL_from_json.py
msgid "You extinguish the lighter."
msgstr "You extinguish the lighter."

#. ~ Description for refillable lighter (lit)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a lighter featuring a flip top cover and refuelable tank.  It is "
"lit."
msgstr "This is a lighter featuring a flip top cover and refuelable tank.  It is lit."

#: lang/json/TOOL_from_json.py
msgid "remote vehicle controller"
msgid_plural "remote vehicle controllers"
msgstr[0] "remote vehicle controller"
msgstr[1] "remote vehicle controllers"

#. ~ Description for remote vehicle controller
#: lang/json/TOOL_from_json.py
msgid ""
"A remote controller for real cars.  Can turn onboard devices on and off.  "
"Some cars can be driven remotely."
msgstr "A remote controller for real cars.  Can turn onboard devices on and off.  Some cars can be driven remotely."

#: lang/json/TOOL_from_json.py
msgid "quern"
msgid_plural "querns"
msgstr[0] "quern"
msgstr[1] "querns"

#. ~ Description for quern
#: lang/json/TOOL_from_json.py
msgid "This is a simple hand-powered stone quern for grinding grain."
msgstr "This is a simple hand-powered stone quern for grinding grain."

#: lang/json/TOOL_from_json.py
msgid "rollmat"
msgid_plural "rollmats"
msgstr[0] "rollmat"
msgstr[1] "rollmats"

#. ~ Use action done_message for rollmat.
#: lang/json/TOOL_from_json.py
msgid "You unroll the mat and lay it on the ground."
msgstr "You unroll the mat and lay it on the ground."

#. ~ Description for rollmat
#: lang/json/TOOL_from_json.py
msgid ""
"This is a sheet of foam which can be rolled tightly for storage.  It "
"insulates you from the floor, making it easier to sleep.  Use it to unroll "
"and place on the ground."
msgstr "This is a sheet of foam which can be rolled tightly for storage.  It insulates you from the floor, making it easier to sleep.  Use it to unroll and place on the ground."

#: lang/json/TOOL_from_json.py
msgid "RX12 jet injector"
msgid_plural "RX12 jet injectors"
msgstr[0] "RX12 jet injector"
msgstr[1] "RX12 jet injectors"

#. ~ Description for RX12 jet injector
#: lang/json/TOOL_from_json.py
msgid ""
"The Rivtech RX12 jet injector is a small pistol-shaped device used to inject"
" advanced fast-healing chemicals through the skin without using a needle.  A"
" label on the side warns against using more than two doses per hour."
msgstr "The Rivtech RX12 jet injector is a small pistol-shaped device used to inject advanced fast-healing chemicals through the skin without using a needle.  A label on the side warns against using more than two doses per hour."

#: lang/json/TOOL_from_json.py
msgid "safe deposit box"
msgid_plural "safe deposit boxes"
msgstr[0] "safe deposit box"
msgstr[1] "safe deposit boxes"

#. ~ Description for safe deposit box
#: lang/json/TOOL_from_json.py
msgid ""
"This is a secure combination lock box.  Sadly, you don't know the "
"combination.  Breaking inside it would destroy anything of value."
msgstr "This is a secure combination lock box.  Sadly, you don't know the combination.  Breaking inside it would destroy anything of value."

#: lang/json/TOOL_from_json.py
msgid "sarcophagus access code"
msgid_plural "sarcophagus access codes"
msgstr[0] "sarcophagus access code"
msgstr[1] "sarcophagus access codes"

#. ~ Description for sarcophagus access code
#: lang/json/TOOL_from_json.py
msgid ""
"This printout is a string of numbers to access the elevator in the hazardous"
" waste sarcophagus."
msgstr "This printout is a string of numbers to access the elevator in the hazardous waste sarcophagus."

#: lang/json/TOOL_from_json.py
msgid "wood saw"
msgid_plural "wood saws"
msgstr[0] "wood saw"
msgstr[1] "wood saws"

#. ~ Description for wood saw
#: lang/json/TOOL_from_json.py
msgid "This is a thin saw, useful for cutting through wood objects."
msgstr "This is a thin saw, useful for cutting through wood objects."

#: lang/json/TOOL_from_json.py
msgid "scalpel"
msgid_plural "scalpels"
msgstr[0] "scalpel"
msgstr[1] "scalpels"

#. ~ Description for scalpel
#: lang/json/TOOL_from_json.py
msgid ""
"This is a very sharp knife designed for surgical cutting.  It's small, sharp"
" blade allows for precision strikes in the hands of the skilled."
msgstr "This is a very sharp knife designed for surgical cutting.  It's small, sharp blade allows for precision strikes in the hands of the skilled."

#: lang/json/TOOL_from_json.py
msgid "pair of scissors"
msgid_plural "pairs of scissors"
msgstr[0] "pair of scissors"
msgstr[1] "pairs of scissors"

#. ~ Description for pair of scissors
#: lang/json/TOOL_from_json.py
msgid ""
"These are a long pair of heavy duty scissors.  Use scissors to cut items "
"made from cotton (like clothing) into rags."
msgstr "These are a long pair of heavy duty scissors.  Use scissors to cut items made from cotton (like clothing) into rags."

#: lang/json/TOOL_from_json.py
msgid "scrambler grenade"
msgid_plural "scrambler grenades"
msgstr[0] "scrambler grenade"
msgstr[1] "scrambler grenades"

#. ~ Use action msg for scrambler grenade.
#: lang/json/TOOL_from_json.py
msgid "You pull the pin on the scrambler grenade."
msgstr "You pull the pin on the scrambler grenade."

#. ~ Description for scrambler grenade
#: lang/json/TOOL_from_json.py
msgid ""
"This is a highly modified EMP grenade, designed to scramble robots' IFF "
"control chips, rather than destroy them.  This converts the robot to your "
"side for a short time, before the backup systems kick in.  Use this item to "
"pull the pin and light the fuse, turning it into an active scrambler "
"grenade."
msgstr "This is a highly modified EMP grenade, designed to scramble robots' IFF control chips, rather than destroy them.  This converts the robot to your side for a short time, before the backup systems kick in.  Use this item to pull the pin and light the fuse, turning it into an active scrambler grenade."

#: lang/json/TOOL_from_json.py
msgid "active scrambler grenade"
msgid_plural "active scrambler grenades"
msgstr[0] "active scrambler grenade"
msgstr[1] "active scrambler grenades"

#. ~ Description for active scrambler grenade
#: lang/json/TOOL_from_json.py
msgid ""
"This scrambler grenade is active, and will soon detonate, releasing a "
"control wave that temporarily converts robots to your side."
msgstr "This scrambler grenade is active, and will soon detonate, releasing a control wave that temporarily converts robots to your side."

#: lang/json/TOOL_from_json.py
msgid "screwdriver"
msgid_plural "screwdrivers"
msgstr[0] "screwdriver"
msgstr[1] "screwdrivers"

#. ~ Description for screwdriver
#: lang/json/TOOL_from_json.py
msgid ""
"This is a Philips-head screwdriver.  It is important for almost all "
"electronics crafting, most mechanics crafting, and has many more uses."
msgstr "This is a Philips-head screwdriver.  It is important for almost all electronics crafting, most mechanics crafting, and has many more uses."

#: lang/json/TOOL_from_json.py
msgid "screwdriver set"
msgid_plural "screwdriver sets"
msgstr[0] "screwdriver set"
msgstr[1] "screwdriver sets"

#. ~ Description for screwdriver set
#: lang/json/TOOL_from_json.py
msgid ""
"This is a set of screwdrivers in several sizes and blade types.  Guaranteed "
"to have the right tools for more precise work."
msgstr "This is a set of screwdrivers in several sizes and blade types.  Guaranteed to have the right tools for more precise work."

#: lang/json/TOOL_from_json.py
msgid "scythe"
msgid_plural "scythes"
msgstr[0] "scythe"
msgstr[1] "scythes"

#. ~ Description for scythe
#: lang/json/TOOL_from_json.py
msgid ""
"This is an old-fashioned farming tool used to cut tall grass.  While it may "
"be a giant blade on the end of a stick, it is incredibly awkward to use for "
"anything but its intended purpose."
msgstr "This is an old-fashioned farming tool used to cut tall grass.  While it may be a giant blade on the end of a stick, it is incredibly awkward to use for anything but its intended purpose."

#: lang/json/TOOL_from_json.py
msgid "war scythe"
msgid_plural "war scythes"
msgstr[0] "war scythe"
msgstr[1] "war scythes"

#. ~ Description for war scythe
#: lang/json/TOOL_from_json.py
msgid ""
"This farming tool has been modified into a weapon by reinforcing and "
"rotating its blade 90 degrees, transforming it into a deadly giant blade on "
"the end of a stick."
msgstr "This farming tool has been modified into a weapon by reinforcing and rotating its blade 90 degrees, transforming it into a deadly giant blade on the end of a stick."

#: lang/json/TOOL_from_json.py
msgid "sewing kit"
msgid_plural "sewing kits"
msgstr[0] "sewing kit"
msgstr[1] "sewing kits"

#. ~ Description for sewing kit
#: lang/json/TOOL_from_json.py
msgid ""
"This is a plastic kit with a variety of needles, some plastic spools for "
"thread, and a few other useful textile tools.  Use a sewing kit on an "
"article of clothing to attempt to repair or reinforce that clothing.  This "
"uses your tailoring skill."
msgstr "This is a plastic kit with a variety of needles, some plastic spools for thread, and a few other useful textile tools.  Use a sewing kit on an article of clothing to attempt to repair or reinforce that clothing.  This uses your tailoring skill."

#: lang/json/TOOL_from_json.py
msgid "shaving kit"
msgid_plural "shaving kits"
msgstr[0] "shaving kit"
msgstr[1] "shaving kits"

#. ~ Description for shaving kit
#: lang/json/TOOL_from_json.py
msgid ""
"This is a compact and lightweight shaving kit made for travelers.  You can "
"use it to shave if it's supplied with soap.  It requires 1 unit of soap per "
"use."
msgstr "This is a compact and lightweight shaving kit made for travelers.  You can use it to shave if it's supplied with soap.  It requires 1 unit of soap per use."

#: lang/json/TOOL_from_json.py
msgid "shelter kit"
msgid_plural "shelter kits"
msgstr[0] "shelter kit"
msgstr[1] "shelter kits"

#. ~ Description for shelter kit
#: lang/json/TOOL_from_json.py
msgid "This is a small shelter, made of sticks and skins.  Use it to place."
msgstr "This is a small shelter, made of sticks and skins.  Use it to place."

#: lang/json/TOOL_from_json.py
msgid "shishkebab (off)"
msgid_plural "shishkebabs (off)"
msgstr[0] "shishkebab (off)"
msgstr[1] "shishkebabs (off)"

#. ~ Use action success_message for shishkebab (off).
#: lang/json/TOOL_from_json.py
msgid "Let's dance, Zeds!"
msgstr "Let's dance, Zeds!"

#. ~ Use action lacks_fuel_message for shishkebab (off).
#: lang/json/TOOL_from_json.py
msgid "This thing needs some fuel!"
msgstr "This thing needs some fuel!"

#. ~ Use action failure_message for shishkebab (off).
#: lang/json/TOOL_from_json.py
msgid "Aw, dangit.  It fails to start!"
msgstr "Aw, dangit.  It fails to start!"

#. ~ Description for shishkebab (off)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a large blade with a fuel pipe on the side, and a small tank and "
"igniter built into the insulated hilt.  When filled with gasoline, the blade"
" can be made scorching hot to singe enemies and light your way.  Use to "
"ignite."
msgstr "This is a large blade with a fuel pipe on the side, and a small tank and igniter built into the insulated hilt.  When filled with gasoline, the blade can be made scorching hot to singe enemies and light your way.  Use to ignite."

#: lang/json/TOOL_from_json.py
msgid "shishkebab (on)"
msgid_plural "shishkebabs (on)"
msgstr[0] "shishkebab (on)"
msgstr[1] "shishkebabs (on)"

#. ~ Use action charges_extinguish_message for shishkebab (on).
#: lang/json/TOOL_from_json.py
msgid "Uncool, outta gas!  Your shishkebab's flame goes out."
msgstr "Uncool, outta gas!  Your shishkebab's flame goes out."

#. ~ Use action voluntary_extinguish_message for shishkebab (on).
#: lang/json/TOOL_from_json.py
msgid "Peace out.  Your shishkebab's flame dies."
msgstr "Peace out.  Your shishkebab's flame dies."

#. ~ Use action water_extinguish_message for shishkebab (on).
#: lang/json/TOOL_from_json.py
msgid "Your shishkebab hisses in the water and goes out."
msgstr "Your shishkebab hisses in the water and goes out."

#. ~ Use action auto_extinguish_message for shishkebab (on).
#: lang/json/TOOL_from_json.py
msgid "Bummer, man!  Your shishkebab's flame flickers and dies out."
msgstr "Bummer, man!  Your shishkebab's flame flickers and dies out."

#. ~ Use action noise_message for shishkebab (on).
#: lang/json/TOOL_from_json.py
msgid "Your shishkebab crackles!"
msgstr "Your shishkebab crackles!"

#. ~ Description for shishkebab (on)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a large blade with a fuel pipe on the side, and a small tank and "
"igniter built into the insulated hilt.  The blade is glowing brightly.  Use "
"to shut off the gas."
msgstr "This is a large blade with a fuel pipe on the side, and a small tank and igniter built into the insulated hilt.  The blade is glowing brightly.  Use to shut off the gas."

#: lang/json/TOOL_from_json.py
msgid "powered quarterstaff"
msgid_plural "powered quarterstaves"
msgstr[0] "powered quarterstaff"
msgstr[1] "powered quarterstaves"

#. ~ Description for powered quarterstaff
#: lang/json/TOOL_from_json.py
msgid ""
"This is an ironshod quarterstaff that has a high-voltage stun gun built into"
" the handle.  The stun gun is wired to the metal caps at either end of the "
"staff, allowing you to zap a dangerous opponent should beating them "
"senseless with it prove too hazardous."
msgstr "This is an ironshod quarterstaff that has a high-voltage stun gun built into the handle.  The stun gun is wired to the metal caps at either end of the staff, allowing you to zap a dangerous opponent should beating them senseless with it prove too hazardous."

#: lang/json/TOOL_from_json.py
msgid "tactical tonfa (off)"
msgid_plural "tactical tonfas (off)"
msgstr[0] "tactical tonfa (off)"
msgstr[1] "tactical tonfas (off)"

#. ~ Description for tactical tonfa (off)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a reinforced plastic tonfa; the core is hollowed out and is filled "
"with capacitors and a high-yield rechargeable storage battery.  When a "
"switch on the handle is pressed, a high-voltage current is transmitted to "
"the two electrodes mounted in the end of the tonfa, and by extension to "
"anyone unfortunate enough to be in contact with them.  It also has a nifty "
"flashlight, which is off at the moment."
msgstr "This is a reinforced plastic tonfa; the core is hollowed out and is filled with capacitors and a high-yield rechargeable storage battery.  When a switch on the handle is pressed, a high-voltage current is transmitted to the two electrodes mounted in the end of the tonfa, and by extension to anyone unfortunate enough to be in contact with them.  It also has a nifty flashlight, which is off at the moment."

#: lang/json/TOOL_from_json.py
msgid "tactical tonfa (on)"
msgid_plural "tactical tonfas (on)"
msgstr[0] "tactical tonfa (on)"
msgstr[1] "tactical tonfas (on)"

#. ~ Description for tactical tonfa (on)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a reinforced plastic tonfa; the core is hollowed out and is filled "
"with capacitors and a high-yield rechargeable storage battery.  When a "
"switch on the handle is pressed, a high-voltage current is transmitted to "
"the two electrodes mounted in the end of the weapon, and by extension to "
"anyone unfortunate enough to be in contact with them.  The integral "
"flashlight is turned on, continually draining power and lighting the "
"surrounding area."
msgstr "This is a reinforced plastic tonfa; the core is hollowed out and is filled with capacitors and a high-yield rechargeable storage battery.  When a switch on the handle is pressed, a high-voltage current is transmitted to the two electrodes mounted in the end of the weapon, and by extension to anyone unfortunate enough to be in contact with them.  The integral flashlight is turned on, continually draining power and lighting the surrounding area."

#: lang/json/TOOL_from_json.py lang/json/trap_from_json.py
#: lang/json/trap_from_json.py
msgid "shotgun trap"
msgid_plural "shotgun traps"
msgstr[0] "shotgun trap"
msgstr[1] "shotgun traps"

#. ~ Use action done_message for shotgun trap.
#: lang/json/TOOL_from_json.py
msgid "You set the shotgun trap."
msgstr "You set the shotgun trap."

#. ~ Description for shotgun trap
#: lang/json/TOOL_from_json.py
msgid ""
"This is a simple tripwire is attached to the trigger of a loaded sawn-off "
"shotgun.  When pulled, the shotgun fires.  Two shells are loaded; the first "
"time the trigger is pulled, one or both shells may be discharged."
msgstr "This is a simple tripwire is attached to the trigger of a loaded sawn-off shotgun.  When pulled, the shotgun fires.  Two shells are loaded; the first time the trigger is pulled, one or both shells may be discharged."

#: lang/json/TOOL_from_json.py
msgid "shovel"
msgid_plural "shovels"
msgstr[0] "shovel"
msgstr[1] "shovels"

#. ~ Description for shovel
#: lang/json/TOOL_from_json.py
msgid "This is a digging tool.  Use it to dig pits adjacent to your location."
msgstr "This is a digging tool.  Use it to dig pits adjacent to your location."

#: lang/json/TOOL_from_json.py
msgid "sickle"
msgid_plural "sickles"
msgstr[0] "sickle"
msgstr[1] "sickles"

#. ~ Description for sickle
#: lang/json/TOOL_from_json.py
msgid ""
"This is an old-fashioned farming tool used to cut tall grass.  While it may "
"be a massive curved blade on a handle, it is incredibly awkward to use for "
"anything but its intended purpose."
msgstr "This is an old-fashioned farming tool used to cut tall grass.  While it may be a massive curved blade on a handle, it is incredibly awkward to use for anything but its intended purpose."

#: lang/json/TOOL_from_json.py
msgid "small fire extinguisher"
msgid_plural "small fire extinguishers"
msgstr[0] "small fire extinguisher"
msgstr[1] "small fire extinguishers"

#. ~ Description for small fire extinguisher
#: lang/json/TOOL_from_json.py
msgid ""
"This is a hand held fire extinguisher containing a liter of highly "
"compressed C02 gas.  It would be useful for putting out adjacent fires."
msgstr "This is a hand held fire extinguisher containing a liter of highly compressed C02 gas.  It would be useful for putting out adjacent fires."

#: lang/json/TOOL_from_json.py
msgid "firearm repair kit"
msgid_plural "firearm repair kits"
msgstr[0] "firearm repair kit"
msgstr[1] "firearm repair kits"

#. ~ Description for firearm repair kit
#: lang/json/TOOL_from_json.py
msgid ""
"This is a portable toolkit made to repair damaged firearms.  Powered by "
"standard batteries, it is a vital tool for long-term firearms maintenance.  "
"It requires 100 charges of battery power per use."
msgstr "This is a portable toolkit made to repair damaged firearms.  Powered by standard batteries, it is a vital tool for long-term firearms maintenance.  It requires 100 charges of battery power per use."

#: lang/json/TOOL_from_json.py
msgid "smart lamp (off)"
msgid_plural "smart lamps (off)"
msgstr[0] "smart lamp (off)"
msgstr[1] "smart lamps (off)"

#. ~ Use action msg for smart lamp (off).
#: lang/json/TOOL_from_json.py
msgid "You turn the smart lamp on."
msgstr "You turn the smart lamp on."

#. ~ Use action need_charges_msg for smart lamp (off).
#: lang/json/TOOL_from_json.py
msgid "The smart lamp batteries are dead."
msgstr "The smart lamp batteries are dead."

#. ~ Description for smart lamp (off)
#: lang/json/TOOL_from_json.py
msgid "This is a smart lamp, it can be activated remotely."
msgstr "This is a smart lamp, it can be activated remotely."

#: lang/json/TOOL_from_json.py
msgid "smart lamp (on)"
msgid_plural "smart lamps (on)"
msgstr[0] "smart lamp (on)"
msgstr[1] "smart lamps (on)"

#. ~ Use action msg for smart lamp (on).
#: lang/json/TOOL_from_json.py
msgid "Your smart lamp turned off"
msgstr "Your smart lamp turned off"

#. ~ Description for smart lamp (on)
#: lang/json/TOOL_from_json.py
msgid ""
"This is a smart lamp, this smart lamp is turned on.  It can be deactivated "
"remotely."
msgstr "This is a smart lamp, this smart lamp is turned on.  It can be deactivated remotely."

#: lang/json/TOOL_from_json.py
msgid "emergency oxygen pack"
msgid_plural "emergency oxygen packs"
msgstr[0] "emergency oxygen pack"
msgstr[1] "emergency oxygen packs"

#. ~ Description for emergency oxygen pack
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small tank of compressed medical oxygen with a folding regulator "
"and mask.  Commonly used in emergency situations, it provides immediate "
"relief for asthma attacks or smoke inhalation, and can provide a brief burst"
" of energy."
msgstr "This is a small tank of compressed medical oxygen with a folding regulator and mask.  Commonly used in emergency situations, it provides immediate relief for asthma attacks or smoke inhalation, and can provide a brief burst of energy."

#: lang/json/TOOL_from_json.py
msgid "snare trigger"
msgid_plural "snare triggers"
msgstr[0] "snare trigger"
msgstr[1] "snare triggers"

#. ~ Description for snare trigger
#: lang/json/TOOL_from_json.py
msgid ""
"This is a stick that has been cut into a trigger mechanism for a snare trap."
msgstr "This is a stick that has been cut into a trigger mechanism for a snare trap."

#: lang/json/TOOL_from_json.py
msgid "soldering iron"
msgid_plural "soldering irons"
msgstr[0] "soldering iron"
msgstr[1] "soldering irons"

#. ~ Description for soldering iron
#: lang/json/TOOL_from_json.py
msgid ""
"This is a device with a metal tip that can get very hot.  It is necessary "
"for advanced electronics crafting.  You could also use it to cauterize "
"wounds, if you had to."
msgstr "This is a device with a metal tip that can get very hot.  It is necessary for advanced electronics crafting.  You could also use it to cauterize wounds, if you had to."

#: lang/json/TOOL_from_json.py
msgid "knife spear"
msgid_plural "knife spears"
msgstr[0] "knife spear"
msgstr[1] "knife spears"

#. ~ Description for knife spear
#: lang/json/TOOL_from_json.py
msgid ""
"This is a simple wood pole made much more deadly by the blade tied to it."
msgstr "This is a simple wood pole made much more deadly by the blade tied to it."

#: lang/json/TOOL_from_json.py
msgid "spray can"
msgid_plural "spray cans"
msgstr[0] "spray can"
msgstr[1] "spray cans"

#. ~ Description for spray can
#: lang/json/TOOL_from_json.py
msgid ""
"This is a spray can, filled with paint.  Use this tool to make graffiti on "
"the floor."
msgstr "This is a spray can, filled with paint.  Use this tool to make graffiti on the floor."

#: lang/json/TOOL_from_json.py lang/json/furniture_from_json.py
msgid "stepladder"
msgid_plural "stepladders"
msgstr[0] "stepladder"
msgstr[1] "stepladders"

#. ~ Description for stepladder
#: lang/json/TOOL_from_json.py
msgid "This is a wooden stepladder.  Use it to set it down."
msgstr "This is a wooden stepladder.  Use it to set it down."

#: lang/json/TOOL_from_json.py lang/json/furniture_from_json.py
msgid "still"
msgid_plural "stills"
msgstr[0] "still"
msgstr[1] "stills"

#. ~ Description for still
#: lang/json/TOOL_from_json.py
msgid ""
"This is a still.  It's useful for creating distillation of alcohol and "
"other, more curious substances."
msgstr "This is a still.  It's useful for creating distillation of alcohol and other, more curious substances."

#: lang/json/TOOL_from_json.py
msgid "survival marker"
msgid_plural "survival markers"
msgstr[0] "survival marker"
msgstr[1] "survival markers"

#. ~ Description for survival marker
#: lang/json/TOOL_from_json.py
msgid ""
"This is a sharpened piece of charcoal that is almost guaranteed to make your"
" hands all covered in charcoal.  Use it to write something down."
msgstr "This is a sharpened piece of charcoal that is almost guaranteed to make your hands all covered in charcoal.  Use it to write something down."

