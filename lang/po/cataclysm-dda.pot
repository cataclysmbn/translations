#: lang/json/AMMO_from_json.py
msgid "rubber slug"
msgid_plural "rubber slugs"
msgstr[0] "rubber slug"
msgstr[1] "rubber slugs"

#. ~ Description for rubber slug
#: lang/json/AMMO_from_json.py
msgid ""
"Rubber slugs from a shotgun beanbag round.  You could use them to make new "
"beanbag rounds."
msgstr "Rubber slugs from a shotgun beanbag round.  You could use them to make new beanbag rounds."

#: lang/json/AMMO_from_json.py
msgid "copper"
msgid_plural "copper"
msgstr[0] "copper"
msgstr[1] "copper"

#. ~ Description for copper
#: lang/json/AMMO_from_json.py
msgid ""
"Copper scraps.  Could be used to craft something, for example makeshift "
"shotgun shells."
msgstr "Copper scraps.  Could be used to craft something, for example makeshift shotgun shells."

#: lang/json/AMMO_from_json.py
msgid "solder"
msgid_plural "solder"
msgstr[0] "solder"
msgstr[1] "solder"

#. ~ Description for solder
#: lang/json/AMMO_from_json.py
msgid ""
"A small spool of solder, able to be used in ammunition and electronics."
msgstr "A small spool of solder, able to be used in ammunition and electronics."

#: lang/json/AMMO_from_json.py
msgid "tin"
msgid_plural "tin"
msgstr[0] "tin"
msgstr[1] "tin"

#. ~ Description for tin
#: lang/json/AMMO_from_json.py
msgid "Tin and pewter scraps.  Usable in making ammo."
msgstr "Tin and pewter scraps.  Usable in making ammo."

#: lang/json/AMMO_from_json.py
msgid "medical tape"
msgid_plural "medical tapes"
msgstr[0] "medical tape"
msgstr[1] "medical tapes"

#. ~ Description for medical tape
#: lang/json/AMMO_from_json.py
msgid "A roll of medical tape, similar to duct tape."
msgstr "A roll of medical tape, similar to duct tape."

#: lang/json/AMMO_from_json.py
msgid "FFV441B HE rocket"
msgid_plural "FFV441B HE rockets"
msgstr[0] "FFV441B HE rocket"
msgstr[1] "FFV441B HE rockets"

#. ~ Description for FFV441B HE rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A 84x246mm High Explosive anti-personnel round for the Carl Gustav M3 "
"recoilless rifle.  Designed to be highly effective against personnel."
msgstr "A 84x246mm High Explosive anti-personnel round for the Carl Gustav M3 recoilless rifle.  Designed to be highly effective against personnel."

#: lang/json/AMMO_from_json.py
msgid "FFV502 HEDP rocket"
msgid_plural "FFV502 HEDP rockets"
msgstr[0] "FFV502 HEDP rocket"
msgstr[1] "FFV502 HEDP rockets"

#. ~ Description for FFV502 HEDP rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A 84x246mm High Explosive Dual Purpose anti-materiel round for the Carl "
"Gustav M3 recoilless rifle.  Designed to be highly effective against "
"vehicles and structures."
msgstr "A 84x246mm High Explosive Dual Purpose anti-materiel round for the Carl Gustav M3 recoilless rifle.  Designed to be highly effective against vehicles and structures."

#: lang/json/AMMO_from_json.py
msgid "FFV469 smoke rocket"
msgid_plural "FFV469 smoke rockets"
msgstr[0] "FFV469 smoke rocket"
msgstr[1] "FFV469 smoke rockets"

#. ~ Description for FFV469 smoke rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A 84x246mm smoke marker round for the Carl Gustav M3 recoilless rifle.  "
"Commonly used for signaling, target designation, and for screening troop "
"movements."
msgstr "A 84x246mm smoke marker round for the Carl Gustav M3 recoilless rifle.  Commonly used for signaling, target designation, and for screening troop movements."

#: lang/json/AMMO_from_json.py
msgid "PG-7VL rocket"
msgid_plural "PG-7VL rockets"
msgstr[0] "PG-7VL rocket"
msgstr[1] "PG-7VL rockets"

#. ~ Description for PG-7VL rocket
#: lang/json/AMMO_from_json.py
msgid "93mm single-stage high-explosive ammunition for the RPG-7."
msgstr "93mm single-stage high-explosive ammunition for the RPG-7."

#: lang/json/AMMO_from_json.py
msgid "M235 TPA rocket"
msgid_plural "M235 TPA rockets"
msgstr[0] "M235 TPA rocket"
msgstr[1] "M235 TPA rockets"

#. ~ Description for M235 TPA rocket
#: lang/json/AMMO_from_json.py
msgid ""
"66mm incendiary rockets used in the M202 FLASH rocket launcher.  Their "
"warheads are filled with a thickened pyrophoric agent, which burns at 2200 "
"degrees Fahrenheit."
msgstr "66mm incendiary rockets used in the M202 FLASH rocket launcher.  Their warheads are filled with a thickened pyrophoric agent, which burns at 2200 degrees Fahrenheit."

#: lang/json/AMMO_from_json.py
msgid "placeholder ammunition"
msgid_plural "placeholder ammunition"
msgstr[0] "placeholder ammunition"
msgstr[1] "placeholder ammunition"

#: lang/json/AMMO_from_json.py
msgid "5x50mm hull"
msgid_plural "5x50mm hulls"
msgstr[0] "5x50mm hull"
msgstr[1] "5x50mm hulls"

#. ~ Description for 5x50mm hull
#: lang/json/AMMO_from_json.py
msgid "An empty plastic hull from a 5x50mm flechette round."
msgstr "An empty plastic hull from a 5x50mm flechette round."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "charcoal"
msgid_plural "charcoal"
msgstr[0] "charcoal"
msgstr[1] "charcoal"

#. ~ Description for charcoal
#: lang/json/AMMO_from_json.py
msgid ""
"Charcoal is a flammable carbon based material obtained by removing water and"
" other volatile constituents from animal and vegetation substances.  It is "
"produced by slowly heating wood or other substances in the absence of "
"oxygen."
msgstr "Charcoal is a flammable carbon based material obtained by removing water and other volatile constituents from animal and vegetation substances.  It is produced by slowly heating wood or other substances in the absence of oxygen."

#: lang/json/AMMO_from_json.py
msgid "coal"
msgid_plural "coal"
msgstr[0] "coal"
msgstr[1] "coal"

#. ~ Description for coal
#: lang/json/AMMO_from_json.py
msgid ""
"Flammable black chunks of carbon-based material commonly used for cooking "
"and heating."
msgstr "Flammable black chunks of carbon-based material commonly used for cooking and heating."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "modified mininuke"
msgid_plural "modified mininukes"
msgstr[0] "modified mininuke"
msgstr[1] "modified mininukes"

#. ~ Description for modified mininuke
#: lang/json/AMMO_from_json.py
msgid ""
"A heavy modified handheld nuclear device.  Intended to be fired from a "
"specialized launcher, its case has been cut down and it has been rigged to "
"explode on impact.  While it is now somewhat lighter than before, it can no "
"longer be triggered manually."
msgstr "A heavy modified handheld nuclear device.  Intended to be fired from a specialized launcher, its case has been cut down and it has been rigged to explode on impact.  While it is now somewhat lighter than before, it can no longer be triggered manually."

#: lang/json/AMMO_from_json.py
msgid "RA21E medical ampoule"
msgid_plural "RA21E medical ampoules"
msgstr[0] "RA21E medical ampoule"
msgstr[1] "RA21E medical ampoules"

#. ~ Description for RA21E medical ampoule
#: lang/json/AMMO_from_json.py
msgid ""
"A tiny glass vial filled with advanced fast-healing chemicals which can only"
" be activated by a Rivtech jet injector device.  A label on the side warns "
"against using more than two doses per hour."
msgstr "A tiny glass vial filled with advanced fast-healing chemicals which can only be activated by a Rivtech jet injector device.  A label on the side warns against using more than two doses per hour."

#: lang/json/AMMO_from_json.py
msgid "RA10K stimulant module"
msgid_plural "RA10K stimulant modules"
msgstr[0] "RA10K stimulant module"
msgstr[1] "RA10K stimulant modules"

#. ~ Description for RA10K stimulant module
#: lang/json/AMMO_from_json.py
msgid ""
"A pressurized multi-chamber glass vial filled with powerful chemical "
"stimulants which can only be activated by a Rivtech stimulant delivery "
"system."
msgstr "A pressurized multi-chamber glass vial filled with powerful chemical stimulants which can only be activated by a Rivtech stimulant delivery system."

#: lang/json/AMMO_from_json.py
msgid "rebreather filter cartridge"
msgid_plural "rebreather filter cartridges"
msgstr[0] "rebreather filter cartridge"
msgstr[1] "rebreather filter cartridges"

#. ~ Description for rebreather filter cartridge
#: lang/json/AMMO_from_json.py
msgid "A replacement filter cartridge for a rebreather."
msgstr "A replacement filter cartridge for a rebreather."

#: lang/json/AMMO_from_json.py
msgid "nicotine liquid"
msgid_plural "nicotine liquids"
msgstr[0] "nicotine liquid"
msgstr[1] "nicotine liquids"

#. ~ Description for nicotine liquid
#: lang/json/AMMO_from_json.py
msgid ""
"A liquid is made up of propylene glycol, vegetable glycerine, flavorings and"
" nicotine."
msgstr "A liquid is made up of propylene glycol, vegetable glycerine, flavorings and nicotine."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "fish bait"
msgid_plural "fish baits"
msgstr[0] "fish bait"
msgstr[1] "fish baits"

#. ~ Description for fish bait
#: lang/json/AMMO_from_json.py
msgid "A bait used in traps to lure fish."
msgstr "A bait used in traps to lure fish."

#: lang/json/AMMO_from_json.py
msgid "oxygen"
msgid_plural "oxygens"
msgstr[0] "oxygen"
msgstr[1] "oxygens"

#. ~ Description for oxygen
#: lang/json/AMMO_from_json.py
msgid "A canister of oxygen."
msgstr "A canister of oxygen."

#: lang/json/AMMO_from_json.py
msgid "spiked home-made rocket"
msgid_plural "spiked home-made rockets"
msgstr[0] "spiked home-made rocket"
msgstr[1] "spiked home-made rockets"

#. ~ Description for spiked home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A home-built rocket, consisting of a spike welded onto a pipe that was "
"filled with improvised rocket fuel.  Horribly inaccurate, as can be expected"
" of this grade of weapon, but packs a fierce punch... if it hits."
msgstr "A home-built rocket, consisting of a spike welded onto a pipe that was filled with improvised rocket fuel.  Horribly inaccurate, as can be expected of this grade of weapon, but packs a fierce punch... if it hits."

#: lang/json/AMMO_from_json.py
msgid "explosive home-made rocket"
msgid_plural "explosive home-made rockets"
msgstr[0] "explosive home-made rocket"
msgstr[1] "explosive home-made rockets"

#. ~ Description for explosive home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A home-built rocket, consisting of a simple explosive warhead attached onto "
"a pipe, filled with improvised rocket fuel.  Not very powerful, but can be "
"made from scratch."
msgstr "A home-built rocket, consisting of a simple explosive warhead attached onto a pipe, filled with improvised rocket fuel.  Not very powerful, but can be made from scratch."

#: lang/json/AMMO_from_json.py
msgid "incendiary home-made rocket"
msgid_plural "incendiary home-made rockets"
msgstr[0] "incendiary home-made rocket"
msgstr[1] "incendiary home-made rockets"

#. ~ Description for incendiary home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A home-built rocket, consisting of a container of flammable gel attached "
"onto a pipe, filled with improvised rocket fuel.  Short-range incendiary – "
"handle with care!"
msgstr "A home-built rocket, consisting of a container of flammable gel attached onto a pipe, filled with improvised rocket fuel.  Short-range incendiary – handle with care!"

#: lang/json/AMMO_from_json.py
msgid "unfinished charcoal"
msgid_plural "unfinished charcoal"
msgstr[0] "unfinished charcoal"
msgstr[1] "unfinished charcoal"

#. ~ Description for unfinished charcoal
#: lang/json/AMMO_from_json.py
msgid ""
"The result of an interrupted charcoal making process.  Useless, except as "
"fuel in a charcoal kiln."
msgstr "The result of an interrupted charcoal making process.  Useless, except as fuel in a charcoal kiln."

#: lang/json/AMMO_from_json.py
msgid "sprayable fungicide"
msgid_plural "sprayable fungicides"
msgstr[0] "sprayable fungicide"
msgstr[1] "sprayable fungicides"

#. ~ Description for sprayable fungicide
#: lang/json/AMMO_from_json.py
msgid ""
"Fungicide enhanced with sulfur to create sprayable anti-fungal ammo for the "
"chemical thrower.  Best be used with some kind of mask or mouth protection."
msgstr "Fungicide enhanced with sulfur to create sprayable anti-fungal ammo for the chemical thrower.  Best be used with some kind of mask or mouth protection."

#: lang/json/AMMO_from_json.py
msgid "sprayable toxic gas"
msgid_plural "sprayable toxic gass"
msgstr[0] "sprayable toxic gas"
msgstr[1] "sprayable toxic gass"

#. ~ Description for sprayable toxic gas
#: lang/json/AMMO_from_json.py
msgid ""
"A hazardous mixture made from household cleaners, improvised for use in a "
"chemical thrower.  Best be used with some kind of mask or mouth protection."
msgstr "A hazardous mixture made from household cleaners, improvised for use in a chemical thrower.  Best be used with some kind of mask or mouth protection."

#: lang/json/AMMO_from_json.py
msgid "arrowhead"
msgid_plural "arrowheads"
msgstr[0] "arrowhead"
msgstr[1] "arrowheads"

#. ~ Description for arrowhead
#: lang/json/AMMO_from_json.py
msgid ""
"Steel heads for an arrow.  Placing these on arrows will make them more "
"damaging and piercing."
msgstr "Steel heads for an arrow.  Placing these on arrows will make them more damaging and piercing."

#: lang/json/AMMO_from_json.py
msgid "wooden arrow shaft"
msgid_plural "wooden arrow shafts"
msgstr[0] "wooden arrow shaft"
msgstr[1] "wooden arrow shafts"

#. ~ Description for wooden arrow shaft
#: lang/json/AMMO_from_json.py
msgid ""
"A crude shaft made from wood.  It needs arrowheads and fletching to become a"
" functional arrow."
msgstr "A crude shaft made from wood.  It needs arrowheads and fletching to become a functional arrow."

#: lang/json/AMMO_from_json.py
msgid "heavy wooden arrow shaft"
msgid_plural "heavy wooden arrow shafts"
msgstr[0] "heavy wooden arrow shaft"
msgstr[1] "heavy wooden arrow shafts"

