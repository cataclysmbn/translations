msgid "curved needle"
msgid_plural "curved needles"
msgstr[0] "curved needle"
msgstr[1] "curved needles"

#. ~ Description for curved needle
#: lang/json/TOOL_from_json.py
msgid ""
"A curved sharp needle made of steel.  Its rounded shape allows it to make "
"stitches that only pierce one side of the material.  While unsuitable for "
"most tailoring projects, it's a necessity for stitching neoprene."
msgstr "A curved sharp needle made of steel.  Its rounded shape allows it to make stitches that only pierce one side of the material.  While unsuitable for most tailoring projects, it's a necessity for stitching neoprene."

#: lang/json/TOOL_from_json.py
msgid "wooden needle"
msgid_plural "wooden needles"
msgstr[0] "wooden needle"
msgstr[1] "wooden needles"

#. ~ Description for wooden needle
#: lang/json/TOOL_from_json.py
msgid ""
"This is a wooden needle whittled down to a sharp point.  It has a narrow "
"hole carved into the head for threading.  Its low quality makes it rather "
"unsuitable for anything requiring speed or precision."
msgstr "This is a wooden needle whittled down to a sharp point.  It has a narrow hole carved into the head for threading.  Its low quality makes it rather unsuitable for anything requiring speed or precision."

#. ~ Description for nodachi
#: lang/json/TOOL_from_json.py
msgid ""
"This is a huge, curved, two-handed sword from Japan.  It is surprisingly "
"light for its size."
msgstr "This is a huge, curved, two-handed sword from Japan.  It is surprisingly light for its size."

#: lang/json/TOOL_from_json.py
