msgid_plural "tailor's kits"
msgstr[0] "tailor's kit"
msgstr[1] "tailor's kits"

#. ~ Description for tailor's kit
#: lang/json/TOOL_from_json.py
msgid ""
"This is a high quality, plastic kit with a variety of needles, some plastic "
