#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "United disunity."
msgstr "United disunity."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Fey"
msgstr "Fey"

#. ~ Mutation class: Fey mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Nature is becoming one with you..."
msgstr "Nature is becoming one with you..."

#. ~ Mutation class: Fey iv_message
#: lang/json/mutation_category_from_json.py
msgid "Everything goes green for a second."
msgstr "Everything goes green for a second."

#. ~ Mutation class: Fey Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Accepted a more natural way of life."
msgstr "Accepted a more natural way of life."

#. ~ Mutation class: Fey Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Accepted a more natural way of life."
msgstr "Accepted a more natural way of life."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Raptor"
msgstr "Raptor"

#. ~ Mutation class: Raptor mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Mmm...sweet, bloody flavor...tastes like victory."
msgstr "Mmm...sweet, bloody flavor...tastes like victory."

#. ~ Mutation class: Raptor iv_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You distinctly smell the mutagen mixing with your blood ...and then it "
"passes."
msgstr "You distinctly smell the mutagen mixing with your blood ...and then it passes."

#. ~ Mutation class: Raptor Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Hatched."
msgstr "Hatched."

#. ~ Mutation class: Raptor Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Hatched."
msgstr "Hatched."

#: lang/json/mutation_from_json.py
msgid "Fleet-Footed"
msgstr "Fleet-Footed"

#. ~ Description for Fleet-Footed
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can move more quickly than most, resulting in a 15% speed bonus on sure "
"footing."
msgstr "You can move more quickly than most, resulting in a 15% speed bonus on sure footing."

#: lang/json/mutation_from_json.py
msgid "Good Hearing"
msgstr "Good Hearing"

#. ~ Description for Good Hearing
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr "Your hearing is better than average, and you can hear distant sounds more easily."

#: lang/json/mutation_from_json.py
msgid "Outdoorsman"
msgstr "Outdoorsman"

#. ~ Description for Outdoorsman
#: lang/json/mutation_from_json.py
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr "You are accustomed to being exposed to the elements.  This decreases morale penalties for being wet."

#: lang/json/mutation_from_json.py
msgid "Parkour Expert"
msgstr "Parkour Expert"

#. ~ Description for Parkour Expert
#: lang/json/mutation_from_json.py
msgid ""
"You're skilled at clearing obstacles; terrain like railings or counters are "
"as easy for you to move on as solid ground."
msgstr "You're skilled at clearing obstacles; terrain like railings or counters are as easy for you to move on as solid ground."

#: lang/json/mutation_from_json.py
msgid "Indefatigable"
msgstr "Indefatigable"

#. ~ Description for Indefatigable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to exercise and good diet, or due to a natural propensity to "
"physical endurance, you tire due to physical exertion much less readily than"
" others.  Your maximum stamina is 25% higher than usual."
msgstr "Whether due to exercise and good diet, or due to a natural propensity to physical endurance, you tire due to physical exertion much less readily than others.  Your maximum stamina is 25% higher than usual."

#: lang/json/mutation_from_json.py
msgid "Quick"
msgstr "Quick"

#. ~ Description for Quick
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr "You're just generally quick!  You get a 10% bonus to action points."

#: lang/json/mutation_from_json.py src/morale.cpp
msgid "Optimist"
msgstr "Optimist"

#. ~ Description for Optimist
#: lang/json/mutation_from_json.py
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, "
"and are generally happier than most people."
msgstr "Nothing gets you down!  You savor the joys of life, ignore its hardships, and are generally happier than most people."

#: lang/json/mutation_from_json.py
msgid "Fast Healer"
msgstr "Fast Healer"

#. ~ Description for Fast Healer
#: lang/json/mutation_from_json.py
msgid "You heal a little faster than most; sleeping will heal more lost HP."
msgstr "You heal a little faster than most; sleeping will heal more lost HP."

#: lang/json/mutation_from_json.py
msgid "Light Eater"
msgstr "Light Eater"

#. ~ Description for Light Eater
#: lang/json/mutation_from_json.py
msgid ""
"Your metabolism is a little slower, and you require less food than most."
msgstr "Your metabolism is a little slower, and you require less food than most."

#: lang/json/mutation_from_json.py
msgid "Accomplished Sleeper"
msgstr "Accomplished Sleeper"

#. ~ Description for Accomplished Sleeper
#: lang/json/mutation_from_json.py
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr "You have always been able to fall asleep easily, even when sleeping in less than ideal circumstances."

#: lang/json/mutation_from_json.py
msgid "Pain Resistant"
msgstr "Pain Resistant"

#. ~ Description for Pain Resistant
#: lang/json/mutation_from_json.py
msgid "You have a high tolerance for pain."
msgstr "You have a high tolerance for pain."

#: lang/json/mutation_from_json.py
msgid "Night Vision"
msgstr "Night Vision"

#. ~ Description for Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You possess natural night vision, and can see further in the dark than most."
"  Activate to toggle NV-visible areas on or off."
msgstr "You possess natural night vision, and can see further in the dark than most.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Poison Resistant"
msgstr "Poison Resistant"

#. ~ Description for Poison Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr "Your system is rather tolerant of poisons and toxins, and most will affect you less."

#: lang/json/mutation_from_json.py
msgid "Fast Reader"
msgstr "Fast Reader"

#. ~ Description for Fast Reader
#: lang/json/mutation_from_json.py
msgid ""
"You're a quick reader, and can get through books a lot faster than most."
msgstr "You're a quick reader, and can get through books a lot faster than most."

#: lang/json/mutation_from_json.py
msgid "Tough Feet"
msgstr "Tough Feet"

#. ~ Description for Tough Feet
#: lang/json/mutation_from_json.py
msgid ""
"The bottoms of your feet are tough and you are accustomed to going barefoot."
"  You receive no movement penalty for not wearing shoes."
msgstr "The bottoms of your feet are tough and you are accustomed to going barefoot.  You receive no movement penalty for not wearing shoes."

#: lang/json/mutation_from_json.py
msgid "Tough"
msgstr "Tough"

#. ~ Description for Tough
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr "It takes a lot to bring you down!  You get a 20% bonus to all hit points."

#: lang/json/mutation_from_json.py
msgid "Durable"
msgstr "Durable"

#. ~ Description for Durable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr "You can shrug off almost anything!  You get a 30% bonus to all hit points."

#: lang/json/mutation_from_json.py
msgid "Unbreakable"
msgstr "Unbreakable"

#. ~ Description for Unbreakable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr "Nothing can break you!  You get a 40% bonus to all hit points."

#: lang/json/mutation_from_json.py
msgid "Thick-Skinned"
msgstr "Thick-Skinned"

#. ~ Description for Thick-Skinned
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is tough.  Cutting damage is slightly reduced for you.  Slightly "
"decreases wet penalties."
msgstr "Your skin is tough.  Cutting damage is slightly reduced for you.  Slightly decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Packmule"
msgstr "Packmule"

#. ~ Description for Packmule
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can manage to find space for anything!  You can carry 40% more volume."
msgstr "You can manage to find space for anything!  You can carry 40% more volume."

#: lang/json/mutation_from_json.py
msgid "Strong Back"
msgstr "Strong Back"

#. ~ Description for Strong Back
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr "You are capable of carrying far more than someone with similar strength could.  Your maximum weight carried is increased by 35%."

#: lang/json/mutation_from_json.py
msgid "Fast Learner"
msgstr "Fast Learner"

#. ~ Description for Fast Learner
#: lang/json/mutation_from_json.py
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr "You have a flexible mind, allowing you to learn skills much faster than others.  Note that this only applies to real-world experience, not to skill gain from other sources like books."

#: lang/json/mutation_from_json.py
msgid "Strong Stomach"
msgstr "Strong Stomach"

#. ~ Description for Strong Stomach
#: lang/json/mutation_from_json.py
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up nevertheless, you won't suffer a residual nausea."
msgstr "You are less likely to throw up from food poisoning, alcohol, etc.  If you throw up nevertheless, you won't suffer a residual nausea."

#: lang/json/mutation_from_json.py
msgid "Good Memory"
msgstr "Good Memory"

#. ~ Description for Good Memory
#: lang/json/mutation_from_json.py
msgid ""
"You have a an exceptional memory, and find it easy to remember things.  Your"
" skills will erode slightly slower than usual."
msgstr "You have a an exceptional memory, and find it easy to remember things.  Your skills will erode slightly slower than usual."

#: lang/json/mutation_from_json.py
msgid "Deft"
msgstr "Deft"

#. ~ Description for Deft
#: lang/json/mutation_from_json.py
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr "While you're not any better at melee combat, you are better at recovering from a miss, and will be able to attempt another strike faster."

#: lang/json/mutation_from_json.py
msgid "Drunken Master"
msgstr "Drunken Master"

#. ~ Description for Drunken Master
#: lang/json/mutation_from_json.py
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr "The ancient arts of drunken brawling come naturally to you!  While under the influence of alcohol, your melee skill will rise considerably, especially unarmed combat."

#: lang/json/mutation_from_json.py
msgid "Spiritual"
msgstr "Spiritual"

#. ~ Description for Spiritual
#: lang/json/mutation_from_json.py
msgid ""
"You've always felt that there is more to the world than we can see.  Whether"
" driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr "You've always felt that there is more to the world than we can see.  Whether driven by religious beliefs or philosophical interest, you find great inspiration in studying holy texts and experiencing mystical things."

#: lang/json/mutation_from_json.py
msgid "Substance Tolerance"
msgstr "Substance Tolerance"

#. ~ Description for Substance Tolerance
#: lang/json/mutation_from_json.py
msgid ""
"You can handle intoxicants well.  Their effects clear up more quickly for "
"you."
msgstr "You can handle intoxicants well.  Their effects clear up more quickly for you."

#: lang/json/mutation_from_json.py
msgid "Gourmand"
msgstr "Gourmand"

#. ~ Description for Gourmand
#: lang/json/mutation_from_json.py
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also "
"enjoy food more; delicious food is better for your morale, and you don't "
"mind unsavory meals as much."
msgstr "You eat faster, and can eat and drink more, than anyone else!  You also enjoy food more; delicious food is better for your morale, and you don't mind unsavory meals as much."

#: lang/json/mutation_from_json.py
msgid "Addiction Resistant"
msgstr "Addiction Resistant"

#. ~ Description for Addiction Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr "Whether due to a lifetime of exposure or through simple willpower, it's harder for you to become addicted to substances, and easier to rid yourself of these addictions."

#: lang/json/mutation_from_json.py
msgid "Animal Empathy"
msgstr "Animal Empathy"

#. ~ Description for Animal Empathy
#: lang/json/mutation_from_json.py
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are"
" less likely to attack.  This only applies to natural animals such as "
"woodland creatures."
msgstr "Peaceful animals will not run away from you, and even aggressive animals are less likely to attack.  This only applies to natural animals such as woodland creatures."

#: lang/json/mutation_from_json.py
msgid "Terrifying"
msgstr "Terrifying"

#. ~ Description for Terrifying
#: lang/json/mutation_from_json.py
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr "There's something about you that creatures find frightening, and they are more likely to try to flee."

#: lang/json/mutation_from_json.py
msgid "Disease Resistant"
msgstr "Disease Resistant"

#. ~ Description for Disease Resistant
#: lang/json/mutation_from_json.py
msgid ""
"It's very unlikely that you will catch ambient diseases like a cold or the "
"flu."
msgstr "It's very unlikely that you will catch ambient diseases like a cold or the flu."

#: lang/json/mutation_from_json.py
msgid "High Adrenaline"
msgstr "High Adrenaline"

#. ~ Description for High Adrenaline
#: lang/json/mutation_from_json.py
msgid ""
"If you are in a very dangerous situation, you may experience a temporary "
"rush which increases your speed and strength significantly."
msgstr "If you are in a very dangerous situation, you may experience a temporary rush which increases your speed and strength significantly."

#: lang/json/mutation_from_json.py
msgid "Less Sleep"
msgstr "Less Sleep"

#. ~ Description for Less Sleep
#: lang/json/mutation_from_json.py
msgid "You need less sleep than the average person."
msgstr "You need less sleep than the average person."

#: lang/json/mutation_from_json.py
msgid "Self-Aware"
msgstr "Self-Aware"

#. ~ Description for Self-Aware
#: lang/json/mutation_from_json.py
msgid ""
"You get to see your exact amount of HP remaining and health, instead of only"
" having a vague idea of whether you're in good condition or not."
msgstr "You get to see your exact amount of HP remaining and health, instead of only having a vague idea of whether you're in good condition or not."

#: lang/json/mutation_from_json.py
msgid "Inconspicuous"
msgstr "Inconspicuous"

#. ~ Description for Inconspicuous
#: lang/json/mutation_from_json.py
msgid ""
"While sleeping or staying still, it is less likely that monsters will wander"
" close to you."
msgstr "While sleeping or staying still, it is less likely that monsters will wander close to you."

#: lang/json/mutation_from_json.py
msgid "Masochist"
msgstr "Masochist"

#. ~ Description for Masochist
#: lang/json/mutation_from_json.py
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr "Although you still suffer the negative effects of pain, it also brings a unique pleasure to you."

#: lang/json/mutation_from_json.py src/morale.cpp
msgid "Stylish"
msgstr "Stylish"

#. ~ Description for Stylish
#: lang/json/mutation_from_json.py
msgid ""
"Practicality is far less important than style.  Your morale is improved by "
"wearing fashionable and attractive clothing."
msgstr "Practicality is far less important than style.  Your morale is improved by wearing fashionable and attractive clothing."

#: lang/json/mutation_from_json.py
msgid "Light Step"
msgstr "Light Step"

#. ~ Description for Light Step
#: lang/json/mutation_from_json.py
msgid ""
"You make less noise while walking.  You're also less likely to set off "
"traps."
msgstr "You make less noise while walking.  You're also less likely to set off traps."

#: lang/json/mutation_from_json.py
msgid "Robust Genetics"
msgstr "Robust Genetics"

#. ~ Description for Robust Genetics
#: lang/json/mutation_from_json.py
msgid ""
"You have a very strong genetic base.  If you mutate, the odds that the "
"mutation will be beneficial are greatly increased."
msgstr "You have a very strong genetic base.  If you mutate, the odds that the mutation will be beneficial are greatly increased."

#: lang/json/mutation_from_json.py
msgid "Scout"
msgstr "Scout"

#. ~ Description for Scout
#: lang/json/mutation_from_json.py
msgid ""
"You're an excellent navigator and your ability to spot distant landmarks is "
"unmatched.  Your sight radius on the overmap extends beyond the normal "
"range."
msgstr "You're an excellent navigator and your ability to spot distant landmarks is unmatched.  Your sight radius on the overmap extends beyond the normal range."

#: lang/json/mutation_from_json.py
msgid "Cannibal"
msgstr "Cannibal"

#. ~ Description for Cannibal
#: lang/json/mutation_from_json.py
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr "For your whole life you've been forbidden from indulging in your peculiar tastes.  Now the world's ended, and you'll be damned if anyone is going to tell you that you can't eat people."

#: lang/json/mutation_from_json.py
msgid "Psychopath"
msgstr "Psychopath"

#. ~ Description for Psychopath
#: lang/json/mutation_from_json.py
msgid ""
"You don't experience guilt like others do.  Even when you know your actions "
"are wrong, you just don't care."
msgstr "You don't experience guilt like others do.  Even when you know your actions are wrong, you just don't care."

#: lang/json/mutation_from_json.py
msgid "Martial Arts Training"
msgstr "Martial Arts Training"

#. ~ Description for Martial Arts Training
#: lang/json/mutation_from_json.py
msgid ""
"You have received some martial arts training at a local dojo.  You start "
"with your choice of Karate, Judo, Aikido, Tai Chi, or Taekwondo."
msgstr "You have received some martial arts training at a local dojo.  You start with your choice of Karate, Judo, Aikido, Tai Chi, or Taekwondo."

#: lang/json/mutation_from_json.py
msgid "Self-Defense Classes"
msgstr "Self-Defense Classes"

#. ~ Description for Self-Defense Classes
#: lang/json/mutation_from_json.py
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Capoeira, Krav Maga, Muay Thai, Ninjutsu, or Zui Quan."
msgstr "You have taken some self-defense classes at a nearby gym.  You start with your choice of Capoeira, Krav Maga, Muay Thai, Ninjutsu, or Zui Quan."

#: lang/json/mutation_from_json.py
msgid "Shaolin Adept"
msgstr "Shaolin Adept"

#. ~ Description for Shaolin Adept
#: lang/json/mutation_from_json.py
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr "You have studied the arts of the Shaolin monks.  You start with one of the five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."

#: lang/json/mutation_from_json.py
msgid "Venom Mob Protege"
msgstr "Venom Mob Protege"

#. ~ Description for Venom Mob Protege
#: lang/json/mutation_from_json.py
msgid ""
"You are a pupil of the Venom Clan.  You start with one of the five deadly "
"venoms: Centipede, Viper, Scorpion, Lizard, or Toad."
msgstr "You are a pupil of the Venom Clan.  You start with one of the five deadly venoms: Centipede, Viper, Scorpion, Lizard, or Toad."

#: lang/json/mutation_from_json.py
msgid "Melee Weapon Training"
msgstr "Melee Weapon Training"

#. ~ Description for Melee Weapon Training
#: lang/json/mutation_from_json.py
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Eskrima, Fencing, Pentjak Silat or Niten Ichi-Ryu."
msgstr "You have practiced fighting with weapons.  You start with your choice of Eskrima, Fencing, Pentjak Silat or Niten Ichi-Ryu."

#: lang/json/mutation_from_json.py
msgid "Weak Scent"
msgstr "Weak Scent"

#. ~ Description for Weak Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with "
"more difficulty."
msgstr "Your scent is quite weak.  Animals that track your scent will do so with more difficulty."

#: lang/json/mutation_from_json.py
msgid "Skilled Liar"
msgstr "Skilled Liar"

#. ~ Description for Skilled Liar
#: lang/json/mutation_from_json.py
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr "You have no qualms about bending the truth, and have practically no tells.  Telling lies and otherwise bluffing will be much easier for you."

#: lang/json/mutation_from_json.py
msgid "Pretty"
msgstr "Pretty"

#. ~ Description for Pretty
#: lang/json/mutation_from_json.py
msgid ""
"You are a sight to behold.  NPCs who care about such thing will react more "
"kindly to you."
msgstr "You are a sight to behold.  NPCs who care about such thing will react more kindly to you."

#: lang/json/mutation_from_json.py
msgid "Bad Knees"
msgstr "Bad Knees"

#. ~ Description for Bad Knees
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr "Whether due to injury or age, your knees aren't particularly strong or flexible.  Moving over rough terrain will slow you down more than normal."

#: lang/json/mutation_from_json.py
msgid "Languorous"
msgstr "Languorous"

#. ~ Description for Languorous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural "
"disinclination to physical endurance, you tire due to physical exertion much"
" more readily than others.  Your maximum stamina is 25% lower than usual."
msgstr "Whether due to lack of exercise and poor diet, or due to a natural disinclination to physical endurance, you tire due to physical exertion much more readily than others.  Your maximum stamina is 25% lower than usual."

#: lang/json/mutation_from_json.py
msgid "Near-Sighted"
msgstr "Near-Sighted"

#. ~ Description for Near-Sighted
#: lang/json/mutation_from_json.py
msgid ""
"Without your glasses, your seeing radius is severely reduced!  However, "
"while wearing glasses this trait has no effect, and you are guaranteed to "
"start with a pair."
msgstr "Without your glasses, your seeing radius is severely reduced!  However, while wearing glasses this trait has no effect, and you are guaranteed to start with a pair."

#: lang/json/mutation_from_json.py
msgid "Slow Healer"
msgstr "Slow Healer"

#. ~ Description for Slow Healer
#: lang/json/mutation_from_json.py
msgid "You heal a little slower than most; sleeping will heal less lost HP."
msgstr "You heal a little slower than most; sleeping will heal less lost HP."

#: lang/json/mutation_from_json.py
msgid "Far-Sighted"
msgstr "Far-Sighted"

#. ~ Description for Far-Sighted
#: lang/json/mutation_from_json.py
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties"
" on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr "Without reading glasses, you are unable to read anything, and take penalties on melee accuracy and electronics/tailoring crafting.  However, you are guaranteed to start with a pair of reading glasses."

#: lang/json/mutation_from_json.py
msgid "Heavy Sleeper"
msgstr "Heavy Sleeper"

#. ~ Description for Heavy Sleeper
#: lang/json/mutation_from_json.py
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr "You're quite the heavy sleeper.  Noises are unlikely to wake you up."

#: lang/json/mutation_from_json.py
msgid "Sleepy"
msgstr "Sleepy"

#. ~ Description for Sleepy
#: lang/json/mutation_from_json.py
msgid "You need sleep more often, but still spend most of your time awake."
msgstr "You need sleep more often, but still spend most of your time awake."

#: lang/json/mutation_from_json.py
msgid "Asthmatic"
msgstr "Asthmatic"

#. ~ Description for Asthmatic
#: lang/json/mutation_from_json.py
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical"
" limitations.  However, you are guaranteed to start with an inhaler."
msgstr "You will occasionally need to use an inhaler, or else suffer severe physical limitations.  However, you are guaranteed to start with an inhaler."

#: lang/json/mutation_from_json.py
msgid "Bad Back"
msgstr "Bad Back"

#. ~ Description for Bad Back
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You simply can not carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr "You simply can not carry as much as people with a similar strength could.  Your maximum weight carried is reduced by 35%."

#: lang/json/mutation_from_json.py
msgid "Bad Temper"
msgstr "Bad Temper"

#. ~ Description for Bad Temper
#: lang/json/mutation_from_json.py
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes "
"some doing to cheer you up."
msgstr "Things just keep getting you down.  You tend to be unhappy, and it takes some doing to cheer you up."

#: lang/json/mutation_from_json.py
msgid "Disorganized"
msgstr "Disorganized"

#. ~ Description for Disorganized
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are terrible at organizing and storing your possessions.  You can carry "
"40% less volume."
msgstr "You are terrible at organizing and storing your possessions.  You can carry 40% less volume."

#: lang/json/mutation_from_json.py
msgid "Illiterate"
msgstr "Illiterate"

#. ~ Description for Illiterate
#: lang/json/mutation_from_json.py
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr "You never learned to read!  Books and computers are off-limits to you."

#: lang/json/mutation_from_json.py
msgid "Poor Hearing"
msgstr "Poor Hearing"

#. ~ Description for Poor Hearing
#: lang/json/mutation_from_json.py
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr "Your hearing is poor, and you may not hear quiet or far-off noises."

#: lang/json/mutation_from_json.py
msgid "Slow Learner"
msgstr "Slow Learner"

#. ~ Description for Slow Learner
#: lang/json/mutation_from_json.py
msgid ""
"You are slow to grasp new ideas and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr "You are slow to grasp new ideas and thus learn things more slowly than others.  Note that this only applies to real-world experience, not to skill gain from other sources like books."

#: lang/json/mutation_from_json.py
msgid "Insomniac"
msgstr "Insomniac"

#. ~ Description for Insomniac
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time falling asleep, even under the best circumstances!"
msgstr "You have a hard time falling asleep, even under the best circumstances!"

#: lang/json/mutation_from_json.py
msgid "Meat Intolerance"
msgstr "Meat Intolerance"

#. ~ Description for Meat Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but "
"you will suffer morale penalties due to nausea."
msgstr "You have problems with eating meat.  It's possible for you to eat it, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py
msgid "Thin-Skinned"
msgstr "Thin-Skinned"

#. ~ Description for Thin-Skinned
#: lang/json/mutation_from_json.py
msgid "Your skin is fragile.  Cutting damage is slightly increased for you."
msgstr "Your skin is fragile.  Cutting damage is slightly increased for you."

#: lang/json/mutation_from_json.py
msgid "Hates Vegetables"
msgstr "Hates Vegetables"

#. ~ Description for Hates Vegetables
#: lang/json/mutation_from_json.py
msgid ""
"You, like many children, hated eating your vegetables; however, you didn't "
"outgrow it.  It's possible for you to eat them, but you will suffer morale "
"penalties due to nausea."
msgstr "You, like many children, hated eating your vegetables; however, you didn't outgrow it.  It's possible for you to eat them, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py
msgid "Hates Fruit"
msgstr "Hates Fruit"

#. ~ Description for Hates Fruit
#: lang/json/mutation_from_json.py
msgid ""
"You despise eating fruits.  It's possible for you to eat them, but you will "
"suffer morale penalties due to nausea."
msgstr "You despise eating fruits.  It's possible for you to eat them, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py src/morale.cpp
msgid "Lactose Intolerance"
msgstr "Lactose Intolerance"

#. ~ Description for Lactose Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"You like 75 percent of the world, cannot tolerate milk or milk based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties due to nausea."
msgstr "You like 75 percent of the world, cannot tolerate milk or milk based products.  It's possible for you to eat them, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py
msgid "Junkfood Intolerance"
msgstr "Junkfood Intolerance"

#. ~ Description for Junkfood Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties due to "
"nausea."
msgstr "Something in those heavily processed foods doesn't agree with you.  It's possible for you to eat them, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py src/morale.cpp
msgid "Wheat Allergy"
msgstr "Wheat Allergy"

#. ~ Description for Wheat Allergy
#: lang/json/mutation_from_json.py
msgid ""
"You have a rare allergy that prevents you from eating wheat.  It's possible "
"for you to eat them, but you will suffer morale penalties due to nausea."
msgstr "You have a rare allergy that prevents you from eating wheat.  It's possible for you to eat them, but you will suffer morale penalties due to nausea."

#: lang/json/mutation_from_json.py
msgid "Glass Jaw"
msgstr "Glass Jaw"

#. ~ Description for Glass Jaw
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual."
msgstr "Your head can't take much abuse.  Its maximum HP is 20% lower than usual."

#: lang/json/mutation_from_json.py
msgid "Forgetful"
msgstr "Forgetful"

#. ~ Description for Forgetful
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual."
msgstr "You have a hard time remembering things.  Your skills will erode slightly faster than usual."

#: lang/json/mutation_from_json.py
msgid "Lightweight"
msgstr "Lightweight"

#. ~ Description for Lightweight
#: lang/json/mutation_from_json.py
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects"
" of these for longer."
msgstr "Alcohol and drugs go straight to your head.  You suffer the negative effects of these for longer."

#: lang/json/mutation_from_json.py
msgid "Addictive Personality"
msgstr "Addictive Personality"

#. ~ Description for Addictive Personality
#: lang/json/mutation_from_json.py
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr "It's easier for you to become addicted to substances, and harder to rid yourself of these addictions."

#: lang/json/mutation_from_json.py
msgid "Trigger Happy"
msgstr "Trigger Happy"

#. ~ Description for Trigger Happy
#: lang/json/mutation_from_json.py
msgid ""
"On rare occasion, you will go full-auto when you intended to fire a single "
"shot.  This has no effect when firing semi-automatic firearms."
msgstr "On rare occasion, you will go full-auto when you intended to fire a single shot.  This has no effect when firing semi-automatic firearms."

#: lang/json/mutation_from_json.py
msgid "Strong Scent"
msgstr "Strong Scent"

#. ~ Description for Strong Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but "
"animals that track your scent will do so more easily."
msgstr "Your scent is particularly strong.  It's not offensive to humans, but animals that track your scent will do so more easily."

#: lang/json/mutation_from_json.py
msgid "Chemical Imbalance"
msgstr "Chemical Imbalance"

#. ~ Description for Chemical Imbalance
#: lang/json/mutation_from_json.py
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr "You suffer from a minor chemical imbalance, whether mental or physical.  Minor changes to your internal chemistry will manifest themselves on occasion, such as hunger, sleepiness, narcotic effects, etc."

#: lang/json/mutation_from_json.py
msgid "Animal Discord"
msgstr "Animal Discord"

#. ~ Description for Animal Discord
#: lang/json/mutation_from_json.py
msgid ""
"Most animals don't like you, and aggressive animals are more likely to "
"attack you.  This only applies to natural animals such as woodland "
"creatures."
msgstr "Most animals don't like you, and aggressive animals are more likely to attack you.  This only applies to natural animals such as woodland creatures."

#: lang/json/mutation_from_json.py
msgid "Slow Reader"
msgstr "Slow Reader"

#. ~ Description for Slow Reader
#: lang/json/mutation_from_json.py
msgid ""
"You're a slow reader, and it takes you longer to get through books than "
"most."
msgstr "You're a slow reader, and it takes you longer to get through books than most."

#: lang/json/mutation_from_json.py
msgid "Schizophrenic"
msgstr "Schizophrenic"

#. ~ Description for Schizophrenic
#: lang/json/mutation_from_json.py
msgid ""
"You will periodically suffer from delusions, ranging from minor effects to "
"full visual hallucinations.  Some of these effects may be controlled through"
" the use of Thorazine."
msgstr "You will periodically suffer from delusions, ranging from minor effects to full visual hallucinations.  Some of these effects may be controlled through the use of Thorazine."

#: lang/json/mutation_from_json.py
msgid "Clumsy"
msgstr "Clumsy"

#. ~ Description for Clumsy
#: lang/json/mutation_from_json.py
msgid ""
"You make more noise while walking.  You're also more likely to set off "
"traps."
msgstr "You make more noise while walking.  You're also more likely to set off traps."

#: lang/json/mutation_from_json.py
msgid "Jittery"
msgstr "Jittery"

#. ~ Description for Jittery
#: lang/json/mutation_from_json.py
msgid ""
"During moments of great stress or under the effects of stimulants, you may "
"find your hands shaking uncontrollably, severely reducing your dexterity."
msgstr "During moments of great stress or under the effects of stimulants, you may find your hands shaking uncontrollably, severely reducing your dexterity."

#: lang/json/mutation_from_json.py src/morale.cpp
msgid "Hoarder"
msgstr "Hoarder"

#. ~ Description for Hoarder
#: lang/json/mutation_from_json.py
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored)."
"  Xanax can help control this anxiety."
msgstr "You don't feel right unless you're carrying as much as you can.  You suffer morale penalties for carrying less than maximum volume (weight is ignored).  Xanax can help control this anxiety."

#: lang/json/mutation_from_json.py
msgid "Savant"
msgstr "Savant"

#. ~ Description for Savant
#: lang/json/mutation_from_json.py
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr "You tend to specialize in one skill and be poor at all others.  You advance at half speed in all skills except your best one.  Note that combining this with Fast Learner will come out to a slower rate of learning for all skills."

#: lang/json/mutation_from_json.py
msgid "Pacifist"
msgstr "Pacifist"

#. ~ Description for Pacifist
#: lang/json/mutation_from_json.py
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr "You don't like thinking about violence.  Your combat skills advance much slower than usual, and you feel more guilt about killing."

#: lang/json/mutation_from_json.py
msgid "Mood Swings"
msgstr "Mood Swings"

#. ~ Description for Mood Swings
#: lang/json/mutation_from_json.py
msgid "Your morale will shift up and down at random, often dramatically."
msgstr "Your morale will shift up and down at random, often dramatically."

#: lang/json/mutation_from_json.py
msgid "Slow Footed"
msgstr "Slow Footed"

#. ~ Description for Slow Footed
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr "You can't move as fast as most, resulting in a 15% speed penalty on flat ground."

#: lang/json/mutation_from_json.py
msgid "Weak Stomach"
msgstr "Weak Stomach"

#. ~ Description for Weak Stomach
#: lang/json/mutation_from_json.py
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr "You are more likely to throw up from food poisoning, alcohol, etc."

#: lang/json/mutation_from_json.py
msgid "Wool Allergy"
msgstr "Wool Allergy"

#. ~ Description for Wool Allergy
#: lang/json/mutation_from_json.py
msgid ""
"You are badly allergic to wool, and can not wear any clothing made of the "
"substance."
msgstr "You are badly allergic to wool, and can not wear any clothing made of the substance."

#: lang/json/mutation_from_json.py
msgid "Truth Teller"
msgstr "Truth Teller"

#. ~ Description for Truth Teller
#: lang/json/mutation_from_json.py
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr "When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  Telling lies and otherwise bluffing will be much more difficult for you."

#: lang/json/mutation_from_json.py
msgid "Ugly"
msgstr "Ugly"

#. ~ Description for Ugly
#: lang/json/mutation_from_json.py
msgid ""
"You're not much to look at.  NPCs who care about such things will react "
"poorly to you."
msgstr "You're not much to look at.  NPCs who care about such things will react poorly to you."

#: lang/json/mutation_from_json.py
msgid "Albino"
msgstr "Albino"

#. ~ Description for Albino
#: lang/json/mutation_from_json.py
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and a sunglasses when going out in the"
" sun."
msgstr "You lack skin pigmentation due to a genetic problem.  You sunburn extremely easily, and typically use an umbrella and a sunglasses when going out in the sun."

#: lang/json/mutation_from_json.py
msgid "Flimsy"
msgstr "Flimsy"

#. ~ Description for Flimsy
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual and"
" you heal slightly slower.  Stacks with Glass Jaw."
msgstr "Your body can't take much abuse.  Its maximum HP is 25% lower than usual and you heal slightly slower.  Stacks with Glass Jaw."

#: lang/json/mutation_from_json.py
msgid "Frail"
msgstr "Frail"

#. ~ Description for Frail
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual and "
"you heal slower.  Stacks with Glass Jaw."
msgstr "Your body breaks very easily.  Its maximum HP is 50% lower than usual and you heal slower.  Stacks with Glass Jaw."

#: lang/json/mutation_from_json.py
msgid "Fragile"
msgstr "Fragile"

#. ~ Description for Fragile
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual and "
"you heal much slower.  Stacks with Glass Jaw."
msgstr "Your body is extremely fragile.  Its maximum HP is 75% lower than usual and you heal much slower.  Stacks with Glass Jaw."

#: lang/json/mutation_from_json.py
msgid "Rough Skin"
msgstr "Rough Skin"

#. ~ Description for Rough Skin
#: lang/json/mutation_from_json.py
msgid "Your skin is slightly rough.  This has no gameplay effect."
msgstr "Your skin is slightly rough.  This has no gameplay effect."

#: lang/json/mutation_from_json.py
msgid "High Night Vision"
msgstr "High Night Vision"

#. ~ Description for High Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible "
"areas on or off."
msgstr "You can see incredibly well in the dark!  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Full Night Vision"
msgstr "Full Night Vision"

#. ~ Description for Full Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles."
"  Activate to toggle NV-visible areas on or off."
msgstr "You can see in pitch blackness as if you were wearing night-vision goggles.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Eyes"
msgstr "Cephalopod Eyes"

#. ~ Description for Cephalopod Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes still bulge, yet your pupils look Different somehow.  Water "
"doesn't seem to cause any trouble at all, though."
msgstr "Your eyes still bulge, yet your pupils look Different somehow.  Water doesn't seem to cause any trouble at all, though."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Vision"
msgstr "Cephalopod Vision"

#. ~ Description for Cephalopod Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr "Your brain has caught up with your eyes.  You can see much better in the dark, but sunlight seems much brighter now.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Fey Eyes"
msgstr "Fey Eyes"

#. ~ Description for Fey Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have turned...green.  It's tough to tell the exact shade as it "
"seems to shift.  The effect is ...pleasant."
msgstr "Your eyes have turned...green.  It's tough to tell the exact shade as it seems to shift.  The effect is ...pleasant."

#: lang/json/mutation_from_json.py
msgid "Fey Vision"
msgstr "Fey Vision"

#. ~ Description for Fey Vision
#: lang/json/mutation_from_json.py
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr "The shadows don't seem as dark now.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Fey Nightsight"
msgstr "Fey Nightsight"

#. ~ Description for Fey Nightsight
#: lang/json/mutation_from_json.py
msgid ""
"You have great low-light vision now, though that doesn't allow you to "
"perform fine tasks such as crafting and reading in darkness.  Activate to "
"toggle NV-visible areas on or off."
msgstr "You have great low-light vision now, though that doesn't allow you to perform fine tasks such as crafting and reading in darkness.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Feline Eyes"
msgstr "Feline Eyes"

#. ~ Description for Feline Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated, now having a slitted pupil and glittering in light, "
"much like those of cats.  This is visually striking, but it isn't helping "
"you see at night."
msgstr "Your eyes have mutated, now having a slitted pupil and glittering in light, much like those of cats.  This is visually striking, but it isn't helping you see at night."

#: lang/json/mutation_from_json.py
msgid "Feline Vision"
msgstr "Feline Vision"

#. ~ Description for Feline Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see "
"pretty well at night.  Activate to toggle NV-visible areas on or off."
msgstr "Your optic nerves and brain caught up with your eyes.  Now you can see pretty well at night.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Ursine Vision"
msgstr "Ursine Vision"

#. ~ Description for Ursine Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr "Your visual processing has shifted: though you can see better in the dark, you're nearsighted in the light.  Maybe glasses would help.  Activate to toggle NV-visible areas on or off."

#: lang/json/mutation_from_json.py
msgid "Avian Eyes"
msgstr "Avian Eyes"

#. ~ Description for Avian Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr "Your vision has become particularly acute: you suspect you could pick out zombies much farther away.  Perception +4."

#. ~ Description for Infrared Vision
#: lang/json/mutation_from_json.py
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr "Your eyes have mutated to pick up radiation in the infrared spectrum."

#: lang/json/mutation_from_json.py
msgid "Reptilian Eyes"
msgstr "Reptilian Eyes"

#. ~ Description for Reptilian Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect "
"your vision."
msgstr "Your eyes have mutated, with a brilliant iris and slitted pupil similar to that of a lizard.  This is visually striking, but doesn't seem to affect your vision."

#: lang/json/mutation_from_json.py
msgid "Reptilian IR"
msgstr "Reptilian IR"

#. ~ Description for Reptilian IR
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, "
"allowing you to see in the infrared spectrum."
msgstr "Your optic nerves and brain have mutated to catch up with your eyes, allowing you to see in the infrared spectrum."

#: lang/json/mutation_from_json.py
msgid "Very Fast Healer"
msgstr "Very Fast Healer"

#. ~ Description for Very Fast Healer
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh regenerates slowly, and you will regain HP even when not "
"sleeping."
msgstr "Your flesh regenerates slowly, and you will regain HP even when not sleeping."

#: lang/json/mutation_from_json.py
msgid "Regeneration"
msgstr "Regeneration"

#. ~ Description for Regeneration
#: lang/json/mutation_from_json.py
msgid "Your flesh regenerates from wounds incredibly quickly."
msgstr "Your flesh regenerates from wounds incredibly quickly."

#: lang/json/mutation_from_json.py
msgid "Reptilian Healing"
msgstr "Reptilian Healing"

#. ~ Description for Reptilian Healing
#: lang/json/mutation_from_json.py
msgid "Your broken limbs mend themselves without significant difficulty."
msgstr "Your broken limbs mend themselves without significant difficulty."

#: lang/json/mutation_from_json.py
msgid "Very Little Sleep"
msgstr "Very Little Sleep"

#. ~ Description for Very Little Sleep
#: lang/json/mutation_from_json.py
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr "You don't sleep often.  But when you do, you need very little of it."

#: lang/json/mutation_from_json.py
msgid "Tireless"
msgstr "Tireless"

#. ~ Description for Tireless
#: lang/json/mutation_from_json.py
msgid "You defend the realm all night and all day."
msgstr "You defend the realm all night and all day."

#: lang/json/mutation_from_json.py
msgid "Fangs"
msgstr "Fangs"

#. ~ Description for Fangs
#: lang/json/mutation_from_json.py
msgid ""
"Your teeth have grown into two-inch-long fangs, allowing you to make an "
"extra attack when conditions favor it."
msgstr "Your teeth have grown into two-inch-long fangs, allowing you to make an extra attack when conditions favor it."

#: lang/json/mutation_from_json.py
msgid "Incisors"
msgstr "Incisors"

#. ~ Description for Incisors
#: lang/json/mutation_from_json.py
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr "Your big teeth have grown in.  Folks had best show some more respect."

#: lang/json/mutation_from_json.py
msgid "Nictitating Membrane"
msgstr "Nictitating Membrane"

#. ~ Description for Nictitating Membrane
#: lang/json/mutation_from_json.py
msgid ""
"You have a second set of clear eyelids which lower while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr "You have a second set of clear eyelids which lower while underwater, allowing you to see as though you were wearing goggles.  Slightly decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Gills"
msgstr "Gills"

#. ~ Description for Gills
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe "
"underwater.  Slightly increases wet benefits."
msgstr "You've grown a set of gills in your neck, allowing you to breathe underwater.  Slightly increases wet benefits."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Gills"
msgstr "Cephalopod Gills"

#. ~ Description for Cephalopod Gills
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr "You've grown a set of gills, running from your neck up behind your ears.  They allow you to breathe underwater and slightly increase wet benefits."

#: lang/json/mutation_from_json.py
msgid "Mycus Flesh"
msgstr "Mycus Flesh"

#. ~ Description for Mycus Flesh
#: lang/json/mutation_from_json.py
msgid ""
"We have adapted local physical structure to Mycus physiology.  Greatly "
"reduces wet effects."
msgstr "We have adapted local physical structure to Mycus physiology.  Greatly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Mycus Fireproofing"
msgstr "Mycus Fireproofing"

#. ~ Description for Mycus Fireproofing
#: lang/json/mutation_from_json.py
msgid ""
"We have incorporated the dense amphibole fibers used in Mycus core towers.  "
"Greatly reduces speed, but also damage, flammability, and wet effects."
msgstr "We have incorporated the dense amphibole fibers used in Mycus core towers.  Greatly reduces speed, but also damage, flammability, and wet effects."

#: lang/json/mutation_from_json.py
msgid "Scales"
msgstr "Scales"

#. ~ Description for Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of flexible green scales has grown to cover your body, acting as "
"natural armor.  Somewhat reduces wet effects."
msgstr "A set of flexible green scales has grown to cover your body, acting as natural armor.  Somewhat reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Thick Scales"
msgstr "Thick Scales"

#. ~ Description for Thick Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of heavy green scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also limits your flexibility, "
"resulting in a -2 penalty to Dexterity.  Greatly reduces wet effects."
msgstr "A set of heavy green scales has grown to cover your body, acting as natural armor.  While difficult to penetrate, it also limits your flexibility, resulting in a -2 penalty to Dexterity.  Greatly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Sleek Scales"
msgstr "Sleek Scales"

#. ~ Description for Sleek Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of very flexible and slick scales has grown to cover your body.  These"
" act as weak natural armor, improve your ability to swim, and make you "
"difficult to grab.  Mostly reduces wet effects."
msgstr "A set of very flexible and slick scales has grown to cover your body.  These act as weak natural armor, improve your ability to swim, and make you difficult to grab.  Mostly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Light Bones"
msgstr "Light Bones"

#. ~ Description for Light Bones
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt "
"a little more."
msgstr "Your bones are very light.  This enables you to move and attack 10% faster, but also reduces your carrying weight by 20% and makes bashing attacks hurt a little more."

#: lang/json/mutation_from_json.py
msgid "Feathers"
msgstr "Feathers"

#. ~ Description for Feathers
#: lang/json/mutation_from_json.py
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr "Iridescent feathers have grown to cover your entire body, providing a marginal protection against attacks and minor protection from cold.  They also provide a natural waterproofing."

#: lang/json/mutation_from_json.py
msgid "Down"
msgstr "Down"

#. ~ Description for Down
#: lang/json/mutation_from_json.py
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr "You shan't need to migrate south with your layer of down.  It's even better with no apes around to kill you for it!"

#: lang/json/mutation_from_json.py
msgid "Lightly Furred"
msgstr "Lightly Furred"

#. ~ Description for Lightly Furred
#: lang/json/mutation_from_json.py
msgid ""
"Light fur has grown to cover your entire body, providing slight protection "
"from cold."
msgstr "Light fur has grown to cover your entire body, providing slight protection from cold."

#: lang/json/mutation_from_json.py
msgid "Furry"
msgstr "Furry"

#. ~ Description for Furry
#: lang/json/mutation_from_json.py
msgid ""
"Thick black fur has grown to cover your entire body, providing a marginal "
"protection against attacks, and considerable protection from cold."
msgstr "Thick black fur has grown to cover your entire body, providing a marginal protection against attacks, and considerable protection from cold."

#: lang/json/mutation_from_json.py
msgid "Shaggy Fur"
msgstr "Shaggy Fur"

#. ~ Description for Shaggy Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your fur has grown out and thickened, providing noticeable protection from "
"attacks as well as considerable insulation."
msgstr "Your fur has grown out and thickened, providing noticeable protection from attacks as well as considerable insulation."

#: lang/json/mutation_from_json.py
msgid "Gray Fur"
msgstr "Gray Fur"

#. ~ Description for Gray Fur
#: lang/json/mutation_from_json.py
msgid ""
"Dense gray fur has grown to cover your entire body, providing a marginal "
"protection against attacks, and considerable protection from cold."
msgstr "Dense gray fur has grown to cover your entire body, providing a marginal protection against attacks, and considerable protection from cold."

#: lang/json/mutation_from_json.py
msgid "Sleek Fur"
msgstr "Sleek Fur"

#. ~ Description for Sleek Fur
#: lang/json/mutation_from_json.py
msgid "You've grown sleek brown fur, providing some protection from cold."
msgstr "You've grown sleek brown fur, providing some protection from cold."

#: lang/json/mutation_from_json.py
msgid "Lynx Fur"
msgstr "Lynx Fur"

#. ~ Description for Lynx Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your fur's grown out significantly around your cheeks and neck.  It provides"
" minor protection against attacks."
msgstr "Your fur's grown out significantly around your cheeks and neck.  It provides minor protection against attacks."

#: lang/json/mutation_from_json.py
msgid "Chitinous Skin"
msgstr "Chitinous Skin"

#. ~ Description for Chitinous Skin
#: lang/json/mutation_from_json.py
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It "
"provides minor protection from cutting wounds.  Slightly reduces wet "
"effects."
msgstr "Your epidermis has turned into a thin, flexible layer of chitin.  It provides minor protection from cutting wounds.  Slightly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Chitinous Armor"
msgstr "Chitinous Armor"

#. ~ Description for Chitinous Armor
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides"
" considerable physical protection, but reduces your dexterity by 1.  "
"Somewhat reduces wet effects."
msgstr "You've grown a chitin exoskeleton, much like that of an insect.  It provides considerable physical protection, but reduces your dexterity by 1.  Somewhat reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Chitinous Plate"
msgstr "Chitinous Plate"

#. ~ Description for Chitinous Plate
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton made of thick, stiff plates.  It provides "
"excellent physical protection, but reduces your dexterity by 1 and encumbers"
" all body parts but your eyes and mouth.  Greatly reduces wet effects."
msgstr "You've grown a chitin exoskeleton made of thick, stiff plates.  It provides excellent physical protection, but reduces your dexterity by 1 and encumbers all body parts but your eyes and mouth.  Greatly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Hairy Chitin"
msgstr "Hairy Chitin"

#. ~ Description for Hairy Chitin
#: lang/json/mutation_from_json.py
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr "You've developed some sort of hair growing out of your chitin.  It's a bit warmer than not having hair."

#: lang/json/mutation_from_json.py
msgid "Furred Chitin"
msgstr "Furred Chitin"

#. ~ Description for Furred Chitin
#: lang/json/mutation_from_json.py
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr "Your chitin hair has thickened and spread across your body.  It provides minor warmth and helps you sense nearby vibrations."

#: lang/json/mutation_from_json.py
msgid "Furred Plate"
msgstr "Furred Plate"

#. ~ Description for Furred Plate
#: lang/json/mutation_from_json.py
msgid ""
"Your exoskeleton has hardened considerably--restricting movement, granted--"
"and boasts a fine coat of hairs that put feline whiskers to shame."
msgstr "Your exoskeleton has hardened considerably--restricting movement, granted--and boasts a fine coat of hairs that put feline whiskers to shame."

#: lang/json/mutation_from_json.py
msgid "Urticating Hairs"
msgstr "Urticating Hairs"

#. ~ Description for Urticating Hairs
#: lang/json/mutation_from_json.py
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an"
" irritating spot; it doesn't carry your venom but it will be distracting."
msgstr "Significant amounts of your hairs have loosened.  If some creature tries to attack you, your assailant is quite likely to get fine, bristly chitin in an irritating spot; it doesn't carry your venom but it will be distracting."

#: lang/json/mutation_from_json.py
msgid "Spines"
msgstr "Spines"

#. ~ Description for Spines
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes"
" a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr "Your skin is covered with fine spines.  Whenever an unarmed opponent strikes a part of your body that is not covered by clothing, they will receive moderate damage."

#: lang/json/mutation_from_json.py
msgid "Quills"
msgstr "Quills"

#. ~ Description for Quills
#: lang/json/mutation_from_json.py
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive significant damage."
msgstr "Your body is covered with large quills.  Whenever an unarmed opponent strikes a part of your body that is not covered by clothing, they will receive significant damage."

#: lang/json/mutation_from_json.py
msgid "Phelloderm"
msgstr "Phelloderm"

#. ~ Description for Phelloderm
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides a weak armor, and helps you retain moisture, resulting in less "
"thirst.  Greatly decreases wet penalties."
msgstr "Your skin is light green and has a slightly woody quality to it.  This provides a weak armor, and helps you retain moisture, resulting in less thirst.  Greatly decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Bark"
msgstr "Bark"

#. ~ Description for Bark
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"resistance to bashing and cutting damage and minor protection from fire.  "
"Greatly reduces wet effects."
msgstr "Your skin is coated in a light bark, like that of a tree.  This provides resistance to bashing and cutting damage and minor protection from fire.  Greatly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Thorns"
msgstr "Thorns"

#. ~ Description for Thorns
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr "Your skin is covered in small, woody thorns.  Whenever an unarmed opponent strikes a part of your body that is not covered by clothing, they will receive minor damage.  Your punches may also deal extra damage."

#: lang/json/mutation_from_json.py
msgid "Leaves"
msgstr "Leaves"

#. ~ Description for Leaves
#: lang/json/mutation_from_json.py
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from"
" being physically striking, these provide you with a minor amount of "
"nutrition while in sunlight.  Slightly reduces wet effects."
msgstr "All the hair on your body has turned to long, grass-like leaves.  Apart from being physically striking, these provide you with a minor amount of nutrition while in sunlight.  Slightly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Flowering"
msgstr "Flowering"

#. ~ Description for Flowering
#: lang/json/mutation_from_json.py
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr "You've started blooming where your scalp used to be.  Your blossoms have a pleasant aroma, are visually striking, and are quite sensitive."

#: lang/json/mutation_from_json.py
msgid "Mycus Spores"
msgstr "Mycus Spores"

#. ~ Description for Mycus Spores
#: lang/json/mutation_from_json.py
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr "We have developed local spore sacs.  The Mycus must grow."

#: lang/json/mutation_from_json.py
msgid "Mycus Sporogenesis"
msgstr "Mycus Sporogenesis"

#. ~ Description for Mycus Sporogenesis
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard open spore-dispersal as a danger, and attack "
"the Mycus.  Accordingly our local spore sacs remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures rapid and effective growth."
msgstr "Local organisms seem to regard open spore-dispersal as a danger, and attack the Mycus.  Accordingly our local spore sacs remain quiescent, until local guidance determines that it is safe to germinate.  Rapid development taxes local nutrient reserves but ensures rapid and effective growth."

#: lang/json/mutation_from_json.py
msgid "Mycus Blossoms"
msgstr "Mycus Blossoms"

#. ~ Description for Mycus Blossoms
#: lang/json/mutation_from_json.py
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr "We have developed local blossoms.  The Mycus must grow."

#: lang/json/mutation_from_json.py
msgid "Mycus Bloom"
msgstr "Mycus Bloom"

#. ~ Description for Mycus Bloom
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard open spore-dispersal as a danger, and attack "
"the Mycus.  Accordingly our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures rapid and effective growth."
msgstr "Local organisms seem to regard open spore-dispersal as a danger, and attack the Mycus.  Accordingly our local blossoms remain quiescent, until local guidance determines that it is safe to germinate.  Rapid development taxes local nutrient reserves but ensures rapid and effective growth."

#: lang/json/mutation_from_json.py
msgid "Long Fingernails"
msgstr "Long Fingernails"

#. ~ Description for Long Fingernails
#: lang/json/mutation_from_json.py
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr "Your fingernails are long and sharp.  If you aren't wearing gloves, your unarmed attacks deal a minor amount of cutting damage."

#: lang/json/mutation_from_json.py
msgid "Claws"
msgstr "Claws"

#. ~ Description for Claws
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr "You have claws on the ends of your fingers.  If you aren't wearing gloves, your unarmed attacks deal a minor amount of cutting damage."

#: lang/json/mutation_from_json.py
msgid "Rat Claws"
msgstr "Rat Claws"

#. ~ Description for Rat Claws
#: lang/json/mutation_from_json.py
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "Your claws have grown tougher and slightly gnarled."

#: lang/json/mutation_from_json.py
msgid "Stainless Claws"
msgstr "Stainless Claws"

#. ~ Description for Stainless Claws
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  "
"They might as well be made of stainless steel."
msgstr "Your paws are bone, muscle, and claw with a thin layer of skin and fur.  They might as well be made of stainless steel."

#: lang/json/mutation_from_json.py
msgid "Retractable Claws"
msgstr "Retractable Claws"

#. ~ Description for Retractable Claws
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them "
"as desired.  Gloves will still get in the way, though."
msgstr "You have claws on the ends of your fingers, and can extend or retract them as desired.  Gloves will still get in the way, though."

#: lang/json/mutation_from_json.py
msgid "Tentacle Rakes"
msgstr "Tentacle Rakes"

#. ~ Description for Tentacle Rakes
#: lang/json/mutation_from_json.py
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr "Your upper tentacles have grown large, hook-barbed rakes on the ends.  They're quite vicious, but really aren't suited for fine manipulation."

#: lang/json/mutation_from_json.py
msgid "Large Talons"
msgstr "Large Talons"

#. ~ Description for Large Talons
#: lang/json/mutation_from_json.py
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, "
"you find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent you from wearing gloves."
msgstr "Your index fingers have grown into huge talons.  After a bit of practice, you find that this does not affect your dexterity, but allows for a deadly unarmed attack.  They also prevent you from wearing gloves."

#: lang/json/mutation_from_json.py
msgid "Radiogenic"
msgstr "Radiogenic"

#. ~ Description for Radiogenic
#: lang/json/mutation_from_json.py
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr "Your system has adapted to radiation.  While irradiated, you will actually heal slowly, converting the radiation into hit points."

#: lang/json/mutation_from_json.py
msgid "Marloss Carrier"
msgstr "Marloss Carrier"

#. ~ Description for Marloss Carrier
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and...sap?"
msgstr "Ever since you ate that Marloss berry, you can't get its scent out of your nose, and you have a strong desire to try some seeds and...sap?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vessel"
msgstr "Marloss Vessel"

#. ~ Description for Marloss Vessel
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and...sap?"
msgstr "Ever since you ate that Marloss seed, you can't get its taste off of your tongue, and you have a strong desire to try some berries and...sap?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vector"
msgstr "Marloss Vector"

#. ~ Description for Marloss Vector
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and "
"you have a strong desire to eat some seeds and berries."
msgstr "Ever since you ate that Marloss jelly, you can't stop thinking of it, and you have a strong desire to eat some seeds and berries."

#: lang/json/mutation_from_json.py
msgid "Marloss Rejection"
msgstr "Marloss Rejection"

#. ~ Description for Marloss Rejection
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr "Ever since you had that life-threatening reaction to that Marloss junk, you can't bear the thought of ever eating it again!"

#: lang/json/mutation_from_json.py
msgid "Mutagenic Aversion"
msgstr "Mutagenic Aversion"

#. ~ Description for Mutagenic Aversion
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr "Ever since you had that life-threatening reaction to those mutagen and purifier things, you can't bear the thought of ever using them again!"

#: lang/json/mutation_from_json.py
msgid "Insect Pheromones"
msgstr "Insect Pheromones"

#. ~ Description for Insect Pheromones
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of insects.  Insects will attack you much less."
msgstr "Your body produces low-level pheromones, identifying you as a friend to many species of insects.  Insects will attack you much less."

#: lang/json/mutation_from_json.py
msgid "Mammal Pheromones"
msgstr "Mammal Pheromones"

#. ~ Description for Mammal Pheromones
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones which puts mammals at ease.  They "
"will be less likely to attack or flee from you."
msgstr "Your body produces low-level pheromones which puts mammals at ease.  They will be less likely to attack or flee from you."

#: lang/json/mutation_from_json.py
msgid "Disease Immune"
msgstr "Disease Immune"

#. ~ Description for Disease Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr "Your body is simply immune to diseases.  You will never catch an ambient disease."

#: lang/json/mutation_from_json.py
msgid "Infection Resistant"
msgstr "Infection Resistant"

#. ~ Description for Infection Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Your immune system is particularly good at resisting infections.  You have "
"an increased chance for bad wounds and infections to heal on their own, and "
"only suffer reduced penalties from them."
msgstr "Your immune system is particularly good at resisting infections.  You have an increased chance for bad wounds and infections to heal on their own, and only suffer reduced penalties from them."

#: lang/json/mutation_from_json.py
msgid "Infection Immune"
msgstr "Infection Immune"

#. ~ Description for Infection Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will "
"never become infected."
msgstr "Your bloodstream has developed antibiotic properties.  Your wounds will never become infected."

#: lang/json/mutation_from_json.py
msgid "Mycus Identity"
msgstr "Mycus Identity"

#. ~ Description for Mycus Identity
#: lang/json/mutation_from_json.py
msgid ""
"We have synchronized our local physiology with that of our reproductive "
"systems.  Any spores we may encounter will not attempt to germinate inside "
"the local system."
msgstr "We have synchronized our local physiology with that of our reproductive systems.  Any spores we may encounter will not attempt to germinate inside the local system."

#: lang/json/mutation_from_json.py
msgid "Parasite Immune"
msgstr "Parasite Immune"

#. ~ Description for Parasite Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr "Your body is unusually inhospitable to parasitic lifeforms.  You will never become infested with internal parasites."

#: lang/json/mutation_from_json.py
msgid "Venomous"
msgstr "Venomous"

#. ~ Description for Venomous
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr "Your body produces a potent venom.  Cutting or stabbing attacks from mutations have a chance to poison your target."

#: lang/json/mutation_from_json.py
msgid "Strongly Venomous"
msgstr "Strongly Venomous"

#. ~ Description for Strongly Venomous
#: lang/json/mutation_from_json.py
msgid ""
"Your venom has become particularly strong.  You're confident that your bites"
" or other cutting/stabbing natural attacks will take your target down "
"quickly."
msgstr "Your venom has become particularly strong.  You're confident that your bites or other cutting/stabbing natural attacks will take your target down quickly."

#: lang/json/mutation_from_json.py
msgid "Slime Hands"
msgstr "Slime Hands"

#. ~ Description for Slime Hands
#: lang/json/mutation_from_json.py
msgid ""
"The skin on your hands is a mucous membrane and produces a thick, acrid "
"slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr "The skin on your hands is a mucous membrane and produces a thick, acrid slime.  Attacks using your hand will cause minor acid damage.  Slightly increases wet benefits."

#: lang/json/mutation_from_json.py
msgid "Stretchy Limbs"
msgstr "Stretchy Limbs"

#. ~ Description for Stretchy Limbs
#: lang/json/mutation_from_json.py
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."

#: lang/json/mutation_from_json.py
msgid "Rubbery Limbs"
msgstr "Rubbery Limbs"

#. ~ Description for Rubbery Limbs
#: lang/json/mutation_from_json.py
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr "Your limbs are significantly more flexible than any pathetic human arm or leg.  +3 Dexterity, -2 Strength."

#: lang/json/mutation_from_json.py
msgid "Pseudolimbs"
msgstr "Pseudolimbs"

#. ~ Description for Pseudolimbs
#: lang/json/mutation_from_json.py
msgid ""
"Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."
msgstr "Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."

#: lang/json/mutation_from_json.py
msgid "Compound Eyes"
msgstr "Compound Eyes"

#. ~ Description for Compound Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"perception by 2 so long as you aren't wearing eyewear."
msgstr "Your eyes are compound, like those of an insect.  This increases your perception by 2 so long as you aren't wearing eyewear."

#: lang/json/mutation_from_json.py
msgid "Padded Feet"
msgstr "Padded Feet"

#. ~ Description for Padded Feet
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and even receive a 10% bonus when moving "
"barefoot."
msgstr "The bottoms of your feet are strongly padded.  You receive no movement penalty for not wearing shoes, and even receive a 10% bonus when moving barefoot."

#: lang/json/mutation_from_json.py
msgid "Toe Talons"
msgstr "Toe Talons"

#. ~ Description for Toe Talons
#: lang/json/mutation_from_json.py
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big"
" toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent you from wearing footgear."
msgstr "You have grown large, curved, and wickedly sharp talons in place of your big toes.  Fortunately, they don't get in the way of your movement.  Unfortunately, they do prevent you from wearing footgear."

#: lang/json/mutation_from_json.py
msgid "Hooves"
msgstr "Hooves"

#. ~ Description for Hooves
#: lang/json/mutation_from_json.py
msgid ""
"Your feet have fused into hooves.  This allows kicking attacks to do much "
"more damage, provides natural armor, and removes the need to wear shoes; "
"however, you can not wear shoes of any kind.  Reduces wet effects."
msgstr "Your feet have fused into hooves.  This allows kicking attacks to do much more damage, provides natural armor, and removes the need to wear shoes; however, you can not wear shoes of any kind.  Reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Alcohol Metabolism"
msgstr "Alcohol Metabolism"

#. ~ Description for Alcohol Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed "
"the ability to metabolize alcohol as a food source."
msgstr "So it's fermented?  Whatever, it's still good drinking.  You've developed the ability to metabolize alcohol as a food source."

#: lang/json/mutation_from_json.py
msgid "Subterranean Fortitude"
msgstr "Subterranean Fortitude"

#. ~ Description for Subterranean Fortitude
#: lang/json/mutation_from_json.py
msgid "The aches and pains of living underground don't bother you as much."
msgstr "The aches and pains of living underground don't bother you as much."

#: lang/json/mutation_from_json.py
msgid "Subterranean Build"
msgstr "Subterranean Build"

#. ~ Description for Subterranean Build
#: lang/json/mutation_from_json.py
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading muscle mass for mobility.  (+2 Strength, -2 "
"Dexterity)"
msgstr "Your frame has adapted for life in confined spaces.  You seem a little shorter and bulkier, trading muscle mass for mobility.  (+2 Strength, -2 Dexterity)"

#: lang/json/mutation_from_json.py
msgid "Saprovore"
msgstr "Saprovore"

#. ~ Description for Saprovore
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr "Your digestive system is specialized to allow you to consume decaying material.  You can eat rotten food, albeit for less nutrition than usual."

#: lang/json/mutation_from_json.py
msgid "Saprophage"
msgstr "Saprophage"

#. ~ Description for Saprophage
#: lang/json/mutation_from_json.py
msgid ""
"You prefer to sustain yourself using your roots and direct nutrient "
"extraction/synthesis.  You can still consume 'food', though, if you have to:"
" you merely prefer it aged a little."
msgstr "You prefer to sustain yourself using your roots and direct nutrient extraction/synthesis.  You can still consume 'food', though, if you have to: you merely prefer it aged a little."

#: lang/json/mutation_from_json.py
msgid "Gizzard"
msgstr "Gizzard"

#. ~ Description for Gizzard
#: lang/json/mutation_from_json.py
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr "You seem to get full faster now, and food goes through you more rapidly as well."

#: lang/json/mutation_from_json.py
msgid "Mycus Feeder"
msgstr "Mycus Feeder"

#. ~ Description for Mycus Feeder
#: lang/json/mutation_from_json.py
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us."
msgstr "We have streamlined our nutritional requirements.  We rely on the Mycus for sustenance, as it relies on us."

#: lang/json/mutation_from_json.py
msgid "Ruminant"
msgstr "Ruminant"

#. ~ Description for Ruminant
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is capable of digesting cellulose and other rough "
"plant material.  You can eat underbrush by activating this, standing over "
"your target, and pressing E."
msgstr "Your digestive system is capable of digesting cellulose and other rough plant material.  You can eat underbrush by activating this, standing over your target, and pressing E."

#: lang/json/mutation_from_json.py
msgid "Grazer"
msgstr "Grazer"

#. ~ Description for Grazer
#: lang/json/mutation_from_json.py
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from "
"grass as well as underbrush.  Eat either one by activating this,  standing "
"over your target, and pressing E."
msgstr "You're accustomed to eating plants directly, and can get nutrition from grass as well as underbrush.  Eat either one by activating this,  standing over your target, and pressing E."

#: lang/json/mutation_from_json.py
msgid "Intestinal Fortitude"
msgstr "Intestinal Fortitude"

#. ~ Description for Intestinal Fortitude
#: lang/json/mutation_from_json.py
msgid ""
"Your guts have developed the ability to handle poisonous food.  Mostly."
msgstr "Your guts have developed the ability to handle poisonous food.  Mostly."

#: lang/json/mutation_from_json.py
msgid "Eater Of The Dead"
msgstr "Eater Of The Dead"

#. ~ Description for Eater Of The Dead
#: lang/json/mutation_from_json.py
msgid ""
"Eating rotting, long-dead flesh is good for the struggle, and safe--if still"
" completely unappealing--for you."
msgstr "Eating rotting, long-dead flesh is good for the struggle, and safe--if still completely unappealing--for you."

#: lang/json/mutation_from_json.py
msgid "Burrowing"
msgstr "Burrowing"

#. ~ Description for Burrowing
#: lang/json/mutation_from_json.py
msgid ""
"Between your claws and teeth, you can tunnel through just about anything."
msgstr "Between your claws and teeth, you can tunnel through just about anything."

#: lang/json/mutation_from_json.py
msgid "Saber Teeth"
msgstr "Saber Teeth"

#. ~ Description for Saber Teeth
#: lang/json/mutation_from_json.py
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat...  but leave nasty wounds"
" when you bite."
msgstr "Your fangs have grown extremely large and incredibly sharp.  They make it impossible to wear mouthgear and difficult to eat...  but leave nasty wounds when you bite."

#: lang/json/mutation_from_json.py
msgid "Hyper-Metabolism"
msgstr "Hyper-Metabolism"

#. ~ Description for Hyper-Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You metabolize nutrients so rapidly that you can convert food directly into "
"useful tissue.  Excess nutrition will convert to HP, rather than being "
"wasted."
msgstr "You metabolize nutrients so rapidly that you can convert food directly into useful tissue.  Excess nutrition will convert to HP, rather than being wasted."

#: lang/json/mutation_from_json.py
msgid "Horns"
msgstr "Horns"

#. ~ Description for Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack."
msgstr "You have a pair of small horns on your head.  They allow you to make a weak piercing headbutt attack."

#: lang/json/mutation_from_json.py
msgid "Curled Horns"
msgstr "Curled Horns"

#. ~ Description for Curled Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent you from wearing any "
"headwear."
msgstr "You have a pair of large curled horns, like those of a ram.  They allow you to make a strong bashing headbutt attack, but prevent you from wearing any headwear."

#: lang/json/mutation_from_json.py
msgid "Pointed Horns"
msgstr "Pointed Horns"

#. ~ Description for Pointed Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent you from "
"wearing any headwear the is not made of fabric."
msgstr "You have a pair of long, pointed horns, like those of an antelope.  They allow you to make a strong piercing headbutt attack, but prevent you from wearing any headwear the is not made of fabric."

#: lang/json/mutation_from_json.py
msgid "Antlers"
msgstr "Antlers"

#. ~ Description for Antlers
#: lang/json/mutation_from_json.py
msgid ""
"You have a huge rack of antlers, like those of a moose.  They prevent you "
"from hearing headwear that is not made of fabric, but provide a weak "
"headbutt attack."
msgstr "You have a huge rack of antlers, like those of a moose.  They prevent you from hearing headwear that is not made of fabric, but provide a weak headbutt attack."

#: lang/json/mutation_from_json.py
msgid "Antennae"
msgstr "Antennae"

#. ~ Description for Antennae
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent you from wearing headwear that is not made of fabric."
msgstr "You have a pair of antennae.  They allow you to detect the presence of monsters up to a few tiles away, even if you can't see or hear them, but prevent you from wearing headwear that is not made of fabric."

#: lang/json/mutation_from_json.py
msgid "Road-Runner"
msgstr "Road-Runner"

#. ~ Description for Road-Runner
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat"
" surfaces."
msgstr "Your legs are extremely limber and fast-moving.  You move 30% faster on flat surfaces."

#: lang/json/mutation_from_json.py
msgid "Stubby Tail"
msgstr "Stubby Tail"

#. ~ Description for Stubby Tail
#: lang/json/mutation_from_json.py
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr "You have a short, stubby tail, like a rabbit's.  It serves no purpose."

#: lang/json/mutation_from_json.py
msgid "Tail Fin"
msgstr "Tail Fin"

#. ~ Description for Tail Fin
#: lang/json/mutation_from_json.py
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr "You have a fin-like tail.  It allows you to swim more quickly, but prevents wearing non-fabric pants.  Slightly increases wet benefits."

#: lang/json/mutation_from_json.py
msgid "Long Tail"
msgstr "Long Tail"

#. ~ Description for Long Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-"
"fabric pants."
msgstr "You have a long, graceful tail, like that of a big cat.  It improves your balance, making your ability to dodge higher, but prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Cattle Tail"
msgstr "Cattle Tail"

#. ~ Description for Cattle Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail with a tuft on the end.  You find yourself "
"instinctively swatting away flies with it, though it's not as effective at "
"balancing you as you'd like.  Prevents wearing non-fabric pants."
msgstr "You have a long tail with a tuft on the end.  You find yourself instinctively swatting away flies with it, though it's not as effective at balancing you as you'd like.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Rat Tail"
msgstr "Rat Tail"

#. ~ Description for Rat Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr "You have a long but hairless tail.  It's a pretty effective balancing aid, but does look, uh, ratty.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Thick Tail"
msgstr "Thick Tail"

#. ~ Description for Thick Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but "
"also makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr "You have a long, thick, lizardlike tail.  It helps you balance a bit but also makes a serviceable whip.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Raptor Tail"
msgstr "Raptor Tail"

#. ~ Description for Raptor Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long and semi-stiff lizardlike tail.  You can't effectively lash "
"it in combat, but it significantly improves your balance.  Prevents wearing "
"non-fabric pants."
msgstr "You have a long and semi-stiff lizardlike tail.  You can't effectively lash it in combat, but it significantly improves your balance.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Fluffy Tail"
msgstr "Fluffy Tail"

#. ~ Description for Fluffy Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric "
"pants."
msgstr "You have a long, fluffy-furred tail.  It greatly improves your balance, making your ability to dodge much higher.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Spiked Tail"
msgstr "Spiked Tail"

#. ~ Description for Spiked Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a vicious stinger, like that of a "
"scorpion.  It does not improve your balance at all, but allows for a "
"powerful piercing attack.  Prevents wearing non-fabric pants."
msgstr "You have a long tail that ends in a vicious stinger, like that of a scorpion.  It does not improve your balance at all, but allows for a powerful piercing attack.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Club Tail"
msgstr "Club Tail"

#. ~ Description for Club Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr "You have a long tail that ends in a heavy, bony club.  It does not improve your balance at all, but allows for a powerful bashing attack.  Prevents wearing non-fabric pants."

#: lang/json/mutation_from_json.py
msgid "Hibernation"
msgstr "Hibernation"

#. ~ Description for Hibernation
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr "You've developed the ability to stockpile calories and then sleep for extended periods of time."

#: lang/json/mutation_from_json.py
msgid "Resilient"
msgstr "Resilient"

#. ~ Description for Resilient
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus"
" to all hit points.  Stacks with Tough, etc."
msgstr "You can survive injuries that would incapacitate humans: you get a 20% bonus to all hit points.  Stacks with Tough, etc."

#: lang/json/mutation_from_json.py
msgid "Solidly Built"
msgstr "Solidly Built"

#. ~ Description for Solidly Built
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr "Not much scares you.  You get a 30% bonus to all hit points.  Stacks with Tough, etc."

#: lang/json/mutation_from_json.py
msgid "TAAANK"
msgstr "TAAANK"

#. ~ Description for TAAANK
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr "You can simply take the punishment from lesser beings and keep going.  You get a 40% bonus to all hit points.  Stacks with Tough, etc."

#: lang/json/mutation_from_json.py
msgid "Pain Recovery"
msgstr "Pain Recovery"

#. ~ Description for Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain slightly faster than normal."
msgstr "You recover from pain slightly faster than normal."

#: lang/json/mutation_from_json.py
msgid "Quick Pain Recovery"
msgstr "Quick Pain Recovery"

#. ~ Description for Quick Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain faster than normal."
msgstr "You recover from pain faster than normal."

#: lang/json/mutation_from_json.py
msgid "Very Quick Pain Recovery"
msgstr "Very Quick Pain Recovery"

#. ~ Description for Very Quick Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain much faster than normal."
msgstr "You recover from pain much faster than normal."

#: lang/json/mutation_from_json.py
msgid "Pain Junkie"
msgstr "Pain Junkie"

#. ~ Description for Pain Junkie
#: lang/json/mutation_from_json.py
msgid ""
"You've developed a serious appetite for pain, and take pride in your scars."
msgstr "You've developed a serious appetite for pain, and take pride in your scars."

#: lang/json/mutation_from_json.py
msgid "Cenobite"
msgstr "Cenobite"

#. ~ Description for Cenobite
#: lang/json/mutation_from_json.py
msgid "You positively adore pain, in all its varied forms."
msgstr "You positively adore pain, in all its varied forms."

#: lang/json/mutation_from_json.py
msgid "Deadened"
msgstr "Deadened"

#. ~ Description for Deadened
#: lang/json/mutation_from_json.py
msgid ""
"Nothing hurts any more.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr "Nothing hurts any more.  Those bites tickle and the wounds itch a bit, but that's it."

#: lang/json/mutation_from_json.py
msgid "Culler"
msgstr "Culler"

#. ~ Description for Culler
#: lang/json/mutation_from_json.py
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die"
" anyway, you preserve resources for those better able to survive.  You are "
"less bothered by death of others: their own weakness invited these fates "
"upon them."
msgstr "You've had a revelation: by killing the weaker creatures, who would only die anyway, you preserve resources for those better able to survive.  You are less bothered by death of others: their own weakness invited these fates upon them."

#: lang/json/mutation_from_json.py lang/json/npc_class_from_json.py
msgid "Hunter"
msgstr "Hunter"

#. ~ Description for Hunter
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has a lot more in common with predatory animal than a human, "
"making it easer to control misplaced reactions to death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easer to learn and "
"maintain."
msgstr "Your brain has a lot more in common with predatory animal than a human, making it easer to control misplaced reactions to death of your prey.  Additionally, combat skills, which you use to hunt, are easer to learn and maintain."

#: lang/json/mutation_from_json.py
msgid "Predator"
msgstr "Predator"

#. ~ Description for Predator
#: lang/json/mutation_from_json.py
msgid ""
"You consider yourself something other than human and no longer empathise "
"with them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr "You consider yourself something other than human and no longer empathise with them.  Combat skills are easy to learn and maintain, but your critical thinking, so characteristic to these creatures, suffers."

#: lang/json/mutation_from_json.py
msgid "Apex Predator"
msgstr "Apex Predator"

#. ~ Description for Apex Predator
#: lang/json/mutation_from_json.py
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top the food chain.  You can effortlessly master and maintain combat skills,"
" but your critical thinking has atrophied further."
msgstr "Your mind and brain have adapted to your new place in the world: as one on top the food chain.  You can effortlessly master and maintain combat skills, but your critical thinking has atrophied further."

#: lang/json/mutation_from_json.py
msgid "Sapiovore"
msgstr "Sapiovore"

#. ~ Description for Sapiovore
#: lang/json/mutation_from_json.py
msgid "The hairless apes are as good eating as any other meat."
msgstr "The hairless apes are as good eating as any other meat."

#: lang/json/mutation_from_json.py
msgid "Mycus Defender"
msgstr "Mycus Defender"

#. ~ Description for Mycus Defender
#: lang/json/mutation_from_json.py
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this "
"task."
msgstr "From time to time the Mycus requires protection from non-Mycus that, for whatever reason, wish it ill.  We have adapted to better carry out this task."

#: lang/json/mutation_from_json.py
msgid "Bird Wings"
msgstr "Bird Wings"

#. ~ Description for Bird Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, feathered wings.  Your body is too heavy to be "
"able to fly, but you can use them to slow your descent during a fall, and "
"will not take falling damage under any circumstances."
msgstr "You have a pair of large, feathered wings.  Your body is too heavy to be able to fly, but you can use them to slow your descent during a fall, and will not take falling damage under any circumstances."

#: lang/json/mutation_from_json.py
msgid "Insect Wings"
msgstr "Insect Wings"

#. ~ Description for Insect Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, translucent wings.  They are too small to lift "
"you, but are powerful enough to greatly speed your movement, with some "
"effort and noise."
msgstr "You have a pair of large, translucent wings.  They are too small to lift you, but are powerful enough to greatly speed your movement, with some effort and noise."

#: lang/json/mutation_from_json.py
msgid "Mouth Tentacles"
msgstr "Mouth Tentacles"

#. ~ Description for Mouth Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr "A set of tentacles surrounds your mouth.  They allow you to eat twice as fast.  Slightly decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Mandibles"
msgstr "Mandibles"

#. ~ Description for Mandibles
#: lang/json/mutation_from_json.py
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you"
" to eat faster and provide a slicing unarmed attack, but prevent you from "
"wearing mouthwear.  Slightly reduces wet effects."
msgstr "A set of insect-like mandibles have grown around your mouth.  They allow you to eat faster and provide a slicing unarmed attack, but prevent you from wearing mouthwear.  Slightly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Folding Fangs"
msgstr "Folding Fangs"

#. ~ Description for Folding Fangs
#: lang/json/mutation_from_json.py
msgid ""
"Your mandibles have developed extensible fangs, allowing you to bite quickly"
" or ensure your venom goes home, as desired.  Activate to extend or retract "
"your fangs."
msgstr "Your mandibles have developed extensible fangs, allowing you to bite quickly or ensure your venom goes home, as desired.  Activate to extend or retract your fangs."

#: lang/json/mutation_from_json.py
msgid "Canine Ears"
msgstr "Canine Ears"

#. ~ Description for Canine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed ones, like those of a canine.  "
"They enhance your hearing, allowing you to hear at greater distances."
msgstr "Your ears have extended into long, pointed ones, like those of a canine.  They enhance your hearing, allowing you to hear at greater distances."

#: lang/json/mutation_from_json.py
msgid "Lupine Ears"
msgstr "Lupine Ears"

#. ~ Description for Lupine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing has evolved further and is now on par with wolves.  You can "
"hear things significantly farther away."
msgstr "Your hearing has evolved further and is now on par with wolves.  You can hear things significantly farther away."

#: lang/json/mutation_from_json.py
msgid "Feline Ears"
msgstr "Feline Ears"

#. ~ Description for Feline Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr "Your ears have extended into long, pointed, velvety ones, like those of a feline.  You find it easier to tune in on sounds from afar."

#: lang/json/mutation_from_json.py
msgid "Ursine Ears"
msgstr "Ursine Ears"

#. ~ Description for Ursine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can"
" hear things a little farther away."
msgstr "Your ears have grown longer and rounder, much like those of a bear.  You can hear things a little farther away."

#: lang/json/mutation_from_json.py
msgid "Pointed Ears"
msgstr "Pointed Ears"

#. ~ Description for Pointed Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr "Your upper earlobes have grown noticeably higher.  Fortunately, they don't get in the way of your headgear, much.  Unfortunately, they also don't seem to help your hearing any."

#: lang/json/mutation_from_json.py
msgid "Web Walker"
msgstr "Web Walker"

#. ~ Description for Web Walker
#: lang/json/mutation_from_json.py
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr "Your body excretes very fine amounts of a chemical which prevents you from sticking to webs.  Walking through webs does not affect you at all."

#: lang/json/mutation_from_json.py
msgid "Web Spinner"
msgstr "Web Spinner"

#. ~ Description for Web Spinner
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr "Your body produces and anchors webbing.  Too bad you can't seem to control the process.  There is a chance that you will leave webs in your wake."

#: lang/json/mutation_from_json.py
msgid "Web Weaver"
msgstr "Web Weaver"

#. ~ Description for Web Weaver
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the necessary anatomy and techniques to control your web-"
"generation.  Activate this to start or stop weaving webs."
msgstr "You've developed the necessary anatomy and techniques to control your web-generation.  Activate this to start or stop weaving webs."

#: lang/json/mutation_from_json.py
msgid "Web Diver"
msgstr "Web Diver"

#. ~ Description for Web Diver
#: lang/json/mutation_from_json.py
msgid ""
"Your webbing is easily strong enough to support your weight.  You'll use it "
"to descend down any sheer drops you may encounter."
msgstr "Your webbing is easily strong enough to support your weight.  You'll use it to descend down any sheer drops you may encounter."

#: lang/json/mutation_from_json.py
msgid "Rope Webs"
msgstr "Rope Webs"

#. ~ Description for Rope Webs
#: lang/json/mutation_from_json.py
msgid ""
"With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr "With spinnerets like THESE, who needs rope?!  Activate to produce rope."

#: lang/json/mutation_from_json.py
msgid "Whiskers"
msgstr "Whiskers"

#. ~ Description for Whiskers
#: lang/json/mutation_from_json.py
msgid ""
"You have a handsome set of feline whiskers around your mouth.  These make "
"you more aware of vibrations in the air, and improve your ability to dodge "
"very slightly."
msgstr "You have a handsome set of feline whiskers around your mouth.  These make you more aware of vibrations in the air, and improve your ability to dodge very slightly."

#: lang/json/mutation_from_json.py
msgid "Wiry Whiskers"
msgstr "Wiry Whiskers"

#. ~ Description for Wiry Whiskers
#: lang/json/mutation_from_json.py
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr "You have a set of prominent rodent-like whiskers around your mouth.  These make you more aware of vibrations in the air, and improve your ability to dodge slightly."

#: lang/json/mutation_from_json.py
msgid "Fat Deposits"
msgstr "Fat Deposits"

#. ~ Description for Fat Deposits
#: lang/json/mutation_from_json.py
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr "You've put on some additional weight around your body.  It slows you down a little, but helps your swimming and warmth."

#: lang/json/mutation_from_json.py
msgid "Inconveniently Large"
msgstr "Inconveniently Large"

#. ~ Description for Inconveniently Large
#: lang/json/mutation_from_json.py
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr "You have grown noticeably taller and broader.  Much of it is useful muscle mass (Strength +2), but you find it throws off your balance and you get in your own way (+10 torso and arm encumbrance)."

#: lang/json/mutation_from_json.py
msgid "Large"
msgstr "Large"

#. ~ Description for Large
#: lang/json/mutation_from_json.py
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr "You carry your rugged body with the dignity you deserve.  Strength +2."

#: lang/json/mutation_from_json.py
msgid "Freakishly Huge"
msgstr "Freakishly Huge"

#. ~ Description for Freakishly Huge
#: lang/json/mutation_from_json.py
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit"
" into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr "You have grown even more massive, to the point where you cannot usefully fit into human-sized clothing or vehicles.  Much of it is powerful muscle mass (Strength +4), but it's a real pain to haul around."

#: lang/json/mutation_from_json.py
msgid "Huge"
msgstr "Huge"

#. ~ Description for Huge
#: lang/json/mutation_from_json.py
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who"
" needs pathetic human cars?  Strength +4."
msgstr "Your cardiovascular system has caught up with your muscular physique, so who needs pathetic human cars?  Strength +4."

#: lang/json/mutation_from_json.py
msgid "Strong"
msgstr "Strong"

#. ~ Description for Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are a little stronger.  Strength + 1"
msgstr "Your muscles are a little stronger.  Strength + 1"

#: lang/json/mutation_from_json.py
msgid "Very Strong"
msgstr "Very Strong"

#. ~ Description for Very Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are stronger.  Strength + 2"
msgstr "Your muscles are stronger.  Strength + 2"

#: lang/json/mutation_from_json.py
msgid "Extremely Strong"
msgstr "Extremely Strong"

#. ~ Description for Extremely Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are much stronger.  Strength + 4"
msgstr "Your muscles are much stronger.  Strength + 4"

#: lang/json/mutation_from_json.py
msgid "Insanely Strong"
msgstr "Insanely Strong"

#. ~ Description for Insanely Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are noticeably bulging.  Strength + 7"
msgstr "Your muscles are noticeably bulging.  Strength + 7"

#: lang/json/mutation_from_json.py
msgid "Prime Strength"
msgstr "Prime Strength"

#. ~ Description for Prime Strength
#: lang/json/mutation_from_json.py
msgid "Your muscles are perfectly developed."
msgstr "Your muscles are perfectly developed."

#: lang/json/mutation_from_json.py
msgid "Dextrous"
msgstr "Dextrous"

#. ~ Description for Dextrous
#: lang/json/mutation_from_json.py
msgid "You are a little nimbler.  Dexterity + 1"
msgstr "You are a little nimbler.  Dexterity + 1"

#: lang/json/mutation_from_json.py
msgid "Very Dextrous"
msgstr "Very Dextrous"

#. ~ Description for Very Dextrous
#: lang/json/mutation_from_json.py
msgid "You are nimbler.  Dexterity + 2"
msgstr "You are nimbler.  Dexterity + 2"

#: lang/json/mutation_from_json.py
msgid "Extremely Dextrous"
msgstr "Extremely Dextrous"

#. ~ Description for Extremely Dextrous
#: lang/json/mutation_from_json.py
msgid "You are nimble and quick.  Dexterity + 4"
msgstr "You are nimble and quick.  Dexterity + 4"

#: lang/json/mutation_from_json.py
msgid "Insanely Dextrous"
msgstr "Insanely Dextrous"

#. ~ Description for Insanely Dextrous
#: lang/json/mutation_from_json.py
msgid "You are much nimbler than before.  Dexterity + 7"
msgstr "You are much nimbler than before.  Dexterity + 7"

#: lang/json/mutation_from_json.py
msgid "Prime Dexterity"
msgstr "Prime Dexterity"

#. ~ Description for Prime Dexterity
#: lang/json/mutation_from_json.py
msgid "You're perfectly coordinated."
msgstr "You're perfectly coordinated."

#: lang/json/mutation_from_json.py
msgid "Smart"
msgstr "Smart"

#. ~ Description for Smart
#: lang/json/mutation_from_json.py
msgid "You are a little smarter.  Intelligence + 1"
msgstr "You are a little smarter.  Intelligence + 1"

#: lang/json/mutation_from_json.py
msgid "Very Smart"
msgstr "Very Smart"

#. ~ Description for Very Smart
#: lang/json/mutation_from_json.py
msgid "You are smarter.  Intelligence + 2"
msgstr "You are smarter.  Intelligence + 2"

#: lang/json/mutation_from_json.py
msgid "Extremely Smart"
msgstr "Extremely Smart"

#. ~ Description for Extremely Smart
#: lang/json/mutation_from_json.py
msgid ""
"You are much smarter, and your skull bulges slightly.  Intelligence + 4"
msgstr "You are much smarter, and your skull bulges slightly.  Intelligence + 4"

#: lang/json/mutation_from_json.py
msgid "Insanely Smart"
msgstr "Insanely Smart"

#. ~ Description for Insanely Smart
#: lang/json/mutation_from_json.py
msgid ""
"Your skull bulges noticeably with your impressive brain.  Intelligence + 7"
msgstr "Your skull bulges noticeably with your impressive brain.  Intelligence + 7"

#: lang/json/mutation_from_json.py
msgid "Prime Intelligence"
msgstr "Prime Intelligence"

#. ~ Description for Prime Intelligence
#: lang/json/mutation_from_json.py
msgid ""
"You understand almost everything about which you think, with minimal effort."
msgstr "You understand almost everything about which you think, with minimal effort."

#: lang/json/mutation_from_json.py
msgid "Distributed Neurology"
msgstr "Distributed Neurology"

#. ~ Description for Distributed Neurology
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr "Your brain has evolved beyond human imagination.  You'll show them the REAL meaning of 'gray goo'!"

#: lang/json/mutation_from_json.py
msgid "Perceptive"
msgstr "Perceptive"

#. ~ Description for Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are a little keener.  Perception + 1"
msgstr "Your senses are a little keener.  Perception + 1"

#: lang/json/mutation_from_json.py
msgid "Very Perceptive"
msgstr "Very Perceptive"

#. ~ Description for Very Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are keener.  Perception + 2"
msgstr "Your senses are keener.  Perception + 2"

#: lang/json/mutation_from_json.py
msgid "Extremely Perceptive"
msgstr "Extremely Perceptive"

#. ~ Description for Extremely Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are much keener.  Perception + 4"
msgstr "Your senses are much keener.  Perception + 4"

#: lang/json/mutation_from_json.py
msgid "Insanely Perceptive"
msgstr "Insanely Perceptive"

#. ~ Description for Insanely Perceptive
#: lang/json/mutation_from_json.py
msgid "You can sense things you never imagined.  Perception + 7"
msgstr "You can sense things you never imagined.  Perception + 7"

#: lang/json/mutation_from_json.py
msgid "Prime Perception"
msgstr "Prime Perception"

#. ~ Description for Prime Perception
#: lang/json/mutation_from_json.py
msgid "Your senses are keenly honed."
msgstr "Your senses are keenly honed."

#: lang/json/mutation_from_json.py
msgid "Sensory Disintegration"
msgstr "Sensory Disintegration"

#. ~ Description for Sensory Disintegration
#: lang/json/mutation_from_json.py
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr "Your sense organs are all over the place: eyes extending and retracting, 'ears' of various shapes migrating about, and taste & smell are uncontrollable.  The world is a horrible mixup.  Ugh!"

#: lang/json/mutation_from_json.py
msgid "Distributed Senses"
msgstr "Distributed Senses"

#. ~ Description for Distributed Senses
#: lang/json/mutation_from_json.py
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr "You can now extend and reabsorb sensory organs at will, and can therefore ignore most shocks that would overwhelm lesser beings."

#: lang/json/mutation_from_json.py
msgid "Metallassomaiphile"
msgstr "Metallassomaiphile"

#. ~ Description for Metallassomaiphile
#: lang/json/mutation_from_json.py
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr "Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes you thirsty.  And you so love your new parts.  You simply must have more mutagen!"

#: lang/json/mutation_from_json.py
msgid "Head Bumps"
msgstr "Head Bumps"

#. ~ Description for Head Bumps
#: lang/json/mutation_from_json.py
msgid "You have a pair of bumps on your skull."
msgstr "You have a pair of bumps on your skull."

#: lang/json/mutation_from_json.py
msgid "Slit Nostrils"
msgstr "Slit Nostrils"

#. ~ Description for Slit Nostrils
#: lang/json/mutation_from_json.py
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a lizard-"
"like appearance.  This makes breathing slightly difficult and increases "
"mouth encumbrance by 10."
msgstr "You have a flattened nose and thin slits for nostrils, giving you a lizard-like appearance.  This makes breathing slightly difficult and increases mouth encumbrance by 10."

#: lang/json/mutation_from_json.py
msgid "Forked Tongue"
msgstr "Forked Tongue"

#. ~ Description for Forked Tongue
#: lang/json/mutation_from_json.py
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr "Your tongue is forked, like that of a reptile.  This has no effect."

#: lang/json/mutation_from_json.py
msgid "Bulging Eyes"
msgstr "Bulging Eyes"

#. ~ Description for Bulging Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr "Your eyes bulge out several inches from your skull.  This does not affect your vision in any way."

#: lang/json/mutation_from_json.py
msgid "Mouth Flaps"
msgstr "Mouth Flaps"

#. ~ Description for Mouth Flaps
#: lang/json/mutation_from_json.py
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your"
" eating, but are unpleasant to look at."
msgstr "Skin tabs and odd flaps of skin surround your mouth.  They don't affect your eating, but are unpleasant to look at."

#: lang/json/mutation_from_json.py
msgid "Wing Stubs"
msgstr "Wing Stubs"

#. ~ Description for Wing Stubs
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades."
"  They can be wiggled at will, but are useless."
msgstr "You have a pair of stubby little wings projecting from your shoulderblades.  They can be wiggled at will, but are useless."

#: lang/json/mutation_from_json.py
msgid "Bat Wings"
msgstr "Bat Wings"

#. ~ Description for Bat Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, leathery wings.  You can move them a little, but "
"they are useless, and in fact put you off balance, reducing your ability to "
"dodge slightly."
msgstr "You have a pair of large, leathery wings.  You can move them a little, but they are useless, and in fact put you off balance, reducing your ability to dodge slightly."

#: lang/json/mutation_from_json.py
msgid "Butterfly Wings"
msgstr "Butterfly Wings"

#. ~ Description for Butterfly Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a very large and very beautiful pair of brightly-colored wings.  "
"They can't lift you, and they make balancing tricky, but they certainly "
"catch air and attention!"
msgstr "You have a very large and very beautiful pair of brightly-colored wings.  They can't lift you, and they make balancing tricky, but they certainly catch air and attention!"

#: lang/json/mutation_from_json.py
msgid "Pale Skin"
msgstr "Pale Skin"

#. ~ Description for Pale Skin
#: lang/json/mutation_from_json.py
msgid "Your skin is rather pale."
msgstr "Your skin is rather pale."

#: lang/json/mutation_from_json.py
msgid "Spots"
msgstr "Spots"

#. ~ Description for Spots
#: lang/json/mutation_from_json.py
msgid "Your skin is covered in a pattern of red spots."
msgstr "Your skin is covered in a pattern of red spots."

#: lang/json/mutation_from_json.py
msgid "Smelly"
msgstr "Smelly"

#. ~ Description for Smelly
#: lang/json/mutation_from_json.py
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr "You smell awful.  Monsters that track scent will find you very easily, and humans will react poorly."

#: lang/json/mutation_from_json.py
msgid "Deformed"
msgstr "Deformed"

#. ~ Description for Deformed
#: lang/json/mutation_from_json.py
msgid ""
"You're minorly deformed.  Some people will react badly to your appearance."
msgstr "You're minorly deformed.  Some people will react badly to your appearance."

#: lang/json/mutation_from_json.py
msgid "Badly Deformed"
msgstr "Badly Deformed"

#. ~ Description for Badly Deformed
#: lang/json/mutation_from_json.py
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction"
" to your appearance."
msgstr "You're hideously deformed.  Some people will have a strong negative reaction to your appearance."

#: lang/json/mutation_from_json.py src/artifact.cpp
msgid "Grotesque"
msgstr "Grotesque"

#. ~ Description for Grotesque
#: lang/json/mutation_from_json.py
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr "Your visage is disgusting and liable to induce vomiting.  People will not want to interact with you unless they have a very good reason to."

#: lang/json/mutation_from_json.py
msgid "Beautiful"
msgstr "Beautiful"

#. ~ Description for Beautiful
#: lang/json/mutation_from_json.py
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr "You're a real head-turner.  Some people will react well to your appearance, and most people have an easier time trusting you."

#: lang/json/mutation_from_json.py
msgid "Very Beautiful"
msgstr "Very Beautiful"

#. ~ Description for Very Beautiful
#: lang/json/mutation_from_json.py
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks,"
" and most people will trust you immediately."
msgstr "You are a vision of beauty.  Some people will react very well to your looks, and most people will trust you immediately."

#: lang/json/mutation_from_json.py
msgid "Glorious"
msgstr "Glorious"

#. ~ Description for Glorious
#: lang/json/mutation_from_json.py
msgid ""
"You are incredibly beautiful.  People cannot help themselves for your "
"charms, and will do whatever they can to please you."
msgstr "You are incredibly beautiful.  People cannot help themselves for your charms, and will do whatever they can to please you."

#: lang/json/mutation_from_json.py
msgid "Snout"
msgstr "Snout"

#. ~ Description for Snout
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have begun...changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr "Your face and jaw have begun...changing.  Masks and such fit OK, but you're noticeably mutated."

#: lang/json/mutation_from_json.py
msgid "Bovine Snout"
msgstr "Bovine Snout"

#. ~ Description for Bovine Snout
#: lang/json/mutation_from_json.py
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but prevents you from wearing mouthgear."
msgstr "Your face resembles that of a bull, with a significant snout.  It looks fearsome but prevents you from wearing mouthgear."

#: lang/json/mutation_from_json.py
msgid "Lupine Muzzle"
msgstr "Lupine Muzzle"

#. ~ Description for Lupine Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents you from wearing "
"mouthgear."
msgstr "Your jaw and nose have extended into a wolfish muzzle.  It lends itself to biting in combat and looks impressive, but prevents you from wearing mouthgear."

#: lang/json/mutation_from_json.py
msgid "Ursine Muzzle"
msgstr "Ursine Muzzle"

#. ~ Description for Ursine Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents you from wearing mouthgear."
msgstr "Your jaw and nose have extended into a bearish muzzle.  You could bite with it, and it looks impressive, but it prevents you from wearing mouthgear."

#: lang/json/mutation_from_json.py
msgid "Ratlike Muzzle"
msgstr "Ratlike Muzzle"

#. ~ Description for Ratlike Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have extended, giving you an alert and attentive "
"appearance."
msgstr "Your face and jaw have extended, giving you an alert and attentive appearance."

#: lang/json/mutation_from_json.py
msgid "Reptilian Muzzle"
msgstr "Reptilian Muzzle"

#. ~ Description for Reptilian Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They"
" look NASTY-as do the bite wounds they can inflict-but prevent you from "
"wearing mouthgear."
msgstr "Your face and jaws are a shorter version of those found on alligators.  They look NASTY-as do the bite wounds they can inflict-but prevent you from wearing mouthgear."

#: lang/json/mutation_from_json.py
msgid "Proboscis"
msgstr "Proboscis"

#. ~ Description for Proboscis
#: lang/json/mutation_from_json.py
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr "You've gotten rid of that terribly imprecise mouth and now imbibe your food like a proper person.  Chewing was tiresome anyway."

#: lang/json/mutation_from_json.py
msgid "Hollow Bones"
msgstr "Hollow Bones"

#. ~ Description for Hollow Bones
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also"
" frail; you can carry 40% less, and bashing attacks injure you more."
msgstr "You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is very light as a result, enabling you to move and attack 20% faster, but also frail; you can carry 40% less, and bashing attacks injure you more."

#. ~ Description for Nausea
#: lang/json/mutation_from_json.py
msgid ""
"You feel nauseous almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr "You feel nauseous almost constantly, and are more liable to throw up from food poisoning, alcohol, etc.  You can, if desired, think yourself into vomiting, too."

#: lang/json/mutation_from_json.py
msgid "Vomitous"
msgstr "Vomitous"

#. ~ Description for Vomitous
#: lang/json/mutation_from_json.py
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand,"
" too."
msgstr "You have a major digestive disorder.  Though it causes you to vomit frequently, you have found that you can trigger your vomit reflex on demand, too."

#: lang/json/mutation_from_json.py
msgid "Fast Metabolism"
msgstr "Fast Metabolism"

#. ~ Description for Fast Metabolism
#: lang/json/mutation_from_json.py
msgid "You require more food than most people."
msgstr "You require more food than most people."

#: lang/json/mutation_from_json.py
msgid "Rapid Metabolism"
msgstr "Rapid Metabolism"

#. ~ Description for Rapid Metabolism
#: lang/json/mutation_from_json.py
msgid "You require more resources than most, but heal more rapidly as well."
msgstr "You require more resources than most, but heal more rapidly as well."

#: lang/json/mutation_from_json.py
msgid "Very Fast Metabolism"
msgstr "Very Fast Metabolism"

#. ~ Description for Very Fast Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You find yourself hungry.  A lot.  You need about twice as much food as the "
"average human."
msgstr "You find yourself hungry.  A lot.  You need about twice as much food as the average human."

#: lang/json/mutation_from_json.py
msgid "Extreme Metabolism"
msgstr "Extreme Metabolism"

#. ~ Description for Extreme Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You burn calories like gasoline-soaked tinder.  You consume three times as "
"much food as the average human."
msgstr "You burn calories like gasoline-soaked tinder.  You consume three times as much food as the average human."

#: lang/json/mutation_from_json.py
msgid "High Thirst"
msgstr "High Thirst"

#. ~ Description for High Thirst
#: lang/json/mutation_from_json.py
msgid "Your body dries out easily; you need to drink more water."
msgstr "Your body dries out easily; you need to drink more water."

#: lang/json/mutation_from_json.py
msgid "Very Thirsty"
msgstr "Very Thirsty"

#. ~ Description for Very Thirsty
#: lang/json/mutation_from_json.py
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr "Ugh, out of water already?  You need about twice the fluids of an average human."

#: lang/json/mutation_from_json.py
msgid "Extremely Thirsty"
msgstr "Extremely Thirsty"

#. ~ Description for Extremely Thirsty
#: lang/json/mutation_from_json.py
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr "You dry out seriously quickly, requiring three times as much liquid to stay hydrated."

#: lang/json/mutation_from_json.py
msgid "Very Heavy Sleeper"
msgstr "Very Heavy Sleeper"

#. ~ Description for Very Heavy Sleeper
#: lang/json/mutation_from_json.py
msgid "You could probably sleep through a firefight."
msgstr "You could probably sleep through a firefight."

#: lang/json/mutation_from_json.py
msgid "Very Sleepy"
msgstr "Very Sleepy"

#. ~ Description for Very Sleepy
#: lang/json/mutation_from_json.py
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half "
"your time in or around bed."
msgstr "You find yourself needing to sleep quite often.  You'll spend about half your time in or around bed."

#: lang/json/mutation_from_json.py
msgid "Weakening"
msgstr "Weakening"

#. ~ Description for Weakening
#: lang/json/mutation_from_json.py
msgid ""
"You feel as though you are slowly weakening, but it's so slight a feeling "
"that it does not affect you at all."
msgstr "You feel as though you are slowly weakening, but it's so slight a feeling that it does not affect you at all."

#: lang/json/mutation_from_json.py
msgid "Deterioration"
msgstr "Deterioration"

#. ~ Description for Deterioration
#: lang/json/mutation_from_json.py
msgid "Your body is very slowly wasting away."
msgstr "Your body is very slowly wasting away."

#: lang/json/mutation_from_json.py
msgid "Disintegration"
msgstr "Disintegration"

#. ~ Description for Disintegration
#: lang/json/mutation_from_json.py
msgid "Your body is slowly wasting away!"
msgstr "Your body is slowly wasting away!"

#: lang/json/mutation_from_json.py
msgid "Solar Sensitivity"
msgstr "Solar Sensitivity"

#. ~ Description for Solar Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr "Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It will seriously burn you."

#: lang/json/mutation_from_json.py
msgid "Sores"
msgstr "Sores"

#. ~ Description for Sores
#: lang/json/mutation_from_json.py
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr "Your extremities are covered in painful sores.  The pain is worse when they are covered in clothing."

#: lang/json/mutation_from_json.py
msgid "Light Sensitive"
msgstr "Light Sensitive"

#. ~ Description for Light Sensitive
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr "Sunlight makes you uncomfortable.  If you are outdoors and the weather is Sunny, you suffer -1 to all stats."

#: lang/json/mutation_from_json.py
msgid "Very Light Sensitive"
msgstr "Very Light Sensitive"

#. ~ Description for Very Light Sensitive
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr "Sunlight makes you very uncomfortable.  If you are outdoors during the day, you suffer -1 to all stats; -2 if the weather is Sunny."

#. ~ Description for Troglobite
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr "Sunlight makes you extremely uncomfortable, resulting in large penalties to all stats."

#: lang/json/mutation_from_json.py
msgid "Webbed Hands"
msgstr "Webbed Hands"

#. ~ Description for Webbed Hands
#: lang/json/mutation_from_json.py
msgid ""
"Your hands and feet are heavily webbed, reducing your dexterity by 1 and "
"causing problems with gloves.  However, you can swim much faster.  Slightly "
"decreases wet penalties."
msgstr "Your hands and feet are heavily webbed, reducing your dexterity by 1 and causing problems with gloves.  However, you can swim much faster.  Slightly decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Paws"
msgstr "Paws"

#. ~ Description for Paws
#: lang/json/mutation_from_json.py
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better."
msgstr "Your hands have fused into quasi-paws.  Fine manipulation is a challenge: permanent hand encumbrance of 10, difficulty with delicate craftwork, and your gloves don't fit.  But they handle water better."

#: lang/json/mutation_from_json.py
msgid "Broad Paws"
msgstr "Broad Paws"

#. ~ Description for Broad Paws
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are much larger now.  Manual dexterity is is difficult: permanent "
"hand encumbrance of 20, serious problems crafting, and no gloves.  But you "
"can swim more effectively."
msgstr "Your paws are much larger now.  Manual dexterity is is difficult: permanent hand encumbrance of 20, serious problems crafting, and no gloves.  But you can swim more effectively."

#: lang/json/mutation_from_json.py
msgid "Beak"
msgstr "Beak"

#. ~ Description for Beak
#: lang/json/mutation_from_json.py
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr "You have a beak for a mouth.  You can occasionally use it to peck at your enemies, but it is impossible for you to wear mouth gear.  Slightly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Woodpecker Beak"
msgstr "Woodpecker Beak"

#. ~ Description for Woodpecker Beak
#: lang/json/mutation_from_json.py
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr "Pecking at prey is part of your daily routine now.  Slightly reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Hummingbird Beak"
msgstr "Hummingbird Beak"

#. ~ Description for Hummingbird Beak
#: lang/json/mutation_from_json.py
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr "Though your beak's not suitable for pecking, those flowers out there are a good source of energy.  Examine them to feed."

#: lang/json/mutation_from_json.py
msgid "Genetically Unstable"
msgstr "Genetically Unstable"

#. ~ Description for Genetically Unstable
#: lang/json/mutation_from_json.py
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr "Your DNA has been damaged in a way that causes you to continually develop more mutations."

#: lang/json/mutation_from_json.py
msgid "Genetic Chaos"
msgstr "Genetic Chaos"

#. ~ Description for Genetic Chaos
#: lang/json/mutation_from_json.py
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr "Your body alters itself rapidly, and without your intervention or conscious control."

#: lang/json/mutation_from_json.py
msgid "Minor Radioactivity"
msgstr "Minor Radioactivity"

#. ~ Description for Minor Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr "Your body has become radioactive!  You continuously emit low levels of radiation, which slowly contaminates the world around you."

#: lang/json/mutation_from_json.py
msgid "Radioactivity"
msgstr "Radioactivity"

#. ~ Description for Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr "Your body has become radioactive!  You continuously emit moderate levels of radiation, which contaminates the world around you."

#: lang/json/mutation_from_json.py
msgid "Severe Radioactivity"
msgstr "Severe Radioactivity"

#. ~ Description for Severe Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr "Your body has become radioactive!  You continuously emit heavy levels of radiation, making your surroundings unlivable."

#: lang/json/mutation_from_json.py
msgid "Slimy"
msgstr "Slimy"

#. ~ Description for Slimy
#: lang/json/mutation_from_json.py
msgid ""
"Your body is coated with a fine slime.  Protects from long term effects of "
"acid, though not short term ones.  Greatly increases wet benefits."
msgstr "Your body is coated with a fine slime.  Protects from long term effects of acid, though not short term ones.  Greatly increases wet benefits."

#: lang/json/mutation_from_json.py
msgid "Viscous"
msgstr "Viscous"

#. ~ Description for Viscous
#: lang/json/mutation_from_json.py
msgid ""
"Your body's slime output has become sticky and gel-like.  Protects from acid"
" somewhat.  Greatly increases wet benefits."
msgstr "Your body's slime output has become sticky and gel-like.  Protects from acid somewhat.  Greatly increases wet benefits."

#: lang/json/mutation_from_json.py
msgid "Amorphous Body"
msgstr "Amorphous Body"

#. ~ Description for Amorphous Body
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem "
"to be moving around, and your leg-equivalents flow comfortably."
msgstr "Your flesh is a pleasing gel-like consistency.  Your bodily functions seem to be moving around, and your leg-equivalents flow comfortably."

#: lang/json/mutation_from_json.py
msgid "Omnicellular"
msgstr "Omnicellular"

#. ~ Description for Omnicellular
#: lang/json/mutation_from_json.py
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr "Your body is more or less one consistent whole: a single, giant, omni-cell that alters itself as needed."

#: lang/json/mutation_from_json.py
msgid "Herbivore"
msgstr "Herbivore"

#. ~ Description for Herbivore
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr "Your body's ability to digest meat is severely hampered.  Eating meat has a good chance of making you vomit it back up; even if you manage to keep it down, its nutritional value is greatly reduced."

#: lang/json/mutation_from_json.py
msgid "Carnivore"
msgstr "Carnivore"

#. ~ Description for Carnivore
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest fruits, vegetables and grains is severely "
"hampered.  You cannot eat anything besides meat."
msgstr "Your body's ability to digest fruits, vegetables and grains is severely hampered.  You cannot eat anything besides meat."

#: lang/json/mutation_from_json.py
msgid "Ponderous"
msgstr "Ponderous"

#. ~ Description for Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr "Your muscles are generally slow to move.  You move 10% slower."

#: lang/json/mutation_from_json.py
msgid "Very Ponderous"
msgstr "Very Ponderous"

#. ~ Description for Very Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr "Your muscles are quite slow to move.  You move 20% slower."

#: lang/json/mutation_from_json.py
msgid "Extremely Ponderous"
msgstr "Extremely Ponderous"

#. ~ Description for Extremely Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr "Your muscles are very slow to move.  You move 30% slower."

#: lang/json/mutation_from_json.py
msgid "Sunlight Dependent"
msgstr "Sunlight Dependent"

#. ~ Description for Sunlight Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in"
" speed when in shade, and a 10% drop in speed when in the dark."
msgstr "You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in speed when in shade, and a 10% drop in speed when in the dark."

#: lang/json/mutation_from_json.py
msgid "Vines"
msgstr "Vines"

#. ~ Description for Vines
#: lang/json/mutation_from_json.py
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're"
" bulky and get in the way."
msgstr "You have developed several vines sprouting from your shoulder area.  They're bulky and get in the way."

#: lang/json/mutation_from_json.py
msgid "Vine Limbs"
msgstr "Vine Limbs"

#. ~ Description for Vine Limbs
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr "You've developed the ability to control your vines; they make good lashes.  You can even rappel down sheer drops using them, but disconnecting HURTS."

#: lang/json/mutation_from_json.py
msgid "Vine Sprouter"
msgstr "Vine Sprouter"

#. ~ Description for Vine Sprouter
#: lang/json/mutation_from_json.py
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr "You have full control of your vines, and can grow new ones and detach old ones more or less at will."

#: lang/json/mutation_from_json.py
msgid "Toe Roots"
msgstr "Toe Roots"

#. ~ Description for Toe Roots
#: lang/json/mutation_from_json.py
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr "Your toes have grown wriggly, and you can't imagine why you wear that stuff on your feet.  Take it off.  It's in the way."

#: lang/json/mutation_from_json.py
msgid "Roots"
msgstr "Roots"

#. ~ Description for Roots
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you started developing a root system.  When reading, fishing"
" from, waiting, or otherwise being stationary for a while on diggable "
"terrain, you'll extract nutrients and water from the soil."
msgstr "It's about time you started developing a root system.  When reading, fishing from, waiting, or otherwise being stationary for a while on diggable terrain, you'll extract nutrients and water from the soil."

#: lang/json/mutation_from_json.py
msgid "Rooter"
msgstr "Rooter"

#. ~ Description for Rooter
#: lang/json/mutation_from_json.py
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients "
"and water whenever on diggable terrain, but move more slowly."
msgstr "You find it difficult not to sink roots when able.  You extract nutrients and water whenever on diggable terrain, but move more slowly."

#: lang/json/mutation_from_json.py
msgid "Chloromorphosis"
msgstr "Chloromorphosis"

#. ~ Description for Chloromorphosis
#: lang/json/mutation_from_json.py
msgid ""
"Every inch of your skin is packed with chlorophyll and you have strong "
"roots.  Sleeping on diggable soil will satisfy any hunger or thirst you "
"might have."
msgstr "Every inch of your skin is packed with chlorophyll and you have strong roots.  Sleeping on diggable soil will satisfy any hunger or thirst you might have."

#: lang/json/mutation_from_json.py
msgid "Heat Dependent"
msgstr "Heat Dependent"

#. ~ Description for Heat Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C)."
msgstr "Your muscle response is dependent on ambient temperatures.  You lose 1% of your speed for every 5 (2.8) degrees below 65 F (18.3 C)."

#: lang/json/mutation_from_json.py
msgid "Very Heat Dependent"
msgstr "Very Heat Dependent"

#. ~ Description for Very Heat Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C)."
msgstr "Your muscle response is highly dependent on ambient temperatures.  You lose 1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C)."

#: lang/json/mutation_from_json.py
msgid "Cold Blooded"
msgstr "Cold Blooded"

#. ~ Description for Cold Blooded
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C)."
msgstr "You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your speed for every 2 (1.1) degrees below 65 F (18.3 C)."

#: lang/json/mutation_from_json.py
msgid "Ectothermic"
msgstr "Ectothermic"

#. ~ Description for Ectothermic
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers--or raises"
"--for every 2 (1.1) degrees below or above 65 F (18.3 C)."
msgstr "Your body has become permanently cold-blooded.  Your speed lowers--or raises--for every 2 (1.1) degrees below or above 65 F (18.3 C)."

#: lang/json/mutation_from_json.py
msgid "Growling Voice"
msgstr "Growling Voice"

#. ~ Description for Growling Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr "You have a growling, rough voice.  Persuading NPCs will be more difficult, but threatening them will be easier."

#: lang/json/mutation_from_json.py
msgid "Snarling Voice"
msgstr "Snarling Voice"

#. ~ Description for Snarling Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr "You have a threatening snarl in your voice.  Persuading NPCs will be near impossible, but threatening them will be much easier."

#: lang/json/mutation_from_json.py
msgid "Hissing Voice"
msgstr "Hissing Voice"

#. ~ Description for Hissing Voice
#: lang/json/mutation_from_json.py
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr "You hiss when speaking.  Persuading NPCs will be more difficult, but threatening them will be easier."

#: lang/json/mutation_from_json.py
msgid "Shouter"
msgstr "Shouter"

#. ~ Description for Shouter
#: lang/json/mutation_from_json.py
msgid "You occasionally shout uncontrollably."
msgstr "You occasionally shout uncontrollably."

#: lang/json/mutation_from_json.py
msgid "Screamer"
msgstr "Screamer"

#. ~ Description for Screamer
#: lang/json/mutation_from_json.py
msgid "You sometimes scream uncontrollably."
msgstr "You sometimes scream uncontrollably."

#: lang/json/mutation_from_json.py
msgid "Howler"
msgstr "Howler"

#. ~ Description for Howler
#: lang/json/mutation_from_json.py
msgid "You frequently let out a piercing howl."
msgstr "You frequently let out a piercing howl."

#: lang/json/mutation_from_json.py
msgid "Feathered Arms"
msgstr "Feathered Arms"

#. ~ Description for Feathered Arms
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have grown vibrantly colored feathers.  They effectively "
"waterproof your arms and take the edge off hits, but really get in the way."
"  They're simply too small to help you in the air."
msgstr "Your arms have grown vibrantly colored feathers.  They effectively waterproof your arms and take the edge off hits, but really get in the way.  They're simply too small to help you in the air."

#: lang/json/mutation_from_json.py
msgid "Insect Limbs"
msgstr "Insect Limbs"

#. ~ Description for Insect Limbs
#: lang/json/mutation_from_json.py
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more-or-less uncontrollably,  making you feel rather larval."
msgstr "You've *finally* sprouted a pair of arms from your midsection.  They flail more-or-less uncontrollably,  making you feel rather larval."

#: lang/json/mutation_from_json.py
msgid "Insect Arms"
msgstr "Insect Arms"

#. ~ Description for Insect Arms
#: lang/json/mutation_from_json.py
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr "It's good having all your arms.  Though they're too thin to block or punch, you can fold them inside human-shaped gear if need be."

#: lang/json/mutation_from_json.py
msgid "Arachnid Limbs"
msgstr "Arachnid Limbs"

#. ~ Description for Arachnid Limbs
#: lang/json/mutation_from_json.py
msgid ""
"There's the last two limbs you were expecting.  Unfortunately you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr "There's the last two limbs you were expecting.  Unfortunately you still can't coordinate them, so you're getting in your own way.  A lot."

#: lang/json/mutation_from_json.py
msgid "Arachnid Arms"
msgstr "Arachnid Arms"

#. ~ Description for Arachnid Arms
#: lang/json/mutation_from_json.py
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' "
"things.  They probably aren't worth concealing."
msgstr "You have four handsome limbs, and then those mutant 'hand' and 'foot' things.  They probably aren't worth concealing."

#: lang/json/mutation_from_json.py
msgid "Tentacle Arms"
msgstr "Tentacle Arms"

#. ~ Description for Tentacle Arms
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into tentacles, resulting in a bonus of 1 to "
"dexterity, permanent hand encumbrance of 30, and inability to wear gloves.  "
"Somewhat decreases wet penalties."
msgstr "Your arms have transformed into tentacles, resulting in a bonus of 1 to dexterity, permanent hand encumbrance of 30, and inability to wear gloves.  Somewhat decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "4 Tentacles"
msgstr "4 Tentacles"

#. ~ Description for 4 Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into four tentacles, resulting in a bonus of 1 to"
" dexterity, permanent hand encumbrance of 30, and inability to wear gloves."
"  You can make up to 3 extra attacks with them.  Somewhat decreases wet "
"penalties."
msgstr "Your arms have transformed into four tentacles, resulting in a bonus of 1 to dexterity, permanent hand encumbrance of 30, and inability to wear gloves.  You can make up to 3 extra attacks with them.  Somewhat decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "8 Tentacles"
msgstr "8 Tentacles"

#. ~ Description for 8 Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into eight tentacles, resulting in a bonus of 1 "
"to dexterity, permanent hand encumbrance of 30, and inability to wear "
"gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr "Your arms have transformed into eight tentacles, resulting in a bonus of 1 to dexterity, permanent hand encumbrance of 30, and inability to wear gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases wet penalties."

#: lang/json/mutation_from_json.py
msgid "Shell"
msgstr "Shell"

#. ~ Description for Shell
#: lang/json/mutation_from_json.py
msgid ""
"You have grown a thick shell over your torso, providing excellent armor.  "
"You find you can use the empty space as 16 storage space, but cannot wear "
"anything on your torso.  Somewhat reduces wet effects."
msgstr "You have grown a thick shell over your torso, providing excellent armor.  You find you can use the empty space as 16 storage space, but cannot wear anything on your torso.  Somewhat reduces wet effects."

#: lang/json/mutation_from_json.py
msgid "Roomy Shell"
msgstr "Roomy Shell"

#. ~ Description for Roomy Shell
#: lang/json/mutation_from_json.py
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--"
"your whole body.  Activate to pull your head and limbs into your shell, "
"trading mobility and vision for warmth and shelter."
msgstr "Your protective shell has grown large enough to accommodate--if need be--your whole body.  Activate to pull your head and limbs into your shell, trading mobility and vision for warmth and shelter."

#: lang/json/mutation_from_json.py
msgid "Leg Tentacles"
msgstr "Leg Tentacles"

#. ~ Description for Leg Tentacles
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on"
" land by 20%, makes your movement silent, increases your swimming speed, and"
" reduces wet penalties."
msgstr "Your legs have transformed into six tentacles.  This decreases your speed on land by 20%, makes your movement silent, increases your swimming speed, and reduces wet penalties."

#: lang/json/mutation_from_json.py
msgid "Tentacle Bracing"
msgstr "Tentacle Bracing"

#. ~ Description for Tentacle Bracing
#: lang/json/mutation_from_json.py
msgid ""
"Your lower-tentacles have developed suckers.  They make land movement "
"marginally more tiring, but do a good job of keeping you set in place."
msgstr "Your lower-tentacles have developed suckers.  They make land movement marginally more tiring, but do a good job of keeping you set in place."

#. ~ Description for Lizard
#: lang/json/mutation_from_json.py
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr "You sometimes look back on your days before your tail came in.  But you're better now."

#. ~ Description for Bird
#: lang/json/mutation_from_json.py
msgid ""
"You're sure you'll fly someday.  In the meantime, there's still nests to "
"build."
msgstr "You're sure you'll fly someday.  In the meantime, there's still nests to build."

#: lang/json/mutation_from_json.py
msgid "Aquatic"
msgstr "Aquatic"

#. ~ Description for Aquatic
#: lang/json/mutation_from_json.py
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And"
" enjoy.  What was that about a surface?"
msgstr "Ninety percent of the planet, and it's yours to explore.  And colonize.  And enjoy.  What was that about a surface?"

#. ~ Description for Beast
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr "It's about time you grew out.  Now that you've matured, it is time to make something of yourself."

#. ~ Description for Feline
#: lang/json/mutation_from_json.py
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr "Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever desire."

#. ~ Description for Wolf
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to lead a pack."
msgstr "You're the perfect candidate to lead a pack."

#. ~ Description for Bear
#: lang/json/mutation_from_json.py
msgid "So the humans died, what's the worry?  Now they won't ruin the woods."
msgstr "So the humans died, what's the worry?  Now they won't ruin the woods."

#: lang/json/mutation_from_json.py
msgid "Bovine"
msgstr "Bovine"

#. ~ Description for Bovine
#: lang/json/mutation_from_json.py
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr "Civilization collapsed?  Great!  You and your kin will never have to worry about a slaughterhouse again."

#. ~ Description for Insect
#: lang/json/mutation_from_json.py
msgid ""
"It would be good to be a Queen, having workers constantly servicing your "
"every need...but how would you keep them in line?"
msgstr "It would be good to be a Queen, having workers constantly servicing your every need...but how would you keep them in line?"

#. ~ Description for Plant
#: lang/json/mutation_from_json.py
msgid ""
"Well, you still have those other walking flowers-and the mushrooms too-to "
"deal with.  But you'll manage."
msgstr "Well, you still have those other walking flowers-and the mushrooms too-to deal with.  But you'll manage."

#: lang/json/mutation_from_json.py
msgid "Aqueous"
msgstr "Aqueous"

#. ~ Description for Aqueous
#: lang/json/mutation_from_json.py
msgid ""
"What was that old advertisement, 'paint the planet'? That might be a good "
"long-term goal, but for now..."
msgstr "What was that old advertisement, 'paint the planet'? That might be a good long-term goal, but for now..."

#: lang/json/mutation_from_json.py
msgid "Subterranean"
msgstr "Subterranean"

#. ~ Description for Subterranean
#: lang/json/mutation_from_json.py
msgid ""
"Not much point to rebuilding up in that horribly bright roofless wasteland."
"  Now that you've become accustomed to your new digs, there's the beginnings"
" of a great empire right here, underground."
msgstr "Not much point to rebuilding up in that horribly bright roofless wasteland.  Now that you've become accustomed to your new digs, there's the beginnings of a great empire right here, underground."

#. ~ Description for Cephalopod
#: lang/json/mutation_from_json.py
msgid ""
"Strange aeons, true, but Death seems to be slacking and you are doing just "
"fine."
msgstr "Strange aeons, true, but Death seems to be slacking and you are doing just fine."

#: lang/json/mutation_from_json.py
msgid "Arachnid"
msgstr "Arachnid"

#. ~ Description for Arachnid
#: lang/json/mutation_from_json.py
msgid "Well, maybe you'll just have to make your own world wide web."
msgstr "Well, maybe you'll just have to make your own world wide web."

#: lang/json/mutation_from_json.py
msgid "Survivor"
msgstr "Survivor"

#. ~ Description for Survivor
#: lang/json/mutation_from_json.py
msgid ""
"Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr "Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."

#: lang/json/mutation_from_json.py
msgid "Prototype"
msgstr "Prototype"

#. ~ Description for Prototype
#: lang/json/mutation_from_json.py
msgid "After all those experiments, what's a few more, hmm?"
msgstr "After all those experiments, what's a few more, hmm?"

#: lang/json/mutation_from_json.py
msgid "Prime"
msgstr "Prime"

#. ~ Description for Prime
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to tidy this mess."
msgstr "You're the perfect candidate to tidy this mess."

#. ~ Description for Fey
#: lang/json/mutation_from_json.py
msgid ""
"You are the tree under which humankind will shelter during these dark times."
msgstr "You are the tree under which humankind will shelter during these dark times."

#: lang/json/mutation_from_json.py
msgid "Chaos"
msgstr "Chaos"

#. ~ Description for Chaos
#: lang/json/mutation_from_json.py
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens."
msgstr "You can't tell what you are anymore.  Everything and yet nothing, like you weren't meant to exist.  But you do, and you're a force, no matter what happens."

#. ~ Description for Raptor
#: lang/json/mutation_from_json.py
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr "The chance to undo not one but TWO extinction events.  You're confident you'll do fine."

#: lang/json/mutation_from_json.py
msgid "Marloss Gateway"
msgstr "Marloss Gateway"

#. ~ Description for Marloss Gateway
#: lang/json/mutation_from_json.py
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr "You get the feeling that you're on the cusp of becoming something greater than yourself."

#: lang/json/mutation_from_json.py
msgid "Mycus"
msgstr "Mycus"

#. ~ Description for Mycus
#: lang/json/mutation_from_json.py
msgid "We are the Mycus."
msgstr "We are the Mycus."

#: lang/json/mutation_from_json.py
msgid "Acidproof"
msgstr "Acidproof"

#. ~ Description for Acidproof
#: lang/json/mutation_from_json.py
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "Your mutated flesh is immune to the damaging effects of acid."

#: lang/json/mutation_from_json.py
msgid "Acid Blood"
msgstr "Acid Blood"

#. ~ Description for Acid Blood
#: lang/json/mutation_from_json.py
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr "Your body has developed a wonderful defense mechanism.  Instead of normal blood, you bleed a strong molecular acid which will damage any creature foolish enough to harm you."

#: lang/json/mutation_from_json.py
msgid "Police Officer"
msgstr "Police Officer"

#. ~ Description for Police Officer
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr "You are a duly sworn law enforcement officer, with jurisdiction throughout the New England region thanks to interstate agreements.  Whether that means anything now is another question."

#: lang/json/mutation_from_json.py
msgid "SWAT Officer"
msgstr "SWAT Officer"

#. ~ Description for SWAT Officer
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcer, with jurisdiction throughout the New "
"England region thanks to interstate agreements.  Whether that means anything"
" now is another question."
msgstr "You are a duly sworn law enforcer, with jurisdiction throughout the New England region thanks to interstate agreements.  Whether that means anything now is another question."

