#: lang/json/TOOL_from_json.py
msgid ""
"This is a stone with spirals all over it, and holes around its perimeter.  "
"Though it is fairly large, it weighs next to nothing.  Air seems to gather "
"around it."
msgstr "This is a stone with spirals all over it, and holes around its perimeter.  Though it is fairly large, it weighs next to nothing.  Air seems to gather around it."

#. ~ Description for wakizashi
#: lang/json/TOOL_from_json.py
msgid ""
"This is a comparatively-common Japanese short sword.  Smaller and lighter "
"than a katana, but still effective in combat."
msgstr "This is a comparatively-common Japanese short sword.  Smaller and lighter than a katana, but still effective in combat."

#: lang/json/TOOL_from_json.py
msgid "washboard"
msgid_plural "washboards"
msgstr[0] "washboard"
msgstr[1] "washboards"

#. ~ Description for washboard
#: lang/json/TOOL_from_json.py
msgid ""
"This is a wooden washboard.  You can use it to wash filthy clothing if it's "
"supplied with soap.  It requires 1 unit of soap per use."
msgstr "This is a wooden washboard.  You can use it to wash filthy clothing if it's supplied with soap.  It requires 1 unit of soap per use."

#: lang/json/TOOL_from_json.py lang/json/vehicle_part_from_json.py
