#: lang/json/GENERIC_from_json.py lang/json/furniture_from_json.py
msgid "lotus"
msgid_plural "lotuses"
msgstr[0] ""

#. ~ Description for {'str': 'lotus', 'str_pl': 'lotuses'}
#: lang/json/GENERIC_from_json.py
msgid "A lotus stalk with some petals."
