msgstr "高火力且準確的步槍彈, 用於擊殺大型動物或人類。"

#: lang/json/AMMO_from_json.py
msgid "rifle ammo, incendiary"
msgid_plural "rifle ammo, incendiary"
msgstr[0] "步槍燃燒彈"

#. ~ Description for rifle ammo, incendiary
#: lang/json/AMMO_from_json.py
msgid ""
"Military ammo for rifles, designed to burn hotly upon impact, piercing armor"
