msgstr "前哨任務"

#: src/mission_companion.cpp
msgid "Junk Shop Missions"
msgstr "舊貨店任務"

#: src/mission_companion.cpp
msgid "Agricultural Missions"
msgstr "農業任務"

#: src/mission_companion.cpp
