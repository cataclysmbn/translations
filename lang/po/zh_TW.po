#. ~ 1$s is monster name, 2$s bodypart in accusative
#: src/monattack.cpp
#, c-format
msgid "The %1$s barfs acid on <npcname>'s %2$s for %3$d damage!"
msgstr "%1$s 吐出的酸液射中了 <npcname> 的 %2$s, 造成 %3$d 傷害!"

#: src/monattack.cpp
#, c-format
msgid "The %1$s barfs acid on your %2$s, but it washes off the armor!"
msgstr "%1$s 吐出的酸液射中了你的 %2$s, 但是它順著護甲流掉了!"

#: src/monattack.cpp
#, c-format
msgid "The %1$s barfs acid on <npcname>'s %2$s, but it washes off the armor!"
msgstr "%1$s 吐出的酸液射中了 <npcname> 的 %2$s, 但是它順著護甲流掉了!"

