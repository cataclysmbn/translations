msgstr "%s 開始尖叫了起來!"

#: src/monattack.cpp
msgid "a piercing wail!"
msgstr "一聲刺耳的哀號!"

#: src/monattack.cpp
msgid "an ear-piercing howl!"
msgstr "一聲震耳欲聾的嚎叫!"

#: src/monattack.cpp
msgid "a sibilant rattling sound!"
msgstr "一陣嘶嘶作響的咯咯聲!"

#: src/monattack.cpp
msgid "a spitting noise."
msgstr "一聲噴吐的聲響。"

#: src/monattack.cpp
#, c-format
msgid "A glob of acid hits the %s!"
msgstr "一團酸液擊中了 %s!"

#: src/monattack.cpp
#, c-format
msgid "The %s barfs acid at you, but you dodge!"
msgstr "%s 向你吐出了酸液, 但是你躲開了!"

#: src/monattack.cpp
#, c-format
msgid "The %s barfs acid at <npcname>, but they dodge!"
msgstr "%s 向 <npcname> 吐出了酸液 , 但是他躲開了!"

#. ~ 1$s is monster name, 2$s bodypart in accusative
