msgstr[0] "感染數據"

#. ~ Description for infection data
#: lang/json/GENERIC_from_json.py
msgid "Medical data on zombie blood."
msgstr "關於殭屍血液的醫學數據。"

#: lang/json/GENERIC_from_json.py
