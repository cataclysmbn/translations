msgid ""
"A array of sensors and diagnostic modules allowing the robot to perceive "
"itself."
msgstr "一系列傳感器和診斷模組，允許機器人能感知自我狀態。"

#: lang/json/GENERIC_from_json.py
msgid "AI core"
msgid_plural "AI cores"
msgstr[0] "人工智慧核心"

#. ~ Description for AI core
#: lang/json/GENERIC_from_json.py
