#: lang/json/mutation_from_json.py
msgid "Culinary Training"
msgstr "烹飪培訓"

#. ~ Description for Culinary Training
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in culinary arts, but not much "
