#: lang/json/TOOL_ARMOR_from_json.py
msgid "scuba tank"
msgid_plural "scuba tanks"
msgstr[0] "水肺氣瓶"

#. ~ Description for scuba tank
#. ~ Description for {'str': 'scuba tank (on)', 'str_pl': 'scuba tanks (on)'}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a high-pressure 232 bar diving tank that can contain up to 12L of "
"compressed mixture of oxygen and nitrogen.  It is equipped with a on-demand "
"regulator and a mouthpiece designed mostly for underwater use."
msgstr "這是一個高壓 232 巴的潛水氣瓶，最多可容納 12 公升混合氧氣和氮氣的壓縮空氣。它配備了依照需求調整的調節器和主要用於水下使用的咬嘴。"

#: lang/json/TOOL_ARMOR_from_json.py
msgid "scuba tank (on)"
msgid_plural "scuba tanks (on)"
msgstr[0] ""

#: lang/json/TOOL_ARMOR_from_json.py
