msgstr "厚實的皮革靴子, 設計來保護雙腳。輕巧且強韌。"

#: lang/json/ARMOR_from_json.py
msgid "pair of light survivor boots"
msgid_plural "pairs of light survivor boots"
msgstr[0] "輕型生存者靴"

#. ~ Description for pair of light survivor boots
