#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Serial Killer"
msgstr "連環殺手"

#. ~ Profession (male Serial Killer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Whether due to insanity, a lack of conscience, or some other reason, your "
"unorthodox employment centered around taking lives.  You pilfered a welding "
"mask from the local garage, and an axe from a stopped fire truck, and "
"created an identity for yourself painted in red.  But now, it seems, someone"
" with skills like yours might actually have a chance."
msgstr ""

