#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Aiaiaiaiaiai.\""
msgstr "\"Aiaiaiaiaiai.\""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Who are you?\""
msgstr "\"Sen kimsin?\""

#: data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Help.\""
