msgid_plural "carbon dioxide tanks"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'carbon dioxide tank'}
#: data/json/items/tool/science.json
msgid "This is a tank of compressed carbon dioxide gas."
msgstr ""

