msgid "Robot Dispatch"
msgstr "Robot Dağıtımı"

#: data/mods/Aftershock/speech.json
msgid "\"I have no mouth and yet I scream!\""
msgstr "\"Ne ağzım var ne de bağırıyorum!\""

#: data/mods/Aftershock/speech.json
msgid "\"¿Por qué?\""
msgstr "\"Neden?\""

#: data/mods/Aftershock/speech.json
msgid "\"Come closer little one.\""
msgstr "\"Yaklaş küçük olan.\""

#: data/mods/Aftershock/speech.json
msgid "\"The better to eat you!  I don't actually think I eat anymore.\""
msgstr "\"Seni yemek için! Aslında artık yemek yediğimi düşünmüyorum.\""

#: data/mods/Aftershock/speech.json
msgid "\"Cyrus said if I was patient, he could get me a new body.\""
msgstr ""
"\"Cyrus, eğer sabırlı olursam, bana yeni bir beden alabileceğini söyledi.\""

#: data/mods/Aftershock/speech.json
msgid "\"Quem é Você?\""
msgstr "\"Sen kimsin?\""

#: data/mods/Aftershock/speech.json
msgid "\"Eu vou te matar!\""
msgstr "\"Seni öldüreceğim!\""

#: data/mods/Aftershock/speech.json
msgid "\"I can't keep myself from killing you, please run!\""
msgstr "\"Seni öldürmekten kendimi alıkoyamıyorum, lütfen kaç!\""

#: data/mods/Aftershock/speech.json
msgid "\"bzzzzzz.\""
msgstr "\"bzzzzzz.\""

