msgstr ""
"Gram, Sigurd'un kılıcı. Efsanevi ejderha Fafnir'i öldüren kılıç olduğu "
"söyleniyor. Bir zamanlar Regin'in örsünü ikiye böldüğü söylenmişti, "
"keskinliği kusursuz."

#: data/mods/MagicalNights/items/melee.json
msgid "Laevateinn"
msgid_plural "Laevateinns"
msgstr[0] "Laevateinn"
msgstr[1] "Laevateinns"

