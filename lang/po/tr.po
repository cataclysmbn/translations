#: data/mods/exotic_ammo/items/magazine/223.json
msgid "LW-56 magazine"
msgid_plural "LW-56 magazine"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'LW-56 magazine'}
#: data/mods/exotic_ammo/items/magazine/223.json
msgid ""
"A 56-round polymer magazine for Leadworks LLC 223 firearms.  It's compact "
"design makes it surprisingly easy to store.  Lightweight and reliable but "
"somewhat more difficult to reload."
msgstr ""

#: data/mods/exotic_ammo/items/magazine/223.json
msgid "LW-32 magazine"
msgid_plural "LW-32 magazine"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'LW-32 magazine'}
#: data/mods/exotic_ammo/items/magazine/223.json
msgid ""
"A 32-round polymer magazine for Leadworks LLC 223 firearms.  Lightweight and"
" reliable but somewhat more difficult to reload."
msgstr ""

#: data/mods/exotic_ammo/items/magazine/460.json
msgid ".460 6-round speedloader"
msgid_plural ".460 6-round speedloader"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': '.460 6-round speedloader'}
#: data/mods/exotic_ammo/items/magazine/460.json
msgid ""
"This speedloader, made by Leadworks for use with L2031 Enforcer revolver, "
"can hold 6 rounds of .460 or .45 and quickly reload a compatible revolver."
msgstr ""

#: data/mods/exotic_ammo/items/magazine/460.json
msgid "LW-12 magazine"
msgid_plural "LW-12 magazine"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'LW-12 magazine'}
#: data/mods/exotic_ammo/items/magazine/460.json
msgid ""
"A 12-round polymer magazine for use with the Leadworks LLC L39-460 and "
"L39B-45 pistols."
msgstr ""

#: data/mods/exotic_ammo/items/magazine/9mm.json
msgid "LW-7 speedloader"
msgid_plural "LW-7 speedloader"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'LW-7 speedloader'}
#: data/mods/exotic_ammo/items/magazine/9mm.json
msgid ""
"This speedloader, made by Leadworks for use with L2032 Lookout revolver, can"
" hold 7 rounds of 9x19mm and quickly reload a compatible revolver."
msgstr ""

#: data/mods/exotic_ammo/items/magazine/9mm.json
msgid "LW-21 magazine"
msgid_plural "LW-21 magazine"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str_sp': 'LW-21 magazine'}
#: data/mods/exotic_ammo/items/magazine/9mm.json
msgid ""
"A 21-round polymer magazine for Leadworks LLC 9x19mm firearms.  Lightweight "
"and reliable but somewhat more difficult to reload."
msgstr ""

#: data/mods/exotic_ammo/magazine/38super.json
msgid "AF2011A1 magazine"
