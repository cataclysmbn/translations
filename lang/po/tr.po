msgstr "Ağrıya karşı yüksek bir toleransınız var."

#: data/json/mutations/mutations.json
msgid "Night Vision"
msgstr "Gece Görüşü"

#. ~ Description for {'str': 'Night Vision'}
#: data/json/mutations/mutations.json
