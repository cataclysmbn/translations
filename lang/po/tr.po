"A large, rigid sheet of translucent plastic, useful for all manner of "
"things; from construction to art, or even junior snowboarding."
msgstr ""

#: data/json/items/resources/plastic.json
msgid "plastic scrap"
msgid_plural "plastic scraps"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'plastic scrap'}
#: data/json/items/resources/plastic.json
