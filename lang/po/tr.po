#: data/mods/DinoMod/startlocations.json
msgid "DinoZoo (Giftshop)"
msgstr ""

#: data/mods/DinoMod/startlocations.json
msgid "DinoZoo (Cages)"
msgstr ""

#: data/mods/DinoMod/startlocations.json
