"C.R.I.T. standard-issue chestrig, has mesh and MOLLE loops for gear and "
"slots with light-armor padding."
msgstr ""

#: data/mods/CRT_EXPANSION/items/crt_armor.json
msgid "pair of C.R.I.T. leg guards"
msgid_plural "pairs of C.R.I.T. leg guards"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'pair of C.R.I.T. leg guards', 'str_pl': 'pairs
#. of C.R.I.T. leg guards'}
