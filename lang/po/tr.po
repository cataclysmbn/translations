msgstr ""
"Otomatik bir anti-personel dronu olan, dönen bıçaklarla çevrili küçük bir "
"quadcopter robot."

#: data/json/monsters/drones.json
msgid "mininuke hack"
msgid_plural "mininuke hacks"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'mininuke hack'}
#: data/json/monsters/drones.json
