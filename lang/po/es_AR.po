msgstr ""
"Es una réplica berreta sin filo de una espada de principios de la edad "
"moderna, usada en los siglos XVI, XVII y XVIII. La llamaban 'ancha' por "
"contraste con los floretes finos."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
msgid "cavalry saber"
msgid_plural "cavalry sabers"
msgstr[0] "sable de caballería"
msgstr[1] "sables de caballería"

#. ~ Description for {'str': 'cavalry saber'}
#: lang/json/GENERIC_from_json.py
