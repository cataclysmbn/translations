msgstr[0] ""
msgstr[1] ""

#. ~ Use action msg for {'str': 'small primitive frag device'}.
#: lang/json/TOOL_from_json.py
msgid ""
"You light the fuse on the small primitive fragmentation device.  Get rid of "
"it quickly!"
msgstr ""

