"ventanas."

#: lang/json/GENERIC_from_json.py
msgid "sheet of reinforced glass"
msgid_plural "sheets of reinforced glass"
msgstr[0] "plancha de vidrio reforzado"
msgstr[1] "planchas de vidrio reforzado"

