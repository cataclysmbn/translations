msgid "A pair of cufflinks with inset peridots."
msgstr "Es un par de gemelos con peridotos incrustados."

#. ~ Description for {'str': 'ruby and gold cufflinks'}
#. ~ Description for {'str': 'ruby and silver cufflinks'}
#. ~ Description for {'str': 'ruby and platinum cufflinks'}
#: lang/json/ARMOR_from_json.py
msgid "A pair of cufflinks with inset rubies."
msgstr "Es un par de gemelos con rubíes incrustados."

#. ~ Description for {'str': 'sapphire and gold cufflinks'}
#. ~ Description for {'str': 'sapphire and silver cufflinks'}
#. ~ Description for {'str': 'sapphire and platinum cufflinks'}
