#. ~ Description of buff 'Sneak Attack' for martial art '{'str': 'Ninjutsu'}'
#: lang/json/martial_art_from_json.py
#, no-python-format
msgid ""
"To a true shinobi, the first strike and the last strike are one in the "
"same.\n"
"\n"
"+50%% all damage."
msgstr ""

#: lang/json/martial_art_from_json.py
msgid "Toad Kung Fu"
