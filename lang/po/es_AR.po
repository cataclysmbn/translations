msgstr[1] "café molido"

#. ~ Description for {'str_sp': 'coffee powder'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Ground coffee beans.  You can boil it into a mediocre stimulant, or "
"something better if you had an atomic coffee pot."
msgstr ""
"Granos de café molidos. Los podés hervir para hacerte un estimulante "
"mediocre, o algo mejor si tenés una cafetera atómica."

#: lang/json/COMESTIBLE_from_json.py
msgid "Kentucky coffee grounds"
msgid_plural "Kentucky coffee grounds"
msgstr[0] "café Kentucky molido"
msgstr[1] "café Kentucky molido"

#. ~ Description for {'str_sp': 'Kentucky coffee grounds'}
#: lang/json/COMESTIBLE_from_json.py
