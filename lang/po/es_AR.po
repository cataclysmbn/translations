#. ~ Profession (female Golfer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"You decided to get away from the family for the day to do a little golfing "
"by yourself."
msgstr ""
"Decidiste alejarte de la familia por un día, para irte sola a jugar al golf "
"un rato."

