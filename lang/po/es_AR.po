msgstr "Es un par de gemelos con ópalos incrustados."

#. ~ Description for {'str': 'pearl and gold cufflinks'}
#. ~ Description for {'str': 'pearl and silver cufflinks'}
#. ~ Description for {'str': 'pearl and platinum cufflinks'}
