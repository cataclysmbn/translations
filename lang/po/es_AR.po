msgstr "Es un blobo vivo hecho como una pasarela."

#: lang/json/vehicle_part_from_json.py
msgid "gel hatch"
msgstr "escotilla de gel"

#. ~ Description for {'str': 'gel hatch'}
#. ~ Description for {'str': 'gray hatch'}
#. ~ Description for {'str': 'ooze hatch'}
#: lang/json/vehicle_part_from_json.py
