"The best-seller from Foodplace, delicious food™, is made with real foodstuff"
" and is guaranteed 100% edible!"
msgstr ""
"Es el producto más vendido de Foodplace, deliciosa comida™, está hecho con "
"verdadera sustancia de comida y ¡está garantizado que es 100% comestible!"

#: lang/json/COMESTIBLE_from_json.py
msgid "cooked lentils"
msgid_plural "cooked lentils"
msgstr[0] "lentejas cocinadas"
msgstr[1] "lentejas cocinadas"

#. ~ Description for {'str_sp': 'cooked lentils'}
#: lang/json/COMESTIBLE_from_json.py
msgid "Some delicious cooked lentils.  Humble but nutrient-rich."
msgstr "Son unas deliciosas lentejas cocinadas. Humildes pero muy nutritivas."

#: lang/json/COMESTIBLE_from_json.py
