"This module continuously runs image recognition algorithms to identify "
"friends from foe."
msgstr ""
"Este módulo está continuamente ejecutando algoritmos de reconocimiento de "
"imagen para identificar amigos y enemigos."

#: lang/json/GENERIC_from_json.py
msgid "pathfinding module"
msgid_plural "pathfinding modules"
msgstr[0] "módulo de reconocimiento"
msgstr[1] "módulos de reconocimiento"

#. ~ Description for {'str': 'pathfinding module'}
#: lang/json/GENERIC_from_json.py
