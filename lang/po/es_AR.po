msgstr[0] "almohada de plumón"
msgstr[1] "almohadas de plumón"

#. ~ Description for {'str': 'down-filled pillow'}
#: lang/json/GENERIC_from_json.py
msgid "A fluffy pillow to rest your head on when sleeping."
msgstr "Es una almohada acolchada para descansar tu cabeza cuando dormís."

#: lang/json/GENERIC_from_json.py
