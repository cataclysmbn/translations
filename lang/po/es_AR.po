msgid "AK-74M"
msgid_plural "AK-74Ms"
msgstr[0] "AK-74M"
msgstr[1] "AK-74M"

#: lang/json/gun_from_json.py
msgid "AKM"
msgid_plural "AKMs"
msgstr[0] "AKM"
msgstr[1] "AKM"

#: lang/json/gun_from_json.py
msgid "AN-94"
msgid_plural "AN-94s"
msgstr[0] "AN-94"
msgstr[1] "AN-94"

#: lang/json/gun_from_json.py
msgid "AR-10"
msgid_plural "AR-10s"
