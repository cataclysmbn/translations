msgstr ""
"Es tomate enlatado. Esencial en toda despensa y útil para muchas recetas."

#: lang/json/COMESTIBLE_from_json.py
msgid "Chardonnay"
msgid_plural "Chardonnay"
msgstr[0] "Chardonnay"
msgstr[1] "Chardonnay"

#. ~ Description for {'str': 'fruit wine', 'str_pl': 'fruit wine'}
#: lang/json/COMESTIBLE_from_json.py
