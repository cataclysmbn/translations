msgid_plural "synthetic fabric sheets"
msgstr[0] "tela sintética"
msgstr[1] "telas sintética"

#. ~ Description for {'str': 'synthetic fabric sheet'}
#: lang/json/AMMO_from_json.py
msgid "A sheet of synthetic fabric, suitable for making clothing."
msgstr "Es una tela sintética, ideal para hacer ropa."

#: lang/json/AMMO_from_json.py
