msgid_plural "protein shakes"
msgstr[0] "licuado de proteína"
msgstr[1] "licuados de proteína"

#. ~ Conditional name for protein shake when FLAG matches CANNIBALISM
#: lang/json/COMESTIBLE_from_json.py
