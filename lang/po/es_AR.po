msgstr "Es un blobo vivo hecho para almacenar objetos."

#: lang/json/vehicle_part_from_json.py
msgid "gel pouch (under)"
msgstr "estuche de gel (debajo)"

#: lang/json/vehicle_part_from_json.py
msgid "gel walkway"
msgstr "pasarela de gel"

#. ~ Description for {'str': 'gel walkway'}
#. ~ Description for {'str': 'gray walkway'}
#. ~ Description for {'str': 'ooze walkway'}
#: lang/json/vehicle_part_from_json.py
