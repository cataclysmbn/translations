#: lang/json/COMESTIBLE_from_json.py
msgid "concentrated acid"
msgid_plural "concentrated acid"
msgstr[0] "ácido concentrado"
msgstr[1] "ácido concentrado"

#. ~ Description for {'str_sp': 'concentrated acid'}
#: lang/json/COMESTIBLE_from_json.py
