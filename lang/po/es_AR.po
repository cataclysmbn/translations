msgstr "Choclo enlatado en agua. ¡A comer!"

#. ~ Description for canned pineapple
#: lang/json/COMESTIBLE_from_json.py
msgid "Canned pineapple rings in water.  Quite tasty."
msgstr "Son aros de ananá enlatados con agua. Bastante sabrosos."

#. ~ Description for {'str': 'canned tomato', 'str_pl': 'canned tomatoes'}
#: lang/json/COMESTIBLE_from_json.py
