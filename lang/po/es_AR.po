#: lang/json/MONSTER_from_json.py
msgid "Tyrannosaurus rex"
msgid_plural "Tyrannosaurus rex"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'howling waif'}
#: lang/json/MONSTER_from_json.py
msgid ""
"Undeath has not been kind to the children of the apocalypse.  This one is "
"little more than a reanimated membrane of skin stretched across tiny brittle "
"bones."
msgstr ""
"Esta muerte viviente no ha sido nada generosa con los niños del apocalipsis. "
"Este es poco más que una membrana de piel reanimada estirada por los "
"pequeños y frágiles huesos."

#: lang/json/MONSTER_from_json.py
msgid "Utahraptor"
msgid_plural "Utahraptors"
msgstr[0] ""
msgstr[1] ""

#: lang/json/MONSTER_from_json.py
