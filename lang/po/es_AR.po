#. ~ Description for The Grey Flame
#: lang/json/faction_from_json.py
msgid ""
"A collection of those cursed by the cataclysm.  They have sworn to rid this "
"world of its curse and will stop at nothing to accomplish their task."
msgstr ""

#. ~ Description for The Free Merchants
#: lang/json/faction_from_json.py
msgid ""
"A conglomeration of entrepreneurs and businessmen that stand together to "
"hammer-out an existence through trade and industry."
msgstr ""
"Una conglomeración de empresarios y emprendedores que se mantienen juntos "
"para poder continuar su existencia a través del comercio y la industria."

#. ~ Description for PrepNet Phyle
#: lang/json/faction_from_json.py
