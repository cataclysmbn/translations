msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "zandcrawler"
msgid_plural "zandcrawlers"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'zandcrawler'}
#: lang/json/MONSTER_from_json.py
