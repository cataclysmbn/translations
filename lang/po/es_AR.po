#. ~ Description for {'str': 'ammo pouch', 'str_pl': 'ammo pouches'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A small pouch that can be used to store most types of small ammunition, "
"rockets will not fit.  Activate to store ammunition."
msgstr ""
"Es una pequeña bolsa que puede usarse para almacenar la mayoría de las "
"municiones pequeñas, los misiles no entran. Hay que activarla para almacenar"
" la munición."

