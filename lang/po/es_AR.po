msgid ""
"A small scope intended for use on a handgun.  Increases weight but improves "
"accuracy greatly."
msgstr ""
"Es una pequeña mira diseñada para ser usada en una pistola. Incrementa el "
"peso pero mejora mucho la precisión."

#: lang/json/gunmod_from_json.py
msgid "red dot sight"
msgid_plural "red dot sights"
msgstr[0] "mirilla de punto rojo"
msgstr[1] "mirillas de punto rojo"

