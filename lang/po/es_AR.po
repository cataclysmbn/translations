#. ~ Description for scenario 'Missed' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"Whether due to stubbornness, ignorance, or just plain bad luck, you missed "
"the evacuation, and are stuck in a city full of the risen dead."
msgstr ""
"Ya sea por tu cabeza dura, ignorancia, o mala suerte, te perdiste la "
"evacuación y ahora estás atrapado en una ciudad llena de muertos vivientes."

