msgstr[0] "torreta militar calibre 50 inactiva"
msgstr[1] "torretas militares calibre 50 inactivas"

#. ~ Description for inactive 50 caliber military turret
#: lang/json/TOOL_from_json.py
msgid ""
"An inactive 50 caliber military turret.  Up to 100 standard 50 caliber bmg "
"rounds will be automatically loaded from your inventory into the turret upon"
" activation.  Place the turret and it will ID you as friendly with its "
"advanced IFF software.  Consult your safety manual in the event of a "
"malfunction."
msgstr ""
"Es una torreta militar inactiva calibre 50. Serán cargadas automáticamente "
"hasta 100 balas calibre 50 bmg desde tu inventario a la torreta cuando la "
"actives. Cuando pongas la torreta te va a identificar como aliado con su "
"software IFF avanzado. Consultá el manual de seguridad en caso de mal "
"funcionamiento."

