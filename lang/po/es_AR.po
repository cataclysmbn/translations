msgstr ""

#: lang/json/MONSTER_from_json.py
msgid "Gila monster"
msgid_plural "Gila monsters"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'Gila monster'}
#: lang/json/MONSTER_from_json.py
