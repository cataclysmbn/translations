#. ~ Description for {'str': 'foodplace loyalty card'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A bright pink loyalty card, all the points are stamped.  This would "
"definitely prove your fidelity to Foodplace, if it still meant anything…"
msgstr ""
"Es una tarjeta de cliente rosa brillante, con todos los puntos estampados. "
"Esto definitivamente probará tu fidelidad con Foodplace, si es que eso "
"todavía significa algo..."

#: lang/json/GENERIC_from_json.py
msgid "withered plant"
msgid_plural "withered plants"
msgstr[0] "planta marchita"
msgstr[1] "plantas marchitas"

#. ~ Description for {'str': 'withered plant'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A dead plant.  Good for starting fires or making a pile of leaves to sleep "
"on."
msgstr ""
"Es una planta muerta. Sirve para encender fuegos o para hacer una pila de "
"hojas para acostarse."

#: lang/json/GENERIC_from_json.py
msgid "fur pelt"
msgid_plural "fur pelts"
msgstr[0] "pelaje"
msgstr[1] "pelajes"

#. ~ Description for {'str': 'fur pelt'}
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of fur from an animal.  Can be made into warm clothing."
msgstr ""
"Un pequeño rollo de pelaje de un animal. Con esto puede hacerse ropa "
"abrigada."

#: lang/json/GENERIC_from_json.py
msgid "faux fur pelt"
msgid_plural "faux fur pelts"
msgstr[0] "pelaje artificial"
msgstr[1] "pelajes artificiales"

#. ~ Description for {'str': 'faux fur pelt'}
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of garishly colored faux fur.  Can be made into clothing."
msgstr ""
"Es un pequeño rollo de pelaje sintético de color estridente. Con esto puede "
"hacerse ropa."

#: lang/json/GENERIC_from_json.py
msgid "leather patch"
msgid_plural "leather patches"
msgstr[0] "pedazo de cuero"
msgstr[1] "pedazos de cuero"

#. ~ Description for {'str': 'leather patch', 'str_pl': 'leather patches'}
#: lang/json/GENERIC_from_json.py
msgid "A smallish patch of leather, could be used to make tough clothing."
msgstr ""
"Es un pedazo bastante chico de cuero, que puede ser usado para hacer ropa "
"resistente."

#: lang/json/GENERIC_from_json.py
msgid "felt patch"
msgid_plural "felt patches"
msgstr[0] "pedazo de fieltro"
msgstr[1] "pedazos de fieltro"

#. ~ Description for {'str': 'felt patch', 'str_pl': 'felt patches'}
#: lang/json/GENERIC_from_json.py
msgid "A smallish patch of felt, could be disassembled for wool fiber."
msgstr ""
"Es un pedazo bastante chico de fieltro, que puede ser desarmado para obtener"
" fibra de lana."

#: lang/json/GENERIC_from_json.py
msgid "Nomex patch"
msgid_plural "Nomex patches"
msgstr[0] "pedazo de Nomex"
msgstr[1] "pedazos de Nomex"

#. ~ Description for {'str': 'Nomex patch', 'str_pl': 'Nomex patches'}
#: lang/json/GENERIC_from_json.py
msgid "A small bolt of Nomex fire-resistant fabric."
msgstr "Un pequeño rollo de nomex, que es una tela ignífuga."

#: lang/json/GENERIC_from_json.py
msgid "superglue"
msgid_plural "superglue"
msgstr[0] "superpegamento"
msgstr[1] "superpegamento"

#. ~ Description for {'str_sp': 'superglue'}
#: lang/json/GENERIC_from_json.py
msgid "A tube of strong glue.  Used in many crafting recipes."
msgstr "Un pomo de pegamento potente. Se usa para fabricar muchas cosas."

#: lang/json/GENERIC_from_json.py
msgid "bone glue"
msgid_plural "bone glues"
msgstr[0] "pegamento de hueso"
msgstr[1] "pegamentos de hueso"

#. ~ Description for {'str': 'bone glue'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Glue made from boiling animal bones.  The adhesive isn't strong enough for "
"heavy-duty usages, but it can be used as a varnish or holding together small"
" items."
msgstr ""
"Es pegamento hecho con huesos hervidos de animales. El adhesivo no es tan "
"fuerte para usos exigentes, pero puede ser usado para barnizar o mantener "
"pegados pequeños objetos."

#: lang/json/GENERIC_from_json.py
msgid "fertilizer"
msgid_plural "fertilizers"
msgstr[0] "fertilizante"
msgstr[1] "fertilizantes"

#. ~ Description for {'str': 'fertilizer'}
#: lang/json/GENERIC_from_json.py
msgid "A token, representing fertilization of a plant."
msgstr "Es un símbolo que representa la fertilización de una planta."

#: lang/json/GENERIC_from_json.py
msgid "steel chain"
msgid_plural "steel chains"
msgstr[0] "cadena de acero"
msgstr[1] "cadenas de acero"

#. ~ Description for {'str': 'steel chain'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A heavy steel chain.  Useful as a weapon, or for crafting.  It has a chance "
"to wrap around your target, allowing for a bonus unarmed attack."
msgstr ""
"Una cadena pesada de acero. Se puede usar como arma, o para fabricar algo. "
"Puede enroscarse en el enemigo, lo que te permite un ataque desarmado extra."

#: lang/json/GENERIC_from_json.py
msgid "chunk of chitin"
msgid_plural "chunks of chitin"
msgstr[0] "pedazo de quitina"
msgstr[1] "pedazos de quitina"

#. ~ Description for {'str': 'chunk of chitin', 'str_pl': 'chunks of chitin'}
#: lang/json/GENERIC_from_json.py
msgid "A piece of an insect's exoskeleton.  It is light and very durable."
msgstr ""
"Es un pedazo del exoesqueleto de un insecto. Es liviano y muy duradero."

#: lang/json/GENERIC_from_json.py
msgid "set of 100 ceramic disk"
msgid_plural "ceramic disks"
msgstr[0] "conjunto de 100 discos de cerámica"
msgstr[1] "discos de cerámica"

#. ~ Description for {'str': 'set of 100 ceramic disk', 'str_pl': 'ceramic
#. disks'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A set of small slightly elongated disks, made of high-grade ceramic.  They "
"remind you of scales."
msgstr ""
"Es un conjunto de pequeños discos un poco ovalados, hechos de cerámica de "
"grado alto. Te hace pensar en escamas."

#: lang/json/GENERIC_from_json.py
msgid "chunk of biosilicified chitin"
msgid_plural "chunks of biosilicified chitin"
msgstr[0] "pedazo de quitina biosilicificada"
msgstr[1] "pedazos de quitina biosilicificada"

#. ~ Description for {'str': 'chunk of biosilicified chitin', 'str_pl':
#. 'chunks of biosilicified chitin'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A lump of exoskeleton that has undergone biosilicification.  It is acid-"
"resistant and remarkably sturdy."
msgstr ""
"Es un pedazo de exoesqueleto que ha sido biosilicificado. Es resistente al "
"ácido y sorprendentemente duro."

#: lang/json/GENERIC_from_json.py
msgid "bundle of rags"
msgid_plural "bundles of rags"
msgstr[0] "paquete de trapos"
msgstr[1] "paquetes de trapos"

#. ~ Description for {'str': 'bundle of rags', 'str_pl': 'bundles of rags'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Cotton rags, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Son pedazos de algodón, atados para que ocupen menos espacio. Lo tenés que "
"desarmar para abrirlo."

#: lang/json/GENERIC_from_json.py
msgid "bundle of leather"
msgid_plural "bundles of leather"
msgstr[0] "paquete de cueros"
msgstr[1] "paquetes de cueros"

#. ~ Description for {'str': 'bundle of leather', 'str_pl': 'bundles of
#. leather'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Leather patches, bundled tightly together for storage.  Disassemble to "
"unpack."
msgstr ""
"Son pedazos de cuero, atados para que ocupen menos espacio. Lo tenés que "
"desarmar para abrirlo."

#: lang/json/GENERIC_from_json.py
msgid "bundle of felt"
msgid_plural "bundles of felt"
msgstr[0] "paquete de fieltros"
msgstr[1] "paquetes de fieltros"

#. ~ Description for {'str': 'bundle of felt', 'str_pl': 'bundles of felt'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Felt patches, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Son pedazos de fieltro, atados para que ocupen menos espacio. Lo tenés que "
"desarmar para abrirlo."

#: lang/json/GENERIC_from_json.py
msgid "t-substrate sample"
msgid_plural "t-substrate samples"
msgstr[0] "muestra t-sustrato"
msgstr[1] "muestras t-sustrato"

#. ~ Description for {'str': 't-substrate sample'}
#: lang/json/GENERIC_from_json.py
msgid ""
"An acrylic cube cast around a small black crystal.  It's tepid to the touch."
msgstr ""
"Es un cubo de acrílico que cubre un pequeño cristal negro. Es tibio al "
"tacto."

#: lang/json/GENERIC_from_json.py
msgid "biollante bud"
msgid_plural "biollante buds"
msgstr[0] "capullo de biollante"
msgstr[1] "capullos de biollante"

#. ~ Description for {'str': 'biollante bud'}
#: lang/json/GENERIC_from_json.py
msgid ""
"An unopened biollante flower, brilliant purple in color.  It may still have "
"its sap-producing organ intact."
msgstr ""
"Es un capullo cerrado de una flor de biollante, de un púrpura brillante. Tal"
" vez todavía contenga intacto el órgano generador de savia."

#: lang/json/GENERIC_from_json.py
msgid "empty canister"
msgid_plural "empty canisters"
msgstr[0] "carcasa vacía"
msgstr[1] "carcasas vacías"

#. ~ Description for {'str': 'empty canister'}
#: lang/json/GENERIC_from_json.py
msgid ""
"An empty canister, which may have once held tear gas or other substances."
msgstr ""
"Una carcasa vacía, que alguna vez puede haber contenido gas lacrimógeno y "
"otras sustancias."

#: lang/json/GENERIC_from_json.py
msgid "petrified eye"
msgid_plural "petrified eyes"
msgstr[0] "ojo petrificado"
msgstr[1] "ojos petrificados"

#. ~ Description for {'str': 'petrified eye'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A fist-sized eyeball with a cross-shaped pupil.  It seems to be made of "
"stone, but doesn't look like it was carved."
msgstr ""
"Un globo ocular del tamaño de un puño, con la pupila en forma de cruz. "
"Parece estar hecho de piedra, pero no parece estar tallado."

#: lang/json/GENERIC_from_json.py
msgid "spiral stone"
msgid_plural "spiral stones"
msgstr[0] "piedra espiral"
msgstr[1] "piedras espirales"

#. ~ Description for {'str': 'spiral stone'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A rock the size of your fist.  It is covered with intricate spirals; it is "
"impossible to tell whether they are carved, naturally formed, or some kind "
"of fossil."
msgstr ""
"Una piedra del tamaño de tu puño. Está cubierta de espirales complejos. Es "
"imposible decir si están tallados, formados naturalmente, o alguna especie "
"de fósil."

#: lang/json/GENERIC_from_json.py
msgid "USB drive"
msgid_plural "USB drives"
msgstr[0] "pendrive"
msgstr[1] "pendrives"

#. ~ Description for {'str': 'USB drive'}
#: lang/json/GENERIC_from_json.py
msgid "A USB thumb drive.  Useful for holding software."
msgstr "Es un pendrive con puerto USB. Útil para almacenar software."

#: lang/json/GENERIC_from_json.py
msgid "data card"
msgid_plural "data cards"
msgstr[0] "tarjeta de información"
msgstr[1] "tarjetas de información"

#. ~ Description for {'str': 'data card'}
#: lang/json/GENERIC_from_json.py
msgid ""
"Some type of advanced data storage device.  Useful for storing very large "
"amounts of information."
msgstr ""
"Es alguna clase de dispositivo avanzado de almacenamiento de información. "
"Útil para guardar grandes cantidades de información."

#: lang/json/GENERIC_from_json.py
msgid "candlestick"
msgid_plural "candlesticks"
msgstr[0] "candelabro"
msgstr[1] "candelabros"

#. ~ Description for {'str': 'candlestick'}
#: lang/json/GENERIC_from_json.py
msgid "A gold candlestick."
msgstr "Un candelabro de oro."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
#: lang/json/vehicle_part_from_json.py
msgid "blade"
msgid_plural "blades"
msgstr[0] "cuchilla"
msgstr[1] "cuchillas"

#. ~ Description for {'str': 'blade'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, relatively sharp blade.  Could be used to make bladed weaponry, or "
"attached to a car."
msgstr ""
"Es una cuchilla larga sin mango y relativamente afilada. Se puede usar para "
"hacer algún arma blanca, o puede ser puesta en un vehículo."

#: lang/json/GENERIC_from_json.py
msgid "scythe blade"
msgid_plural "scythe blades"
msgstr[0] "cuchilla de guadaña"
msgstr[1] "cuchillas de guadaña"

#. ~ Description for {'str': 'scythe blade'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, curved blade.  Could be used to assemble a scythe, or make an "
"improvised polearm."
msgstr ""
"Es una cuchilla larga y curvada. Puede ser usada para armar una guadaña, o "
"para improvisar un arma de asta."

#: lang/json/GENERIC_from_json.py
msgid "circular sawblade"
msgid_plural "circular sawblades"
msgstr[0] "hoja de sierra circular"
msgstr[1] "hojas de sierra circular"

#. ~ Description for {'str': 'circular sawblade'}
#: lang/json/GENERIC_from_json.py
msgid ""
"An 8\" circular sawblade.  You could make a saw with it, or throw it.  "
"Wielding it without sturdy gloves is a bad idea."
msgstr ""
"Una hoja de sierra circular de 8\". Con ella podés hacer una sierra, o la "
"podés lanzar. Empuñarla sin unos buenos guantes resistentes, es una mala "
"idea."

#: lang/json/GENERIC_from_json.py
msgid "tree spile"
msgid_plural "tree spiles"
msgstr[0] "canilla para árbol"
msgstr[1] "canillas para árbol"

#. ~ Description for {'str': 'tree spile'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A hollow metal cylinder which is inserted in a tree crust in order to slowly"
" harvest its sap.  Can be used on a maple tree in between late winter and "
"early spring to harvest maple sap."
msgstr ""
"Es un cilindro hueco de metal que se inserta en la corteza de los árboles "
"para cosechar lentamente su savia. Puede ser usado en arces entre fines de "
"invierno y comienzos de primavera para cosechar savia de arce."

#: lang/json/GENERIC_from_json.py
msgid "wire"
msgid_plural "wires"
msgstr[0] "alambre"
msgstr[1] "alambres"

#. ~ Description for {'str': 'wire'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of thin, relatively stiff, steel wire.  Like the sort you find in "
"wire fences."
msgstr ""
"Es un pedazo de alambre de acero delgado y relativamente rígido. Como el que"
" se usa en los alambrados."

#: lang/json/GENERIC_from_json.py
msgid "barbed wire"
msgid_plural "barbed wires"
msgstr[0] "alambre de púas"
msgstr[1] "alambres de púas"

#. ~ Description for {'str': 'barbed wire'}
#: lang/json/GENERIC_from_json.py
msgid "A length of stiff wire, covered in sharp barbs."
msgstr "Es un pedazo de alambre rígido, cubierto con púas puntiagudas."

#: lang/json/GENERIC_from_json.py
msgid "steel mesh"
msgid_plural "steel meshes"
msgstr[0] "malla de acero"
msgstr[1] "mallas de acero"

#. ~ Description for {'str': 'steel mesh', 'str_pl': 'steel meshes'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A mat of woven fine steel wire, useful for dryer lint traps and reusable "
"coffee filter baskets.  You could put these on a window to keep mosquitoes "
"and other bugs out, but chainlink fencing will do these days."
msgstr ""
"Es como una esterilla de cables de acero tejidos, útil para filtros para "
"pelusa de secadora, o como filtros de café. Podés ponerlos en una ventana "
"para evitar que entren los mosquitos y otros bichos, pero generalmente se "
"utiliza una tela metálica común para eso."

#: lang/json/GENERIC_from_json.py
msgid "rebar"
msgid_plural "rebars"
msgstr[0] "varilla corrugada"
msgstr[1] "varillas corrugadas"

#. ~ Description for {'str': 'rebar'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of rebar, makes a nice melee weapon, and could be handy in "
"constructing tougher walls and such."
msgstr ""
"Es un pedazo de varilla corrugada, que sirve como arma de cuerpo a cuerpo, y"
" puede ser útil para construir paredes más resistentes y cosas de ese "
"estilo."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "small railroad track"
msgid_plural "small railroad tracks"
msgstr[0] "vía pequeña"
msgstr[1] "vías pequeñas"

#. ~ Description for {'str': 'small railroad track'}
#: lang/json/GENERIC_from_json.py
msgid "A length of track, made from some planks and rails."
msgstr "Es un pedazo de vía, hecha con algunas maderas e hierros."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
#: lang/json/terrain_from_json.py
msgid "concrete"
msgid_plural "concrete"
msgstr[0] "concreto"
msgstr[1] "concreto"

#. ~ Description for {'str_sp': 'concrete'}
#: lang/json/GENERIC_from_json.py
msgid "Some concrete, ready to be used in a construction project."
msgstr "Es un poco de concreto, listo para ser usado en alguna construcción."

#: lang/json/GENERIC_from_json.py
msgid "bone skewer"
msgid_plural "bone skewers"
msgstr[0] "brochette de hueso"
msgstr[1] "brochettes de hueso"

#. ~ Description for {'str': 'bone skewer'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A thin skewer carved from bone.  Sadly, it won't make squirrel on a stick "
"taste better."
msgstr ""
"Es un palito fino de brochette tallado de hueso. Lamentablemente, no va a "
"hacer que la ardilla en un palo tenga mejor gusto."

#: lang/json/GENERIC_from_json.py
msgid "burnt out torch"
msgid_plural "burnt out torches"
msgstr[0] "antorcha quemada"
msgstr[1] "antorchas quemadas"

#. ~ Description for {'str': 'burnt out torch', 'str_pl': 'burnt out torches'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A torch that has consumed all its fuel; it can be recrafted into another "
"torch."
msgstr ""
"Una antorcha que ya ha consumido todo su combustible. Puede ser utilizada "
"para hacer una antorcha nueva."

#: lang/json/GENERIC_from_json.py
msgid "dead flare"
msgid_plural "dead flares"
msgstr[0] "bengala usada"
msgstr[1] "bengalas usadas"

#. ~ Description for {'str': 'dead flare'}
#: lang/json/GENERIC_from_json.py
msgid "This is a spent magnesium flare.  It is essentially trash."
msgstr "Es una bengala de magnesio usada. Prácticamente, basura."

#: lang/json/GENERIC_from_json.py
msgid "spring"
msgid_plural "springs"
msgstr[0] "resorte"
msgstr[1] "resortes"

#. ~ Description for {'str': 'spring'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy-duty spring.  Expands with significant force when compressed."
msgstr ""
"Un resorte grande reforzado. Se expande con una fuerza importante cuando es "
"comprimido."

#: lang/json/GENERIC_from_json.py
msgid "lawnmower"
msgid_plural "lawnmowers"
msgstr[0] "cortadora de pasto"
msgstr[1] "cortadoras de pasto"

#. ~ Description for {'str': 'lawnmower'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A motorized pushmower that seems to be broken.  You could take it apart if "
"you had a wrench."
msgstr ""
"Una cortadora de pasto con motor que parece estar rota. Podés desarmarla si "
"tenés una llave inglesa."

#: lang/json/GENERIC_from_json.py
msgid "damaged tent"
msgid_plural "damaged tents"
msgstr[0] "carpa rota"
msgstr[1] "carpas rotas"

#. ~ Description for {'str': 'damaged tent'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A small tent, just big enough to fit a person comfortably.  This tent is "
"broken and cannot be deployed."
msgstr ""
"Una pequeña carpa, donde entra cómodamente una sola persona. Esta carpa está"
" rota y no puede ser armada."

#: lang/json/GENERIC_from_json.py
msgid "large damaged tent"
msgid_plural "large damaged tents"
msgstr[0] "carpa grande rota"
msgstr[1] "carpas grandes rotas"

#. ~ Description for {'str': 'large damaged tent'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A family sized tent, very bulky but with plenty of space.  This tent is "
"broken and can not be deployed."
msgstr ""
"Una carpa tamaño familiar, muy voluminosa pero con mucho espacio. Esta carpa"
" está rota y no puede ser armada."

#: lang/json/GENERIC_from_json.py
msgid "heating element"
msgid_plural "heating elements"
msgstr[0] "resistencia térmica"
msgstr[1] "resistencias térmicas"

#. ~ Description for {'str': 'heating element'}
#: lang/json/GENERIC_from_json.py
msgid "A heating element, like the ones used in hotplates or kettles."
msgstr ""
"Es una resistencia térmica, como las que se usa en las pavas y anafes "
"eléctricos."

#: lang/json/GENERIC_from_json.py
msgid "bimetal thermostat"
msgid_plural "bimetal thermostats"
msgstr[0] "termostato bimetálico"
msgstr[1] "termostatos bimetálicos"

#. ~ Description for {'str': 'bimetal thermostat'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A simple thermostat controlled by thermal expansion of a bimetal strip."
msgstr ""
"Es un termostato común controlado por expansión térmico de una banda "
"bimetálica."

#: lang/json/GENERIC_from_json.py
msgid "television"
msgid_plural "televisions"
msgstr[0] "televisor"
msgstr[1] "televisores"

#. ~ Description for {'str': 'television'}
#: lang/json/GENERIC_from_json.py
msgid "A large LCD television, full of delicious electronics."
msgstr "Es un televisor LCD grande , lleno de deliciosas piezas electrónicas."

#: lang/json/GENERIC_from_json.py
msgid "pilot light"
msgid_plural "pilot lights"
msgstr[0] "piloto"
msgstr[1] "pilotos"

#. ~ Description for {'str': 'pilot light'}
#: lang/json/GENERIC_from_json.py
msgid ""
"A pilot light from a gas-burning device, this particular one is a simple "
"piezoelectric igniter."
msgstr ""
"Un piloto de un aparato que funcionaba a gas, este en particular es un "
"simple encendedor piezoeléctrico."

#: lang/json/GENERIC_from_json.py
msgid "delayed fuze"
msgid_plural "delayed fuzes"
msgstr[0] "mecha retrasada"
msgstr[1] "mechas retrasadas"

#. ~ Description for delayed fuze
#: lang/json/GENERIC_from_json.py
msgid ""
"A complex mechanical fuze.  It seems it can be used to detonate stable "
"explosives after a short time by triggering it."
msgstr ""
"Es una compleja mecha mecánica. Parece que puede usarse para detonar "
"explosivos estables luego de un corto tiempo."

#: lang/json/GENERIC_from_json.py
msgid "impact fuze"
msgid_plural "impact fuzes"
msgstr[0] "mecha de impacto"
msgstr[1] "mechas de impacto"

#. ~ Description for impact fuze
#: lang/json/GENERIC_from_json.py
msgid ""
"A complex mechanical fuze.  It seems it can be used to detonate stable "
"explosives upon a solid impact."
msgstr ""
"Es una compleja mecha mecánica. Parece que puede usarse para detonar "
"explosivos estables luego de un impacto sólido."

#: lang/json/GENERIC_from_json.py
msgid "toaster"
msgid_plural "toasters"
msgstr[0] "tostadora"
msgstr[1] "tostadoras"

#. ~ Description for {'str': 'toaster'}
#: lang/json/GENERIC_from_json.py
msgid "A small two slice toaster, not much use as anything but spare parts"
msgstr ""
