msgstr[0] "tela de neopreno"
msgstr[1] "telas de neopreno"

#. ~ Description for {'str': 'neoprene sheet'}
#: lang/json/AMMO_from_json.py
msgid ""
"A sheet of neoprene, a synthetic rubber, suitable for making underwater "
