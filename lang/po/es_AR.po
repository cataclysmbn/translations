#. ~ Description for {'str': 'Subdermal Carbon Filament CBM'}
#: lang/json/BIONIC_ITEM_from_json.py
msgid ""
"A thin armor made of carbon nanotubes, implanted just beneath the skin.  "
"This reduces bashing damage by 2 and cutting damage by 4."
msgstr ""
"Implantada debajo de la piel, hay una fina armadura de nanotubos de carbono. "
"Esto logra reducir el daño golpeante en 2 y el cortante en 4."

#. ~ Description for {'str': 'Offensive Defense System CBM'}
#: lang/json/BIONIC_ITEM_from_json.py
msgid ""
