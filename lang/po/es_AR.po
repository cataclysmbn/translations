#: lang/json/mission_def_from_json.py
msgid ""
"Prozac was really common.  You can probably find it in most medicine "
"cabinets and pharmacies."
msgstr ""

#: lang/json/mission_def_from_json.py
msgid "Quitting already?"
msgstr "¿Ya te vas a rendir?"

