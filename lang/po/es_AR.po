#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Skater Boy"
msgstr "Skater"

#. ~ Profession (Skater Boy) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You love to skate!  At least now the grown-ups aren't telling you where you "
"can't roll."
msgstr ""
"¡Te encanta el skate! Por lo menos ahora los adultos no te van a andar "
"diciendo por dónde no podés andar."

