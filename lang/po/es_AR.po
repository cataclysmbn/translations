msgid "Crazy Cat Dude"
msgstr ""

#. ~ Profession (Crazy Cat Dude) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Everyone is dead?  Well, it doesn't matter… your cats are all the friends "
