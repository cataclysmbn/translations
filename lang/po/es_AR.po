#. ~ Description for {'str': 'ring of dexterity +2', 'str_pl': 'rings of dexterity +2'}
#: lang/json/TOOL_ARMOR_from_json.py
msgid "A silver ring that makes you a good bit more agile when you wear it."
msgstr ""

#. ~ Description for {'str': 'ring of intelligence +2', 'str_pl': 'rings of intelligence +2'}
