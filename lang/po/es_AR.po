msgstr ""
"Son pequeños pedazos irregulares de piel artificial, desperdicio de algún "
"proyecto de sastrería. No son muy útiles para nada."

#: lang/json/AMMO_from_json.py
msgid "felt scraps"
msgid_plural "felt scraps"
msgstr[0] "trozos de fieltro"
msgstr[1] "trozos de fieltro"

