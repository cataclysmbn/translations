msgid_plural "tofu"
msgstr[0] "tofu"
msgstr[1] "tofu"

#. ~ Description for {'str_sp': 'tofu'}
#. ~ Description for {'str_sp': 'fried tofu'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Tofu, a soy protein crucial to East Asian cuisine.  It absorbs flavors very "
"well and can be used as a meat alternative in many dishes."
msgstr ""
"Tofu es la proteína de soja elemental de la cocina del este de Asia. Absorbe"
" muy bien los sabores y puede usarse como una alternativa de la carne en "
"muchas comidas."

#: lang/json/COMESTIBLE_from_json.py
msgid "fried tofu"
msgid_plural "fried tofu"
