#. ~ Description for {'str': 'PB&H sandwich', 'str_pl': 'PB&H sandwiches'}
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Some damned fool put honey on this peanut butter sandwich, who in their "
"right mind- oh wait this is pretty good."
msgstr ""
"Algún estúpido puso miel en su sánguche de mantequilla de maní, que en su "
"sano juicio- ah, pará, está bastante bueno."

#. ~ Description for gluten free PB&H sandwich
#: lang/json/COMESTIBLE_from_json.py
msgid ""
