"extraña forma lo hace inservible como herramienta."

#: lang/json/GENERIC_from_json.py
msgid "alien resin chunk"
msgid_plural "alien resin chunks"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'alien resin chunk'}
#: lang/json/GENERIC_from_json.py
