#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/Aftershock/npcs/mutant_npcs/npc_classes_mutant.json
#: data/mods/Mutant_NPCs/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
msgid "Beast Mutant"
msgstr "야수 돌연변이"

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/Aftershock/npcs/mutant_npcs/npc_classes_mutant.json
#: data/mods/Mutant_NPCs/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
msgid ""
"I'm looking for beast mutagen… this world is no place for humans anymore, "
"and I don't plan to keep being one."
msgstr "야수 뮤타젠이 필요해… 이 세상은 더이상 인간이 살만한 곳이 아니고, 난 그런 곳에서 굳이 인간으로 남아있고 싶지는 않아."

#: data/mods/Aftershock/npcs/Backgrounds/npc_classes_mutant.json
#: data/mods/Aftershock/npcs/mutant_npcs/npc_classes_mutant.json
#: data/mods/Mutant_NPCs/npc_classes_mutant.json
#: data/mods/No_Hope/NPC/npc_classes_mutant.json
msgid "Ursine Mutant"
msgstr "곰 돌연변이"

