#: src/iuse.cpp
#, c-format
msgid "You've already pulled the %s's pin, try throwing it instead."
msgstr "이미 %s의 핀을 뽑았다. 던져야 한다."

#. ~ Description for {'str': 'active flashbang'}
#: data/json/items/tool/explosives.json
msgid ""
"This flashbang is active, and will soon detonate with intense light and "
"sound, blinding, deafening and disorienting anyone nearby.  It may be a good"
" idea to throw it!"
msgstr ""
"이 섬광탄은 켜져있다. 곧 강렬한 빛과 소리로 폭발할 것이며, 눈 가리고 주변 사람들을 혼란스럽게 할 것입니다. 던지는 것이 좋은 "
"생각일지도 몰라요!"

#: data/json/items/tool/explosives.json
msgid "fungicidal gas grenade"
msgid_plural "fungicidal gas grenades"
msgstr[0] "살진균가스탄"

#. ~ Description for {'str': 'fungicidal gas grenade'}
#: data/json/items/tool/explosives.json
msgid ""
"This is a canister grenade filled with fungicidal solution.  Use this item "
"to pull the pin and light the fuse, turning it into an active fungicidal "
"grenade.  In five turns it will begin to expel a volatile spray that is "
"highly toxic to fungal life forms."
msgstr ""
"살진균제 용액으로 가득한 확산 유탄입니다. 사용하여 안전핀을 뽑고 도화선에 불을 붙여, 활성화된 살진균탄으로 바꿉니다. 5턴 뒤 식물에게"
" 극도로 해로운 휘발성 스프레이를 사방에 쏘아냅니다."

#: data/json/items/tool/explosives.json
msgid "armed fungicidal gas canister"
msgid_plural "armed fungicidal gas canisters"
msgstr[0] "살진균가스탄 (켜짐)"

#. ~ Description for {'str': 'armed fungicidal gas canister'}
#: data/json/items/tool/explosives.json
msgid ""
"This fungicidal bomb has had its pin removed and is expelling highly toxic "
"gas."
msgstr "이 살진균탄은 안전핀이 뽑혀있고, 유독한 가스를 방출 중입니다."

#: data/json/items/tool/explosives.json
msgid "makeshift fungicidal gas grenade"
msgid_plural "makeshift fungicidal gas grenades"
msgstr[0] "수제 살진균가스탄"

#. ~ Description for {'str': 'makeshift fungicidal gas grenade'}
#: data/json/items/tool/explosives.json
msgid ""
"This is a makeshift canister grenade filled with fungicidal solution.  Use "
"this item to pull the pin and light the fuse, turning it into an active "
"fungicidal grenade.  In five turns it will begin to expel a volatile spray "
"that is highly toxic to fungal life forms."
msgstr ""
"살진균제 용액이 가득한 수제 확산 유탄입니다. 사용하여 안전핀을 뽑고 도화선에 불을 붙여, 활성화된 살진균탄으로 바꿉니다. 5턴 뒤 "
"식물에게 극도로 해로운 휘발성 스프레이를 사방에 쏘아냅니다."

#: data/json/items/tool/explosives.json
msgid "armed makeshift fungicidal gas canister"
msgid_plural "armed makeshift fungicidal gas canisters"
msgstr[0] "수제 살진균가스탄 (켜짐)"

#. ~ Description for {'str': 'armed makeshift fungicidal gas canister'}
#: data/json/items/tool/explosives.json
msgid ""
"This makeshift fungicidal bomb has had its pin removed and is expelling "
"highly toxic haze."
msgstr "이 수제 살진균탄은 안전핀이 뽑혀있고, 유독한 가스를 방출 중입니다."

#: data/json/items/tool/explosives.json
msgid "makeshift gas canister"
msgid_plural "makeshift gas canisters"
msgstr[0] "수제 최루탄"

#. ~ Use action menu_text for {'str': 'makeshift gas canister'}.
#: data/json/items/tool/explosives.json
msgid "Arm"
msgstr "작동"

#. ~ Use action msg for {'str': 'makeshift gas canister'}.
#: data/json/items/tool/explosives.json
msgid "You arm the makeshift gas canister."
msgstr "수제 최루탄을 작동시켰다."

#. ~ Description for {'str': 'makeshift gas canister'}
#: data/json/items/tool/explosives.json
msgid ""
"This is a crude gasbomb using household chemicals.  Use this item to arm it."
"  In three turns it will begin to expel a highly toxic gas for a short time."
"  This gas poisons those exposed to it, in addition to obscuring vision and "
"scent."
msgstr ""
"가정용 화학 약품으로 대강 만든 최루탄. 사용하면 최루탄을 작동시킵니다. 3턴이 지나면 잠시 유독성 가스를 내뿜고, 이 가스에 중독되면 "
"시야와 후각이 차단됩니다."

#: data/json/items/tool/explosives.json
msgid "active makeshift gas grenade"
msgid_plural "active makeshift gas grenades"
msgstr[0] "수제 최루탄 (켜짐)"

#. ~ Use action no_deactivate_msg for {'str': 'active makeshift gas grenade'}.
#: data/json/items/tool/explosives.json
msgid "You've already armed the %s, try throwing it instead."
msgstr "이미 %s은 작동되었다. 던져야 한다."

#. ~ Use action sound_msg for {'str': 'active makeshift gas grenade'}.
#. ~ Use action sound_msg for active nail bomb.
#: data/json/items/tool/explosives.json data/legacy/1/obsolete.json
msgid "Hiss."
msgstr "쉬익."

#. ~ Description for {'str': 'active makeshift gas grenade'}
#: data/json/items/tool/explosives.json
msgid ""
"This homemade canister of poison gas has been unsealed, and is (or will "
"shortly be) expelling highly toxic gas.  You should consider getting rid of "
"it soon."
msgstr "수제 독가스의 통은 봉인되지 않았으며, 곧 독가스를 배출할 것이다. 이것을 곧 없애는 것을 고려해야 한다."

#: data/json/items/tool/explosives.json
msgid "grenade"
msgid_plural "grenades"
