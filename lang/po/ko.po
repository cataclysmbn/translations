"into functioning companions."
msgstr "로봇 유형을 추가하고 고장난 로봇을 동료로 기능하게 수리가 가능합니다."

#: data/mods/Salvaged_Robots/monsters.json
msgid "craftbuddy"
msgid_plural "craftbuddies"
msgstr[0] "크래프트버디"

#. ~ Description for {'str': 'craftbuddy', 'str_pl': 'craftbuddies'}
#: data/mods/Salvaged_Robots/monsters.json
