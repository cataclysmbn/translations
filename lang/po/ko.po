#: data/json/items/tool/explosives.json
msgid "packed M72 LAW"
msgid_plural "packed M72 LAWs"
msgstr[0] "M72 LAW (접힘)"

#. ~ Use action msg for {'str': 'packed M72 LAW'}.
#: data/json/items/tool/explosives.json
msgid "You pull the activating lever, readying the LAW to fire."
msgstr "작동 레버를 당겨서, LAW를 발사 준비 상태로 만들었다."

#. ~ Description for {'str': 'packed M72 LAW'}
#: data/json/items/tool/explosives.json
msgid ""
"This is a M72 LAW, packed in its storage form.  Use it to pop it out and "
"make it ready to fire.  Once it is activated, it cannot be repacked."
msgstr "휴대용 상태로 접혀진 M72 LAW. 사용하면 꼬리날개를 펼쳐 발사 준비 상태로 만든다. 한 번 펼치면 다시 접을 수 없다."

#: data/json/items/tool/explosives.json
msgid "improvised grenade"
msgid_plural "improvised grenades"
msgstr[0] "급조 수류탄"

#. ~ Use action msg for {'str': 'improvised grenade'}.
#: data/json/items/tool/explosives.json
msgid ""
"You light the fuse on the improvised grenade.  Throw it before it blows in "
"your face!"
msgstr ""

#. ~ Description for {'str': 'improvised grenade'}
#: data/json/items/tool/explosives.json
msgid ""
"A improvised explosive device cobbled together from parts.  Use this item "
"light the fuse.  You will then have some amount of time before it explodes; "
"throwing it would be a good idea."
msgstr ""

#: data/json/items/tool/explosives.json
msgid "active improvised grenade"
msgid_plural "active improvised grenades"
msgstr[0] "급조 수류탄 (켜짐)"

#. ~ Use action no_deactivate_msg for {'str': 'active improvised grenade'}.
