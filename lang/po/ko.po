msgid "<ally_rule_allow_pick_up_true_text>"
msgstr "<ally_rule_allow_pick_up_true_text>"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "<ally_rule_allow_pick_up_false_text>"
