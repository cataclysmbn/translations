#: data/json/items/comestibles/raw_fruit.json
#: data/mods/Aftershock/items/seed.json
msgid "melon"
msgid_plural "melons"
msgstr[0] "멜론"

#. ~ Description for melon
#: data/json/items/comestibles/raw_fruit.json
msgid "A large and very sweet fruit."
msgstr "크고 아주 달콤한 과일입니다."

#: data/json/items/comestibles/raw_fruit.json
msgid "blackberries"
msgid_plural "blackberries"
msgstr[0] "블랙베리"

#. ~ Description for {'str_sp': 'blackberries'}
#: data/json/items/comestibles/raw_fruit.json
