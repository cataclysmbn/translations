#: data/mods/More_Locations/secret_doors/secret_door_terrain.json
#: data/mods/No_Hope/terrain.json
msgid "whump!"
msgstr "쿵!"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid "wood stove"
msgstr "나무 난로"

#. ~ Description for wood stove
#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid ""
"Wood stove for heating and cooking.  Much more efficient than an open flame."
msgstr "가열 및 조리를 위한 나무 난로입니다. 그냥 바닥에 장작을 쌓아놓고 불을 피우는 것보다 훨씬 효율적입니다."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
msgid "brazier"
msgid_plural "braziers"
msgstr[0] "화로"

#. ~ Description for brazier
#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid "A raised metal dish in which to safely burn things."
msgstr "다리 달린 높은 금속 접시로, 내용물들을 안전하게 불태울 수 있습니다."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
msgid "hobo stove"
msgid_plural "hobo stoves"
msgstr[0] "간이 조리기구"

#. ~ Description for hobo stove
#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid ""
"This is a small improvised wood stove, made from a metal can.  It's too "
"small to fit anything much larger than splintered wood."
msgstr "금속 깡통으로 만든, 급조한 소형 나무 난로입니다. 쪼개진 나무 이외의 것을 땔감으로 쓰기에는 너무 작습니다."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
msgid "fire barrel (200L)"
msgid_plural "fire barrels (200L)"
msgstr[0] "기름통 (200L)"

#. ~ Description for fire barrel (200L)
#. ~ Description for fire barrel (100L)
#. ~ Description for {'str': 'fire barrel (200L)', 'str_pl': 'fire barrels
#. (200L)'}
#. ~ Description for {'str': 'fire barrel (100L)', 'str_pl': 'fire barrels
#. (100L)'}
#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
msgid ""
"A large metal barrel used to contain a fire.  It has multiple holes punched "
"in its walls for air supply.  Fires set in a fire barrel will not spread to "
"surrounding flammable objects."
msgstr ""
"불을 담는 거대한 금속 통입니다.  공기 유입을 위해 벽에 여러 개의 구멍이 뚫려 있습니다.  기름통 안에서 붙은 불은 주변의 가연성 "
"물체로 번지지 않습니다."

#: data/json/furniture_and_terrain/furniture-fireplaces.json
#: data/json/items/tool/deployable.json
msgid "fire barrel (100L)"
msgid_plural "fire barrels (100L)"
msgstr[0] "기름통 (100L)"

#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid "fire ring"
msgstr "모닥불 터"

#. ~ Description for fire ring
#: data/json/furniture_and_terrain/furniture-fireplaces.json
msgid "A ring of stones to safely contain a fire."
msgstr "안전하게 불을 보관하기 위한 돌의 고리입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
msgid "mutated poppy flower"
msgstr "변이된 양귀비 꽃"

#. ~ Description for mutated poppy flower
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"These strange flowers have appeared in the wake of the Cataclysm, and their "
"buds can be used for medicinal purposes, like the seeds of the mundane poppy"
" they're named after.  The dirt around them gently churns as their roots "
"writhe beneath the soil, and it's surrounded by an overwhelming floral smell"
" that makes you feel sleepy."
msgstr ""
"이 낯선 꽃은 대재앙의 시작과 동시에 나타났으며, 그 꽃봉오리는 의료용도로 쓸 수 있습니다. 이름을 딴 평범한 양귀비의 씨앗처럼요. 이 "
"양귀비 주변의 흙은 양귀비 뿌리가 아래에서 뒤틀림에 따라 부드럽게 흔들리고, 점점 졸리게 만드는 압도적인 꽃향기로 덮여있습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/seed.json
msgid "dandelion"
msgstr "민들레"

#. ~ Description for dandelion
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A common weed with a yellow flower.  Produces seeds that get carried on the "
"wind by thin, gray filaments."
msgstr "노란 꽃이 피는 흔한 잡초입니다. 얇은 회색빛의 실타래 같은 것이 나있어, 바람에 쉬이 날리는 씨앗을 만듭니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/seed.json
msgid "burdock"
msgstr "우엉"

#. ~ Description for burdock
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A common weed with a purple thistle-like flower.  Its seeds tend to stick to"
" clothing and fur."
msgstr "보라색 엉겅퀴처럼 생긴 꽃이 피는 흔한 잡초입니다. 이 풀의 씨앗은 옷이나 털에 달라붙곤 합니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/seed.json
msgid "chamomile"
msgstr "캐모마일"

#. ~ Description for chamomile
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "Ahh, soothing chamomile tea."
msgstr "아, 캐모마일 차를 마시면 기분이 편안해지죠."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/obsoletion/items.json
msgid "tulip"
msgid_plural "tulips"
msgstr[0] "튤립"

#. ~ Description for tulip
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A bright, colorful flower with petals forming a small cup at its top."
msgstr "꼭대기에 작은 잔을 이루는 꽃잎이 있는 밝고 알록달록한 꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
msgid "spurge flower"
msgstr "등대풀 꽃"

#. ~ Description for spurge flower
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A yellow-green flower that grows in densely packed bushes."
msgstr "빽빽하게 우거진 수풀에서 자라는 황록색 꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
msgid "cattails"
msgstr "부들"

#. ~ Description for cattails
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"This useful plant is available all year round.  Many parts of the plant are "
"edible."
msgstr "이 유용한 풀은 연중 내내 핍니다. 이 풀의 대부분은 먹을 수 있습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/obsoletion/items.json
msgid "black eyed susan"
msgid_plural "black eyed susans"
msgstr[0] "검은눈천인국"

#. ~ Description for black eyed susan
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A yellow flower that has a dark ball in the middle.  Sometimes known as an "
"ox-eye daisy."
msgstr "가운데에 검은 공이 달린 노란 꽃입니다. 때때로 황소눈 데이지라고 불리기도 합니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/obsoletion/items.json
msgid "lily"
msgid_plural "lilies"
msgstr[0] "백합"

#. ~ Description for lily
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A pretty flower that comes in a variety of colors."
msgstr "다양한 색의 예쁜 꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/obsoletion/items.json
msgid "lotus"
msgid_plural "lotuses"
msgstr[0] "연"

#. ~ Description for lotus
#. ~ Description for {'str': 'lotus flower'}
#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/generic.json
msgid ""
"A lovely flower that grows on the surface of bodies of freshwater.  "
"Traditionally connected with many Eastern cultures."
msgstr "담수 수면에서 자라는 사랑스러운 꽃. 많은 동양 전통 문화와 관련이 있습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/generic.json data/json/items/comestibles/seed.json
msgid "sunflower"
msgid_plural "sunflowers"
msgstr[0] "해바라기"

#. ~ Description for sunflower
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A tall, wide-headed flower with a large dark center.  Produces many "
"nutritious seeds."
msgstr "높이 자라고, 중심부가 검고 커다란 넓은 꽃입니다. 영양이 풍부한 씨를 얻을 수 있습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
msgid "lilypad"
msgstr "연꽃잎"

#. ~ Description for lilypad
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"These lilypads don't look they'd support the weight of the things you've "
"heard croaking in the swamp."
msgstr "이 연꽃잎이 늪에서 개굴거리던 것들의 무게를 지탱할 수 있을 것 같지는 않습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/obsoletion/items.json
msgid "bluebell"
msgid_plural "bluebells"
msgstr[0] "블루벨"

#. ~ Description for bluebell
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A common bluebell flower.  Pretty."
msgstr "평범한 블루벨입니다. 예쁩니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/seed.json data/json/obsoletion/items.json
msgid "dahlia"
msgid_plural "dahlias"
msgstr[0] "달리아"

#. ~ Description for dahlia
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A puffy flower with many tightly layered petals."
msgstr "좁게 층층이 쌓인 꽃잎들로 이뤄진, 둥실둥실한 꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/raw_veggy.json
#: data/json/items/comestibles/seed.json
msgid "chicory"
msgid_plural "chicory"
msgstr[0] "치커리"

#. ~ Description for chicory
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A blue flower imported from Europe, also known as a Cornflower."
msgstr "콘플라워라고도 불리는, 유럽에서 들여온 푸른 꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/seed.json
msgid "datura"
msgstr "독말풀"

#. ~ Description for datura
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A pretty moonflower."
msgstr "예쁜 독말꽃입니다."

#: data/json/furniture_and_terrain/furniture-flora.json
msgid "pile of leaves"
msgstr "나뭇잎 더미"

#. ~ Description for pile of leaves
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A sizable pile of leaves.  You could sleep on it if you don't care about "
"comfort or warmth."
msgstr "큼직한 낙엽 더미입니다. 안락함이나 온기에 대해 신경쓰지 않는다면, 이 위에 누워서 잘 수 있습니다."

#: data/json/furniture_and_terrain/furniture-flora.json
#: data/json/items/comestibles/drink_other.json
#: data/json/items/comestibles/seed.json
msgid "mustard"
msgid_plural "mustard"
msgstr[0] "겨자"

#. ~ Description for mustard
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"Yellow flower known as Brassica Nigra.  Known for its seeds that can be used"
" for making table mustard."
msgstr "브라시카 니그라라고도 불리는 노란 꽃입니다. 씨앗을 식탁에 올리는 겨자 소스를 만드는데 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid "marloss flower"
msgstr "말로스 꽃"

#. ~ Description for marloss flower
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"This flower is like the other flowers taken by the mushrooms, but its bulb "
"is colored a brilliant cyan color, and it emits an aroma both overwhelming "
"and… delicious?"
msgstr "버섯 덮인 것만 빼면 다른 꽃과 비슷하게 생겼지만, 구근이 찬란한 청록색이고, 압도적이고도... 맛있는 냄새를 풍기네요?"

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/mods/No_Fungi/furniture.json
msgid "poof."
msgstr "펑."

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/json/items/comestibles/seed.json data/mods/No_Fungi/furniture.json
msgid "fungal flower"
msgstr "진균체 꽃"

#. ~ Description for fungal flower
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"This flower has been overgrown by gray, sinewy tendrils of fungus, and the "
"color has leached from its petals and stem.  It gently sways of its own "
"volition."
msgstr "이 꽃은 회색 근육질 진균으로 덮여있고, 그 색이 꽃잎과 줄기에까지 퍼졌습니다. 저 바라는대로 부드럽게 흔들립니다."

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid "fungal mass"
msgstr "진균체 덩어리"

#. ~ Description for fungal mass
#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid ""
"Thick ropes of mycal matter have covered the ground here completely.  It's "
"soft to the touch, but you sink into it, making moving across it difficult."
msgstr "미커스 덩어리 끈이 이곳의 바닥을 완전히 덮었습니다. 만지면 푹신하지만, 그 안으로 푹푹 빠져서 지다니기 힘듭니다."

#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid "fungal clump"
msgstr "진균체 덤불"

#. ~ Description for fungal clump
#: data/json/furniture_and_terrain/furniture-fungal.json
#: data/mods/No_Fungi/furniture.json
msgid ""
"Alien mold and stems mingle tightly here, creating a sort of fungal bush."
msgstr "외계의 곰팡이와 줄기가 뒤섞여, 이곳에 진균체 덤불 같은 것을 만들었습니다."

#: data/json/furniture_and_terrain/furniture-fungal.json
msgid "fungal tangle"
msgstr "진균체 얽힘"

#. ~ Description for fungal tangle
#: data/json/furniture_and_terrain/furniture-fungal.json
msgid ""
"Thick, ropy tendrils of fungus have risen from the ground and gathered into "
"an impenetrable clump."
msgstr "질기고도 길쭉한 진균체 덩굴이 바닥에서 솟아, 앞을 틀어막는 덤불을 이뤘습니다."

#: data/json/furniture_and_terrain/furniture-fungal.json
msgid "squelch."
msgstr "질퍽."

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "stone slab"
msgstr "석재 평판"

#. ~ Description for stone slab
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "A flat slab of heavy stone."
msgstr "무거운 돌로 된 평평한 판입니다."

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "headstone"
msgstr "비석"

#. ~ Description for headstone
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "Keeps the bodies."
msgstr "시체들을 지켜줍니다."

#: data/json/furniture_and_terrain/furniture-graves.json
#: data/json/furniture_and_terrain/furniture-recreation.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/mods/Aftershock/maps/terrain.json src/map.cpp src/mapdata.cpp
msgid "thump!"
msgstr "쿵!"

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "gravestone"
msgstr "묘비"

#. ~ Description for gravestone
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "Keeps the bodies.  More fancy."
msgstr "시체들을 지켜줍니다. 더 멋집니다."

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "worn gravestone"
msgstr "낡은 묘비"

#. ~ Description for worn gravestone
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "A worn-out gravestone."
msgstr "닳고 닳은 묘비입니다."

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "obelisk"
msgstr "오벨리스크"

#. ~ Description for obelisk
#: data/json/furniture_and_terrain/furniture-graves.json
msgid "Monument to pride."
msgstr "자부심의 기념비입니다."

#: data/json/furniture_and_terrain/furniture-graves.json
msgid "thunk!"
msgstr "꽝!"

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/More_Locations/terrain.json
msgid "robotic assembler"
msgstr "기계식 조립기"

#. ~ Description for robotic assembler
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"A durable and versatile robotic arm with a tool fitted to the end, for "
"working on an assembly line."
msgstr "단단하고 범용적인 기계 팔로, 끄트머리에 도구가 달려있습니다. 공장 조립 라인에 사용됩니다."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/mods/More_Locations/terrain.json
msgid "chemical mixer"
msgstr "화학 물질 혼합기"

#. ~ Description for chemical mixer
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"When chemicals need to be mixed in large quantities at just the right "
"combinations and temperatures, this is the tool for the job."
msgstr "화학물질들을 적절한 배합과 온도에서 다량 혼합해야 할 때 쓰는 장비입니다."

#: data/json/furniture_and_terrain/furniture-industrial.json
msgid "robotic arm"
msgstr "로봇팔"

#. ~ Description for robotic arm
#: data/json/furniture_and_terrain/furniture-industrial.json
msgid ""
"Automation!  Science!  Industry!  Make a better horse!  This robot arm "
"promises to do it all.  Except it's currently unpowered.  You could remove "
"the casing and retrieve the electronics through disassembly."
msgstr ""
"오토마톤이여! 과학이여! 산업의 발전이여! 더 나은 말을 만들어다오! 이 기계팔은 그 모든 것을 해낼 수 있습니다. 그렇지만 지금은 "
"동력원이 없군요. 겉표면을 뜯어내고 내부 장비를 분해해 꺼낼 수 있습니다."

#: data/json/furniture_and_terrain/furniture-industrial.json
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "thunk."
msgstr "꽝."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/tool/med.json
msgid "Autodoc Mk. XI"
msgid_plural "Autodoc Mk. XIs"
msgstr[0] "오토닥 Mk. XI"

#. ~ Description for Autodoc Mk. XI
#. ~ Description for {'str': 'Autodoc Mk. XI'}
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/tool/med.json
msgid ""
"A surgical apparatus used for installation and removal of bionics.  It's "
"only as skilled as its operator."
msgstr "바이오닉 설치 및 제거를 위한 수술기구입니다. 조종하는 사람이 능숙해야 이 장비도 능숙하게 작동합니다."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/tool/med.json
msgid "Autodoc operation couch"
msgid_plural "Autodoc operation couchs"
msgstr[0] "오토닥 수술용 소파"

#. ~ Description for Autodoc operation couch
#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/tool/med.json
msgid ""
"A plush red sofa made less comfortable by the medical machinery directly "
"above it.  It has a single leather strap on the right armrest."
msgstr "고급 소파지만, 위에 달린 의료 장비 탓에 좀 덜 편안합니다. 오른팔걸이에 가죽 스트랩이 달려있습니다."

#: data/json/furniture_and_terrain/furniture-medical.json
#: data/json/items/tool/med.json data/json/vehicleparts/vehicle_parts.json
msgid "autoclave"
msgid_plural "autoclaves"
msgstr[0] "오토클레이브"

#. ~ Description for autoclave
#. ~ Description for filled autoclave
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This thing is basically an extremely high tech laundry machine or "
"dishwasher.  It steams things at temperatures that will kill almost "
"anything."
msgstr "이건 굳이 말하자면 최고급 세탁기나 식기세척기의 일종입니다. 내용물에 고온 증기를 뿜어 거의 모든걸 죽입니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "filled autoclave"
msgstr "오토클레이브 (가득참)"

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "sample freezer"
msgstr "샘플 냉장고"

#. ~ Description for sample freezer
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"When cold just isn't cold enough, you have this extreme deep freeze.  This "
"will store stuff at -80 degrees Celsius.  Don't lick the metal on the "
"inside."
msgstr ""
"평범한 냉기로는 부족한 당신을 위해, 이 극지의 혹한을 그대로 옮겨온듯한 장비가 기다리고 있습니다. 내부에 보관된 물품들을 섭씨 "
"-80도로 보관해줍니다. 내부의 금속을 핥지 마세요."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "lab workbench"
msgstr "실험실 작업대"

#. ~ Description for lab workbench
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A metal storage cabinet topped by a durable resin countertop resistant to "
"most chemical spills and burns.  It has wired in electrical and gas "
"fittings."
msgstr ""
"대부분의 화학물질 누출이나 화염에 저항력이 있는 튼튼한 수지 작업판이 달린 금속 저장용 캐비넷입니다. 전기 및 가스 부품이 설치되어 "
"있습니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "fume hood"
msgstr "환기장치"

#. ~ Description for fume hood
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A metal hood overtop of a lab workspace, with durable glass shutters.  A fan"
" in the hood draws fumes and smoke from dangerous chemicals up into a "
"ventilation duct."
msgstr ""
"실험실 작업대 위에 설치되는, 튼튼한 유리 셔터가 달린 금속 환기장치입니다. 환기장치 안에 달린 팬이 위험한 화학물질에서 피어오른 연기와"
" 매연을 통풍구로 내보냅니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "shaker incubator"
msgstr "진탕배양기"

#. ~ Description for shaker incubator
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"A tool for keeping broth nicely mixed, at just the right temperature to grow"
" bacteria.  This is great for microbiology, but terrible for preserving "
"food."
msgstr ""
"수프를 적절히 섞어주는데 필요한 도구로, 박테리아가 성장하기 적당한 온도를 유지시킵니다. 미생물학적 용도에 굉장히 좋지만, 음식을 "
"보존하는데는 영 아닙니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "emergency wash station"
msgstr "긴급 세정실"

#. ~ Description for emergency wash station
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This pole has a lot of weird nozzles and attachments.  If there were running"
" water, you could use those attachments to wash harmful chemicals out of "
"your eyes, or to take a pleasant cold shower in a public place."
msgstr ""
"이 기둥에는 기묘한 노즐과 부착물들이 잔뜩 달려있습니다. 수도가 공급되면 이 부착물들로 눈에 들어간 해로운 화학물질을 씻어내거나, "
"공공장소에서 즐거운 찬물 샤워를 즐길 수 있을겁니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "IV pole"
msgstr "IV 기둥"

#. ~ Description for IV pole
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "This is basically just a stick on wheels with some hooks at the top."
msgstr "꼭대기에 조그만 훅이 달린, 바퀴 달린 막대입니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "high performance liquid chromatographer"
msgstr "고성능 액체 크로마토그래퍼"

#. ~ Description for high performance liquid chromatographer
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a liquid or aqueous phase based on "
"their affinity to a solid state medium in a tube.  In other words, it's a "
"fancy way to separate things."
msgstr ""
"전력과 숙련된 사용자가 있다면 액체 혹은 액체 위상을 갖고 있는 화학물질을 고체 촉매에 대한 친화도에 따라 분류할 수 있는 기계입니다. "
"그러니까, 대충 멋진 분류기계입니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "gas chromatographer"
msgstr "기체 크로마토그래퍼"

#. ~ Description for gas chromatographer
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This high-tech tool would, with electricity and an experienced user, be a "
"very useful way to separate chemicals in a gaseous phase based on their "
"affinity to a solid state medium in a tube.  In other words, it's a fancy "
"way to separate things."
msgstr ""
"전력과 숙련된 사용자가 있다면 기체 혹은 기체 위상을 갖고 있는 화학물질을 고체 촉매에 대한 친화도에 따라 분류할 수 있는 기계입니다. "
"그러니까, 대충 멋진 분류기계입니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "mass spectrometer"
msgstr "질량 분광계"

#. ~ Description for mass spectrometer
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"Inside this thing is a carefully balanced set of electric field generators "
"that can precisely separate ionized particles based on their charge-to-mass "
"ratio, firing them into a detector that measures the exact mass of the "
"particle hitting it.  On the outside, it looks like a very boring white box."
msgstr ""
"이 물건 안에는 섬세하게 조정된 전기장 생성기가 있어 어떤 물질의 전하 대 질량비에 따라 입자를 이온화하여 분리하고 그 입자를 탐지기로 "
"발사하여 입자의 정확한 질량을 계산할 수 있습니다. 겉으로 보기에는 그냥 하얀 상자네요."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "nuclear magnetic resonance spectrometer"
msgstr "핵자기공명 분광계"

#. ~ Description for nuclear magnetic resonance spectrometer
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This is a giant electromagnet in a kind of sci-fi looking housing.  Somehow "
"it can be used to wiggle molecular bonds or something, and from there, look "
"at the deepest inner workings of chemical structures!  Magnets: how do they "
"work?"
msgstr ""
"SF에 나올법하게 생긴 거대한 전자기석입니다. 원자의 결합 같은 걸 흐트러트려서, 화학 구조의 가장 내밀한 작동원리를 밝혀낼 수 "
"있습니다!  자석은 도대체 어떻게 작동하는 걸까요?"

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "electron microscope"
msgstr "전자 현미경"

#. ~ Description for electron microscope
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"An enormous tool for using electron reflections off a surface to see what "
"very tiny things look like.  Amazing for taking gross pictures of bugs."
msgstr ""
"물체의 표면에 전자를 투사하여 반사된 전자를 통해 아주 작은 물체가 어떻게 생겼는지 볼 수 있는 기계입니다. 끔찍한 벌레 사진을 찍기 "
"아주 쉽습니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "CT scanner"
msgstr "CT 스캐너"

#. ~ Description for CT scanner
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This giant donut can take hundreds of x-rays in rapid sequence, making a "
"really cool looking picture of all your innards that have varying degrees of"
" radio-opacity."
msgstr ""
"이 거대한 도넛모양 기계는 아주 빠르게 아주 많은 엑스레이를 투사해 방사선 투과율에 따라 달라지는 당신의 내부 모습을 아주 멋지게 찍어낼"
" 수 있습니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "MRI machine"
msgstr "MRI 기계"

#. ~ Description for MRI machine
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This thing is really an NMR that you stick a person into, but people weren't"
" excited about getting into a tiny hole in a loud machine called a 'nuclear "
"magnetic resonance imager', so they changed it."
msgstr ""
"이건 사실 사람을 안에 넣는 핵자기공명장치인데, 사람들이 \"핵자기공명영상기\"라고 불리는 기계 안에 들어가는 걸 별로 좋아하지 않아서 "
"그냥 MRI라고 이름을 바꿨습니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "scanner bed"
msgstr "스캔용 침대"

#. ~ Description for scanner bed
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"This is a narrow, uncomfortable bed for putting someone into an imaging "
"machine or other small hole."
msgstr "이 좁고 불편한 침대는 사람을 영상기 안 혹은 작은 구멍에 밀어넣는 데 사용합니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "anesthetic machine"
msgstr "마취기계"

#. ~ Description for anesthetic machine
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"Keeping a person at just the right level of asleep to do surgery is hard.  "
"This machine helps an anesthesiologist keep the right mix of drugs and air "
"to keep a patient asleep."
msgstr ""
"수술 동안 필요한 정도로만 사람이 잠들게 하는 것은 어려운 일입니다. 이 기계는 마취과 의사를 도와 환자를 계속 잠들게 하려면 필요한 "
"양의 약물과 공기량을 알려줍니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "dialysis machine"
msgstr "투석기"

#. ~ Description for dialysis machine
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"If your kidneys don't work, this is a large and inconvenient machine that "
"can do the job instead!  It's super useful in the apocalypse, especially "
"with how it requires power, tons of supplies, and a trained operator."
msgstr ""
"당신의 신장에 문제가 있다면, 이 크고 불편한 장비로 신장이 해야 할 일을 대신할 수 있습니다! 대재앙이 찾아온 지금 이 친구는 어찌나 "
"유용한지, 동력원도 필요하고, 소모품도 많이 필요하며, 훈련된 작동기사도 있어야 합니다."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "medical ventilator"
msgstr "의료용 인공호흡기"

#. ~ Description for medical ventilator
#: data/json/furniture_and_terrain/furniture-medical.json
msgid ""
"When they talk about the 'breathing machine' that you don't want to wind up "
"stuck on, this is what they mean.  It just looks like a couple boxes on a "
"trolley."
msgstr ""
"의사들이 \"숨쉬기용 기계\"를 달고 다니고 싶지는 않을 것이다, 라고 말할 때의 그 \"숨쉬기용 기계\"입니다. 트롤리에 박스 두 개 "
"끼운 것처럼 생겼네요."

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "privacy curtain"
msgstr "개인용 커튼"

#. ~ Description for privacy curtain
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "No peeking!"
msgstr "훔쳐보기 금지!"

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "swish!"
msgstr "스르륵"

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "clattering metal!"
msgstr "부딪치는 금속음"

#: data/json/furniture_and_terrain/furniture-medical.json
msgid "open privacy curtain"
msgstr "열린 개인용 커튼"

#. ~ Description for open privacy curtain
#: data/json/furniture_and_terrain/furniture-medical.json
msgid "Stop peeking!"
msgstr "그만 좀 훔쳐보세요!"

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "glowing tendril"
msgstr "빛나는 덩굴손"

#. ~ Description for glowing tendril
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"A willowy tendril growing from the floor, gently waving back and forth.  A "
"faint illumination spills from it."
msgstr "바닥에서 자라난 흐늘흐늘한 덩굴손으로, 부드럽게 앞뒤로 흔들립니다. 희미한 빛이 흐릅니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "splorch!"
msgstr "뿌직!"

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "wafting anemone"
msgstr "퍼지는 아네모네"

#. ~ Description for wafting anemone
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"A fleshy white protuberance growing from the floor, with a cluster of "
"tendrils pouring out of it.  It looks almost exactly like a sea anemone, "
"even waving gently as though in the water."
msgstr ""
"바닥에서 자라난 살집 있는 흰 돌기로, 한 뭉치의 덩굴손이 튀어나와있습니다. 물 속에 있는 것처럼 부드럽게 흔들리는게 꼭 말미잘 "
"같습니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "gasping tube"
msgstr "움켜쥐는 관"

#. ~ Description for gasping tube
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This is a meaty green stalactite with a thickened hide like that of a "
"starfish, extending from the floor to the ceiling.  In the center is a "
"series of ports somewhat like mouths, from which pour bursts of a vile "
"smelling gas."
msgstr ""
"살덩이 같은 녹색 종유석으로, 불가사리 같은 두터운 가죽이 달려있고 바닥에서 자라나 천장까지 뻗어있습니다. 중심부에는 뭔가 입처럼 생긴 "
"구멍들이 있어, 역겨운 냄새의 가스를 뿜어냅니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "twitching frond"
msgstr "꿈틀거리는 이파리"

#. ~ Description for twitching frond
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"A spine like the antenna of a moth juts from the ground, swaying gently in "
"the air.  Every so often, a cascade of energy arcs along it and discharges "
"into the ceiling."
msgstr "바닥에서 자라난, 애벌레 더듬이처럼 생긴 허리뼈로, 공기 중에서 부드럽게 흔들립니다. 이따금 전류가 튀어 천장까지 닿습니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "scarred lump"
msgstr "흉진 덩어리"

#. ~ Description for scarred lump
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This is a pile of unidentified twitching alien flesh, belching strange gases"
" out of injured vessels."
msgstr "알 수 없는 외계 살점 덩어리로, 찢겨진 용기 사이로 낯선 가스를 내뿜습니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "slimy pod"
msgstr "끈적한 주머니"

#. ~ Description for slimy pod
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This is a slick, translucent pod suspended on a thin stalk.  It is covered "
"in a thick mucus, obscuring whatever is floating in the gel-like substance "
"inside.  You could fairly easily tear it from the stalk and see if anything "
"is inside."
msgstr ""
"얇은 줄기에 매달린 두툼하고 반투명한 주머니입니다. 액이 두껍게 덮여있어, 젤 같은 내용물 안에 뭐가 떠있는지 잘 보이지 않습니다. 꽤 "
"쉽게 줄기에서 떼어내 내용물이 뭔지 볼 수 있을겁니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "organ pod"
msgstr "장기 주머니"

#. ~ Description for organ pod
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This is a translucent pod suspended on a thin stalk.  Inside you can see the"
" dimly outlined shape of human organs, floating in some kind of preservative"
" goo.  You could fairly easily tear it from the stalk and see if anything is"
" inside."
msgstr ""
"얇은 줄기에 매달린 반투명한 주머니입니다. 안에 보존성이 있어보이는 찐득이 안에 둥둥 떠있는, 흐릿한 인간 장기 형상들이 보입니다. 꽤 "
"쉽게 떼어내 내용물이 뭔지 볼 수 있을겁니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "resin pod"
msgstr "수지 주머니"

#. ~ Description for resin pod
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This is a translucent pod suspended on a thin stalk.  Inside is a clean, "
"clear resinous-looking fluid.  You could fairly easily tear it from the "
"stalk and take it with you."
msgstr ""
"얇은 줄기에 매달린 반투명한 주머니입니다. 안에 깨끗하고 투명한 수지 같은 액체가 있는 것이 보입니다. 꽤 쉽게 떼어내 내용물이 뭔지 볼"
" 수 있을겁니다."

#: data/json/furniture_and_terrain/furniture-migo.json
msgid "fleshy altar"
msgstr "살덩이 제단"

#. ~ Description for fleshy altar
#: data/json/furniture_and_terrain/furniture-migo.json
msgid ""
"This pulsing protuberance juts from the floor, its sides covered in scaled, "
"oozing skin.  The surface is flat, but undulates softly.  A handful of "
"unidentifiable appendages reach from the sides, suggesting a sort of "
"nightmarish living autodoc."
msgstr ""
"이 맥동하는 돌기는 바닥에서 솟아나, 양 옆이 비늘 달리고 진물 흐르는 피부로 덮여있습니다. 표면은 평평하면서도 부드럽게 파도칩니다. 한"
" 줌의 알 수 없는 부속물이 옆에서 뻗어나와있어, 마치 악몽에서 나올 법한 살아있는 오토닥처럼 보입니다."

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "bathtub"
msgstr "욕조"

#. ~ Description for bathtub
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"You could lay in and take a soothing bath, if there were running water.  The"
" plug is intact, so you could use it to store liquids."
msgstr "수도가 멀쩡했다면 안에 누워 편히 목욕할 수 있었을텐데요. 마개로 막혀있어 액체를 보관하는데 쓸 수 있을겁니다."

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "porcelain breaking!"
msgstr "도자기 깨짐!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "whunk!"
msgstr "터엉!"

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "shower"
msgstr "샤워기"

#. ~ Description for shower
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "You would be able to clean yourself if water was running."
msgstr "수도가 멀쩡했다면 이걸로 간만에 샤워를 좀 할 수 있을텐데요."

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "sink"
msgstr "싱크대"

#. ~ Description for sink
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"Emergency relief provider.  Water isn't running, so it's basically useless."
msgstr "긴급 구호 제공용입니다. 수도가 공급되지 않으므로 쓸모는 없습니다."

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "toilet"
msgstr "변기"

#. ~ Description for toilet
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"A porcelain throne.  Emergency water source, from the tank, and provider of "
"relief."
msgstr "도자기 왕좌입니다. 긴급상황에서는 탱크의 물을 수원으로 쓸 수 있고, 긴급 구호 제공용입니다."

#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "water heater"
msgstr "온수기"

#. ~ Description for water heater
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"An insulated metal tank that holds water, kept to a temperature by a small "
"gas flame."
msgstr "물을 담아놓는 내장된 금속 탱크가 있습니다. 작은 가스불로 온도를 유지합니다."

#: data/json/furniture_and_terrain/furniture-plumbing.json
#: data/json/items/tool/cooking.json data/json/vehicleparts/vehicle_parts.json
msgid "water purifier"
msgid_plural "water purifiers"
msgstr[0] "정수기"

#. ~ Description for water purifier
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid ""
"This removes ions dissolved in the water, making it pretty clean, if you "
"care about that kind of thing."
msgstr "이 장치는 물에 용해된 이온을 제거해, 그럭저럭 깨끗하게 만듭니다. 그런 것에 신경쓴다면 말이죠."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "exercise machine"
msgstr "운동 기계"

#. ~ Description for exercise machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Typically used for, well, exercising.  You're getting quite enough of that; "
"running for your life."
msgstr "대체로, 음, 운동하는데 쓰였습니다. 그거면 됐죠. 살고 싶으면 달려야 하지 않겠어요."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "ball machine"
msgstr "볼머신"

#. ~ Description for ball machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An unpowered machine that seems like it could've been used to launch various"
" balls for different types of sports.  It's only good for parts now if "
"disassembled."
msgstr "한때 여러 스포츠에 맞는 적절한 공을 발사할 수 있었던 동력 끊긴 기계입니다. 이제 분해해서 좋은 부품을 얻을 수 있습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "pool table"
msgstr "당구대"

#. ~ Description for pool table
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "A good-looking pool table.  You wish you learned how to play."
msgstr "괜찮은 당구대입니다. 당구를 어떻게 치는지 배워뒀다면 좋을텐데요."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "diving block"
msgstr "다이빙 대"

#. ~ Description for diving block
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "Jump!  Jump!  Dive!"
msgstr "뛰어! 뛰어! 다이브!"

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "target"
msgstr "목표"

#. ~ Description for target
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "A metal shooting target in the rough shape of a human."
msgstr "인간 형상을 대충 비슷하게 만든 금속제 사격 과녁."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "arcade machine"
msgstr "아케이드 게임기"

#. ~ Description for arcade machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Play stupid games, win stupid prizes.  That was the idea, anyway.  Now, "
"without power, it's just stupid.  Smarter to disassemble for all kinds of "
"useful electronic parts."
msgstr ""
"멍청한 게임을 하며 멍청한 상을 탑시다. 뭐 좋은 생각이긴 했어요. 지금은, 전기가 없으니, 멍청한 생각입니다. 좀 더 똑똑한 사람은 "
"온갖 쓸모있는 전자 부품을 얻으려 분해할겁니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "pinball machine"
msgstr "핀볼 게임기"

#. ~ Description for pinball machine
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Most underrated game of the 20th century.  Press buttons so the ball doesn't"
" go in the hole.  It doesn't seem to be working without electricity.  Could "
"be disassembled for various electronic parts."
msgstr ""
"20세기에 가장 저평가되었던 게임입니다. 버튼을 눌러 공이 구멍에 빠지지 않게 합니다. 전기가 없어 작동하지 않습니다. 분해하여 여러 "
"전자 부품을 회수할 수 있을 것 같습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "ergometer"
msgstr "에르고미터"

#. ~ Description for ergometer
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"An rowing exercise machine.  Without power, it can no longer help you with "
"your workout.  Might have useful electronic parts in it."
msgstr "조정 운동용 장비입니다. 전기가 없어 운동에 쓸 수는 없지만, 분해하면 쓸만한 전자 부품이 있을지도 모르겠습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "treadmill"
msgstr "런닝머신"

#. ~ Description for treadmill
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Used for training leg muscles.  It'll be extra hard without power.  Could be"
" taken apart for its… parts."
msgstr "다리 운동에 쓰였습니다. 전기가 없는 지금은 더 힘들겁니다. 분해해서... 부품을 얻을 수 있습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "heavy punching bag"
msgstr "샌드백"

#. ~ Description for heavy punching bag
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"Punch Punch!  Exercise those arms!  Main selling point: it doesn't fight "
"back!"
msgstr "펀치! 펀치! 팔 운동 시간입니다! 주요 세일즈 포인트: 이건 당신에게 반격하지 않아요!"

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "whud."
msgstr "퍽."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "piano"
msgstr "피아노"

#. ~ Description for piano
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"The ol' ebony and ivory.  Really classes up the place.  You could take it "
"apart if you wanted… you monster."
msgstr "옛 흑백. 정말 품위있는 물건입니다. 원한다면 분해할 수 있습니다... 이 괴물아."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "a suffering piano!"
msgstr "거친 피아노음"

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "kerchang."
msgstr "콰창"

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "speaker cabinet"
msgstr "스피커 캐비넷"

#. ~ Description for speaker cabinet
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid ""
"A cabinet loaded with 12-inch speakers, intended to help make various things"
" loud.  It can't serve its original purpose these days, but it could be "
"disassembled for various electronic parts."
msgstr ""
"12인치 스피커가 실린 캐비넷으로, 온갖 소리를 키울 수 있습니다. 요즘은 본래 용도로 쓸 수 없지만, 분해해 여러 전자 부품을 회수할 "
"수는 있습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "dancing pole"
msgstr "댄스용 기둥"

#. ~ Description for dancing pole
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "Tall metal pole meant for dancing, attached on bottom and top."
msgstr "높은 금속 기둥으로, 춤추는데 쓰였습니다. 바닥에서 천장까지 고정되어 있습니다."

#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "roulette table"
msgstr "룰렛 테이블"

#. ~ Description for roulette table
#: data/json/furniture_and_terrain/furniture-recreation.json
msgid "A big, scratched roulette table."
msgstr "크고 긁힌 자국이 있는 룰렛 테이블."

#. ~ Description for this should never actually show up, it's a pseudo
#. furniture
#: data/json/furniture_and_terrain/furniture-regional-pseudo.json
msgid "this should never actually show up, it's a pseudo furniture"
msgstr "이건 보이면 안됩니다. 가짜 가구거든요."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "cell phone signal booster"
msgstr "휴대폰 신호 증폭기"

#. ~ Description for cell phone signal booster
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "A cell phone signal booster, it may be useful for parts now."
msgstr "휴대폰 신호 증폭기로, 분해해서 부품을 얻는데 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "womp!"
msgstr "왕!"

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "satellite dish"
msgstr "위성 접시"

#. ~ Description for satellite dish
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "A small satellite dish for home entertainment."
msgstr "가정용 소형 위성 접시입니다."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "chimney crown"
msgstr "굴뚝 뚜껑"

#. ~ Description for chimney crown
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "The top of a chimney, it looks sooty."
msgstr "굴뚝 꼭대기 부분입니다. 거무튀튀합니다."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "TV antenna"
msgstr "TV 안테나"

#. ~ Description for TV antenna
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "The television antenna improved reception for televisions."
msgstr "더 나은 수신을 위한 텔레비전 안테나입니다."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "vent pipe"
msgstr "배기관"

#. ~ Description for vent pipe
#: data/json/furniture_and_terrain/furniture-roof.json
msgid "The plumbing vent pipe removes gas and odors from the building."
msgstr "건물에서 가스와 악취를 빼내는 환기용 배기관입니다."

#: data/json/furniture_and_terrain/furniture-roof.json
msgid "roof turbine vent"
msgstr "옥상 터빈 환풍구"

#. ~ Description for roof turbine vent
#: data/json/furniture_and_terrain/furniture-roof.json
msgid ""
"The turbine uses wind power to suck hot and humid air out of the attic."
msgstr "덥고 습한 공기를 다락에서 빼내기 위한 터빈입니다. 풍력을 사용합니다."

#: data/json/furniture_and_terrain/furniture-rural.json
msgid "bale of hay"
msgstr "건초더미"

#. ~ Description for bale of hay
#: data/json/furniture_and_terrain/furniture-rural.json
msgid "A bale of hay.  You could sleep on it, if desperate."
msgstr "건초더미입니다. 꼭 필요하다면 이 위에서 잘 수 있습니다."

#: data/json/furniture_and_terrain/furniture-rural.json
msgid "whish!"
msgstr "쉬잇!"

#: data/json/furniture_and_terrain/furniture-rural.json
msgid "pile of woodchips"
msgstr "쪼개진 나무조각 더미"

#. ~ Description for pile of woodchips
#: data/json/furniture_and_terrain/furniture-rural.json
msgid "Pile of chipped wood pieces.  You can move it with a shovel."
msgstr "쪼개진 나무조각 더미. 삽으로 치울 수 있습니다."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "bench"
msgstr "벤치"

#. ~ Description for bench
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "Hobo bed.  Airy.  Use at your own risk."
msgstr "허술한 침대입니다. 바람이 참 잘 통합니다. 본인 책임 하에 사용하세요."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "arm chair"
msgstr "안락의자"

#. ~ Description for arm chair
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "A more comfortable way of sitting down."
msgstr "더 편안하게 앉기 위해."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "airplane seat"
msgstr "비행기 좌석"

#. ~ Description for airplane seat
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "An airplane seat with a seatbelt."
msgstr "안전벨트가 달린 비행기 좌석."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "chair"
msgstr "의자"

#. ~ Description for chair
#. ~ Description for stool
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "Sit down, have a drink."
msgstr "여기 앉아서 한잔 걸치세요."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "sofa"
msgstr "소파"

#. ~ Description for sofa
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "Lie down OR sit down!  Perfect!"
msgstr "앉든가 눕든가! 최고야!"

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "stool"
msgstr "등받이 없는 의자"

#: data/json/furniture_and_terrain/furniture-seats.json
#: data/json/items/tool/deployable.json
msgid "camp chair"
msgid_plural "camp chairs"
msgstr[0] "캠프 의자"

#. ~ Description for camp chair
#: data/json/furniture_and_terrain/furniture-seats.json
msgid "Sit down, have a drink.  It can folded for easy transportation."
msgstr "여기 앉아서 한 잔 걸치세요. 접어서 운반할 수 있습니다."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "log stool"
msgstr "통나무 의자"

#. ~ Description for log stool
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A log tipped on its end with any rough edges cut off.  Basically a very "
"simple seat."
msgstr "거친 테두리를 베어낸, 끝이 기울어진 통나무. 간단한 의자로 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "deck chair"
msgstr "선탠용 의자"

#. ~ Description for deck chair
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A comfortable deck chair for sunbathing.  If only you had time for that."
msgstr "일광욕하기 좋은 선탠용 의자입니다. 선탠할 시간이 있다면 좋을텐데요."

#: data/json/furniture_and_terrain/furniture-seats.json
msgid "metal bench"
msgstr "금속 벤치"

#. ~ Description for metal bench
#: data/json/furniture_and_terrain/furniture-seats.json
msgid ""
"A bench made of scrap metal.  Not the most comfortable furniture you've ever"
" seen."
msgstr "고철로 만든 벤치. 솔직히 편안한 가구는 아닙니다."

#: data/json/furniture_and_terrain/furniture-signs.json
msgid "bulletin board"
msgstr "게시판"

#. ~ Description for bulletin board
#: data/json/furniture_and_terrain/furniture-signs.json
msgid ""
"A big, cork bulletin board capable of sporting various notices.  Pin some "
"notes for other survivors to read."
msgstr "커다란 코르크 게시판으로, 여러 안내문들을 고정해놓기 좋습니다. 다른 생존자들이 읽을 수 있게 메모를 남겨주세요."

#: data/json/furniture_and_terrain/furniture-signs.json
msgid "sign"
msgstr "표지판"

#. ~ Description for sign
#: data/json/furniture_and_terrain/furniture-signs.json
msgid "Read it.  Warnings ahead."
msgstr "읽으세요. 이 너머는 위험하다고요."

#: data/json/furniture_and_terrain/furniture-signs.json
msgid "warning sign"
msgstr "경고 표지판"

#. ~ Description for warning sign
#: data/json/furniture_and_terrain/furniture-signs.json
msgid ""
"A triangle-shaped sign on a post meant to indicate something important or "
"hazard."
msgstr "무언가 중요한 것이나 위험한 것을 알려주는 삼각형의 표지판입니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "bed"
msgstr "침대"

#. ~ Description for bed
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"This is a bed.  A luxury in these times.  Quite comfortable to sleep in."
msgstr "침대입니다. 요즘에는 호화로운 것이라고 할 수 있죠. 편안하게 잠들 수 있습니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "bunk bed"
msgstr "2단 침대"

#. ~ Description for bunk bed
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "A wooden bunk bed with mattresses for two people."
msgstr "2인용 매트리스가 있는 나무 2단 침대."

#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "bed frame"
msgstr "침대 틀"

#. ~ Description for bed frame
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"This is an empty bed frame.  With a mattress on it, it would be a nice place"
" to sleep.  Sleeping on it right now wouldn't be great."
msgstr ""
"비어있는 침대 틀입니다. 매트릭스를 설치하고 누우면 잠을 청하는데 훌륭합니다. 지금 당장은 수면에 도움이 되지 않을 거 같습니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "whack."
msgstr "콰직"

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/resources/misc.json
msgid "mattress"
msgid_plural "mattresses"
msgstr[0] "매트리스"

#. ~ Description for mattress
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"A comfortable mattress has been tossed on the floor for sleeping here.  It's"
" not quite as comfy as a real bed, but it's pretty close."
msgstr "잠을 자기 위해 푹신한 매트릭스를 바닥에 깔았습니다. 진짜 침대처럼 편하지는 않지만, 그럭저럭 비슷합니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors_indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json src/map.cpp
msgid "rrrrip!"
msgstr "찌이이이익!"

#: data/json/furniture_and_terrain/furniture-sleep.json
#: data/json/items/resources/misc.json
msgid "down mattress"
msgid_plural "down mattresses"
msgstr[0] "솜털 매트리스"

#. ~ Description for down mattress
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid ""
"A comfortable feather down mattress has been tossed on the floor for "
"sleeping here.  It's not quite as comfy as a real bed, but it's pretty "
"close."
msgstr "잠을 자기 위해 푹신한 솜털 매트릭스를 바닥에 깔았습니다. 진짜 침대처럼 편하지는 않지만, 그럭저럭 비슷합니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "makeshift bed"
msgstr "간이 침대"

#. ~ Description for makeshift bed
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "Not as comfortable as a real bed, but it will suffice."
msgstr "진짜 침대처럼 편하지는 않지만, 이정도면 충분합니다."

#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "straw bed"
msgstr "짚 침대"

#. ~ Description for straw bed
#: data/json/furniture_and_terrain/furniture-sleep.json
msgid "Kinda itches when you lay on it."
msgstr "위에 누우면 조금 근질근질합니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "bookcase"
msgstr "책장"

#. ~ Description for bookcase
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores books.  Y'know, those things.  Who reads books anymore?"
msgstr "책을 보관합니다. 제 말은, 그런 것들 말이죠. 대체 요즘 누가 책을 읽겠어요?"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "entertainment center"
msgstr "오락기기"

#. ~ Description for entertainment center
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores audio visual equipment, books and collectibles."
msgstr "시청각적 장비, 책, 그리고 잡다한 수집품들을 보관합니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "coffin"
msgstr "관"

#. ~ Description for coffin
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Holds the bodies of the countless killed in the Cataclysm."
msgstr "대재앙에서 죽어간 수많은 이들의 시신을 담습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
#: data/json/furniture_and_terrain/terrain-windows.json
msgid "wham!"
msgstr "꽝!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "open coffin"
msgstr "열린 관"

#. ~ Description for open coffin
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"You can only hope you'll look good enough for one of these, when the time "
"comes."
msgstr "그 순간이 찾아오면, 당신은 그저 적당한 관이 있기를 바랄 수밖에 없을겁니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "crate"
msgstr "상자"

#. ~ Description for crate
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"What's inside?  Pry it open to find out!  Or just smash it, but you might "
"break the contents."
msgstr "안에 뭐가 들어있을까요? 열어서 확인해봅시다! 아니면 두들겨부술 수도 있지만, 내용물이 망가질 수도 있습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "open crate"
msgstr "열린 상자"

#. ~ Description for open crate
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "What's inside?  Look in it!"
msgstr "안에 뭐가 들어있을까요? 확인해봅시다!"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/items/containers.json
msgid "large cardboard box"
msgid_plural "large cardboard boxes"
msgstr[0] "대형 종이상자"

#. ~ Description for large cardboard box
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A large cardboard box: this could be used to store things, or as a hiding "
"place."
msgstr "대형 종이상자입니다: 물건을 보관하는 용도로 쓸 수 있습니다. 아니면 숨는 장소로도요."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "crumple!"
msgstr "콰직!"

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/furniture-terrains.json src/ballistics.cpp
msgid "thud."
msgstr "툭."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Dark-Skies-Above/overrides/furniture_terrain/indoor_furniture.json
msgid "dresser"
msgstr "옷장"

#. ~ Description for dresser
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Dress yourself for the zombie prom, or other occasions."
msgstr "좀비 무도회나 뭐 그런 것들을 위해 옷을 차려입으세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "glass front cabinet"
msgstr "거울 달린 캐비넷"

#. ~ Description for glass front cabinet
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A tall storage cabinet with a clear glass window."
msgstr "깨끗한 유리창이 달린 큰 보관용 캐비넷입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors_indoor.json
#: data/json/furniture_and_terrain/terrain-walls.json
#: data/json/furniture_and_terrain/terrain-windows.json
#: data/mods/Magiclysm/furniture.json data/mods/No_Hope/terrain.json
#: src/ballistics.cpp src/map.cpp
msgid "glass breaking!"
msgstr "쨍그랑!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "gun safe"
msgstr "총기 금고"

#. ~ Description for gun safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Oooooohhhh.  Shiny."
msgstr "오오오오오오오오. 반짝이네요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "screeching metal!"
msgstr "콰앙!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "jammed gun safe"
msgstr "고장난 총기 금고"

#. ~ Description for jammed gun safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Does it have guns in it?  You won't find out.  It's jammed."
msgstr "안에 총이 들어 있을까요? 모르겠네요. 망가져서."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "electronic gun safe"
msgstr "전자식 총기 금고"

#. ~ Description for electronic gun safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Can you hack it open to get the firearms?"
msgstr "해킹해서 총을 얻을 수 있을까요?"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "locker"
msgstr "개인 물품 보관함"

#. ~ Description for locker
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Usually used for storing equipment or items."
msgstr "장비나 물품을 보관하는데 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "mailbox"
msgstr "우편함"

#. ~ Description for mailbox
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A metal box attached to the top of a wooden post.  Mail delivery hasn't come"
" for awhile.  Doesn't look like it's coming again anytime soon."
msgstr "나무 기둥 위에 달린 금속 상자입니다. 우편 배달부는 꽤 오래 안 왔고, 앞으로도 안 올 것 같습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "clothing rail"
msgstr "의류 보관대"

#. ~ Description for clothing rail
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A rail for hanging clothes on."
msgstr "옷들을 걸어놓는 보관대입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "display rack"
msgstr "진열용 선반"

#. ~ Description for display rack
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your items."
msgstr "당신의 물건을 전시하세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wooden rack"
msgstr "나무 선반"

#. ~ Description for wooden rack
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A simple wooden rack.  Display your items on it."
msgstr "나무 선반입니다. 물건들을 전시하세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "coat rack"
msgstr "코트 걸이"

#. ~ Description for coat rack
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A hooked rack for hanging jackets and hats."
msgstr "갈고리 달린 코트 걸이로, 코트나 모자를 걸어놓을 수 있습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "recycle bin"
msgstr "재활용 쓰레기통"

#. ~ Description for recycle bin
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores items for recycling."
msgstr "재활용품을 담아두세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "safe"
msgstr "금고"

#. ~ Description for safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Holds items.  Securely."
msgstr "물건을 보관합니다. 안전하게 말이죠."

#. ~ Description for safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "What needs protection like this?"
msgstr "얼마나 중요한 물건이길래 이렇게 철저히 보관해야 할까요?"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "open safe"
msgstr "열린 금고"

#. ~ Description for open safe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Grab the firearms!"
msgstr "총 챙기세요!"

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "trash can"
msgstr "쓰레기통"

#. ~ Description for trash can
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "One man's trash is another man's dinner."
msgstr "누군가의 쓰레기는 누군가의 저녁식사죠."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wardrobe"
msgstr "옷장"

#. ~ Description for wardrobe
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A tall piece of furniture - basically a freestanding closet."
msgstr "널찍한 가구로, 받침대 없는 벽장입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
#: data/mods/Urban_Development/building_jsons/urban_37_office_tower_beehive.json
msgid "filing cabinet"
msgstr "사무용 수납장"

#. ~ Description for filing cabinet
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A set of drawers in a sturdy metal cabinet, used to hold files.  It can be "
"locked to protect important information.  If you're lucky, there are often "
"keys nearby."
msgstr ""
"견고한 금속 캐비넷 안에 서랍장이 여럿 달려있어, 이런저런 서류를 보관할 수 있습니다. 중요한 정보를 보호하기 위해 잠궈둘 수 있고, "
"운이 좋다면 근처에 열쇠가 있을지도 모릅니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "utility shelf"
msgstr "다용도 선반"

#. ~ Description for utility shelf
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A simple heavy-duty plastic and metal shelving unit."
msgstr "플라스틱 및 금속으로 된 작은 보관함들이 딸린 선반입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "warehouse shelf"
msgstr "창고 선반"

#. ~ Description for warehouse shelf
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A large, sturdy shelf made of metal for storing pallets and crates in "
"warehouses."
msgstr "창고에 팔레트와 상자를 보관하기 위해 금속으로 만든 크고 튼튼한 선반입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "wooden keg"
msgstr "나무통"

#. ~ Description for wooden keg
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A keg made mostly of wood.  Holds liquids, preferably alcoholic."
msgstr "대체로 나무로 만들어진 통입니다. 액체, 특히 알코올을 담는데 쓰입니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "display case"
msgstr "진열장"

#. ~ Description for display case
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your stuff fancily and securely."
msgstr "당신의 물건을 멋지고 안전하게 보관하세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "broken display case"
msgstr "부서진 진열장"

#. ~ Description for broken display case
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Display your stuff.  It'll get stolen."
msgstr "당신의 물건을 여기에 보관하면 도둑맞을겁니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "standing tank"
msgstr "물탱크"

#. ~ Description for standing tank
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A large freestanding metal tank, useful for holding liquids."
msgstr "받침대 없는 커다란 금속 탱크로, 액체를 보관하는데 좋습니다."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "dumpster"
msgstr "쓰레기 컨테이너"

#. ~ Description for dumpster
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "Stores trash.  Doesn't get picked up anymore.  Note the smell."
msgstr "쓰레기를 담아놓는 것입니다. 그렇지만 더이상 쓰레기를 치워줄 환경미화원도 업체도 없군요. 냄새에 주의하세요."

#: data/json/furniture_and_terrain/furniture-storage.json
msgid "butter churn"
msgstr "버터 교유기"

#. ~ Description for butter churn
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "A pedal driven butter churn."
msgstr "페달식 버터 교유기입니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "counter"
msgstr "계산대"

#. ~ Description for counter
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Affixed to the wall or found in kitchens or stores."
msgstr "벽에 붙여진 채로 주방 또는 가게에서 흔히 찾아볼 수 있습니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "cupboard"
msgstr "찬장"

#. ~ Description for cupboard
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Store your cups."
msgstr "컵들을 담아놓으세요."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "closed counter gate"
msgstr "카운터 문 닫기"

#. ~ Description for closed counter gate
#. ~ Description for open counter gate
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A commercial quality swinging door made of wood that allows passage behind "
"counters."
msgstr "밀거나 당겨 카운터 뒤편 통로로 드나들 수 있는 상업용 문입니다. 흔히 서부영화에 나옵니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "open counter gate"
msgstr "카운터 문 열기"

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "desk"
msgstr "책상"

#. ~ Description for desk
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Sit down at it or work on it."
msgstr "위에 걸터앉거나, 서류를 올려놓는데 쓰입니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "workbench"
msgid_plural "workbenches"
msgstr[0] "작업대"

#. ~ Description for workbench
#. ~ Description for {'str': 'workbench', 'str_pl': 'workbenches'}
#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/vehicle/tables.json
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and"
" heavy things."
msgstr "철로 만든 견고한 작업대.  크고 무거운 걸 만들기에 적합합니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "leather tarp"
msgid_plural "leather tarps"
msgstr[0] "가죽 방수포"

#. ~ Description for leather tarp
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large sheet of sewn leather that can be used instead of a picnic blanket, "
"but it's more valuable as a butchery appliance as it does not soak in blood."
msgstr "피크닉용 돗자리 대신에 쓸 수 있는 커다랗고 무두질한 가죽 낱장이고, 피에 절어있지 않다면 도축 기구로서의 가치도 높습니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "plastic groundsheet"
msgstr "플라스틱 방수포"

#. ~ Description for plastic groundsheet
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large sheet of thick plastic has been tossed on the ground here.  It would"
" be a useful place to do some butchery, perhaps."
msgstr "바닥에 던져진 널찍한 플라스틱판입니다. 여기서 도축하기 좋을 것 같습니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "whuff!"
msgstr "퍽!"

#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "crinkle."
msgstr "딸그락"

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "fiber mat"
msgid_plural "fiber mats"
msgstr[0] "섬유 직조망"

#. ~ Description for fiber mat
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"A large mat woven from fibrous material that can be used instead of a picnic"
" blanket, but it's more valuable as a butchery appliance.  Too thin to be a "
"comfortable sleeping place."
msgstr ""
"피크닉용 돗자리 대신에 쓸 수 있는 커다란 직물 매트로, 피에 절어있지 않다면 도축 기구로서의 가치도 높습니다. 여기서 편히 자기에는 "
"너무 얇습니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/items/tool/deployable.json
msgid "tourist table"
msgid_plural "tourist tables"
msgstr[0] "여행 테이블"

#. ~ Description for tourist table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid ""
"Small metal folding table, ideal for off-road trips into the wild.  Can be "
"used as a workbench in a pinch."
msgstr "작은 금속제 접이식 테이블로, 야생으로 떠나는 오프로드 여행에 이상적입니다. 적당한 작업대로 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-surfaces.json
#: data/json/vehicleparts/vehicle_parts.json
msgid "table"
msgstr "탁자"

#. ~ Description for table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "Sit down when you eat!"
msgstr "'밥 먹을 때는 앉아서 먹어야지!'"

#. ~ Description for table
#: data/json/furniture_and_terrain/furniture-surfaces.json
msgid "a low table for livingrooms."
msgstr "거실에 자주 있는 낮은 탁자입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "tatami mat"
msgstr "다다미"

#. ~ Description for tatami mat
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A tatami is a type of mat used as a flooring material in traditional "
"Japanese-style rooms."
msgstr "다다미는 전통 일본식 방에서 바닥재로 사용하는 일종의 깔개입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pillow fort"
msgstr "베개 요새"

#. ~ Description for pillow fort
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A comfy place to hide from the world.  Not very defensible, though."
msgstr "세상으로부터 숨는데 좋은 장소입니다. 뭐 방어력은 별로 없겠습니다만."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "paf!"
msgstr "폭"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard fort"
msgstr "골판지 요새"

#. ~ Description for cardboard fort
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A fort built by tipping a cardboard box on its side, lining it with "
"blankets, and partly weather sealing it with a plastic sheet."
msgstr "골판지 상자를 집고 담요로 이어 플라스틱판으로 감싼 요새입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "cardboard wall"
msgstr "골판지 벽"

#. ~ Description for cardboard wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall."
msgstr "쓰레기와 잡동사니를 채워 벽돌처럼 쌓은 골판지 벽입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "beaded curtain"
msgstr "구슬장식 커튼"

#. ~ Description for beaded curtain
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This beaded curtain could be pulled aside."
msgstr "옆으로 젖힐 수 있는 구슬장식 커튼입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack… clack"
msgstr "짤그랑 짤그락... 짤그락... 짤그락"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack"
msgstr "짤그랑 짤그락... 짤그락"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open beaded curtain"
msgstr "구슬장식 커튼 열기"

#. ~ Description for open beaded curtain
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This beaded curtain has been pulled aside."
msgstr "이 구슬장식 커튼은 옆으로 젖혀둘 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "clickity clack… clack… clack!"
msgstr "짤그랑, 짤그락... 짤그락... 짤그락!"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas floor"
msgstr "캔버스 바닥"

#. ~ Description for canvas floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep the dirt out "
"of the tent."
msgstr "쫙 펼친 방수천을 바닥에 깔았습니다. 텐트에 흙이 들어오지 않게 막아줍니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas wall"
msgstr "캔버스 벽"

#. ~ Description for canvas wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A wall made of stretched, waterproof cloth."
msgstr "쫙 펼친 방수천 벽입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-floors_indoor.json
#: data/json/furniture_and_terrain/terrain-roofs.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "slap!"
msgstr "찰싹!"

#. ~ Description for canvas wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "A wall made of stretched, heavy-duty, waterproof cloth."
msgstr "쫙 펼친 튼튼한 방수천으로 만든 벽입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "canvas flap"
msgstr "캔버스 덮개"

#. ~ Description for canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This canvas flap door could be pulled aside."
msgstr "이 캔버스 덮개는 옆으로 젖혀둘 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open canvas flap"
msgstr "열린 캔버스 덮개"

#. ~ Description for open canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This canvas flap door has been pulled aside."
msgstr "이 캔버스 덮개는 옆으로 젖혀져 있습니다."

#. ~ Description for canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This heavy canvas flap door could be pulled aside."
msgstr "이 묵직한 캔버스 덮개는 옆으로 젖혀져 있습니다."

#. ~ Description for open canvas flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This heavy canvas flap door has been pulled aside."
msgstr "이 묵직한 캔버스 덮개 문은 옆으로 젖혀져 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "groundsheet"
msgstr "방수포"

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This plastic groundsheet could keep you dry."
msgstr "이 플라스틱 방수포가 있으면 몸이 젖지 않을 것입니다."

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This large plastic groundsheet could keep you dry."
msgstr "이 커다란 플라스틱 방수포가 있으면 몸이 젖지 않을 것입니다."

#. ~ Description for groundsheet
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"This plastic government-issue groundsheet could keep you dry, but was made "
"by the lowest bidder."
msgstr "이 관급 플라스틱 방수포가 있으면 몸이 젖지 않을 것입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin wall"
msgstr "짐승가죽 벽"

#. ~ Description for animalskin wall
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Wall made out of animal skin.  Either an amazing or horrifying sight."
msgstr "짐승가죽으로 만든 벽입니다. 보기 굉장할수도, 끔찍할수도 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin flap"
msgstr "짐승가죽 덮개"

#. ~ Description for animalskin flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin flap could be pulled aside."
msgstr "이 짐승가죽 덮개는 옆으로 젖혀둘 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "open animalskin flap"
msgstr "열린 짐승가죽 덮개"

#. ~ Description for open animalskin flap
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin flap has been pulled aside."
msgstr "이 짐승가죽 덮개는 옆으로 젖혀져 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "animalskin floor"
msgstr "짐승가죽 바닥"

#. ~ Description for animalskin floor
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "This animal skin groundsheet could keep you dry."
msgstr "이 짐승가죽 방수포가 있으면 몸이 젖지 않을 것입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of rubble"
msgstr "깨진 돌무더기"

#. ~ Description for pile of rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Pile of various metals, bricks, and other building materials.  You could "
"clear it with a shovel."
msgstr "여러 금속, 벽돌, 기타 건축 폐기물 더미입니다. 삽으로 치울 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of rocky rubble"
msgstr "깨진 바위더미"

#. ~ Description for pile of rocky rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Pile of rocks.  Useless?"
msgstr "깨진 바위더미입니다. 쓸모가 있을까요?"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of trashy rubble"
msgstr "쓰레기 더미"

#. ~ Description for pile of trashy rubble
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Trash topped with dirt and grass, it smells gross, but another man's trash…"
msgstr "흙과 잔디로 덮인 쓰레기 더미입니다. 냄새가 끔찍하고, 어쩌면 다른 누군가가 버린 쓰레기도 있을지 모르겠습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "metal wreckage"
msgstr "금속 잔해"

#. ~ Description for metal wreckage
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Pile of various bent and twisted metals."
msgstr "여러 구부러지고 뒤틀린 금속들이 쌓인 더미입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "pile of ash"
msgstr "잿더미"

#. ~ Description for pile of ash
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Some ash, from wood or possibly bodies."
msgstr "나무나 시체를 태우고 남은 재입니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "small boulder"
msgstr "작은 바위"

#. ~ Description for small boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Blocking your path.  Should be easy to move.  It can be used as a primitive "
"anvil."
msgstr "지나가는 길을 막고 있지만, 치우기는 쉽습니다. 원시적인 모루로 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "medium boulder"
msgstr "중간 크기의 바위"

#. ~ Description for medium boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Blocking your path.  It'll be a struggle to move.  It can be used as a "
"primitive anvil."
msgstr "지나가는 길을 막고 있고, 치우기 어렵습니다. 원시적인 모루로 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "large boulder"
msgstr "큰 바위"

#. ~ Description for large boulder
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "Now how are you going to move this?"
msgstr "이제 이걸 어떻게 치워야 할까요?"

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "street light"
msgstr "가로등"

#. ~ Description for street light
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Raised source of light which used to illuminate streets and their "
"surrounding area, but it's useless without electricity."
msgstr "거리와 주변을 밝히는 광원. 전력이 없으면 쓸모가 없습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "traffic light"
msgstr "신호등"

#. ~ Description for traffic light
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"Signaling device positioned at road intersections and pedestrian crossings "
"to control flows of traffic, but it's useless without electricity."
msgstr "교차로나 횡단보도에서 교통의 흐름을 조정하는 신호기. 전력이 없으면 쓸모가 없습니다."

#: data/json/furniture_and_terrain/furniture-terrains.json
msgid "utility pole"
msgstr "전신주"

#. ~ Description for utility pole
#: data/json/furniture_and_terrain/furniture-terrains.json
msgid ""
"A long wooden post which used to support overhead power lines and other "
"public utilities, but it doesn't work anymore."
msgstr "전기를 운반하는 긴 나무 기둥입니다. 더 이상 작동하지 않습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "forge"
msgstr "용광로"

#. ~ Description for forge
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Metalworking station typically used in combination with an anvil."
msgstr "보통 모루와 함께 사용하는 금속 가공 스테이션입니다."

#. ~ Description for anvil
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Used in metalworking."
msgstr "금속가공에 사용합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/cooking.json
msgid "still"
msgid_plural "stills"
msgstr[0] "증류기"

#. ~ Description for still
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An essential component for brewing and chemistry that allows for refining "
"liquid mixtures."
msgstr "액체 혼합물을 정제할 수 있도록 해줘 양조와 화학에 필수적인 기기입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/metalworking.json
msgid "charcoal kiln"
msgid_plural "charcoal kilns"
msgstr[0] "목탄 가마"

#. ~ Description for charcoal kiln
#. ~ Description for filled charcoal kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A rock kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr "나무와 유기물을 무산소 환경에서 연소시켜 목탄으로 만들도록 설계된 돌 가마입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/metalworking.json
msgid "filled charcoal kiln"
msgid_plural "filled charcoal kilns"
msgstr[0] "목탄 가마 (가득참)"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "metal charcoal kiln"
msgstr "금속 목탄 가마"

#. ~ Description for metal charcoal kiln
#. ~ Description for filled metal charcoal kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A metal kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr "나무와 유기물을 무산소 환경에서 연소시켜 목탄으로 만들도록 설계된 금속 가마입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled metal charcoal kiln"
msgstr "금속 목탄 가마 (가득참)"

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/fake.json
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "아크 용광로"

#. ~ Description for arc furnace
#. ~ Description for filled arc furnace
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to "
"create calcium carbide."
msgstr "코크스와 석회석을 태워 탄화칼슘을 만들기 위한 아크 용광로입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled arc furnace"
msgstr "아크 용광로 (가득참)"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "smoking rack"
msgstr "훈제 선반"

#. ~ Description for smoking rack
#. ~ Description for metal smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  "
"Works as a charcoal smoker in crafting recipes."
msgstr "더 나은 보존성과 맛을 위해 음식을 훈연하는데 쓰이는 특별한 선반입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active smoking rack"
msgstr "훈제 선반 (작동)"

#. ~ Description for active smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  It"
" is lit and smoking."
msgstr "더 나은 보존성과 맛을 위해 음식을 훈연하는데 쓰이는 특별한 선반입니다. 현재 불이 붙어 연기를 내뿜고 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "metal smoking rack"
msgid_plural "metal smoking racks"
msgstr[0] "강철 훈제 선반"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active metal smoking rack"
msgstr "강철 훈제 선반 (작동)"

#. ~ Description for active metal smoking rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste."
msgstr "더 나은 보존성과 맛을 위해 음식을 훈연하는데 쓰이는 특별한 선반입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "rock forge"
msgstr "석재 용광로"

#. ~ Description for rock forge
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Metalworking station made of rock, typically used in combination with an "
"anvil.  Works as a charcoal forge in crafting recipes."
msgstr "돌로 만들어진 금속 제련용 시설로, 보통 모루와 함께 사용됩니다. 물품 제작에 있어 목탄 화로처럼 작동합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "clay kiln"
msgstr "점토 가마"

#. ~ Description for clay kiln
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A kiln designed to bake clay pottery and bricks."
msgstr "점토로 도자기와 벽돌을 굽는데 쓰이는 가마입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/misc.json
msgid "stepladder"
msgid_plural "stepladders"
msgstr[0] "발판 사다리"

#. ~ Description for stepladder
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A short, foldable ladder.  Can help you climb to a rooftop, or maybe slow "
"something down."
msgstr "작고 접을 수 있는 사다리입니다. 지붕에 올라가는데 쓰거나, 뭔가가 다가올 때 거치적거리게 하는데 쓸 수 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "electric arc furnace"
msgstr "전기 화로"

#. ~ Description for electric arc furnace
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Not the kind of furnace you'd heat your house with, this is a device for "
"heating things to extreme temperatures as part of industrial fabrication "
"processes."
msgstr "집에 난방을 공급하는데 쓰이는 화로와 달리, 이것은 공장식 제작 공정의 일부로, 물질을 초고온으로 가열하는데 쓰였습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "drill press"
msgstr "드릴 프레스기"

#. ~ Description for drill press
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  "
"Useful in all kinds of projects from industrial fabrication to home "
"woodworking."
msgstr ""
"강력한 드릴이 경사에 장착되어 정밀하게 내리쳐질 준비를 마쳤습니다. 산업 공작에서 집에서 하는 목공예까지 온갖 작업에 유용합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "tablesaw"
msgstr "테이블톱"

#. ~ Description for tablesaw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A rotating saw blade set into a large flat table, for making straight "
"measured cuts.  One of the key tools in a carpenter's arsenal."
msgstr "넓고 평평한 탁자에 달린 회전식 톱날로, 반듯하게 자르는데 쓰입니다. 목수의 작업고에 꼭 필요한 핵심 도구 중 하나입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "mitre saw"
msgstr "미터톱"

#. ~ Description for mitre saw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A circular saw blade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry."
msgstr "거의 모든 목공예 작업에 유용한 도구로, 팔에 달려 여러 방향으로 회전하고 또 미끄러질 수 있는 회전식 톱날입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "bandsaw"
msgstr "띠톱"

#. ~ Description for bandsaw
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle."
msgstr "이 도구에는 한 방향으로 돌아가는 리본처럼 생긴 톱날이 달려있어, 거의 어느 각도로든 정밀한 절단을 가능케 합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "router table"
msgstr "라우터 테이블"

#. ~ Description for router table
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves and stuff."
msgstr ""
"이 탁자에는 라우터가 끼워넣어져 있고, 교환 가능한 날머리가 달린 회전하는 모터가 있어, 윤곽을 잡거나 홈을 내거나 하는 일에 "
"유용합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "planer"
msgstr "플래너"

#. ~ Description for planer
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width.  Particularly great if working with raw lumber stock, but "
"also good just for shaving wood down to size."
msgstr ""
"널빤지를 매끈하고 평평하며 일정한 너비를 갖게끔 잘라낼 수 있는 커다란 도구입니다. 생나무에 작업할 때 특히 좋지만, 나무를 적당한 "
"크기로 벗겨내는데도 유용합니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "jointer"
msgstr "조인터"

#. ~ Description for jointer
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, "
"and square off a board to make it very smooth and nice indeed."
msgstr ""
"아무 널빤지를 자르고, 껍질을 벗기고, 네모나게 잘라 매끈하고 멋지게 만들 수 있는, 회전하는 칼날이 달린 탁자처럼 생긴 도구입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/mods/More_Locations/terrain.json
msgid "hydraulic press"
msgstr "수력 압착기"

#. ~ Description for hydraulic press
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"If you really want to squash something a lot, this would be exactly the "
"right industrial tool for you.  If, you know, it had power."
msgstr "뭔가를 정말 잔뜩 뭉개야 한다면, 이게 바로 당신에게 필요한 도구입니다. 뭐, 당신도 알다시피, 동력만 있다면요."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/mods/More_Locations/terrain.json
msgid "power lathe"
msgstr "동력 선반"

#. ~ Description for power lathe
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"An industrial-grade lathe, for turning chunks of metal and other hard things"
" into round chunks of metal and other hard things."
msgstr "산업용 선반으로, 금속 덩어리나 다른 단단한 것들을 둥근 금속 덩어리 내지는 그런 것들로 만드는데 쓰입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "air compressor"
msgstr "에어 컴프레서"

#. ~ Description for air compressor
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"This durable tank is topped with a motor that will cram as much air into the"
" tank as possible."
msgstr "이 튼튼한 탱크는 공기를 탱크에 가능한한 많이 주입하는데 쓰이는 모터가 꼭대기에 달려있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "fermenting vat"
msgstr "발효통"

#. ~ Description for fermenting vat
#. ~ Description for filled fermenting vat
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A sealable vat for fermenting vinegar and various alcoholic brews."
msgstr "식초나 다른 알코올 혼합물들을 발효시키는데 쓰이는, 봉인 가능한 통입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "filled fermenting vat"
msgstr "채워진 발효통"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "butchering rack"
msgstr "도축 선반"

#. ~ Description for butchering rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Butchering rack designed to hang a carcass in the air."
msgstr "시체를 허공에 매달아놓기 위한 도축 선반입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "metal butchering rack"
msgid_plural "metal butchering racks"
msgstr[0] "강철 도축 선반"

#. ~ Description for metal butchering rack
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Metal butchering rack designed to hang a carcass in the air.  It can be "
"deconstructed and folded for easy transportation."
msgstr "시체를 허공에 매달아놓기 위한 금속 도축 선반입니다. 떼어내고 접어서 쉽게 이동시킬 수 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "hanging meathook"
msgstr "고정용 고기갈고리"

#. ~ Description for hanging meathook
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A hefty hook suspended from a chain for stringing up corpses."
msgstr "시체를 매달아놓는데 쓰이는 묵직한 갈고리로, 사슬 끝에 매달려있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "wind mill"
msgid_plural "wind mills"
msgstr[0] "풍차"

#. ~ Description for wind mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small wind-powered mill that can convert starchy products into flour."
msgstr "조그만 풍력 방아로, 탄수화물이 풍부한 것들을 빻아 밀가루로 만들 수 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active wind mill"
msgstr "풍차 (작동)"

#. ~ Description for active wind mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small wind-powered mill that can convert starchy products into flour.  Its"
" brake has been removed and it is turning."
msgstr "조그만 풍력 방아로, 탄수화물이 풍부한 것들을 빻아 밀가루로 만들 수 있습니다. 브레이크가 치워져 현재 돌아가고 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/items/tool/deployable.json
msgid "water mill"
msgid_plural "water mills"
msgstr[0] "물레방아"

#. ~ Description for water mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small water-powered mill that can convert starchy products into flour."
msgstr "조그만 수력 방아로, 탄수화물이 풍부한 것들을 빻아 밀가루로 만들 수 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "active water mill"
msgstr "물레방아 (작동)"

#. ~ Description for active water mill
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A small water-powered mill that can convert starchy products into flour.  "
"Its brake has been removed and it is turning."
msgstr "조그만 수력 방아로, 탄수화물이 풍부한 것들을 빻아 밀가루로 만들 수 있습니다. 브레이크가 치워져 현재 돌아가고 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "automated gas console"
msgstr "자동식 주유 제어기"

#. ~ Description for automated gas console
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Automated gas flow control console."
msgstr "주유를 자동으로 제어하는 조작판입니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "broken automated gas console"
msgstr "고장난 자동식 주유 제어기"

#. ~ Description for broken automated gas console
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Automated gas flow control console.  Broken.  This is not a good thing."
msgstr "주유를 자동으로 제어하는 조작판입니다. 망가져서 별 쓸모는 없습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "reinforced vending machine"
msgstr "강화된 자판기"

#. ~ Description for reinforced vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"A bit tougher to crack open than regular vending machines.  That just makes "
"it all the sweeter a target, doesn't it?"
msgstr "다른 자판기보다 박살내기 어려운 튼튼한 자판기. 뭐 이런 고난이 결과물을 더 달콤하게 만들겠죠. 안 그런가요?"

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "vending machine"
msgstr "자판기"

#. ~ Description for vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "Buy stuff with a cash card."
msgstr "현금 카드로 내용물을 삽시다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "broken vending machine"
msgstr "고장난 자판기"

#. ~ Description for broken vending machine
#: data/json/furniture_and_terrain/furniture-tools.json
msgid ""
"Ponder if you could buy stuff, as it's broken.  Maybe if you broke it more, "
"you wouldn't need to pay at all!"
msgstr "뭔가를 살 수 있을지 곰곰히 고민합니다. 고장났거든요. 좀 더 부수면 아예 돈을 안 내도 될 것 같습니다!"

#: data/json/furniture_and_terrain/furniture-tools.json
#: data/json/furniture_and_terrain/terrain-zlevel-transitions.json
msgid "rope leading up"
msgstr "위로 올라가는 밧줄"

#. ~ Description for rope leading up
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A rope.  You could climb it up."
msgstr "밧줄입니다. 붙잡고 오를 수 있습니다."

#: data/json/furniture_and_terrain/furniture-tools.json
msgid "web rope leading up"
msgstr ""

#. ~ Description for web rope leading up
#: data/json/furniture_and_terrain/furniture-tools.json
msgid "A web rope.  You could climb it up."
msgstr ""

#. ~ Description for -
#: data/json/furniture_and_terrain/furniture-zztesting.json src/item.cpp
msgid "-"
msgstr "-"

#: data/json/furniture_and_terrain/furniture-zztesting.json
msgid "floor lamp (no power)"
msgstr "실내용 전등 (전력 없음)"

#. ~ Description for floor lamp (no power)
#: data/json/furniture_and_terrain/furniture-zztesting.json
msgid "A tall standing lamp, plugged into a wall.  This one has no power."
msgstr "벽에 달린 콘센트에 연결된 길쭉한 실내용 전등입니다. 전기가 들어오지 않는 것 같습니다."

#. ~ Message for furniture 'floor lamp (no power)'
#. ~ Message for furniture 'floor lamp (on)'
#. ~ Use action msg for {'str': 'electric lantern (on)', 'str_pl': 'electric
#. lanterns (on)'}.
#: data/json/furniture_and_terrain/furniture-zztesting.json
#: data/json/items/tool/lighting.json
msgid "You turn the lamp off."
msgstr "랜턴을 껐습니다."

#: data/json/furniture_and_terrain/furniture-zztesting.json
msgid "floor lamp (off)"
msgstr "실내용 전등 (꺼짐)"

#. ~ Message for furniture 'floor lamp (off)'
#. ~ Use action msg for {'str': 'electric lantern (off)', 'str_pl': 'electric
#. lanterns (off)'}.
#. ~ Use action msg for {'str': 'gasoline lantern (off)', 'str_pl': 'gasoline
#. lanterns (off)'}.
#. ~ Use action msg for {'str': 'oil lamp (off)', 'str_pl': 'oil lamps
#. (off)'}.
#: data/json/furniture_and_terrain/furniture-zztesting.json
#: data/json/items/tool/lighting.json
msgid "You turn the lamp on."
msgstr "랜턴을 켰습니다."

#: data/json/furniture_and_terrain/furniture-zztesting.json
msgid "floor lamp (on)"
msgstr "실내용 전등 (켜짐)"

#. ~ Description for floor lamp (on)
#: data/json/furniture_and_terrain/furniture-zztesting.json
msgid "A tall standing lamp, plugged into a wall."
msgstr "벽에 달린 콘센트에 연결된 길쭉한 실내용 전등입니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "walkway"
msgstr "통로"

#. ~ Description for walkway
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A metallic bridge commonly used in industrial settings to meet specified "
"safety standards."
msgstr "산업지구에서 구체화된 안전 표준을 준수하기 위해 흔히 쓰이는 금속 다리입니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/overmap/overmap_terrain/overmap_terrain_recreational.json
msgid "dock"
msgstr "부두"

#. ~ Description for dock
#. ~ Description for shallow bridge
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "A wooden platform held by a support made of logs dug into the ground."
msgstr "땅에 통나무를 매립해 만든 지지대로 떠받쳐지는 목재 플랫폼입니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock pile"
msgstr "깊은 부두 기둥"

#. ~ Description for deep dock pile
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A sturdy pile made of wood extending all the way to the riverbed.  A frame "
"will be required to support a surface."
msgstr "강바닥 깊숙한 곳까지 꽂혀있는 튼튼한 기둥. 바닥을 지탱하려면 프레임이 필요합니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock frame"
msgstr "깊은 부두 프레임"

#. ~ Description for deep dock frame
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A log frame secured atop a wooden pile.  Adding a wood surface will make "
"this into a proper dock section."
msgstr "나무 기둥 위에 고정시킨 통나무 프레임. 이 위에 나무 바닥을 깔면 적당한 부두 구획이 될겁니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "deep dock"
msgstr "깊은 부두"

#. ~ Description for deep dock
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A wooden platform held by a tall wooden pile that extend to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr "강바닥 깊숙한 곳까지 꽃힌 커다란 나무 기둥으로 지탱되는 나무 플랫폼. 매우 튼튼하고, 당신보다 오래 살 것 같습니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "shallow bridge"
msgstr "얕은 강 다리"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "pontoon bridge"
msgstr "부교"

#. ~ Description for pontoon bridge
#. ~ Description for river bridge
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid ""
"A floating temporary bridge, like the ones army used to make to cross "
"rivers."
msgstr "떠다니는 임시 다리로, 흔히 군인들이 강을 건너는데 쓰곤 합니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
msgid "river bridge"
msgstr "강 다리"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge pavement"
msgstr "도로-다리"

#. ~ Description for bridge pavement
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "A bridge section made out of metal and concrete."
msgstr "금속과 콘크리트로 만든 다리 구획입니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "concrete cracking and metal screeching!"
msgstr "콘크리트가 깨지고 금속이 긁히는 소리"

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge yellow pavement"
msgstr "중앙선-다리"

#. ~ Description for bridge yellow pavement
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "A bridge section made out of metal and concrete.  It's painted yellow."
msgstr "금속과 콘크리트로 만든 다리 구획입니다. 노란색으로 칠해져 있습니다."

#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "bridge sidewalk"
msgstr "인도-다리"

#. ~ Description for bridge sidewalk
#: data/json/furniture_and_terrain/terrain-bridges-docks.json
#: data/json/furniture_and_terrain/terrain-highways.json
msgid "The sidewalk section of a concrete bridge."
msgstr "콘크리트 다리의 인도 구획입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed laminated glass door"
msgstr "닫힌 접합 유리 문"

#. ~ Description for closed laminated glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A closed laminated glass door is composed layers of glass and plastic held "
"together by an interlayer."
msgstr "유리판과 플라스틱판을 교차하도록 접합한 닫힌 접합 유리 문입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open laminated glass door"
msgstr "열린 접합 유리 문"

#. ~ Description for open laminated glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Laminated glass door is composed layers of glass and plastic held together "
"by an interlayer.  Yep, it's open."
msgstr "유리판과 플라스틱판을 교차하도록 접합한 접합 유리 문입니다. 네, 열려 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed ballistic glass door"
msgstr "닫힌 방탄 유리 문"

#. ~ Description for closed ballistic glass door
#. ~ Description for ballistic glass
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "Ballistic glass consists of layers of laminated glass."
msgstr "방탄 유리는 여러 겹의 접합 유리로 이루어져 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open ballistic glass door"
msgstr "열린 방탄 유리 문"

#. ~ Description for open ballistic glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Ballistic glass consists of layers of laminated glass.  Yep, it's open."
msgstr "겹겹의 합판 유리로 이루어진 방탄 유리입니다.  열려있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed reinforced glass door"
msgstr "닫힌 강화 유리 문"

#. ~ Description for closed reinforced glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A closed glass door reinforced with woven steel wires in a stylish, but "
"practical pattern."
msgstr "멋있고 실용적인 무늬가 짜여진, 강철 철사로 강화된 닫힌 유리 문입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open reinforced glass door"
msgstr "열린 강화 유리 문"

#. ~ Description for open reinforced glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A glass door reinforced with woven steel wires in a stylish, but practical "
"pattern.  Yep, it's open."
msgstr "멋있고 실용적인 무늬가 짜여진, 강철 철사로 강화된 유리 문입니다. 예, 열려있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed wood door"
msgstr "닫힌 나무 문"

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too."
msgstr "별 탄력 없어보이는 평범한 나무 문입니다. 쉽게 불에 탈 것입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open wood door"
msgstr "열린 나무 문"

#. ~ Description for open wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one is wide open."
msgstr "별 탄력 없어보이는 평범한 나무 문입니다. 쉽게 불에 탈 것입니다. 활짝 열려 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged wood door"
msgstr "파손된 나무 문"

#. ~ Description for damaged wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A trashed wooden door, that is more of an obstacle than a door.  Also, you "
"can see right through it.  It could be boarded up with a few two by fours."
msgstr "본래 용도보다는 장애물에 가깝게 파손된 나무 문입니다.  그 너머로 볼 수 있습니다.  널빤지 몇 개로 수리할 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty door frame"
msgstr "빈 문틀"

#. ~ Description for empty door frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty door frame made from two by fours and nails.  A variety of doors "
"could be constructed here."
msgstr "널빤지와 못으로 만든 빈 문틀입니다. 이곳에 여러 종류의 문을 설치할 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed glass door"
msgstr "닫힌 유리 문"

#. ~ Description for closed glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A sliding glass door, the kind that was on social media with people and "
"animals running into.  This one is closed, so don't hurt yourself."
msgstr ""
"미닫이식 유리 문으로,  사람이나 동물이 뛰어들어 부딪히는 움짤에 흔히 나오던 것들입니다. 닫혀있으니 괜한 시도는 하지 마세요."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open glass door"
msgstr "열린 유리 문"

#. ~ Description for open glass door
#. ~ Description for open frosted glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A sliding glass door that has been left open for all manner of things to "
"travel through."
msgstr "미닫이식 유리 문으로, 활짝 열려 누구든 지나갈 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed wood door with peephole"
msgstr "닫힌 나무 문-외시경"

#. ~ Description for closed wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole."
msgstr "평범한 나무로 만들어진 문이지만, 외시경이 달려있습니다. 가까이에서 살펴보면 구멍을 통해 바깥을 엿볼 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged wood door with peephole"
msgstr "파손된 나무 문-외시경"

#. ~ Description for damaged wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Bad news is the peephole is broken and you can't look outside the door.  "
"Good news is the door is nearly broken down, so there's nothing blocking the"
" view.  A few planks, nails and the right tools could patch up all the "
"damage."
msgstr ""
"나쁜 소식은, 외시경이 망가져서 바깥을 볼 수 없다는겁니다. 좋은 소식은 문도 거의 망가져서 당신의 시야를 가로막는게 없다는거고요. "
"널빤지 몇 장, 못, 그리고 적당한 도구가 있다면 이 모든 손상을 고칠 수 있을겁니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open wood door with peephole"
msgstr "열린 나무 문-외시경"

#. ~ Description for open wood door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  "
"Although, you don't need to peek through it since the door is open anyway."
msgstr ""
"평범한 나무로 만들어진 문이지만, 외시경이 달려있습니다. 가까이에서 살펴보면 구멍을 통해 바깥을 엿볼 수 있습니다. 그렇지만 문이 이미 "
"열려있으니 굳이 엿볼 필요는 없을 것 같네요."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed reinforced wood door"
msgstr "닫힌 강화 나무 문"

#. ~ Description for closed reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours and additional hinge for reinforcement.  It might be barricaded, but "
"still susceptible to fire."
msgstr ""
"다른 나무 문과 같지만, 이 문은 못 박은 널빤지 몇 겹 및 추가 경첩으로 보강되어 있습니다. 튼튼해졌지만 여전히 불에는 취약합니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "damaged reinforced wood door"
msgstr "파손된 강화 나무 문"

#. ~ Description for damaged reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"There are splintering planks and visible holes in the wood, it looks like it"
" could be smashed apart if not repaired."
msgstr "박살난 판잣조각이 널브러져있고, 나무에 구멍이 몇 개 보입니다. 수리하지 않으면 박살나 산산조각날 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open reinforced wood door"
msgstr "열린 강화 나무 문"

#. ~ Description for open reinforced wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours for reinforcement.  It might be fortified, but still susceptible to "
"fire.  It's open so it's not stopping anything right now."
msgstr ""
"다른 나무 문과 같지만, 이 문은 못 박은 널빤지 몇 겹 및 추가 경첩으로 보강되어 있습니다. 튼튼해졌지만 여전히 불에는 취약합니다. "
"이미 열려있으니 당신을 가로막을 수 있는건 없습니다."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has an extra keyhole, so it's likely locked.  You "
"could pry it open or pick the lock."
msgstr ""
"별 탄력 없어보이는 평범한 나무 문입니다. 쉽게 불에 탈 것입니다. 추가 열쇠구멍이 달려있는걸 볼 때 잠겨있을지도 모릅니다. 지레로 뜯어"
" 열거나 혹은 자물쇠를 딸 수 있습니다."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has a deadbolt keyhole, so it's likely locked.  You "
"could pry it open or pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"별 탄력 없어보이는 평범한 나무 문입니다. 쉽게 불에 탈 것입니다. 이중 자물쇠가 달려있는걸 볼 때 잠겨있을지도 모릅니다. 지레로 뜯어 "
"열거나, 자물쇠를 따거나, 혹은 내부에서 이중 자물쇠를 해제할 수 있습니다."

#. ~ Description for closed wood door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  This "
"one has a deadbolt keyhole, so it's likely locked.  You could pry it open or"
" pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"평범한 나무로 만들어진 문이지만, 외시경이 달려있습니다. 가까이에서 살펴보면 구멍을 통해 바깥을 엿볼 수 있습니다. 이중 자물쇠가 "
"달려있는걸 볼 때 잠겨있을지도 모릅니다. 지레로 뜯어 열거나, 자물쇠를 따거나, 혹은 내부에서 이중 자물쇠를 해제할 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed door curtain"
msgstr "닫힌 커튼 달린 문"

#. ~ Description for closed door curtain
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else."
msgstr "창문에서 떼어낸 커튼이 문 역할을 하고 있습니다. 재료 또는 다른 곳에 설치하기 위해 쉽게 떼어낼 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed makeshift door"
msgstr "닫힌 임시 문"

#. ~ Description for closed makeshift door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with vertical "
"rope hanging from the top of the doorway.  Could be easily taken down and "
"re-purposed."
msgstr "문간 꼭대기에 수직 밧줄로 매달린 널빤지들로 구성된 급조 차단막입니다. 쉽게 떼어내 다른 용도에 쓸 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "wham."
msgstr "쿵."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open door curtain"
msgstr "열린 커튼 달린 문"

#. ~ Description for open door curtain
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else.  These curtains are open, "
"bundled and tied next to the doorway."
msgstr ""
"창문에서 떼어낸 커튼이 문 역할을 하고 있습니다. 재료 또는 다른 곳에 설치하기 위해 쉽게 떼어낼 수 있습니다. 커튼이 열려있고, 모아서"
" 묶인 채 문간에 걸려있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open makeshift door"
msgstr "열린 임시 문"

#. ~ Description for open makeshift door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with rope "
"hanging from the top of the doorway.  Could be easily taken down and re-"
"purposed.  The planks have been rolled up and attached to the top of the "
"doorway, allowing free movement through."
msgstr ""
"문간 꼭대기에 수직 밧줄로 매달린 널빤지들로 구성된 급조 차단막입니다. 쉽게 떼어내 다른 용도에 쓸 수 있습니다. 널빤지가 돌돌 말려 "
"문간 꼭대기에 붙어있어, 통로로 쉽게 다닐 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty metal door frame"
msgstr "빈 금속 문틀"

#. ~ Description for empty metal door frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty door frame made of steel and assorted metal.  A variety of doors "
"could be constructed here."
msgstr "철과 다른 금속으로 만든 빈 문틀입니다. 이곳에 여러 종류의 문을 설치할 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "empty metal window frame"
msgstr "빈 금속 창문틀"

#. ~ Description for empty metal window frame
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An empty window frame constructed from assembled metal and carefully braced "
"with various hardware."
msgstr "금속으로 만들어지고 여러 장치로 지지되고 있는 빈 창문 틀입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up door"
msgstr "판자로 막은 문"

#. ~ Description for boarded up door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A standard wooden door that has several planks across it, nailed down to "
"board it up and increase its durability.  Still flammable though."
msgstr "평범한 나무 문 위에 널빤지를 여러 장 못질해 내구성을 늘렸습니다. 여전히 불에는 취약합니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged door"
msgstr "파손된 판자로 막은 문"

#. ~ Description for boarded up damaged door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A boarded up wooden door, except some of the planks are fractured or coming "
"loose.  Without repairs, it could be broken down easily."
msgstr "덧댄 나무 문이지만, 널빤지 몇 장이 쪼개지고 또 느슨해졌습니다. 수리하지 않으면 쉽게 부서질 것입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up door with peephole"
msgstr "판자로 막은 문-외시경"

#. ~ Description for boarded up door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A boarded up door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, you could still examine the "
"peephole."
msgstr "나무를 덧댄 문이지만, 외시경이 달려있습니다. 널빤지로 덮여있긴 하지만, 외시경을 살펴볼 수는 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up reinforced door"
msgstr "판자로 막은 강화 문"

#. ~ Description for boarded up reinforced door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An additionally reinforced door of layered two by fours that has been "
"boarded up with more wood to prevent it from opening.  Still susceptible to "
"fire."
msgstr "개방을 막기 위해 널빤지를 추가로 겹겹이 덧댄 문입니다. 여전히 불에 취약합니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged reinforced door"
msgstr "파손된 판자로 막은 강화 문"

#. ~ Description for boarded up damaged reinforced door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A battered and torn reinforced door with planks bursting from the joints.  "
"The boarded up two by fours are fragmented and in pieces, this doesn't look "
"like an easy repair."
msgstr ""
"뭉개지고 찢겨진 강화된 문으로, 고정된 자리에서 널빤지들이 튀어나와있습니다. 덧댄 널빤지가 조각조각 박살나있어, 수리하기 쉽지 "
"않아보입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "boarded up damaged door with peephole"
msgstr "파손된 판자로 막은 문-외시경"

#. ~ Description for boarded up damaged door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A wrecked door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, the peephole was damaged and can't "
"be used to see through."
msgstr "파손된 문이고, 외시경이 달려있습니다. 널빤지로 덮여있긴 하지만, 외시경이 손상되어 밖을 내다보는데 쓸 수 없습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed metal door"
msgstr "닫힌 금속 문"

#. ~ Description for closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape."
msgstr "제련된 금속을 틀에 부어 만든 매우 튼튼한 문입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid "metal wall"
msgstr "금속 벽"

#. ~ Description for metal wall
#: data/json/furniture_and_terrain/terrain-doors.json
#: data/json/furniture_and_terrain/terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned and joined "
"seamlessly with perimeter sealant, this wall is capable of resisting extreme"
" elements as well as hostile forces.  Blast load rated and extremely fire-"
"retardant, breaching will require specialized tools or industrial vehicles."
msgstr ""
"공장제 철판들을 조심스럽게 위치를 잡고 주위를 빈틈없이 밀폐되도록 접합시킨 이 금속 벽은 적대적 공격 및 해로운 환경에 충분히 저항할 수"
" 있습니다. 폭발 저항력 및 화염 저항력이 우수해, 이 벽을 파쇄하려면 전문 장비나 산업 차량이 있어야 할겁니다."

#: data/json/furniture_and_terrain/terrain-doors.json
#: data/mods/More_Locations/secret_doors/secret_door_terrain.json
msgid "open secret door"
msgstr "열린 비밀 문"

#. ~ Description for open secret door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"This apparently normal segment of metal wall has opened to reveal a secret "
"passage."
msgstr "평범한 금속 벽처럼 생겼지만, 활짝 열려 비밀 통로가 드러나있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open metal door"
msgstr "열린 금속 문"

#. ~ Description for open metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's open, so no tools are needed to break in."
msgstr "제련된 금속을 틀에 부어 만든 매우 튼튼한 문입니다. 열려있으니 딱히 특별한 도구 없이도 들어갈 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed metal door with peephole"
msgstr "닫힌 금속 문-외시경"

#. ~ Description for closed metal door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole."
msgstr "제련된 금속을 틀에 부어 만든 매우 튼튼한 문입니다. 가까이에서 살펴보면 구멍을 통해 바깥을 엿볼 수 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open metal door with peephole"
msgstr "열린 금속 문-외시경"

#. ~ Description for open metal door with peephole
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole.  Although, you don't need to peek through it since the door is open "
"anyway."
msgstr ""
"제련된 금속을 틀에 부어 만든 매우 튼튼한 문입니다. 가까이에서 살펴보면 구멍을 통해 바깥을 엿볼 수 있습니다. 그렇지만 문이 이미 "
"열려있으니 굳이 엿볼 필요는 없습니다."

#. ~ Description for closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A galvanized steel door, forged to withstand punishment and impede anyone or"
" anything.  Typically used in conjunction with automated electronic locking "
"mechanisms that require an external source to unlock."
msgstr ""
"가혹하게 다뤄도 견디도록, 그 누구도 그 무엇도 막아내도록 단조된 아연 도금 강철 문. 일반적으로, 풀려면 외부 전원이 필요한 전자식 "
"자동 잠금 장치와 함께 쓰입니다."

#. ~ Description for open metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A hanging metal gate.  Typically used in conjunction with mechanical winch."
"  Probably shouldn't be underneath when it comes down."
msgstr "매달린 금속 대문. 일반적으로 기계식 윈치와 함께 쓰입니다. 대문이 내려올 때 그 아래에 있으면 아마 안됩니다."

#. ~ Description for closed metal door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  This one has an extra keyhole, so it's likely locked.  You could "
"probably pick the lock, or a very strong tool could pry it open."
msgstr ""
"제련된 금속을 틀에 부어 만든 매우 튼튼한 문입니다. 추가 열쇠구멍이 달려있는걸 보니 아마 잠겨있을겁니다. 원한다면 자물쇠를 딸 수 "
"있습니다. 아니면 강력한 도구가 지레질로 열 수도 있습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed bar door"
msgstr "닫힌 쇠창살 문"

#. ~ Description for closed bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism doesn't appear to be engaged."
msgstr "십자형 스테인리스 스틸 막대로 만들어진 쇠창살 문. 잠금 장치가 작동하지 않는 것 같습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open bar door"
msgstr "열린 쇠창살 문"

#. ~ Description for open bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's swung "
"wide open.  Freedom!"
msgstr "십자형 스테인리스 스틸 막대로 만들어진 쇠창살 문. 활짝 열려 있습니다. 프리덤!"

#. ~ Description for closed bar door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism appears to be engaged.  The mechanism could be picked open with "
"enough skill."
msgstr "십자형 스테인리스 스틸 막대로 만들어진 쇠창살 문. 잠금 장치가 작동하는 것 같습니다. 기술이 충분하면 열릴 것 같습니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "closed frosted glass door"
msgstr "닫힌 간유리 문"

#. ~ Description for closed frosted glass door
#: data/json/furniture_and_terrain/terrain-doors.json
msgid "A sliding door of frosted white glass."
msgstr "간유리로 만든 미닫이문입니다."

#: data/json/furniture_and_terrain/terrain-doors.json
msgid "open frosted glass door"
msgstr "열린 간유리 문"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "palisade gate"
msgstr "말뚝 대문"

#. ~ Description for palisade gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A large doorway consisting of long logs cabled together, that could be "
"expanded upon.  Can act as a door if some type of pulley system were rigged "
"on an adjacent palisade wall."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open palisade gate"
msgstr "열린 말뚝 대문"

#. ~ Description for open palisade gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A hanging palisade gate, hoisted by a nearby pulley system.  Probably "
"shouldn't be underneath when it comes down."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "makeshift portcullis"
msgstr "간이 쇠창살 문"

#. ~ Description for makeshift portcullis
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"An immense gateway scrapped together with various bits of steel and metal "
"scraps."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "locked wire gate"
msgstr "잠긴 철책 문"

#. ~ Description for locked wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chain link fence.  This one has a locked padlock on the latch "
"system.  With the right tools, you could cut the metal fence or pick the "
"lock.  You could also examine the fence to see if it looks climbable."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed wire gate"
msgstr "닫힌 철책 문"

#. ~ Description for closed wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A gate for a chain link fence with a latch system to stay closed."
msgstr "걸쇠가 달려 닫아둘 수 있는 철책 문입니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open wire gate"
msgstr "열린 철책 문"

#. ~ Description for open wire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chain link fence with a latch system to stay closed.  The latch"
" is undone, so the gate has swung open."
msgstr "걸쇠가 달려 닫아둘 수 있는 철책 문입니다. 지금은 걸쇠가 걸려있지 않아 문이 열려있습니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed wooden gate"
msgstr "닫힌 나무 울타리 문"

#. ~ Description for closed wooden gate
#. ~ Description for closed wooden split rail gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A commercial quality gate made of wood with a latch system."
msgstr "돈 받고 팔아도 될 수준의 나무 문으로, 걸쇠가 달려있습니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open wooden gate"
msgstr "열린 나무 울타리 문"

#. ~ Description for open wooden gate
#. ~ Description for open wooden split rail gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A commercial quality gate made of wood with a latch system.  The gate is "
"wide open, allowing anything to travel through."
msgstr "돈 받고 팔아도 될 수준의 나무 문으로, 걸쇠가 달려있습니다. 문이 활짝 열려있어 뭐든지 지나갈 수 있습니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed screen door"
msgstr "플라스틱 망 문 닫기"

#. ~ Description for closed screen door
#. ~ Description for open screen door
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "A simple wooden doorway with screen mesh."
msgstr "플라스틱 망으로 된 문입니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "rattle!"
msgstr "덜컹!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open screen door"
msgstr "플라스틱 망 문 열기"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "closed chickenwire gate"
msgstr "육각 철조망 울타리 문 닫기"

#. ~ Description for closed chickenwire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed."
msgstr "육각 철조망 울타리 문으로, 걸쇠가 달려있어 닫아둘 수 있습니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "open chickenwire gate"
msgstr "육각 철조망 울타리 문 열기"

#. ~ Description for open chickenwire gate
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed.  "
"The latch is undone, so the gate has swung open."
msgstr "육각 철조망 울타리 문으로, 걸쇠가 달려있어 닫아둘 수 있습니다. 지금은 걸쇠가 걸려있지 않아 문이 열려있습니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "picket fence"
msgstr "울타리"

#. ~ Description for picket fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of wood, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "나무로 만든 간단한 장애물입니다. 여기로 가서는 안된다고 알리는 가벼운 경고이기도 합니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chain link fence"
msgstr "철책"

#. ~ Description for chain link fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A tall fence made of woven wires.  It doesn't suggest to stop, it just "
"stops."
msgstr "강철 철사로 만들어진 높은 울타리입니다. 이것은 멈추라고 경고하고 있지 않습니다. 그냥 막아섭니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "metal post"
msgstr "금속 기둥"

#. ~ Description for metal post
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "Set of metal posts, that can hold more serious fences."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chickenwire fence"
msgstr "육각 철조망 울타리"

#. ~ Description for chickenwire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather flimsy tall fence made of 2x4s and woven wire, suitable for "
"containing small livestock like chickens."
msgstr ""
"2x4 크기로 강철 철사를 이용해 만들어진, 비교적으로 조잡한 높은 울타리입니다. 닭과 같은 작은 가축들을 두는 데 적합합니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "metal rattling!"
msgstr "끼기기기긱!"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "screen mesh wall"
msgstr "플라스틱 망 벽"

#. ~ Description for screen mesh wall
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather flimsy tall wall made of 2x4s and screen mesh, suitable for keeping"
" the bugs out."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "chickenwire fence post"
msgstr "육각 철조망 울타리 기둥"

#. ~ Description for chickenwire fence post
#. ~ Description for fence post
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A couple of posts that support the fence.  They look alone without the "
"fence."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "fence post"
msgstr "울타리 기둥"

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "wire fence"
msgstr "철조망"

#. ~ Description for wire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of wire, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "철사로 만든 간단한 장애물입니다. 여기로 가서는 안된다고 알리는 가벼운 경고이기도 합니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "barbed wire fence"
msgstr "가시철조망"

#. ~ Description for barbed wire fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of sharp barbed wire.  More persuasive brother of wire fence."
msgstr ""

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "rope fence"
msgstr "밧줄 울타리"

#. ~ Description for rope fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A barrier made of rope, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "밧줄로 만든 간단한 장애물입니다. 여기로 가서는 안된다고 알리는 가벼운 경고이기도 합니다."

#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid "split rail fence"
msgstr "분할 레일 울타리"

#. ~ Description for split rail fence
#: data/json/furniture_and_terrain/terrain-fences-gates.json
msgid ""
"A rather stout fence made of 2x4s and fence posts, suitable for containing "
"livestock like horses, cows and pigs."
msgstr ""

