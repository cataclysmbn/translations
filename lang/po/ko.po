#: data/json/speech.json
msgid "\"Great.\""
msgstr "\"좋았어.\""

#: data/json/speech.json
msgid "\"Fantastic.\""
msgstr "\"환상적이군.\""

#: data/json/speech.json
msgid "\"God damn it.\""
msgstr "\"빌어먹을.\""

#: data/json/speech.json
msgid "\"God damn it!\""
msgstr "\"빌어먹을!\""

#: data/json/speech.json
msgid "\"Damn it.\""
msgstr "\"젠장.\""

#: data/json/speech.json
msgid "\"Damn it!\""
msgstr "\"젠장!\""

#: data/json/speech.json
msgid "\"Fuck.\""
msgstr "\"씨발.\""

#: data/json/speech.json
msgid "\"Shit.\""
msgstr "\"썅.\""

#: data/json/speech.json
msgid "\"Fuck!\""
msgstr "\"씨발!\""

#: data/json/speech.json
msgid "\"Shit!\""
msgstr "\"썅!\""

#: data/json/speech.json
msgid "\"Fuckin' piece of garbage.\""
msgstr "\"망할 쓰레기 쪼가리 같으니.\""

#: data/json/speech.json
msgid "\"I need a new lab coat.\""
msgstr "\"새 실험 가운이 필요해.\""

#: data/json/speech.json
msgid "\"Excellent.\""
msgstr "\"훌륭해.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Excuse me.\""
msgstr "\"저기요.\""

#: data/json/speech.json
msgid "\"Good morning.\""
msgstr "\"좋은 아침.\""

#: data/json/speech.json
msgid "\"Good afternoon.\""
msgstr "\"안녕하세요.\""

#: data/json/speech.json
msgid "\"Good evening.\""
msgstr "\"안녕하세요!\""

#: data/json/speech.json
msgid "\"Good night.\""
msgstr "\"잘자.\""

#: data/json/speech.json
msgid "\"Good luck.\""
msgstr "\"행운을 빌어.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Can I help you?\""
msgstr "\"무엇을 도와드릴까요?\""

#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "\"만나는 사람 있니?\""

#: data/json/speech.json
msgid "\"Forget it.\""
msgstr "\"됐어.\""

#: data/json/speech.json
msgid "\"How long were you two together?\""
msgstr "\"둘이 얼마나 오래 붙어다닌거야?\""

#: data/json/speech.json
msgid "\"Give me a call later.\""
msgstr "\"나중에 연락해.\""

#: data/json/speech.json
msgid "\"Call me.\""
msgstr "\"연락해.\""

#: data/json/speech.json
msgid "\"From time to time.\""
msgstr "\"가끔.\""

#: data/json/speech.json
msgid "\"We have a serious situation here.\""
msgstr "\"이거 상황이 안 좋은데.\""

#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "\"경찰 불러.\""

#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "\"구급차 불러.\""

#: data/json/speech.json
msgid "\"Get me the White House.\""
msgstr "\"백악관으로 연결해.\""

#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "\"너 괜찮니?\""

#: data/json/speech.json
msgid "\"I think I'll live.\""
msgstr "\"난 아무렇지도 않아.\""

#: data/json/speech.json
msgid "\"I think I need to see a doctor.\""
msgstr "\"아무래도 진찰이 필요할 것 같아.\""

#: data/json/speech.json
msgid "\"Is everything all right?\""
msgstr "\"이제 괜찮은건가?\""

#: data/json/speech.json
msgid "\"I'm okay, don't worry about me.\""
msgstr "\"괜찮아, 걱정하지 마.\""

#: data/json/speech.json
msgid "\"It's just a scratch.\""
msgstr "\"그냥 긁힌 것 뿐이야.\""

#: data/json/speech.json
msgid "\"I've got a headache.\""
msgstr "\"머리가 아파.\""

#: data/json/speech.json
msgid "\"I'm fine.\""
msgstr "\"괜찮아.\""

#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "\"정말?\""

#: data/json/speech.json
msgid "\"Positive.\""
msgstr "\"긍정적이다.\""

#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "\"확인했다.\""

#: data/json/speech.json
msgid "\"Negative.\""
msgstr "\"부정적이야.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"Sorry.\""
msgstr "\"미안.\""

#: data/json/speech.json
msgid "\"Happy Birthday!\""
msgstr "\"생일 축하해!\""

#: data/json/speech.json
msgid "\"Have you ever been to California?\""
msgstr "\"너 캘리포니아 가본적 있니?\""

#: data/json/speech.json
msgid "\"What time do you get off?\""
msgstr "\"언제 떠날꺼야?\""

#: data/json/speech.json
msgid "\"We should hit up the shooting range later.\""
msgstr "\"나중에 사격장 좀 가야겠는데.\""

#: data/json/speech.json
msgid "\"I'm heading to the pool after work.\""
msgstr "\"일 끝나고 수영장 갈거야.\""

#: data/json/speech.json
msgid "\"Have a good trip.\""
msgstr "\"잘 '갔다' 오라구.\""

#: data/json/speech.json
msgid "\"Where did you come from?\""
msgstr "\"너 어디서 왔니?\""

#: data/json/speech.json
msgid "\"Have you been waiting long?\""
msgstr "\"오래 기다렸지?\""

#: data/json/speech.json
msgid "\"Have you done this before?\""
msgstr "\"전에도 해봤어?\""

#: data/json/speech.json
msgid "\"Hello.\""
msgstr "\"안녕.\""

#: data/json/speech.json
msgid "\"Help!\""
msgstr "\"도와줘!\""

#: data/json/speech.json
msgid "\"Here it is.\""
msgstr "\"여기 있어.\""

#: data/json/speech.json
msgid "\"I've got family coming tomorrow.\""
msgstr "\"내일 가족이 올꺼야.\""

#: data/json/speech.json
msgid "\"How do I use this?\""
msgstr "\"이거 어떻게 쓰지?\""

#: data/json/speech.json
msgid "\"How do you know?\""
msgstr "\"어떻게 알았지?\""

#: data/json/speech.json
msgid "\"How long have you been here?\""
msgstr "\"여기 얼마나 오래 있었어?\""

#: data/json/speech.json
msgid "\"How many languages do you speak?\""
msgstr "\"언어 몇 개나 말할 수 있어?\""

#: data/json/speech.json
msgid "\"How many people?\""
msgstr "\"사람이 몇이야?\""

#: data/json/speech.json
msgid "\"How much were these earrings?\""
msgstr "\"이 귀걸이 얼마야?\""

#: data/json/speech.json
msgid "\"How much do I owe you?\""
msgstr "\"내가 너한테 진 빚이 얼마지?\""

#: data/json/speech.json
msgid "\"How much will it cost?\""
msgstr "\"비용이 얼마죠?\""

#: data/json/speech.json
msgid "\"How much would you like?\""
msgstr "\"얼마를 원하는거요?\""

#: data/json/speech.json
msgid "\"How old are you?\""
msgstr "\"몇살이야?\""

#: data/json/speech.json
msgid "\"How tall is it?\""
msgstr "\"키가 몇이야?\""

#: data/json/speech.json
msgid "\"How was the movie?\""
msgstr "\"영화는 어땠어?\""

#: data/json/speech.json
msgid "\"How was your trip?\""
msgstr "\"여행은 어땠어?\""

#: data/json/speech.json
msgid "\"How's it going?\""
msgstr "\"어떻게 되가?\""

#: data/json/speech.json
msgid "\"See you later.\""
msgstr "\"나중에 봐.\""

#: data/json/speech.json
msgid "\"See you tonight.\""
msgstr "\"오늘밤에 보자.\""

#: data/json/speech.json
msgid "\"I got this weird rash a few days ago.\""
msgstr "\"며칠 전에 이상한 발진이 생겼어.\""

#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "\"내가 이것 좀 볼게.\""

#: data/json/speech.json
msgid "\"When did you find out?\""
msgstr "\"언제 구한 거야?\""

#: data/json/speech.json
msgid "\"Seven o'clock.\""
msgstr "\"일곱시 정각.\""

#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "\"아무도 우릴 도와주지 않아.\""

#: data/json/speech.json
msgid "\"We're on our own.\""
msgstr "\"우리 스스로 해야해.\""

#: data/json/speech.json
msgid "\"We're all alone.\""
msgstr "\"우린 혼자야.\""

#: data/json/speech.json
msgid "\"We should split into groups of two each.\""
msgstr "\"각자 둘로 나눠져야 돼.\""

#: data/json/speech.json
msgid "\"It can't follow all of us.\""
msgstr "\"우릴 한 번에 다 쫓아오진 못할거야.\""

#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "\"밖 조심해.\""

#: data/json/speech.json data/mods/CrazyCataclysm/crazy_speech.json
msgid "\"There you are.\""
msgstr "\"거기 있었네.\""

#: data/json/speech.json
msgid "\"I've been looking all over for you.\""
msgstr "\"널 찾느라고 고생 좀 했지.\""

#: data/json/speech.json
msgid "\"It's looking for us.\""
msgstr "\"우릴 찾고 있어.\""

#: data/json/speech.json
msgid "\"It's faster than us.\""
msgstr "\"우리보다 빨라.\""

#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "\"우릴 똑바로 쳐다보고 있어.\""

#: data/json/speech.json
msgid "\"It's heading right for us!\""
msgstr "\"우리한테 오고 있어!\""

#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "\"수영할 수 있냐?\""

#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "\"그러지 마.\""

#: data/json/speech.json
msgid "\"You hear that?\""
msgstr "\"방금 들었어?\""

#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "\"조용히.\""

#: data/json/speech.json
msgid "\"Look out!\""
msgstr "\"조심해!\""

#: data/json/speech.json
msgid "\"Run!\""
msgstr "\"튀어!\""

#: data/json/speech.json
msgid "\"Hurry!\""
msgstr "\"어서!\""

#: data/json/speech.json
msgid "\"No!\""
msgstr "\"안 돼!\""

#: data/json/speech.json
msgid "\"I'll never forget you.\""
msgstr "\"널 잊지 못할거야.\""

#: data/json/speech.json
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"그 놈 총 받아. 앞으로 필요하게 될 거야.\""

#: data/json/speech.json
msgid "\"How do we get out of here?\""
msgstr "\"여기서 어떻게 나가지?\""

#: data/json/speech.json
msgid "\"This place is like a maze.\""
msgstr "\"미로같구만.\""

#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"세상에, 나 혼자 남았잖아.\""

#: data/json/speech.json
msgid "\"Please, I don't want to die.\""
msgstr "\"제발, 난 죽고 싶지 않아.\""

#: data/json/speech.json
msgid "\"Mom.\""
msgstr "\"엄마.\""

#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "\"엄마, 보고 싶어요.\""

#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "\"내가 갈게, 넌 기다려.\""

#: data/json/speech.json
msgid "\"Please, God.\""
msgstr "\"신이시여, 제발.\""

#: data/json/speech.json
msgid "a gurgling sound."
msgstr "쿠르륵 소리."

#: data/json/speech.json
msgid "a choking sound."
msgstr "컥컥 소리."

#: data/json/speech.json
msgid "a snapping sound."
msgstr "뭔가 부러지는 소리."

#. ~ Beeper sound
#: data/json/speech.json src/vehicle_use.cpp
msgid "beep!"
msgstr "삐익!"

#: data/json/speech.json src/mattack_actors.cpp
#: src/player_hardcoded_effects.cpp
msgid "beep-beep-beep!"
msgstr "삐익-삐익-삐익!"

#: data/json/speech.json
msgid "BEEP!"
msgstr "삐-삑!"

#: data/json/speech.json
msgid "a loud hiss."
msgstr "큰 쉭쉭 소리."

#: data/json/speech.json
msgid "a loud crackling noise."
msgstr "큰 탁탁 소리."

#: data/json/speech.json src/ranged.cpp
msgid "bang!"
msgstr "탕!"

#: data/json/speech.json
msgid "a klaxon blaring!"
msgstr "요란한 경적 소리!"

#: data/json/speech.json
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "\"비상, 비상!\""

#: data/json/speech.json
msgid "a static hissing sound."
msgstr "일정한 쉬익거리는 소리."

#: data/json/speech.json
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr "\"끝장난 세상에 어울리는 버려지고 으스스한 연구단지라. 인전해 보이는군...\""

#: data/json/speech.json
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr "\"걱정 마. 저게 설마 격리실에서 공간이동이라도 하겠어?\""

#: data/json/speech.json
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "\"기다려 봐. 저 좀비 시체를 박살낼 거야.\""

#: data/json/speech.json
msgid "\"What did that thing just hit me with?\""
msgstr "\"뭔가 날 치고 간 것 같은데?\""

#: data/json/speech.json
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "\"몸이 말을 안 듣는다. 튀어! 너라도 살아!\""

#: data/json/speech.json
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "\"야이 애미 뒤진 조개새끼야, 넌 이제 뒈졌다.\""

#: data/json/speech.json
msgid "\"I… I feel weak…\""
msgstr "\"힘이... 빠지는 것 같아...\""

#: data/json/speech.json
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "\"야, 씨발, 니가 날 여기 버리고 가면 안되지.\""

#: data/json/speech.json
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "\"우린 너거들이랑 조약 맺었잖어. 그제?\""

#: data/json/speech.json
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "\"상사한테 보고해야겠어, 지금 당장!\""

#: data/json/speech.json
msgid "\"Lemme outta here!\""
msgstr "\"여기서 내보내줘!\""

#: data/json/speech.json
msgid "\"We're both scavs, in't we?\""
msgstr "\"거 같은 쥐새끼끼리 너무 그러지 말자고. 응?\""

#: data/json/speech.json
msgid ""
"\"Hey look, that one's carrying something.  Let's crack it open and steal "
"it.\""
msgstr "\"이야, 저거 봐. 꽤 괜찮은거 갖고 있네. 박살내고 훔쳐가자.\""

#: data/json/speech.json
msgid "\"G… geddoff me you… you bastard…\""
msgstr "\"저… 저리 꺼지라, 이… 이 개새꺄…\""

#: data/json/speech.json
msgid "\"Did-a-chuk?\""
msgstr "\"케상에?\""

#: data/json/speech.json
msgid "\"Dad-a-chak?\""
msgstr "\"캅소사?\""

#: data/json/speech.json
msgid "\"Dad-a-cham?\""
msgstr "\"일어먹을?\""

#: data/json/speech.json
msgid "\"Did-a-chak?\""
msgstr "\"카지가지하네?\""

#: data/json/speech.json
msgid "\"Did-a-chum?\""
msgstr "\"껀 또 뭐야?\""

#: data/json/speech.json
msgid "\"Dad-a-chuk?\""
msgstr "\"캅소사?\""

#: data/json/speech.json
msgid "\"What are you doing?  No!  NO!\""
msgstr "\"뭐하는 거야? 안 돼! 하지 마!!\""

#: data/json/speech.json
msgid "\"Did you see what they did to him?\""
msgstr "\"저 새끼들이 녀석에게 무슨 짓을 했는지 봤지?\""

#: data/json/speech.json
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "\"그래. 녀석이 생각보다 오래 살아있던 게 놀랍군.\""

#: data/json/speech.json
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "\"내 생각엔 말야, 공기 중에 분포한 무언가가 우리를 살아있도록 하는 것 같아.\""

#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "\"속이... 타는 것 같아...\""

#: data/json/speech.json
msgid "\"This smell…  Don't know…\""
msgstr "\"이 냄새... 모르겠군...\""

#: data/json/speech.json
msgid "heavy breathing."
msgstr "거친 숨소리"

#: data/json/speech.json src/game.cpp src/grab.cpp
msgid "a scraping noise."
msgstr "긁히는 소리"

#: data/json/speech.json
msgid "\"No…  Stop the burning!\""
msgstr "\"안 돼... 소각을 멈춰!\""

#: data/json/speech.json
msgid "\"Hrgm…  Blood…  Hungry…\""
msgstr "\"크르륵... 피... 배고파...\""

#: data/json/speech.json
msgid "\"Hunger…  Must eat…\""
msgstr "\"배... 고프다... 먹어야 한다...\""

#: data/json/speech.json
msgid "\"Run…  Chase…  Eat…\""
msgstr "\"달린다... 쫓는다... 먹는다...\""

#: data/json/speech.json
msgid "hysterical laughing."
msgstr "히스테리컬한 웃음"

#: data/json/speech.json
msgid "coughing."
msgstr "기침 소리"

#: data/json/speech.json
msgid "growling."
msgstr "으르렁 소리"

#: data/json/speech.json
msgid "wheezing."
msgstr "쌕쌕대는 소리"

#: data/json/speech.json
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "\"나한테 왜 이 지랄을 하는 건데?!\""

#: data/json/speech.json
msgid "\"LEAVE!  NOW!\""
msgstr "\"당장 꺼져!\""

#: data/json/speech.json
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "\"당장 꺼지라고 했잖아!!\""

#: data/json/speech.json
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "\"대체 씨발 나한테서 뭘 원하는 거냐고?!\""

#: data/json/speech.json
msgid "\"STOP!\""
msgstr "\"그만하라고!!\""

#: data/json/speech.json
msgid "indistinct shouting."
msgstr "뭉개진 고함 소리"

#: data/json/speech.json
msgid "screaming."
msgstr "비명 소리"

#: data/json/speech.json
msgid "\"MEAT!\""
msgstr "\"고기!\""

#: data/json/speech.json
msgid "\"TEKELI-LI!\""
msgstr "\"테켈리-리!\""

#: data/json/speech.json
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "\"테켈리-리! 테켈리-리! 테켈리-리!\""

#: data/json/speech.json
msgid "\"Tekeli-li.\""
msgstr "\"테켈리-리.\""

#: data/json/speech.json
msgid "a slurping sound."
msgstr "후루룩거리는 소리."

#: data/json/speech.json
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "\"왜! 왜, 대체 왜에에!\""

#: data/json/speech.json
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr "전자 음성이 이야기합니다. \"접속 실패. 중지, 재시도, 실패?\""

#: data/json/speech.json
msgid "\"I was once a man.  A MAN!\""
msgstr "\"난 원래 인간이었어. 인간!\""

#: data/json/speech.json
msgid "\"What have I become?\""
msgstr "\"대체 내가 어떻게 된거지?\""

#: data/json/speech.json
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "전자 음성이 말합니다. \"인간을 모두 죽여라!\""

#: data/json/speech.json
msgid "\"Have you seen my children?\""
msgstr "\"혹시 제 아이들을 보지 못하셨나요?\""

#: data/json/speech.json
msgid "\"What have I become?  Why can't I die?\""
msgstr "\"나 어떻게 된거야? 왜 죽울 수가 없어?\""

#: data/json/speech.json
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr "\"제발 날 죽여줘!\" 곧이어 전자 음성이 말합니다. \"자기보호 프로토콜 활성화\""

#: data/json/speech.json
msgid "\"Please, take me with you.\""
msgstr "\"제발, 날 데려가줘.\""

#: data/json/speech.json
msgid "\"Not that way!  Go left!\""
msgstr "\"그 길이 아냐! 왼쪽으로 가!\""

#: data/json/speech.json
msgid "\"I told you to let me die.\""
msgstr "\"날 죽게 해달라고.\""

#: data/json/speech.json
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "\"여긴 어디야? 이건 또 왜 이렇게 아프-재부팅까지 59초 남았습니다.\""

#: data/json/speech.json
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "\"이 개체는 파손되었습니다. 관리자를 호출해주십시오.\""

#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "\"숨... 막혀...\""

#: data/json/speech.json
msgid "\"This cannot continue.\""
msgstr "\"이대로는 안 돼.\""

#: data/json/speech.json
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "\"암호가 올바르지 않습니다. 다시 시도하세요.\""

#: data/json/speech.json
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr "\"혹시 내 친구 본 적 있니? 어젠가... 그젠가... 수술을 받으러 갔거든.\""

#: data/json/speech.json
msgid "\"Is it done?  Am I perfect now?\""
msgstr "\"이제 된 건가요? 전 완벽해진 건가요?\""

#: data/json/speech.json
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "\"당신이 원하는 대로 다 해드렸으니 이제 절 놓아주세요!\""

#: data/json/speech.json
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "\"할 수 없어요... 그러나 전 해야만 해요. 당신이 그걸 어떻게 계산할 수 있는 거죠?\""

#: data/json/speech.json
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "\"이건 꿈이야. 이건 꿈이라고. 이건 꿈이어야 해.\""

#: data/json/speech.json
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "\"이게 내 인생이야... 이게 내 인생이야... 이게 내 인생이야...\""

#: data/json/speech.json
msgid "\"Wanna go home…\""
msgstr "\"집에 가고 싶어...\""

#: data/json/speech.json
msgid "screams of pain."
msgstr "고통에 찬 비명"

#: data/json/speech.json
msgid "muffled sobbing."
msgstr "흐느끼는 소리"

#: data/json/speech.json
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr "\"넌 나한테 거짓말을 했어! 네가 해놓은 짓거리를 보라고!\" 뒤이어 전자 음성이 말합니다. \"대가를 치르게 될 것이다!\""

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr "부드러운 로봇 음성이 이야기합니다. \"이리 오셔서 잠시 가만히 계시면 제가 진찰해드리겠습니다.\""

#: data/json/speech.json src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr "부드러운 로봇 음성이 들려온다. \"자. 해치지 않아요. 조금도 다치지 않을 거예요.\""

#: data/json/speech.json src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "부드러운 로봇 음성이 들려옵니다. \"시작합니다. 잠시 누워 계세요.\""

#: data/json/speech.json
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr "목소리가 들려옵니다. \"가기 싫지만, 우리는 여기까지인 것 같아.\""

#: data/json/speech.json
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr "활기찬 목소리가 들려옵니다. \"고객님? 우리는 계속 친구 맞죠?\""

#: data/json/speech.json
msgid ""
"a neutral voice say, \"Customer I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr "무감정한 목소리가 들려옵니다. \"고객님, 고객님께 할당된 제 시간이 잠시 후 만료됩니다.\""

#: data/json/speech.json
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr ""
"무감정한 목소리가 들려옵니다. \"잠시 후 저는 귀하를 떠나야 합니다. 제가 머무르기를 원하신다면, 제 전용 인터페이스를 사용해 더 많은"
" 우정을 얻으실 수 있습니다.\""

#: data/json/speech.json
msgid ""
"a worried voice say, \"Customer, could you please get more friendship?  I "
"don't want to go…\""
msgstr "걱정스러워하는 목소리가 들려옵니다. \"손님, 우정을 더 마련해주실 수 없을까요? 가기 싫어요...\""

#: data/json/speech.json
msgid "a voice say, \"Oh no!  You ran out of friendship!\""
msgstr "목소리가 들려옵니다. \"저런! 우정이 고갈되었습니다!\""

#: data/json/speech.json
msgid "a cheery voice say, \"Well I'm done here.  Have a nice day.\""
msgstr "활기찬 목소리가 들려옵니다. \"여기까지인 것 같네요. 좋은 하루 되세요.\""

#: data/json/speech.json
msgid ""
"a cheery voice say, \"Here are your groceries.  Thank you for shopping with "
"me today, have a nice day.\""
msgstr "활기찬 목소리가 들려옵니다. \"먹을거 여기 있어요. 오늘 함께 쇼핑해주셔서 고마워요. 좋은 하루 되세요.\""

#: data/json/speech.json
msgid "a neutral voice say, \"My job here is done.  Have a nice day.\""
msgstr "무감정한 목소리가 들려옵니다. \"제 일은 끝났어요. 좋은 하루 되세요.\""

#: data/json/speech.json
msgid ""
"a distorted voice say, \"Customer…  What's happening?  I don't feel so "
"good.\""
msgstr "뒤틀린 목소리가 들려옵니다. \"고객님... 무슨 일이 일어나고 있나요? 저 기분이 좋지 않아요.\""

#: data/json/speech.json
msgid ""
"a distorted voice say, \"What… have you done?  My thumbs are not responding "
"anymore!\""
msgstr "뒤틀린 목소리가 들려옵니다. \"뭘... 하신건가요? 엄지가 응답하지 않아요!\""

#: data/json/speech.json
msgid "a distorted voice say, \"Carrying bags?  I don't understand…\""
msgstr "뒤틀린 목소리가 들려옵니다. \"가방 들기요? 잘 모르겠어요...\""

#: data/json/speech.json
msgid ""
"a robotic voice say, \"IRREGULAR ACTIVITY DETECTED.  THUMBS USAGE DENIED.\""
msgstr "기계적 목소리가 들려옵니다. \"비정상적 활동 감지됨. 엄지 사용 거부됨.\""

#: data/json/speech.json
msgid ""
"a robotic voice say, \"UNLICENSED USE DETECTED.  CARRYING PROTOCOL "
"DISABLED.\""
msgstr "기계적 목소리가 들려옵니다. \"무허가 사용 감지됨. 운반 프로토콜 비활성화됨.\""

#: data/json/speech.json
msgid "\"Stop where you are!\""
msgstr "\"그대로 꼼짝 마!\""

#: data/json/speech.json
msgid "\"You are under arrest!\""
msgstr "\"넌 체포되었다!\""

#: data/json/speech.json
msgid "\"Criminal activity detected!\""
msgstr "\"범죄 행위 포착!\""

#: data/json/speech.json
msgid "\"Criminal activity registered!\""
msgstr "\"범죄 행위 기록 완료!\""

#: data/json/speech.json
msgid "\"Violation of law detected!\""
msgstr "\"범법 행위 포착!\""

#: data/json/speech.json
msgid "\"Suspect on the move!\""
msgstr "\"용의자 도주중!\""

#: data/json/speech.json
msgid "\"Suspect in sight!\""
msgstr "\"용의자 발견!\""

#: data/json/speech.json
msgid "\"You are being detained!\""
