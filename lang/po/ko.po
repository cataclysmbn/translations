msgid "You eat your %s."
msgstr "%s을(를) 먹었다."

#: src/consumption.cpp
msgid "The shadows are getting ever closer."
msgstr "그림자가 점점 다가오고 있다."

#: src/consumption.cpp
msgid "You have a bad feeling about this."
msgstr "끔찍한 느낌이 든다."

#: src/consumption.cpp
