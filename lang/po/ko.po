#: data/mods/Generic_Guns/ammo/pistol.json
msgid "pistol ammo, ball"
msgid_plural "pistol ammo, ball"
msgstr[0] "권총탄, Ball"

#. ~ Description for {'str_sp': 'pistol ammo, ball'}
#: data/mods/Generic_Guns/ammo/pistol.json
msgid ""
"Modern ubiquitous medium pistol ammo, popularized by usage in two wars and "
"almost a century of post-war defensive and duty usage.  'Ball' is an old "
"term for full metal jacketed bullets which offer reduced fouling, better "
"reliability, and slightly improved penetration compared to plain lead."
msgstr ""

#: data/mods/Generic_Guns/ammo/pistol.json
msgid "pistol ammo, JHP"
msgid_plural "pistol ammo, JHP"
msgstr[0] "권총탄, JHP"

#. ~ Description for {'str_sp': 'pistol ammo, JHP'}
#: data/mods/Generic_Guns/ammo/pistol.json
msgid ""
"Modern ubiquitous medium pistol ammo, popularized by usage in two wars and "
"almost a century of post-war defensive and duty usage.  Jacketed Hollow "
"Points are defensive/duty projectiles that are more destructive to tissue "
"than plain ball ammunition, and slightly reduce overpenetration concerns."
msgstr ""

