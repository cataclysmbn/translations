#: data/json/npcs/talk_tags.json
msgid "They'll kill us!  Run away!"
msgstr "우릴 죽일거야!  도망쳐!"

#: data/json/npcs/talk_tags.json
msgid "We're going to die!  Fall back!"
msgstr "우린 곧 죽을 거야!  후퇴해!"

#: data/json/npcs/talk_tags.json
msgid "Fall back and regroup!"
msgstr "후퇴해서 재정비해!"

#: data/json/npcs/talk_tags.json
msgid "There's no hope for victory.  I'm running!"
msgstr "이길 수가 없어.  난 도망칠 거야!"

#: data/json/npcs/talk_tags.json
msgid "Feet don't fail me now!"
msgstr "걸음아 나 살려라!"

#: data/json/npcs/talk_tags.json
msgid "I don't have to be faster than them, just faster than you!"
msgstr "놈들보다 빠를 필요는 없지, 너보다만 빠르면 돼!"

#: data/json/npcs/talk_tags.json
msgid "Oh God, my leg, Oh God!"
msgstr "으아악, 내 다리! 으아아악!!"

#: data/json/npcs/talk_tags.json
msgid "We have a serious situation here.  I'm leaving!"
msgstr "우린 심각한 상황이군. 난 갈게!"

#: data/json/npcs/talk_tags.json
msgid "It can't follow all of us.  I'll run this way, you go there!"
msgstr "저놈이 우리 모두를 쫓아올 수는 없을거야. 난 이대로 갈테니, 넌 저쪽으로 가!"

#: data/json/npcs/talk_tags.json
msgid "Me go, you stay."
msgstr "난 간다, 넌 남아."

#: data/json/npcs/talk_tags.json
msgid "Not that way!  Go left!"
msgstr "그쪽이 아니야! 반대쪽으로!"

#: data/json/npcs/talk_tags.json
msgid "<move>!"
msgstr "<move>"

#: data/json/npcs/talk_tags.json
msgid "Retreat!  Retreat!"
msgstr "후퇴! 후퇴!"

#: data/json/npcs/talk_tags.json
msgid "Book it!"
msgstr "어서 떠나자!"

#: data/json/npcs/talk_tags.json
msgid "Leg it!"
msgstr "도망가!"

#: data/json/npcs/talk_tags.json
msgid "Thank fuck for all the cardio!"
msgstr "씨발 유산소 운동 만세!"

#: data/json/npcs/talk_tags.json
msgid "I can't outrun it!  I'm going to kill it!"
msgstr "도망칠 수가 없어!  이 놈을 죽여야겠어!"

#: data/json/npcs/talk_tags.json
msgid "<swear>!  Die, you <name_b>!  I want to live!"
msgstr "<swear>! 뒈져, <name_b>! 난 살아야겠어!"

#: data/json/npcs/talk_tags.json
msgid "My feet failed me!  Arms, don't fail me!"
msgstr "다리가 좆됐어! 팔도 좆되면 안되는데!"

#: data/json/npcs/talk_tags.json
msgid "Can't run!  Have to fight!"
msgstr "도망칠수가 없어! 싸워야 해!"

#: data/json/npcs/talk_tags.json
msgid "If I die, I'm taking you all with me!"
msgstr "내가 뒈진다면, 적어도 니들도 같이 뒈져야겠다!"

#: data/json/npcs/talk_tags.json
msgid "Call the fire department!  Wait, they're dead!  Run away!"
msgstr "소방서에 전화해! 잠깐만, 걔들도 죽었겠네! 도망쳐!"

#: data/json/npcs/talk_tags.json
msgid "This place is on fire.  I'm leaving."
msgstr "참 잘도 타는군. 난 나가야겠어."

#: data/json/npcs/talk_tags.json
msgid "Put the fire out!  Put it out!"
msgstr "불꺼! 씨발, 불끄라고!"

#: data/json/npcs/talk_tags.json
msgid "Fire bad!  <move>!"
msgstr "불이다! <move>!"

#: data/json/npcs/talk_tags.json
msgid "We need to put this fire out!"
msgstr "불을 당장 꺼뜨려야 해!"

#: data/json/npcs/talk_tags.json
msgid "Somebody get some water!"
msgstr "누가 물 좀 가져와!"

#: data/json/npcs/talk_tags.json
msgid "Fire, fire, FIRE!"
msgstr "불이야, 불, 불이라고!"

#: data/json/npcs/talk_tags.json
msgid "Get an extinguisher!"
msgstr "소화기 가져와!"

#: data/json/npcs/talk_tags.json
msgid "Danger hot!"
msgstr "빌어먹게 뜨겁네!"

#: data/json/npcs/talk_tags.json
msgid "I've done so much for you, and you can't even keep me fed!"
msgstr "널 위해서 그렇게 많은 걸 해줬는데도 넌 날 굶기다니!"

#: data/json/npcs/talk_tags.json
msgid "You are the worst person in the world!"
msgstr "세상에서 네가 제일 최악이야!"

#: data/json/npcs/talk_tags.json
msgid "Why are you such a horrible leader?"
msgstr "넌 리더로서 왜 그렇게 끔찍할까?"

#: data/json/npcs/talk_tags.json
msgid "I trusted you, and you can't even provide food!"
msgstr "널 믿었는데 음식조차도 챙겨주질 못하다니!"

#: data/json/npcs/talk_tags.json
msgid ""
"I don't have to take this abuse from you, there are plenty of people to "
"abuse me!"
msgstr "세상에 나한테 좆같게 구는 놈이 얼마나 많은데, 굳이 너까지 나한테 이지랄을 해야겠냐!"

#: data/json/npcs/talk_tags.json
msgid "You said you would keep me safe, and you haven't!"
msgstr "날 안전하게 지켜주겠다더니, 지금 꼴을 봐!"

#: data/json/npcs/talk_tags.json
msgid ""
"There's only a couple hundred people left in the world, and I relied on the "
"dumbest one!"
msgstr "세상에 살아남은 사람이 수백도 안되는데, 하필 내가 그중 최악에 걸렸네!"

#: data/json/npcs/talk_tags.json
msgid "You're a monster!"
msgstr "괴물 자식아!"

#: data/json/npcs/talk_tags.json
msgid "You call this safe?  You're crazy and incompetent!"
msgstr "니가 보기엔 이게 안전해보이냐? 정신나간 무능력자 새끼가!"

#: data/json/npcs/talk_tags.json
msgid "That was the last straw!  I'm not following your orders anymore!"
msgstr "그래, 씨발 기어이 선 넘네! 이제 니가 뭐라하든 좆깔테니 그리 아셔!"

#: data/json/npcs/talk_tags.json
msgid "child"
msgstr "아이"

#: data/json/npcs/talk_tags.json
msgid "my child"
msgstr "내 아이"

#: data/json/npcs/talk_tags.json
msgid "dear"
msgstr "그대"

#: data/json/npcs/talk_tags.json
msgid "my dear"
msgstr "당신"

#: data/json/npcs/talk_tags.json
msgid "survivor"
msgstr "생존자"

#: data/json/npcs/talk_tags.json
msgid "Clean water, the taste that refreshes!"
msgstr "깨끗한 물, 이 신선한 맛이란!"

#: data/json/npcs/talk_tags.json
msgid "I was parched, but not I am not."
msgstr "목말라 죽는줄 알았네."

#: data/json/npcs/talk_tags.json
msgid "Water is nice, but I should get a grog ration."
msgstr "물은 충분하지만, 그로그가 없는게 아쉬운걸."

#: data/json/npcs/talk_tags.json
msgid "That wasn't Evian, but I'm not thirsty."
msgstr "에비앙 생수는 아니었지만, 최소한 목마른건 해결됐어."

#: data/json/npcs/talk_tags.json
msgid "And now I have eaten and am not hungry."
msgstr "배고파 죽는줄 알았네."

#: data/json/npcs/talk_tags.json
msgid "That food was good, but I miss real restaurants."
msgstr "이것도 나쁘진 않지만, 진짜 식당이 그리운걸."

#: data/json/npcs/talk_tags.json
msgid "Well, that satisfied me."
msgstr "이거면 만족해."

#: data/json/npcs/talk_tags.json
msgid ""
"I just had some food, but I'm still peckish.  Would you mind if I ate more?"
msgstr "막 먹긴 했지만 좀 모자라. 좀 더 먹어도 될까?"

#: data/json/npcs/talk_tags.json
msgid "Hey, <name_g>, we're out of food."
msgstr "이봐, <name_g>. 먹을게 다 떨어졌어."

#: data/json/npcs/talk_tags.json
msgid "Hey, the larder is empty!  We're going to starve."
msgstr "으악, 식료품 저장고가 텅 비었어! 굶게 생겠는걸."

#: data/json/npcs/talk_tags.json
msgid ""
"Uhm, <name_g>, I don't meant to criticize, but we should focus on "
"distributing some food into the basecamp larder."
msgstr "음, <name_g>. 네 욕하는건 아니지만, 식료품 저장고에 음식을 채우는걸 우선시해야 한다고 생각해."

#: data/json/npcs/talk_tags.json
msgid "right on top of us!"
msgstr "위쪽이다!"

#: data/json/npcs/talk_tags.json
msgid "right there!"
msgstr "저기야!"

#: data/json/npcs/talk_tags.json
msgid "danger close!"
msgstr "오사위험!"

#: data/json/npcs/talk_tags.json
msgid "almost in melee range!"
msgstr "거의 근접 범위야!"

#: data/json/npcs/talk_tags.json
msgid "too close for comfort!"
msgstr "안전하다기엔 너무 가까워!"

#: data/json/npcs/talk_tags.json
msgid "within shooting range."
msgstr "사거리 내에 있어."

#: data/json/npcs/talk_tags.json
msgid "only a couple of seconds' away."
msgstr "몇 초면 닿을 거리야."

#: data/json/npcs/talk_tags.json
msgid "just a bit away."
msgstr "조금만 더."

#: data/json/npcs/talk_tags.json
msgid "closer than I'd like."
msgstr "내 생각보다 가까운데."

#: data/json/npcs/talk_tags.json
msgid "near enough to see us."
msgstr "우리를 볼 수 있을 정도로 가까워."

#: data/json/npcs/talk_tags.json
msgid "quite a bit away."
msgstr "꽤 멀리 있어."

#: data/json/npcs/talk_tags.json
msgid "maybe within shooting range."
msgstr "아마 사거리 내에 있어."

#: data/json/npcs/talk_tags.json
msgid "at a good distance."
msgstr "충분한 거리 밖에 있어."

#: data/json/npcs/talk_tags.json
msgid "far enough away that we could make sneak away."
msgstr "우리가 숨어 지나갈 수 있을만큼 멀리 있어."

#: data/json/npcs/talk_tags.json
msgid "out on the horizon, so don't worry much."
msgstr "지평선 너머에 있으니, 그렇게 걱정하지 않아도 돼."

#: data/json/npcs/talk_tags.json
msgid "at a long distance."
msgstr "먼 거리에 있어."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will use ranged weapons."
msgstr "<mypronoun>(은)는 이제 원거리 무기를 사용합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not use ranged weapons."
msgstr "<mypronoun>(은)는 이제 원거리 무기를 사용하지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will use grenades."
msgstr "<mypronoun>(은)는 이제 폭발물을 사용합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not use grenades."
msgstr "<mypronoun>(은)는 이제 폭발물을 사용하지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will only use silenced ranged weapons."
msgstr "<mypronoun>(은)는 이제 무소음 원거리 무기만 사용합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will use any ranged weapons."
msgstr "<mypronoun>(은)는 이제 아무 원거리 무기든지 사용합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will avoid shooting if allies are in the line of fire."
msgstr "<mypronoun>(은)는 이제 사선에 아군이 있으면 사격을 꺼립니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will shoot even if allies are in the line of fire."
msgstr "<mypronoun>(은)는 이제 사선에 아군이 있더라도 사격합니다."

#: data/json/npcs/talk_tags.json
msgid "* will pick up items."
msgstr "* 물품을 줍습니다."

#: data/json/npcs/talk_tags.json
msgid "* will only pick up items from the whitelist."
msgstr "* 화이트리스트에 있는 물품만 줍습니다."

#: data/json/npcs/talk_tags.json
msgid "* will not pick up items."
msgstr "* 물품을 줍지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will bash down obstacles."
msgstr "<mypronoun>(은)는 이제 장애물을 박살냅니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not bash down obstacles."
msgstr "<mypronoun>(은)는 이제 장애물을 박살내지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will sleep when tired."
msgstr "<mypronoun>(은)는 이제 피곤할 때 수면을 취합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will stay awake as long as possible."
msgstr "<mypronoun>(은)는 이제 가능한한 오래 깨어있으려 합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will complain about wounds and needs."
msgstr "<mypronoun>(이)가 부상과 욕구에 대해 불평할 것입니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will only complain in an emergency."
msgstr "<mypronoun>(은)는 이제 오직 비상상황에서만 불평할 것입니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will smash nearby zombie corpses."
msgstr "<mypronoun>(은)는 이제 근처에 있는 좀비 시체를 박살냅니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will leave zombie corpses intact."
msgstr "<mypronoun>(은)는 이제 근처에 있는 좀비 시체를 건드리지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will close doors after passing through."
msgstr "<mypronoun>(은)는 이제 지나간 문을 닫아둡니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not close doors."
msgstr "<mypronoun>(은)는 이제 문을 닫지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will follow you closely even when threatened."
msgstr "<mypronoun>(은)는 이제 위협당하는 중에도 당신 근처에서 따라다닙니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will move freely as needed."
msgstr "<mypronoun>(은)는 이제 자기가 원하는 대로 움직입니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will follow you at about two paces."
msgstr "<mypronoun>(은)는 이제 당신을 대략 2보로 따라다닙니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will follow you at about four paces."
msgstr "<mypronoun>(은)는 이제 당신을 대략 4보로 따라다닙니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not go places that require opening a door."
msgstr "<mypronoun>(은)는 이제 문을 열어야 하는 곳에 가지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will open doors to reach a destination."
msgstr "<mypronoun>(은)는 이제 목적지에 도달하기 위해 문을 엽니다."

#: data/json/npcs/talk_tags.json
msgid ""
"<mypronoun> will hold the line by not moving into doorways or obstructions "
"adjacent to you."
msgstr "<mypronoun>(은)는 이제 당신에게 인접한 출입구나 통로로 가지 않고 그 자리를 사수합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will move freely to attack enemies."
msgstr "<mypronoun>(은)는 이제 적을 공격할 때 자유롭게 이동합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not investigate noises."
msgstr "<mypronoun>(은)는 이제 소음을 조사하지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will investigate noises from unseen places."
msgstr "<mypronoun>(은)는 이제 보이지 않는 곳에서 난 소음을 조사합니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will not engage enemies if avoidable."
msgstr "<mypronoun>(은)는 이제 가능한한 적에게 근접하지 않습니다."

#: data/json/npcs/talk_tags.json
msgid "<mypronoun> will follow normal engagement rules."
msgstr "<mypronoun> (은)는 일반적인 교전 수칙을 따릴 것입니다."

