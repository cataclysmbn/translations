#: src/vehicle_use.cpp
msgid ""
"You turn the autoclave off before it's finished the program, and open its "
"door."
msgstr "작동이 종료되기 전에 오토클레이브를 끄고, 문을 열었다."

#: src/vehicle_use.cpp
msgid "The autoclave is empty, there's no point in starting it."
msgstr "오토클레이브가 비어 있어서, 작동시키는 의미가 없다."

#: src/vehicle_use.cpp
#, c-format
msgid ""
"You need 8 charges of water in tanks of the %s for the autoclave to run."
msgstr "%s 의 탱크에서 8 충전량의 물이 있어야 오토클레이브를 시작할 수 있다"

#: src/vehicle_use.cpp
msgid ""
"You need to remove all filthy items from the autoclave to start the "
"sterilizing cycle."
msgstr "오토클레이브에서 모든 불결한 물건을 제거해야 살균 사이클을 시작할 수 있다"

#: src/vehicle_use.cpp
msgid "Only CBMs can be sterilized in an autoclave."
msgstr "CBM만이 오토클레이브에서 살균될 수 있다."

#: src/vehicle_use.cpp
msgid "You should put your CBMs in autoclave pouches to keep them sterile."
msgstr "CBM을 오토클레이브 파우치에 넣어야 살균한 채로 유지할 수 있다."

#: src/vehicle_use.cpp
msgid "You turn the autoclave on and it starts its cycle."
msgstr "오토클레이브를 켜서 한 사이클을 돌리기 시작했다."

#: src/vehicle_use.cpp
msgid ""
"You turn the washing machine off before it's finished the program, and open "
"its lid."
msgstr "세탁과정이 끝나기 전에 세탁기의 전원을 내리고 뚜껑을 열었다."

#: src/vehicle_use.cpp
msgid "The washing machine is empty, there's no point in starting it."
msgstr "세탁기가 비어 있어서, 작동하는 의미가 없다."

#: src/vehicle_use.cpp
#, c-format
msgid ""
"You need 24 charges of water in tanks of the %s to fill the washing machine."
msgstr "세탁기를 채우려면 %s의 탱크에 든 24 단위의 물이 필요하다."

#: src/vehicle_use.cpp
msgid "You need 5 charges of a detergent for the washing machine."
msgstr "세탁기를 돌리는 데 5 충전량의 세제가 필요하다."

#: src/vehicle_use.cpp
msgid ""
"You need to remove all non-filthy items from the washing machine to start "
"the washing program."
msgstr "세탁과정을 시작하려면 세탁기에서 불결하지 않은 옷을 모두 꺼내야 한다."

#: src/vehicle_use.cpp
msgid "CBMs can't be cleaned in a washing machine.  You need to remove them."
msgstr "CBM은 세탁기에서 세척할 수 없다.  CBM을 제거해야 한다."

#: src/vehicle_use.cpp
msgid "Use what detergent?"
msgstr "어떤 세제를 사용합니까?"

#: src/vehicle_use.cpp
msgid ""
"You pour some detergent into the washing machine, close its lid, and turn it"
" on.  The washing machine is being filled with water from vehicle tanks."
msgstr "세탁기에 세제를 약간 쏟아붓고 뚜껑을 닫은 뒤 전원을 켰다. 이내 차량 탱크의 물이 세탁기를 가득 채웠다."

#: src/vehicle_use.cpp
msgid ""
"Soft items can't be cleaned in a dishwasher, you should use a washing "
"machine for that.  You need to remove them:"
msgstr "부드러운 물품은 식기세척기에서 세탁할 수 없고, 대신 세탁기를 사용해야 한다.  다음 것들을 빼내야 한다:"

#: src/vehicle_use.cpp
msgid ""
"You turn the dishwasher off before it's finished the program, and open its "
"lid."
msgstr "작동이 종료되기 전에 식기세척기를 끄고, 뚜껑을 열었다."

#: src/vehicle_use.cpp
msgid "The dishwasher is empty, there's no point in starting it."
msgstr "식기세척기가 비어 있어서, 작동하는 의미가 없다."

#: src/vehicle_use.cpp
#, c-format
msgid ""
"You need 24 charges of water in tanks of the %s to fill the dishwasher."
msgstr "%s 의 탱크에 24 충전량의 물이 있어야 식기세척기를 채울 수 있다."

#: src/vehicle_use.cpp
msgid "You need 5 charges of detergent for the dishwasher."
msgstr "식기세척기를 작동하기 위해서는 세제 5 충전량이 필요하다."

#: src/vehicle_use.cpp
msgid ""
"You need to remove all non-filthy items from the dishwasher to start the "
"washing program."
msgstr "불결하지 않은 모든 물건을 식기세척기에서 빼내야 세탁 프로그램을 시작할 수 있다."

#: src/vehicle_use.cpp
msgid ""
"You pour some detergent into the dishwasher, close its lid, and turn it on."
"  The dishwasher is being filled with water from vehicle tanks."
msgstr "식기세척기에 세제를 조금 붓고, 뚜껑을 닫고, 작동 버튼을 눌렀다. 식기세척기는 차량 탱크의 물로 차오르고 있다."

#: src/vehicle_use.cpp
