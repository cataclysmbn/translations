msgstr "もっと寝床を広げるために、金属壁の避難シェルターを広げましょう。"

#: lang/json/recipe_from_json.py
msgid "expand northeast shack"
msgstr "小屋拡張(北東区画)"

#: lang/json/recipe_from_json.py
msgid "We should use metal to finish the northeast shack."
msgstr "北東の金属壁の小屋を完成させましょう。"

#: lang/json/recipe_from_json.py
msgid "finish northeast shack"
msgstr "小屋完成(北東区画)"

