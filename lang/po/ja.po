#: src/player.cpp
#, c-format
msgid "Go kill that %1$s!"
msgstr "%1$sを殺す！"

#: src/player.cpp
#, c-format
msgid "Look at that %1$s!"
msgstr "%1$sがいるぞ！"

#: src/player.cpp
#, c-format
msgid "That %1$s doesn't deserve to live!"
msgstr "%1$sを生かしてはおかない！"

#: src/player.cpp
msgid "Hey, you're bleeding."
msgstr "なあ、出血しているようだが。"

#: src/player.cpp
msgid "Your wound looks pretty bad."
msgstr "ひどい傷だな。"

#: src/player.cpp
msgid "Shouldn't you put a bandage on that?"
msgstr "傷に包帯を巻いた方が良いのでは？"

#: src/player.cpp
msgid "Please don't die! No one else lets me kill things!"
msgstr "死なないでくれ！一人では奴らに太刀打ちできない！"

#: src/player.cpp
msgid "You look hurt, did I do that?"
msgstr "怪我をしているが、私のせいか？"

#: src/player.cpp
msgid "Are you supposed to be bleeding?"
msgstr "出血が止まっていないよ？"

#: src/player.cpp
msgid "You're not going to die, are you?"
msgstr "このまま死ぬつもりはないんだよな？"

#: src/player.cpp
msgid "Kill a few more before you bleed out!"
msgstr "出血したままでは、奴らを十分に殺せないだろ！"

#: src/player.cpp
msgid "Hey fix me up."
msgstr "手当して欲しいんだ。"

#: src/player.cpp
msgid "I need healing!"
msgstr "治療が必要だ！"

#: src/player.cpp
msgid "I hurt all over..."
msgstr "身体中が痛む..."

#: src/player.cpp
msgid "You can put me back together, right?"
msgstr "ケガの治療をしてもらえないかな？"

#: src/player.cpp
msgid "I... I can't move my legs!"
msgstr "あ、脚が動かない！"

#: src/player.cpp
msgid "Medic!"
msgstr "衛生兵！"

#: src/player.cpp
msgid "I can still fight, don't replace me!"
msgstr "まだ戦えるから、置いていかないで！"

#: src/player.cpp
msgid "They got me!"
msgstr "やられた！"

#: src/player.cpp
msgid "Go on without me..."
msgstr "置いて行ってくれ..."

#: src/player.cpp
msgid "Am I gonna die?"
msgstr "私は死ぬのか？"

#: src/player.cpp
msgid "Let me kill something already!"
msgstr "さっさと殺そう！"

#: src/player.cpp
msgid "I'm your best friend, right?"
msgstr "私たちは親友だよな？"

#: src/player.cpp
msgid "Do you think it will rain today?"
msgstr "今日は雨が降ると思う？"

#: src/player.cpp
msgid "Try not to drop me."
msgstr "置いて行かないで。"

#: src/player.cpp
msgid "How many do you think we've killed?"
msgstr "今までに何人殺したかな？"

#: src/player.cpp
msgid "I'll keep you safe!"
msgstr "君を守るよ！"

#: src/player.cpp
msgid "You get a bad feeling."
msgstr "体調が悪そうだな。"

#: src/player.cpp
msgid "You suddenly feel so numb..."
msgstr "身体に強烈な痺れを感じました..."

#: src/player.cpp
msgid "You start to shake uncontrollably."
msgstr "震えがこみ上げてきました。"

#: src/player.cpp
msgid "\"Get away from there!\""
msgstr "「そこから離れろ！」"

#: src/player.cpp
msgid "\"What do you think you're doing?\""
msgstr "「何をしているか分かっているのか？」"

#: src/player.cpp
msgid "\"Stop laughing at me!\""
msgstr "「笑うのを止めろ！」"

#: src/player.cpp
msgid "\"Don't point that thing at me!\""
msgstr "「指差すのを止めろ！」"

#: src/player.cpp
msgid "\"Stay away from me!\""
msgstr "「あっちへ行け！」"

#: src/player.cpp
msgid "\"No! Stop!\""
msgstr "「だめだ！止まれ！」"

#: src/player.cpp
msgid "\"Get the fuck away from me!\""
msgstr "「消え失せろ！」"

#: src/player.cpp
msgid "\"That's not true!\""
msgstr "「嘘をつくな！」"

#: src/player.cpp
msgid "\"What do you want from me?\""
msgstr "「どうしろって言うんだ？」"

#: src/player.cpp
msgid "\"I didn't mean to do it!\""
msgstr "「そんなつもりじゃなかった！」"

#: src/player.cpp
msgid "\"It wasn't my fault!\""
msgstr "「私のせいじゃない！」"

#: src/player.cpp
msgid "\"I had to do it!\""
msgstr "「仕方なかったんだ！」"

#: src/player.cpp
msgid "\"They made me do it!\""
msgstr "「命令されたんだ！」"

#: src/player.cpp
msgid "\"What are you!?\""
msgstr "「何者だ！？」"

#: src/player.cpp
msgid "\"I should never have trusted you!\""
msgstr "「絶対に信じない！」"

#: src/player.cpp
msgid "You're suddenly overcome with the urge to sleep and you pass out."
msgstr "急な眠気に襲われ、意識を失いました。"

#: src/player.cpp
msgid "You have an asthma attack!"
msgstr "喘息の発作に見舞われた！"

#: src/player.cpp
msgid "You use your Oxygenator to clear it up, then go back to sleep."
msgstr "酸素供給装置を使って発作を抑え、再び眠りにつきました。"

#: src/player.cpp
msgid "You use your inhaler and go back to sleep."
msgstr "吸入器を使用し、再び眠りにつきました。"

#: src/player.cpp
msgid "You take a deep breath from your oxygen tank and go back to sleep."
msgstr "酸素タンクを使用して深呼吸し、再び眠りにつきました。"

#: src/player.cpp
msgid "You can't focus while choking!"
msgstr "窒息中は集中できません！"

#: src/player.cpp
msgid "You use your last inhaler charge."
msgstr "吸入器を使い切りました。"

#: src/player.cpp
#, c-format
msgid "You use your inhaler, only %d charge left."
msgid_plural "You use your inhaler, only %d charges left."
msgstr[0] "吸入器を使用しました。残量は%dです。"

#: src/player.cpp
msgid "You breathe in last bit of oxygen from the tank."
