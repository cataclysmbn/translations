msgid "toilet"
msgstr "便器"

#. ~ Description for toilet
#: lang/json/furniture_from_json.py
msgid ""
"A porcelain throne.  Emergency water source, from the tank, and provider of "
"relief."
msgstr "磁器製の便器です。非常時にはタンクからは水を補給できます。"

