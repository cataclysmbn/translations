#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "CBM Engineer"
msgstr "CBM技師"

#. ~ Profession (male CBM Engineer) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You worked as a technician in a sterile, high-security facility concerned "
"with the fabrication of bionic implants.  Armed with the solderers in your "
"hands, and aided by precise machines, you earned great pay."
msgstr ""
"CBMの製造に関係する警備の厳重な施設で、面白味のない技師の仕事をしていました。手にはんだごてを移植し、精密機械の補助を受けながら働いて高い給料を得ていました。"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "CBM Engineer"
msgstr "CBM技師"

#. ~ Profession (female CBM Engineer) description
#: lang/json/professions_from_json.py
