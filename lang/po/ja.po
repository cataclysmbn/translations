#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Baker"
msgstr "ケーキ屋"

#. ~ Profession (male Baker) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You worked at a modest bakery specializing in birthday cakes.  When the "
"sirens sounded, you had one, decorated and all, in your hands, and by the "
"time you got to relative safety, you were still holding it."
msgstr ""
"バースデーケーキを専門とする小さなケーキ屋で働いていました。外でサイレンが鳴ったので、デコレーションケーキと手近な道具類を持って非難しました。周囲は比較的安全になったようですが、持ち出した荷物はまだ手元に残っています。"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
