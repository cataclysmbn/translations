msgstr "「今日はフードプレイスで食べ物を買おう！」"

#: lang/json/speech_from_json.py
msgid "\"FoodPlace: The best restaurant in an area!\""
msgstr "「フードプレイス、この地域で最高のレストラン！」"

#: lang/json/speech_from_json.py
#, no-python-format
