msgstr "原子力を利用した製品に入っていた放射性物質です。現状では使い道が思い浮かびません。"

#: lang/json/GENERIC_from_json.py
msgid "sandbag"
msgid_plural "sandbags"
msgstr[0] "砂袋"

#. ~ Description for sandbag
#: lang/json/GENERIC_from_json.py
