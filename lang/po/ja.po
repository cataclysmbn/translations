msgid_plural "revolvers"
msgstr[0] "リボルバー"

#: lang/json/gun_from_json.py
msgid "cap & ball revolver"
msgid_plural "cap & ball revolvers"
msgstr[0] "キャップ&ボールリボルバー"

#: lang/json/gun_from_json.py
