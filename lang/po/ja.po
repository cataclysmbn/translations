msgstr "なあ、%1$sを殺すべきだろう！"

#: src/player.cpp
#, c-format
msgid "I want to watch that %1$s bleed!"
msgstr "血を流す%1$sが見たいな！"

#: src/player.cpp
#, c-format
msgid "Wait, that %1$s needs to die!"
