#, c-format
msgid ""
"%s returns from working as a laborer having earned $%d and a bit of "
"experience..."
msgstr "%s が多少の経験を積んで労働作業から帰還しました。 $%d の報酬を得ました。"

#: src/mission_companion.cpp
