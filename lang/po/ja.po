#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Affluent Executive"
msgstr "会社役員"

#. ~ Profession (male Affluent Executive) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You worked at a high position in a wealthy company, earning numbers most "
"people could only dream of, and you savored it.  You start with a maxed-out "
"cash card."
msgstr "大企業で役員の座に就き、大抵の人が夢見ることしかできない程の金を稼いできました。最高額のキャッシュカードを持った状態で開始します。"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Affluent Executive"
msgstr "会社役員"

#. ~ Profession (female Affluent Executive) description
#: lang/json/professions_from_json.py
