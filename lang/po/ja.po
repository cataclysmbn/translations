msgid "Striking the %1$s shocks %2$s!"
msgstr "%1$sを攻撃したことで%2$sは感電しました！"

#: src/mondefense.cpp
#, c-format
msgid "Acid covering %s burns your hand!"
msgstr "%sを覆う酸が手を焼きました！"

#: src/mondefense.cpp
#, c-format
msgid "Acid sprays out of %s as it is hit!"
msgstr "%sは酸を噴射しました！"

