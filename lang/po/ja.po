"Time: 1 hour minimum\n"
" \n"
"Labor Roster:\n"
msgstr ""
"収益: $12/1時間\n"
"危険: 最小\n"
"時間: 1時間～\n"
"\n"
"建設労働者名簿: \n"

#: src/mission_companion.cpp
msgid "Recover Ally from Carpentry Work"
msgstr "仲間を大工仕事から呼び戻す"

