#: lang/json/gun_from_json.py
msgid "brace slingshot"
msgid_plural "brace slingshots"
msgstr[0] ""
msgstr[1] ""

#: lang/json/gun_from_json.py
msgid ""
"A modern slingshot with a wrist brace, it is easy to use, accurate, and "
"quite powerful."
msgstr ""
" cinta estilingue Um estilingue moderno com um aparelho de pulso, é fácil "
"deusar, preciso e bastante poderoso."

#: lang/json/gun_from_json.py
