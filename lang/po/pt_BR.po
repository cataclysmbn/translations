msgstr "40x46mm, granada"

#: lang/json/AMMO_from_json.py
msgid "40x46mm M1006"
msgstr "40x46mm M1006"

#. ~ Description for 40x46mm M1006
#: lang/json/AMMO_from_json.py
msgid ""
"A low velocity less-lethal 40x46mm round with a foam and plastic projectile "
"intended to cause pain and disorientation to the target.  May still injure "
"or kill."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "40x46mm M433"
msgstr "40x46mm M433"

#. ~ Description for 40x46mm M433
#: lang/json/AMMO_from_json.py
msgid ""
"A low velocity 40x46mm HEDP grenade.  It can penetrate 2 inches of steel "
"armor and fragmentation of the projectile body also makes it suitable for "
"use against infantry."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "40x46mm M576"
msgstr "40x46mm M576"

#. ~ Description for 40x46mm M576
#: lang/json/AMMO_from_json.py
msgid ""
"A 40x46mm buckshot load, designed for use in thick vegetation or room "
"clearing."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "40x46mm M651"
msgstr "40x46mm M651"

#. ~ Description for 40x46mm M651
#: lang/json/AMMO_from_json.py
msgid ""
"A low velocity 40mm tear gas canister.  It is effective for riot control and"
" driving infantry from entrenched positions"
msgstr ""
"Uma granada 40mm de gás lacrimogêneo de baixa velocidade. Eficaz para "
"controle de tumultos e expulsar infantaria de posições entrincheiradas."

#: lang/json/AMMO_from_json.py
msgid "40x46mm buckshot"
msgstr "40x46mm chumbo grosso"

#. ~ Description for 40x46mm buckshot
#: lang/json/AMMO_from_json.py
msgid "An improvised 40x46mm buckshot load somewhat resembling M576."
msgstr ""
"Um cartucho 40x46mm improvisado com uma carga de chumbo grosso, um pouco "
"semelhante a um M576."

#: lang/json/AMMO_from_json.py
msgid "40x46mm slug"
msgstr "40x46mm balaço"

#. ~ Description for 40x46mm slug
#: lang/json/AMMO_from_json.py
msgid "An improvised 40x46mm load resembling an oversized shotgun slug."
msgstr ""
"Um cartucho 40x46mm com uma carga improvisada lembrando um balaço de "
"escopeta muito maior."

#: lang/json/AMMO_from_json.py
msgid "40x46mm flechette"
msgstr "40x46mm flechette"

#. ~ Description for 40x46mm flechette
#: lang/json/AMMO_from_json.py
msgid "An improvised 40x46mm flechette load containing 70 steel darts."
msgstr ""
"Um cartucho 40x46mm improvisado com uma carga tipo flechette, contendo 70 "
"dardos de aço."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "40x53mm grenade"
msgstr "40x53mm, granada"

#: lang/json/AMMO_from_json.py
msgid "40x53mm M1001"
msgstr "40x53mm M1001"

#. ~ Description for 40x53mm M1001
