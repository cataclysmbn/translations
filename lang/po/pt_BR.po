msgstr[1] ""

#: lang/json/gun_from_json.py
msgid ""
"Popular among children.  It's fairly accurate, but BBs deal nearly no "
"damage."
msgstr ""
" Arma de BB Popular entre as crianças. É bastante preciso, mas os BBs "
"quasenão causam dano."

