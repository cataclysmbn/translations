msgstr "hacksawEsta é uma serra robusta, útil para cortar objetos de metal."

#: lang/json/TOOL_from_json.py
msgid "Halligan bar"
msgid_plural "Halligan bars"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for Halligan bar
#: lang/json/TOOL_from_json.py
