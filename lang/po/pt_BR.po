#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You worked as a technician in a sterile, high-security facility concerned "
"with the fabrication of bionic implants.  Armed with the solderers in your "
"hands, and aided by precise machines, you earned great pay."
msgstr ""

