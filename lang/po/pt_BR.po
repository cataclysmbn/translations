"weight distribution, cold environments and to allow them to be used "
"separately."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "chainmail vest"
msgid_plural "chainmail vests"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for chainmail vest
#: lang/json/ARMOR_from_json.py
