msgstr ""
" Um compactador hidráulico que pode aceitar itens feitos de vários metais, e"
" pressioná-los em formas básicas, prontos para mais artesanato."

#: lang/json/terrain_from_json.py
msgid "gasoline pump"
msgstr "distribuidor de gasolina"

#. ~ Description for gasoline pump
#: lang/json/terrain_from_json.py
