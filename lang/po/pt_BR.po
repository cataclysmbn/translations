" trabalha na loja de animais."

#: lang/json/BOOK_from_json.py
msgid "spy novel"
msgid_plural "spy novels"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for spy novel
#: lang/json/BOOK_from_json.py
msgid ""
"A tale of intrigue and espionage amongst Nazis, no, Commies, no, Iraqis!"
msgstr ""
" Um conto de intrigas e espionagem entre os nazistas, não, comunistas, não, "
"iraquianos!"

