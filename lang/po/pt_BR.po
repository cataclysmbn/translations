#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Burglar"
msgstr "Assaltante"

#. ~ Profession (male Burglar) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You thought this would be your lucky break.  Does it count as breaking and "
"entering if everyone in town is undead?"
msgstr ""
" Você pensou que esta seria sua chance de sorte. Será que isso conta como "
"entrar e sair se todos na cidade são mortos-vivos?"

#: lang/json/professions_from_json.py
