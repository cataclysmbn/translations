"levantartampas de bueiros. Você também pode usá-lo para bater em algumas "
"cabeças."

#: lang/json/TOOL_from_json.py
msgid "hammer"
msgid_plural "hammers"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for hammer
#: lang/json/TOOL_from_json.py
