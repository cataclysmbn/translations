#: lang/json/AMMO_from_json.py
msgid "rubber sole"
msgstr "sola de borracha"

#. ~ Description for rubber sole
#: lang/json/AMMO_from_json.py
msgid ""
"This is a sole made from rubber, usually found on the bottoms of boots.  Can"
" be used for making actual boots."
msgstr ""
"Isto é uma sola feita de borracha, normalmente encontrada nos fundos de "
"botas. Pode ser usada para fazer botas de verdade."

