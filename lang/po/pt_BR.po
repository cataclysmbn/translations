#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Volunteer Mutant"
msgstr "Mutante Voluntário"

#. ~ Profession (male Volunteer Mutant) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Your dreams of becoming a super-human mutant through genetic alteration may "
"have fallen a bit short, but when the Cataclysm struck, you and the "
"scientists were ready to put your new body to the test."
msgstr ""
" Seus sonhos de se tornar um mutante super-humano através de alterações "
"genéticas podem ter caído um pouco, mas quando o Cataclismo aconteceu, você "
"e os cientistas estavam prontos para colocar seu novo corpo em teste."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Volunteer Mutant"
msgstr "Mutante Voluntário"

#. ~ Profession (female Volunteer Mutant) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"Your dreams of becoming a super-human mutant through genetic alteration may "
"have fallen a bit short, but when the Cataclysm struck, you and the "
"scientists were ready to put your new body to the test."
msgstr ""
" Seus sonhos de se tornar um mutante super-humano através de alterações "
