msgid "simple knife spear"
msgid_plural "simple knife spears"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for simple knife spear
#: lang/json/TOOL_from_json.py
msgid ""
"A flimsy pole made of wood with a knife bound to the end.  It's long enough "
