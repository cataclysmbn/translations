msgid "Tourist"
msgstr "Turista"

#. ~ Profession (male Tourist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You came here to get a taste of New England; Now you hope New England won't "
"get a taste of you!"
msgstr ""
" Você veio aqui para sentir o gosto da Nova Inglaterra; Agora você espera "
"que a Nova Inglaterra não tenha um gostinho de você!"

