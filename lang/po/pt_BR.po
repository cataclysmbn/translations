msgstr ""
" Etiqueta AI para evitar que você receba vários itens de missão. Este é "
"umbug se você tiver."

#: lang/json/effects_from_json.py
msgid "Catch Up"
msgstr "Alcançar"

#. ~ Description of effect 'Catch Up'.
#: lang/json/effects_from_json.py
msgid "AI tag for telling NPCs to catch up.  This is a bug if you have it."
msgstr ""
" Etiqueta AI para dizer aos NPCs para os alcançar. Este é um bug se "
"vocêtiver."

#: lang/json/effects_from_json.py
msgid "Allow to Sleep"
msgstr "Permitir dormir"

#. ~ Description of effect 'Allow to Sleep'.
#: lang/json/effects_from_json.py
msgid "AI tag for telling NPCs to sleep.  This is a bug if you have it."
msgstr ""
" Etiqueta AI para dizer aos NPCs para dormir. Este é um bug se você tiver."

#: lang/json/effects_from_json.py
msgid "Said Something Recently"
msgstr "Disse algo recentemente"

#. ~ Description of effect 'Said Something Recently'.
#: lang/json/effects_from_json.py
