msgstr "'Estradas? Onde estamos indo, não precisamos de estradas."

#: lang/json/speech_from_json.py
msgid "\"Fasten your seatbelts. It's going to be a bumpy night.\""
msgstr "\\ 'Prenda seus cintos de segurança. Vai ser uma noite acidentada. \""

