msgstr "A caixa de som produz uma antiga melodia de Ethel Merman."

#: src/iuse_software_kitten.cpp
msgid "It's \"Finding kitten\", published by O'Reilly and Associates."
msgstr "É 'Finding kitten', publicado pela O&#39;Reilly and Associates."

#: src/iuse_software_kitten.cpp
msgid "Pumpkin pie spice."
msgstr "Tempero torta de abóbora."

#: src/iuse_software_kitten.cpp
msgid "It's the Bass-Matic '76! Mmm, that's good bass!"
msgstr "É o Bass-Matic &#39;76! Mmm, isso é bom baixo!"

#: src/iuse_software_kitten.cpp
