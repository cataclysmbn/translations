"suasmãostodas cobertas de carvão. Use-o para escrever algo."

#: lang/json/TOOL_from_json.py
msgid "survivor telescope"
msgid_plural "survivor telescopes"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'survivor telescope', 'str_pl': 'survivor
#. telescopes'}
