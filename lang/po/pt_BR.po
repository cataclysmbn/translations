#: lang/json/AMMO_from_json.py
msgid "40x53mm M430A1"
msgstr "40x53mm M430A1"

#. ~ Description for 40x53mm M430A1
#: lang/json/AMMO_from_json.py
msgid ""
"A high velocity 40x53mm HEDP grenade.  It can penetrate 3 inches of steel "
"armor and fragmentation of the projectile body also makes it suitable for "
"use against infantry."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid "40x53mm buckshot"
msgstr "40x53mm chumbo grosso"

#. ~ Description for 40x53mm buckshot
#: lang/json/AMMO_from_json.py
