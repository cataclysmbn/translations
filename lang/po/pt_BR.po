msgid ".308 Winchester, reloaded"
msgstr ".308 Winchester, recarregado"

#: lang/json/AMMO_from_json.py
msgid "7.62x51mm, reloaded"
msgstr "7.62x51mm, recarregado"

#: lang/json/AMMO_from_json.py
msgid "7.62x51mm incendiary, reloaded"
msgstr "7.62x51mm incendiário, recarregado"

#: lang/json/AMMO_from_json.py
msgid ".32 ACP"
msgstr ".32 ACP"

#. ~ Description for .32 ACP
#: lang/json/AMMO_from_json.py
msgid ""
"The .32 ACP was a popular handgun cartridge in the 20th century.  Not so "
"powerful as the .38 or the 9x19mm though."
msgstr ""
"O .32 ACP era um cartucho de pistolas popular no século XX. Não tão poderoso"
" quanto o .38 ou o 9x19mm."

#: lang/json/AMMO_from_json.py
msgid ".32 ACP, black powder"
msgstr ".32 ACP, pólvora negra"

#: lang/json/AMMO_from_json.py
msgid ".32 ACP, reloaded"
msgstr ".32 ACP, recarregado"

#: lang/json/AMMO_from_json.py
msgid ".357 magnum FMJ"
msgstr ".357 magnum FMJ"

#. ~ Description for {'str': '.357 magnum FMJ'}
#: lang/json/AMMO_from_json.py
msgid ""
"Jacketed .357 magnum ammunition.  The .357 magnum round is derived from the "
"earlier .38 special, with a marginally longer case and generating greater "
"pressure."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid ".357 magnum JHP"
msgstr ".357 magnum JHP"

#. ~ Description for {'str': '.357 magnum JHP'}
#: lang/json/AMMO_from_json.py
msgid ""
"Jacketed hollow point .357 magnum ammunition.  The .357 magnum round is "
"derived from the earlier .38 special, with a marginally longer case and "
"generating greater pressure."
msgstr ""

#: lang/json/AMMO_from_json.py
msgid ".357 Magnum FMJ, black powder"
msgstr ".357 Magnum FMJ, pólvora negra"

#: lang/json/AMMO_from_json.py
msgid ".357 Magnum JHP, black powder"
msgstr ".357 Magnum JHP, pólvora negra"

