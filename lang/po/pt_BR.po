#: lang/json/terrain_from_json.py
msgid "simple metal wall"
msgstr "parede de metal simples"

#. ~ Description for simple metal wall
#: lang/json/terrain_from_json.py
msgid ""
"A relatively simple wall made of scraped together metal.  It's still capable"
" of blocking intruders and supporting a roof with adjacent walls."
msgstr ""
" Uma parede relativamente simples feita de metal raspado. Ainda é capaz de "
"bloquear intrusos e apoiar um telhado com paredes adjacentes."

