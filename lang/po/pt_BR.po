#: lang/json/effects_from_json.py
msgid "Paid"
msgstr "Pago"

#. ~ Description of effect 'Paid'.
#: lang/json/effects_from_json.py
msgid "AI tag used for paid critters.  This is a bug if you have it."
msgstr "Etiqueta de IA para criaturas pagas. Se você tiver isto, é um bug."

#: lang/json/effects_from_json.py
msgid "Pacified"
msgstr "Pacificado"

#. ~ Description of effect 'Pacified'.
#: lang/json/effects_from_json.py
msgid "AI tag used for pacified critters.  This is a bug if you have it."
msgstr ""
" Etiqueta AI usada para criaturas pacificadas. Este é um bug se você tiver."

#: lang/json/effects_from_json.py
msgid "Has Bag"
msgstr "Tem saco"

#. ~ Description of effect 'Has Bag'.
#: lang/json/effects_from_json.py
msgid ""
"AI tag used for critters holding your bags.  This is a bug if you have it."
