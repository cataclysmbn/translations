msgid "Mode 1: Numpad Emulation"
msgstr ""

#: src/options.cpp
msgid "Mode 2: CW/CCW"
msgstr ""

#: src/options.cpp
msgid "Mode 3: L/R Tilt"
msgstr ""

#: src/options.cpp
msgid "Vehicle plating changes part color"
msgstr "Cor das partes da blindagem do veículo muda"

#: src/options.cpp
