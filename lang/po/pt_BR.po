msgstr[0] ""
msgstr[1] ""

#. ~ Description for {'str': 'pair of XL black dragonhide boots', 'str_pl':
#. 'pairs of XL black dragonhide boots'}
#: lang/json/ARMOR_from_json.py
msgid ""
"Massive boots made of black dragonhide, modified to fit even the strangest "
