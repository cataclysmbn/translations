#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Skater Boy"
msgstr "Skatista"

#. ~ Profession (Skater Boy) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You love to skate!  At least now the grown-ups aren't telling you where you "
"can't roll."
msgstr ""
" Você ama patinar! Pelo menos agora os adultos não estão dizendo onde você "
"não pode rolar."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Skater Girl"
msgstr "Skatista"

#. ~ Profession (Skater Girl) description
#: lang/json/professions_from_json.py
