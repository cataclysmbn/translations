#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Naked and Afraid"
msgstr "Nu e com medo"

#. ~ Profession (male Naked and Afraid) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were out filming a reality TV show in the woods and the cast and crew "
"all seemed to have turned into zombies.  Looks like it's for real now..."
msgstr ""
" Você estava filmando um reality show na floresta e o elenco e a equipe "
"pareciam ter se transformado em zumbis. Parece que é pra valer agora ..."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Naked and Afraid"
msgstr "Nu e com medo"

#. ~ Profession (female Naked and Afraid) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
