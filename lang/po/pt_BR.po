msgstr[1] "pés-de-cabra"

#. ~ Description for crowbar
#: lang/json/TOOL_from_json.py
msgid ""
"This is a hefty prying tool.  Use it to open locked doors without destroying"
" them or to lift manhole covers.  You could also wield it to bash some heads"
" in."
msgstr ""
" crowbarEsta é uma ferramenta pesada e intrigante. Use-o para "
"abrirportastrancadas sem destruí-las ou levantar tampas de bueiros. Você "
