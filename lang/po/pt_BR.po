#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "A/V Club Member"
msgstr "Membro do clube A / V"

#. ~ Profession (male A/V Club Member) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were a member of the school A/V club.  You're sure there's some way you "
"can use your technical skills to help stay alive.  You just haven't figured "
"out how to make an awesome death ray yet."
msgstr ""
" Você era um membro do clube A / V da escola. Você tem certeza de que há "
"alguma maneira de usar suas habilidades técnicas para se manter vivo. Você "
"ainda não descobriu como fazer um incrível raio da morte ainda."

