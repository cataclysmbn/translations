#: lang/json/speech_from_json.py
msgid "\"That's the first time it moved all morning.\""
msgstr "'Essa é a primeira vez que se move toda a manhã."

#: lang/json/speech_from_json.py
msgid "\"I'm certain it's trying to understand us.\""
msgstr "'Estou certo de que está tentando nos entender."

#: lang/json/speech_from_json.py
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "'Eu não estou convencido de que possa realmente nos compreender."

#: lang/json/speech_from_json.py
msgid "\"It's just repeating us.\""
msgstr "\\ 'Está apenas nos repetindo. \""

#: lang/json/speech_from_json.py
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr ""
" 'Ser apenas uma criatura alienígena não significa que ela seja inteligente."

#: lang/json/speech_from_json.py
