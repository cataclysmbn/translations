"para comer seus cérebros."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Rabbi"
msgstr "Rabino"

#. ~ Profession (male Rabbi) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were celebrating with your flock in the temple when the Cataclysm "
"struck.  You sure could use a messiah right now!"
msgstr ""

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Rabbi"
msgstr "Rabino"

#. ~ Profession (female Rabbi) description
