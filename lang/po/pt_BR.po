#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Miner"
msgstr "Mineiro"

#. ~ Profession (male Miner) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You're a miner, not a minor!  Your canteen is dry, your jackhammer is out of"
" gas, and you're on your last pair of batteries for your mining helmet..."
msgstr ""
" Você é um mineiro, não um menor! Sua cantina está seca, sua britadeira está"
" sem gasolina e você está em seu último par de baterias para seu capacete de"
" mineração ..."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Miner"
msgstr "Mineiro"

#. ~ Profession (female Miner) description
#: lang/json/professions_from_json.py
