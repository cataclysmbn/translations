msgid "heat pack"
msgid_plural "heat packs"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for heat pack
#: lang/json/TOOL_from_json.py
msgid ""
"This is a chemical heat pack.  It's used to treat sports injuries and heat "
"food.  It is usable only once."
msgstr ""
" pacote de calorEste é um pacote de calor químico. É usado para "
"tratarlesõesesportivas e aquecer alimentos. É utilizável apenas uma vez."

#: lang/json/TOOL_from_json.py
msgid "used heat pack"
msgid_plural "used heat packs"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for used heat pack
#: lang/json/TOOL_from_json.py
msgid ""
"This is a chemical heat pack.  It's used to treat sports injuries and heat "
"food.  This one has been used and is chemically inert, rendering it useless."
msgstr ""
" pacote de calor usadoEste é um pacote de calor químico. É usado "
"paratratarlesões esportivas e aquecer alimentos. Este foi usado e "
"équimicamenteinerte, tornando-o inútil."

