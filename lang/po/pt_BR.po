#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Gym Teacher"
msgstr "Professor de ginástica"

#. ~ Profession (male Gym Teacher) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"After a career of teaching kids the art of sports they mostly hate, the "
"zombies around you refuse to do laps, even at the blow of your whistle."
msgstr ""
" Depois de uma carreira de ensinar às crianças a arte dos esportes que eles "
"mais odeiam, os zumbis ao seu redor se recusam a dar as voltas, mesmo com o "
"assovio."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
