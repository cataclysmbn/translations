msgstr ""

#. ~ Description for {'str': 'leather vest'}
#: lang/json/ARMOR_from_json.py
msgid "A vest made from thick leather.  Offers excellent protection from cuts."
msgstr ""

#. ~ Description for makeshift kevlar vest
#: lang/json/ARMOR_from_json.py
