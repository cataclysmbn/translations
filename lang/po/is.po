msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Getting by as much as I can.  What brings you around today?"
msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Getting by will do for now."
msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Giant bees?  Tell me more."
msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Give it some time, I'll show you something new later..."
msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Give it to me, or else!"
msgstr ""

