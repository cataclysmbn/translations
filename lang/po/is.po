#. ~ Description for {'str': 'sleeveless leather duster'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick leather full-length duster without sleeves, leaving your arms "
"unencumbered.  Has plenty of storage space due to its many pockets."
msgstr ""

#. ~ Description for {'str': 'leather duster'}
#: lang/json/ARMOR_from_json.py
msgid "A thick leather full-length duster.  Has many pockets for storage."
msgstr ""

#. ~ Description for {'str': 'leather armor helmet'}
#: lang/json/ARMOR_from_json.py
msgid "A thick leather helmet that provides excellent protection for the head."
msgstr ""

#. ~ Description for {'str': 'sleeveless leather trenchcoat'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick leather trenchcoat without sleeves, leaving your arms unencumbered.  "
"Has plenty of storage space due to its many pockets."
msgstr ""

#. ~ Description for {'str': 'leather trenchcoat'}
#: lang/json/ARMOR_from_json.py
msgid "A thick leather trenchcoat, lined with pockets.  Great for storage."
msgstr ""

#. ~ Description for {'str': 'pair of wool gloves', 'str_pl': 'pairs of wool gloves'}
#: lang/json/ARMOR_from_json.py
msgid "A thick pair of wool gloves.  Cumbersome, but warm."
msgstr ""

#. ~ Description for {'str': 'titanium ring'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick, masculine ring made out of titanium.  Made in a variety of styles "
"and finishes, they're valued for their durability."
msgstr ""

#. ~ Description for {'str': 'titanium watch', 'str_pl': 'titanium watches'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick, masculine watch made out of titanium.  It is durable, light-weight "
"and water-resistant, an excellent watch to have in a hostile environment."
msgstr ""

#. ~ Description for {'str': 'sleeveless faux fur duster'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thick, sleeveless faux fur duster, falling below your knees.  Has many "
"pockets for storing things."
msgstr ""

#. ~ Description for {'str': 'light jacket'}
#: lang/json/ARMOR_from_json.py
msgid "A thin cotton jacket with a hood.  Good for brisk weather."
msgstr ""

#. ~ Description for {'str': 'sleeveless trenchcoat'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin cotton trenchcoat that leaves your arms unencumbered.  Has plenty of "
"storage space due to its many pockets."
msgstr ""

#. ~ Description for {'str': 'trenchcoat'}
#: lang/json/ARMOR_from_json.py
msgid "A thin cotton trenchcoat, lined with pockets.  Great for storage."
msgstr ""

#. ~ Description for {'str': 'stoneskin coating', 'str_pl': 'stoneskin coating'}
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin layer of shifting, almost fluid living rock, covering the entire body."
msgstr ""

#. ~ Description for {'str': 'pair of leather gloves', 'str_pl': 'pairs of leather gloves'}
#: lang/json/ARMOR_from_json.py
msgid "A thin pair of black leather gloves."
msgstr ""

#. ~ Description for {'str': 'pair of golfing gloves', 'str_pl': 'pairs of golfing gloves'}
#: lang/json/ARMOR_from_json.py
