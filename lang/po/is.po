msgstr ""

#. ~ Description for {'str': 'flute'}
#: lang/json/TOOL_from_json.py
msgid "A simple silver-plated flute."
msgstr ""

#. ~ Description for {'str': 'grip hook'}
#: lang/json/TOOL_from_json.py
msgid ""
"A simple steel meathook with a circular steel handle.  Makes a passable "
