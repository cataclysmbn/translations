#. ~ Description for {'str': 'UPS', 'str_pl': "UPS's"}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a unified power supply, or UPS.  It is a device developed jointly by "
"military and scientific interests for use in combat and the field.  The UPS "
"is designed to power armor and some guns, but drains batteries quickly.  It "
"can be worn around to either leg for ease of access, and it's been "
"waterproofed to protect the delicate electronics.  Has it's own custom "
"battery, with higher capacity and rechargeable, but not removeable"
msgstr ""

#. ~ Description for {'str': 'headlamp (on)', 'str_pl': 'headlamps (on)'}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
