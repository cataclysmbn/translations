#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"This gear has <info>cloaking tech</info> that will <good>make you "
"invisible</good> when active, at the cost of <info>power from a UPS</info>."
msgstr ""
"У этого снаряжения есть <info>устройство маскировки</info>, которое при "
"активации <good>сделает вас невидимым</good> за счёт <info>энергии "
"УБП</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid "This gear has an <info>alarm clock</info> feature."
msgstr "У этого снаряжения есть функция <info>будильника</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"This clothing won't hinder special attacks that involve <info>mutated "
"anatomy</info>."
msgstr ""
"Этот предмет одежды не стесняет проведение особых атак, связанных с "
"<info>мутацией тела</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"This item can be activated or reloaded from adjacent tile without picking it"
" up."
msgstr ""
"Этот предмет можно активировать или перезаряжать с соседнего тайла, без "
"необходимости брать его в руки."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
