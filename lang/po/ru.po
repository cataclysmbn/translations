msgstr[2] "шерстяных нагрудных повязок"
msgstr[3] "шерстяная нагрудная повязка"

#. ~ Description for wool chestwrap
#: lang/json/ARMOR_from_json.py
msgid ""
"Felt patches wrapped around the chest.  Preserves your modesty and keeps "
"things out of the way, but not good for much else."
msgstr ""
"Войлочные лоскуты, обмотанные вокруг груди. Оберегают вашу застенчивость и "
"не стесняют движений, но не более того."

#: lang/json/ARMOR_from_json.py
