#, c-format
msgid "You cannot use a %s there."
msgstr "Вы не можете использовать здесь %s."

#: src/iuse.cpp
#, c-format
msgid "The %1$s is too big to put in your %2$s."
msgstr "Этот предмет (%1$s) слишком велик, чтобы убрать в %2$s!"

#: src/iuse.cpp
#, c-format
msgid "Error serializing monster: %s"
msgstr "Ошибка сериализации монстра: %s"

#: src/iuse.cpp
#, c-format
msgid "%s holding %s"
msgstr "%s держит %s"

#: src/iuse.cpp
#, c-format
msgid "The %1$s avoids your attempts to put it in the %2$s."
msgstr "%1$s избегает ваших попыток убрать в %2$s."

#: src/iuse.cpp
#, c-format
msgid "The %s can't capture nothing"
msgstr "%s не может ничего заснять"

#: src/iuse.cpp
msgid "Put the ladder where?"
msgstr "Куда поставить лестницу?"

#: src/iuse.cpp
msgid "Can't place it there."
msgstr "Невозможно поставить её здесь."

#: src/iuse.cpp
msgid "You set down the ladder."
msgstr "Вы установили лестницу."

#: src/iuse.cpp
msgid "Saw barrel?"
msgstr "Обрезать ствол?"

#: src/iuse.cpp
msgid "You don't have guns with long barrels."
msgstr "У вас нет оружия с длинными стволами."

#: src/iuse.cpp
#, c-format
msgid "You saw down the barrel of your %s"
msgstr "Вы обрезали ствол оружия (%s)."

#: src/iuse.cpp
msgid "You need a cleansing agent to use this."
msgstr "Для этого вам понадобится чистящее средство."

#: src/iuse.cpp
msgid "Wash what?"
msgstr "Стирать что?"

#: src/iuse.cpp
#, c-format
msgid "You need %1$i charges of water or clean water to wash your %2$s."
msgstr "Вам нужно %1$i единиц воды или чистой воды, чтобы отстирать %2$s."

#: src/iuse.cpp
#, c-format
msgid "You need %1$i charges of cleansing agent to wash your %2$s."
msgstr "Чтобы вымыть %2$s, вам понадобится %1$i зарядов чистящего средства."

#: src/iuse_actor.cpp
#, c-format
msgid "The %s is empty!"
msgstr "Этот %s пуст!"

#: src/iuse_actor.cpp
msgid "You can't do that while underwater"
msgstr "Вы не можете это делать под водой."

#: src/iuse_actor.cpp
#, c-format
msgid "<bold>Turns into</bold>: %s"
msgstr "<bold>Превращается в</bold>: %s"

#: src/iuse_actor.cpp
msgid "Countdown: "
msgstr "Обратный отсчет: "

#: src/iuse_actor.cpp
#, c-format
msgid "You've already set the %s's timer you might want to get away from it."
msgstr "Вы уже установили таймер на %s. Возможно, вам пора уже убегать."

#: src/iuse_actor.cpp
msgid "Power at <bold>epicenter</bold>: "
msgstr "Мощность в <bold>эпицентре</bold>: "

#: src/iuse_actor.cpp
msgid "Shrapnel <bold>count</bold>: "
msgstr "Осколки <bold>количество</bold>: "

#: src/iuse_actor.cpp
msgid "Shrapnel <bold>mass</bold>: "
msgstr "Осколки <bold>масса</bold>: "

#: src/iuse_actor.cpp
#, c-format
msgid "You need %s to do it!"
msgstr "Требуется %s, чтобы сделать это!"

#: src/iuse_actor.cpp
msgid "You need a <info>syringe</info> to inject this drug"
msgstr "Вам нужен <info>шприц</info>, чтобы ввести это вещество"

#: src/iuse_actor.cpp
#, c-format
msgid "You need %1$s to consume %2$s!"
msgstr "Вам нужен %1$s, чтобы съесть %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "I need a %1$s to consume %2$s!"
msgstr "Мне нужен %1$s, чтобы съесть %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "There is no adjacent square to release the %s in!"
msgstr "Недостаточно места, чтобы выпустить %s."

#: src/iuse_actor.cpp
#, c-format
msgid "You cannot place a %s there."
msgstr "Вы не можете разместить %s здесь."

#: src/iuse_actor.cpp
#, c-format
msgid ""
"If you had standard factory-built %1$s bullets, you could load the %2$s."
msgstr "Если бы у вас были заводские %1$s пули, вы бы смогли зарядить %2$s."

#. ~ First %s is the ammo item (with plural form and count included), second
#. is the monster name
#: src/iuse_actor.cpp
#, c-format
msgid "You load %1$d x %2$s round into the %3$s."
msgid_plural "You load %1$d x %2$s rounds into the %3$s."
msgstr[0] "Вы зарядили %1$d патрон %2$s в %3$s."
msgstr[1] "Вы зарядили %1$d патрона %2$s в %3$s."
msgstr[2] "Вы зарядили %1$d патронов %2$s в %3$s."
msgstr[3] "Вы зарядили %1$d патрон %2$s в %3$s."

#: src/iuse_actor.cpp
#, c-format
msgid "The %s scans you and makes angry beeping noises!"
msgstr "%s сканирует вас и издаёт противные звуковые сигналы!"

#: src/iuse_actor.cpp
#, c-format
msgid "The %s emits an IFF beep as it scans you."
msgstr "%s издаёт сигнал «свой-чужой», сканируя вас."

#: src/iuse_actor.cpp
msgid "A flashing LED on the laser turret appears to indicate low light."
msgstr "Мигающий светодиод на лазерной туррели, судя по всему, указывает на недостаток света."

#: src/iuse_actor.cpp
#, c-format
msgid "You should wear the %s before activating it."
msgstr "Вы должны надеть %s, перед тем как включить его."

#: src/iuse_actor.cpp
#, c-format
msgid "You need some source of power for your %s (a simple UPS will do)."
msgstr "%s требует какого-нибудь источника энергии (обычный УБП подойдёт)."

#: src/iuse_actor.cpp
msgid "There is also a certain bionic that helps with this kind of armor."
msgstr "Также есть определённая бионика, которая может помочь с этим типом брони."

#: src/iuse_actor.cpp
msgid "Use your lockpick where?"
msgstr "Где использовать отмычку?"

#: src/iuse_actor.cpp
msgid "You pick your nose and your sinuses swing open."
msgstr "Вы поковыряли в носу и ваши пазухи распахнулись."

#: src/iuse_actor.cpp
msgid ""
"You can pick your friends, and you can\n"
"pick your nose, but you can't pick\n"
"your friend's nose"
msgstr "Вы можете подковырнуть друзей\nпоковырять у себя в носу, но вы не\nможете ковырять в носу у друзей."

#: src/iuse_actor.cpp
msgid "With a satisfying click, the chain-link gate opens."
msgstr "С приятным щелчком, замок на воротах ограды открывается."

#: src/iuse_actor.cpp
msgid "With a satisfying click, the lock on the door opens."
msgstr "С приятным щелчком, замок на двери открывается."

#: src/iuse_actor.cpp
msgid "The door swings open..."
msgstr "Дверь распахнулась..."

#: src/iuse_actor.cpp
msgid "That door isn't locked."
msgstr "Дверь не заперта."

#: src/iuse_actor.cpp
msgid "That cannot be picked."
msgstr "Это нельзя подобрать."

#: src/iuse_actor.cpp
msgid "The lock stumps your efforts to pick it, and you destroy your tool."
msgstr "Замок сопротивляется вашим попыткам взломать его, и ломает ваш инструмент."

#: src/iuse_actor.cpp
msgid "The lock stumps your efforts to pick it, and you damage your tool."
msgstr "Замок сопротивляется вашим попыткам взломать его и повреждает ваш инструмент."

#: src/iuse_actor.cpp
msgid "The lock stumps your efforts to pick it."
msgstr "Замок сопротивляется вашим попыткам взломать его."

#: src/iuse_actor.cpp
#, c-format
msgid "There isn't anything new on the %s."
msgstr "На этой %s нет ничего нового."

#: src/iuse_actor.cpp
#, c-format
msgid "You should read your %s when you get to the surface."
msgstr "Вам следует прочесть %s, когда вы доберетесь до поверхности."

#: src/iuse_actor.cpp
msgid "This tool doesn't have enough charges."
msgstr "В этом инструменте недостаточно зарядов."

#: src/iuse_actor.cpp
msgid "Light where?"
msgstr "Что поджечь?"

#: src/iuse_actor.cpp
msgid "You would set yourself on fire."
msgstr "Ты бы зажёг сам себя."

#: src/iuse_actor.cpp
msgid "But you're already smokin' hot."
msgstr "Но ты и так уже горячая штучка."

#: src/iuse_actor.cpp
msgid "There is already a fire."
msgstr "Здесь уже зажжён огонь."

#: src/iuse_actor.cpp
msgid ""
"There's a brazier there but you haven't set it up to contain the fire. "
"Continue?"
msgstr "Здесь находится жаровня, но вы не установили её, чтобы сдерживать огонь. Продолжить?"

#: src/iuse_actor.cpp
msgid "There's nothing to light there."
msgstr "Здесь нечего поджечь."

#: src/iuse_actor.cpp
msgid "You successfully light a fire."
msgstr "Вы успешно разожгли огонь."

#: src/iuse_actor.cpp
msgid "You need direct sunlight to light a fire with this."
msgstr "Вам нужен прямой солнечный свет, чтобы развести огонь при помощи этой вещи."

#: src/iuse_actor.cpp
#, c-format
msgid ""
"If the current weather holds, it will take around %d minutes to light a "
"fire."
msgstr "Если текущая погода не изменится, то разведение огня займёт %d минут."

#: src/iuse_actor.cpp
#, c-format
msgid "At your skill level, it will take around %d minutes to light a fire."
msgstr "С вашим уровнем навыка разведение огня займёт %d минут."

#: src/iuse_actor.cpp src/player.cpp
msgid "You do not have that item."
msgstr "У вас нет этого предмета."

#: src/iuse_actor.cpp
#, c-format
msgid "Can't salvage anything from %s."
msgstr "Нельзя извлечь что-нибудь из %s."

#: src/iuse_actor.cpp
#, c-format
msgid "Try disassembling the %s instead."
msgstr "Вместо этого попытайтесь разобрать %s."

#: src/iuse_actor.cpp
#, c-format
msgid "The %s is made of material that cannot be cut up."
msgstr "%s из материала, который нельзя разрезать."

#: src/iuse_actor.cpp
#, c-format
msgid "Please empty the %s before cutting it up."
msgstr "Пожалуйста, опустошите %s перед тем, как разрезать."

#: src/iuse_actor.cpp
#, c-format
msgid "The %s is too small to salvage material from."
msgstr "%s имеет слишком маленькие размеры, чтобы можно было извлечь какие-нибудь материалы."

#: src/iuse_actor.cpp
msgid "You are wielding that, are you sure?"
msgstr "Вы вооружены этим. Уверены?"

#: src/iuse_actor.cpp
msgid "You're wearing that, are you sure?"
msgstr "Вы ведь носите это, вы уверены?"

#: src/iuse_actor.cpp
#, c-format
msgid "You can not cut the %s with itself."
msgstr "Вы не можете разрезать %s при помощи этого же самого предмета."

#: src/iuse_actor.cpp
#, c-format
msgid "You try to salvage materials from the %s."
msgstr "Вы пытаетесь извлечь материалы из %s."

#: src/iuse_actor.cpp
#, c-format
msgid "Salvaged %1$i %2$s."
msgid_plural "Salvaged %1$i %2$s."
msgstr[0] "Извлечено: %1$i %2$s."
msgstr[1] "Извлечено: %1$i %2$s."
msgstr[2] "Извлечено: %1$i %2$s."
msgstr[3] "Извлечено: %1$i %2$s."

#: src/iuse_actor.cpp
#, c-format
msgid "Could not salvage a %s."
msgstr "Не удалось извлечь: %s."

#: src/iuse_actor.cpp
msgid "You can't inscribe an item that isn't solid!"
msgstr "Вы не можете нанести надпись на не твёрдый предмет."

#: src/iuse_actor.cpp
#, c-format
msgid "%s meaning?"
msgstr "%s значит?"

#: src/iuse_actor.cpp
msgid "It's a label"
msgstr "Это надпись"

#: src/iuse_actor.cpp
msgid "It's a note"
msgstr "Это заметка"

#: src/iuse_actor.cpp
msgid "Inscribe which item?"
msgstr "Нанести надпись на что?"

#: src/iuse_actor.cpp
msgid "You cauterize yourself."
msgstr "Вы прижгли свою рану."

#: src/iuse_actor.cpp
msgid "It hurts like hell!"
msgstr "Адская боль!"

#: src/iuse_actor.cpp
msgid "It itches a little."
msgstr "Немного зудит."

#: src/iuse_actor.cpp
msgid ""
"You need a source of flame (4 charges worth) before you can cauterize "
"yourself."
msgstr "Чтобы прижечь раны, нужен источник огня с 4 зарядами."

#: src/iuse_actor.cpp
#, c-format
msgid "You need at least %d charges to cauterize wounds."
msgstr "Чтобы прижечь рану, нужно как минимум %d зарядов."

#: src/iuse_actor.cpp
msgid "You can't cauterize anything underwater."
msgstr "Вы не можете прижигать раны под водой."

#: src/iuse_actor.cpp
msgid "No suitable corpses"
msgstr "Нет подходящих трупов"

#: src/iuse_actor.cpp
msgid ""
"The prospect of cutting up the corpse and letting it rise again as a slave "
"is too much for you to deal with right now."
msgstr "Перспектива разделать труп и дать ему возродиться снова в виде раба - в данный момент для вас это слишком."

#: src/iuse_actor.cpp
msgid "Selectively butcher the downed zombie into a zombie slave?"
msgstr "Избирательно разделать утонувшего зомби, чтобы превратить его в зомби-раба?"

#: src/iuse_actor.cpp
msgid "Make love, not zlave."
msgstr "Занимайтесь любовью, а не рабством."

#: src/iuse_actor.cpp
msgid "Well, it's more constructive than just chopping 'em into gooey meat..."
msgstr "Ну, это более конструктивно, чем просто рубить их на липкое мясо..."

#: src/iuse_actor.cpp
msgid "You feel horrible for mutilating and enslaving someone's corpse."
msgstr "Вы ужасно себя чувствуете из-за уродования чьего-то трупа и превращения его в раба."

#: src/iuse_actor.cpp
msgid "You can't play music underwater"
msgstr "Вы не можете играть музыку под водой."

#: src/iuse_actor.cpp
#, c-format
msgid "You stop playing your %s"
msgstr "Вы прекратили играть на инструменте (%s)."

#: src/iuse_actor.cpp
#, c-format
msgid "You need to hold or wear %s to play it"
msgstr "%s нужно держать в руках или повесить на шею, чтобы играть."

#: src/iuse_actor.cpp
#, c-format
msgid "You feel too weak to play your %s"
msgstr "Вы чувствуете себя слишком слабым, чтобы играть на %s."

#: src/iuse_actor.cpp
#, c-format
msgid "You start playing your %s"
msgstr "Вы начали играть на %s."

#: src/iuse_actor.cpp
msgid "You produce an annoying sound"
msgstr "Вы производите раздражающий звук."

#: src/iuse_actor.cpp
#, c-format
msgid "Your %1$s is too big to fit in your %2$s"
msgstr "Этот предмет (%1$s) слишком велик для %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "Your %1$s is too small to fit in your %2$s"
msgstr "Этот предмет (%1$s) слишком мал для %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "Your %1$s is too heavy to fit in your %2$s"
msgstr "Этот предмет (%1$s) слишком тяжёл для %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "You can't put your %1$s in your %2$s"
msgstr "Вы не можете положить этот предмет (%1$s) в %2$s!"

#: src/iuse_actor.cpp
#, c-format
msgid "You holster your %s"
msgstr "Вы убираете %s в кобуру."

#: src/iuse_actor.cpp
msgid "Holster item"
msgstr "Убрать вещь в кобуру"

#: src/iuse_actor.cpp
#, c-format
msgid "You need to unwield your %s before using it."
msgstr "Вам нужно убрать %s из рук перед использованием."

#: src/iuse_actor.cpp
#, c-format
msgid "Draw %s"
msgstr "Вытащить %s"

#: src/iuse_actor.cpp
#, c-format
msgid "Use %s"
msgstr "Использовать %s"

#: src/iuse_actor.cpp
msgid "Can contain items from "
msgstr ""

