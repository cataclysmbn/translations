msgid_plural "cleansuits"
msgstr[0] "лабораторный костюм"
msgstr[1] "лабораторных костюма"
msgstr[2] "лабораторных костюмов"
msgstr[3] "лабораторный костюм"

#. ~ Description for cleansuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple hazardous materials handling suit.  Though somewhat restrictive and"
