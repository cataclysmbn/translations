msgstr "Живица слишком вязкая, поэтому вы не можете сражаться эффективно."

#: lang/json/effects_from_json.py
msgid "Common Cold"
msgstr "Простуда"

#. ~ Description of effect 'Common Cold'.
#: lang/json/effects_from_json.py
