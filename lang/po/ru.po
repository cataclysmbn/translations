msgstr "Нажмите %s для сброса фильтра"

#: src/construction.cpp
#, c-format
msgid "Press %s or %s to tab."
msgstr "Нажмите «%s» или «%s» для смены вкладки."

#: src/construction.cpp
#, c-format
msgid "Press %s to search."
msgstr "Нажмите «%s» для поиска."

#: src/construction.cpp
