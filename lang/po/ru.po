msgstr[1] "баскетбольных мяча"
msgstr[2] "баскетбольных мячей"
msgstr[3] "баскетбольный мяч"

#. ~ Description for basketball
#: lang/json/GENERIC_from_json.py
msgid "A high-quality indoor basketball.  You may throw it at zombies."
msgstr "Качественный баскетбольный мяч. Вы можете бросать его в зомби."

#: lang/json/GENERIC_from_json.py
