msgstr[1] "попкорна"
msgstr[2] "попкорнов"
msgstr[3] "попкорн"

#. ~ Description for popcorn
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Plain and unseasoned popcorn.  Not as tasty as other kinds, but healthier as"
" a result."
msgstr "Обычный попкорн без всяких приправ. Не такой вкусный, как остальные виды попкорна, но для здоровья полезнее."

#: lang/json/COMESTIBLE_from_json.py
msgid "salted popcorn"
msgid_plural "salted popcorn"
