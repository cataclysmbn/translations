msgstr "Это снаряжение <info>пристёгивается</info> к вам."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"A <good>follower</good> could <info>make use of this CBM</info> if installed"
" properly."
msgstr ""
"<good>Неигровой персонаж-спутник</good> мог бы <info>использовать этот "
"КБМ</info> при правильной установке."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
