msgstr "Стеклянная стена закрыта."

#. ~ 'fail' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The glass wall can't be closed!"
msgstr "Стеклянную стену нельзя закрыть!"

#. ~ 'open' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The glass slides open!"
msgstr "Стеклянная стена открыта!"

#. ~ 'pull' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "You activate the mechanism..."
msgstr "Вы активировали механизм…"

#. ~ 'close' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The bolts slide back into place."
msgstr "Болты вернулись на место."

#. ~ 'fail' action message of some gate object.
#: lang/json/gates_from_json.py
