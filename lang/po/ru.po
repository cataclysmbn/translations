" урон всем существам в области."

#: lang/json/GENERIC_from_json.py
msgid "Scroll of Mana Blast"
msgid_plural "Scrolls of Mana Blast"
msgstr[0] "Свиток Взрыва Маны"
msgstr[1] "Свитка Взрыва Маны"
msgstr[2] "Свитков Взрыва Маны"
msgstr[3] "Свитки Взрыва Маны"

