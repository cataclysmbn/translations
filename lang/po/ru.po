msgstr "Продолжай."

#: lang/json/talk_topic_from_json.py
msgid "Please stop your current activity."
msgstr "Пожалуйста, прекрати текущее занятие."

#: lang/json/talk_topic_from_json.py
msgid "Please sort out some of these items nearby."
msgstr "Пожалуйста, отсортируй ближайшие вещи."

#: lang/json/talk_topic_from_json.py
msgid "Please do any construction work that you can."
msgstr "Пожалуйста, работай над любой строительной задачей, какую осилишь."

#: lang/json/talk_topic_from_json.py
msgid "Please study from a book."
msgstr "Пожалуйста, учись по книге."

#: lang/json/talk_topic_from_json.py
msgid "Please start deconstructing any vehicles in a deconstruction zone."
msgstr "Пожалуйста, начни разбирать любые машины в области разборки."

#: lang/json/talk_topic_from_json.py
msgid "Please start repairing any vehicles in a repair zone."
msgstr "Пожалуйста, начни чинить все машины в области починки."

#: lang/json/talk_topic_from_json.py
msgid "Please chop logs into planks."
msgstr "Пожалуйста, руби брёвна на доски."

#: lang/json/talk_topic_from_json.py
msgid "Please butcher any corpses that you can."
msgstr "Пожалуйста, разделывай все трупы, какие сможешь."

#: lang/json/talk_topic_from_json.py
msgid "Please chop any trees in the designated areas."
msgstr "Пожалуйста, руби все деревья в размеченных зонах."

#: lang/json/talk_topic_from_json.py
msgid "Please go catch some fish."
msgstr "Пожалуйста, отправляйся на рыбалку."

#: lang/json/talk_topic_from_json.py
msgid "Please do some farming work."
msgstr "Пожалуйста, займись работой в огороде."

#: lang/json/talk_topic_from_json.py
