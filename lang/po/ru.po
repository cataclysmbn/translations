msgstr "%s даёт вам предмет из ячейки хранения."

#: src/mission_start.cpp
#, c-format
msgid "%s gave you a dog whistle."
msgstr "%s отдал вам собачий свисток."

#: src/mission_start.cpp
msgid "Demonic Soul"
msgstr "Демоническая душа"

#: src/mission_start.cpp
