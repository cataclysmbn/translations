msgstr "слизевые шасси"

#: lang/json/vehicle_part_from_json.py
msgid "ooze reinforcement"
msgstr "слизевая броня"

#: lang/json/vehicle_part_from_json.py
msgid "ooze roof"
msgstr "слизевая крыша"

#: lang/json/vehicle_part_from_json.py
msgid "ooze seat"
msgstr "слизевое сиденье"

#: lang/json/vehicle_part_from_json.py
