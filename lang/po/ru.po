msgstr "Вас ломает от боли!"

#: lang/json/SPELL_from_json.py
msgid "Artifact Teleport"
msgstr "Артефакт - Телепортация"

#. ~ Description for Artifact Teleport
#: lang/json/SPELL_from_json.py
msgid "Randomly teleports you a short distance."
msgstr "Телепортирует вас на короткое расстояние в случайном направлении."

#. ~ Message for SPELL 'Artifact Teleport'
#: lang/json/SPELL_from_json.py
msgid "You teleport!"
msgstr "Вы телепортируетесь!"

#: lang/json/SPELL_from_json.py
