msgid_plural "pointy sticks"
msgstr[0] "заострённая палка"
msgstr[1] "заострённых палки"
msgstr[2] "заострённых палок"
msgstr[3] "заострённая палка"

#. ~ Description for pointy stick
#: lang/json/GENERIC_from_json.py
