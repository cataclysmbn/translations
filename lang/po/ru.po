msgid_plural "tiny fish"
msgstr[0] "рыбёшка"
msgstr[1] "рыбёшки"
msgstr[2] "рыбёшек"
msgstr[3] "рыбёшки"

#. ~ Description for {'str': 'tiny fish', 'str_pl': 'tiny fish'}
