#. ~ Description for LW-56 magazine
#: lang/json/MAGAZINE_from_json.py
msgid ""
"A 56-round polymer magazine for Leadworks LLC 223 firearms.  It's compact "
"design makes it surprisingly easy to store.  Lightweight and reliable but "
"somewhat more difficult to reload."
msgstr "Полимерный магазин на 56 патронов для оружия LLC 223 от Лидворкс. Благодаря компактному дизайну его на удивление легко хранить. Он лёгкий и надежный, но заряжать его чуть сложнее."

#: lang/json/MAGAZINE_from_json.py
msgid "LW-32 magazine"
msgstr ""

#. ~ Description for LW-32 magazine
#: lang/json/MAGAZINE_from_json.py
msgid ""
"A 32-round polymer magazine for Leadworks LLC 223 firearms.  Lightweight and"
