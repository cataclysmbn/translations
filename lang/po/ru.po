msgid_plural "firearm waterproofings"
msgstr[0] "влагозащита для оружия"
msgstr[1] "влагозащиты для оружия"
msgstr[2] "влагозащит для оружия"
msgstr[3] "влагозащиты для оружия"

#: lang/json/gunmod_from_json.py
