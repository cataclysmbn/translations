msgstr[1] "вилы"
msgstr[2] "вил"
msgstr[3] "вилы"

#. ~ Description for pitchfork
#: lang/json/GENERIC_from_json.py
msgid ""
"An agricultural tool with long wooden shaft and four spikes.  Is used to "
"lift hay."
msgstr ""
"Сельскохозяйственный инструмент с длинным деревянным древком и четырьмя "
"шипами. Используется для подъёма сена."

#: lang/json/GENERIC_from_json.py
