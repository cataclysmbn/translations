msgstr[2] "S&W 500"
msgstr[3] "S&W 500"

#: lang/json/gun_from_json.py
msgid ""
"The 5-shot Smith and Wesson 500 revolver fires the comparably-named .500 S&W"
" Magnum.  It's an impressive weapon."
msgstr "Пятизарядный револьвер Смит и Вессон 500, стреляющий соответствующими зарядами .500 S&W Магнум. Впечатляющее оружие."

#: lang/json/gun_from_json.py
msgid "AK-74M"
