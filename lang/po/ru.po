msgstr[1] "Мегингьорда"
msgstr[2] "Мегингьордов"
msgstr[3] "Мегингьорды"

#. ~ Description for {'str': 'Megingjörð', 'str_pl': 'Megingjörð'}
#: lang/json/TOOL_ARMOR_from_json.py
