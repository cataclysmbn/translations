#. ~ Description for {'str': 'thermal electric outfit'}
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This suit of thin thermal underwear covers you from head to toe and is "
"equipped with internal battery-powered heating elements.  Use it to turn it "
"on."
msgstr ""
"Этот комплект тонкого термобелья покрывает ваше тело с головы до пяток и "
"оборудован встроенными нагревательными элементами, работающими на "
"батарейках. Активируйте, чтобы включить."

