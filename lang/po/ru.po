msgid_plural "leather corsets"
msgstr[0] "кожаный корсет"
msgstr[1] "кожаных корсета"
msgstr[2] "кожаных корсетов"
msgstr[3] "кожаный корсет"

#. ~ Description for leather corset
#: lang/json/ARMOR_from_json.py
msgid ""
"A snug, black leather corset.  Has no pockets, but its thick material "
"provides good protection from harm."
msgstr ""
"Удобный корсет из чёрной кожи. Нет карманов, но толстый материал даёт "
"неплохую защиту."

#: lang/json/ARMOR_from_json.py
