msgstr[2] "использованных грелок"
msgstr[3] "использованная грелка"

#. ~ Description for used heat pack
#: lang/json/TOOL_from_json.py
msgid ""
"This is a chemical heat pack.  It's used to treat sports injuries and heat "
"food.  This one has been used and is chemically inert, rendering it useless."
msgstr ""
"Одноразовая грелка, используется для лечения спортивных травм и разогрева "
"еды. Эта уже была использована и теперь бесполезна."

#: lang/json/TOOL_from_json.py
