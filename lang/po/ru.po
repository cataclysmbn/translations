msgid "Saved list of active mods as default"
msgstr "Текущий список модов сохранён как список по умолчанию."

#: src/worldfactory.cpp
msgid "World Name:"
msgstr "Название мира:"

#: src/worldfactory.cpp
#, c-format
msgid "Press <color_yellow>%s</color> to pick a random name for your world."
msgstr ""
"Нажмите клавишу <color_yellow>«%s»</color>, чтобы выбрать случайное имя для "
"вашего мира."

#: src/worldfactory.cpp
#, c-format
msgid ""
"Press <color_yellow>%s</color> when you are satisfied with the world as it "
"is and are ready to continue, or <color_yellow>%s</color> to go back and "
"review your world."
msgstr ""
"Нажмите клавишу <color_yellow>%s</color>, если вы удовлетворены настройками "
"мира и готовы продолжить, иначе нажмите <color_yellow>%s</color>, чтобы "
"вернуться назад и пересмотреть настройки вашего мира."

#: src/worldfactory.cpp
msgid "________NO NAME ENTERED!________"
msgstr "________ИМЯ НЕ ВВЕДЕНО!________"

#: src/worldfactory.cpp
msgid "Are you SURE you're finished?  World name will be randomly generated."
msgstr ""
"Вы УВЕРЕНЫ, что закончили? Будет сгенерировано случайное название мира."

#: src/worldfactory.cpp
#, c-format
msgid ""
"%s = Save Load Order as default.  %s = Controls %s/%s = Prev/Next Option.  "
"%s/%s = Prev/Next Tab."
msgstr ""
"%s = сохранить порядок загрузки модов. %s = помощь. %s/%s = "
"предыдущая/следующая настройка. %s/%s = предыдущая/следующая вкладка."

#: src/worldfactory.cpp
msgid "World Mods"
msgstr "Моды мира"

#: src/worldfactory.cpp
msgid "World Options"
msgstr "Настройки мира"

#: src/worldfactory.cpp
msgid "Finalize World"
msgstr "Завершить создание мира"

