msgstr[2] "колышков для мяча"
msgstr[3] "колышек для мяча"

#. ~ Description for golf tee
#: lang/json/GENERIC_from_json.py
msgid ""
"A pin shaped piece of wood meant for holding a golf ball slightly off the "
"ground."
msgstr ""
"Заострённый кусок дерева с выемкой, на который устанавливают мяч для гольфа "
"перед ударом."

#: lang/json/GENERIC_from_json.py
