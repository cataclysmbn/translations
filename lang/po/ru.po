msgstr[2] "браг из рома"
msgstr[3] "брага из рома"

#. ~ Description for rum wash
#: lang/json/COMESTIBLE_from_json.py
msgid "Fermented, but not distilled rum.  No longer tastes sweet."
msgstr "Ферментированный, но не дистилированный ром. На вкус больше не сладкий."

#: lang/json/COMESTIBLE_from_json.py
