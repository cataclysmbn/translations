msgstr[2] "Свитков Скольжения по Льду"
msgstr[3] "Свитки Скольжения по Льду"

#. ~ Description for {'str': 'Scroll of Glide on Ice', 'str_pl': 'Scrolls of
#. Glide on Ice'}
