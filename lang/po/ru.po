msgstr "Ферментированная, но не дистилированная водка. На вкус больше не сладкая."

#: lang/json/COMESTIBLE_from_json.py
msgid "rum wort"
msgstr "сусло рома"

#. ~ Description for rum wort
#: lang/json/COMESTIBLE_from_json.py
