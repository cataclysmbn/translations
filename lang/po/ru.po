msgstr[1] "шара для боулинга"
msgstr[2] "шаров для боулинга"
msgstr[3] "шар для боулинга"

#. ~ Description for bowling ball
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy ball.  Before the apocalypse, its main purpose was to be "
"rolled along waxed floors."
msgstr ""
"Большой тяжёлый шар. До апокалипсиса нужен был, чтобы катать его по вощёному"
" полу."

#: lang/json/GENERIC_from_json.py
