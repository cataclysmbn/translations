#: lang/json/GENERIC_from_json.py lang/json/SPELL_from_json.py
msgid "I cast Magic Missile at the darkness!"
msgstr "Я кастую волшебную ракету в темноту!"

#: lang/json/GENERIC_from_json.py
msgid "Scroll of Phase Door"
msgid_plural "Scrolls of Phase Door"
msgstr[0] "Свиток Двери Измерений"
msgstr[1] "Свитка Двери Измерений"
msgstr[2] "Свитков Двери Измерений"
msgstr[3] "Свитки Двери Измерений"

#. ~ Description for {'str': 'Scroll of Phase Door', 'str_pl': 'Scrolls of
