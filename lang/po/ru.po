msgstr[1] "воды"
msgstr[2] "воды"
msgstr[3] "вода"

#. ~ Description for water
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Water, the stuff of life, the best thirst-quencher available.  It would be "
"safer to drink once purified."
msgstr "Вода - основа жизни. Лучший способ утолить жажду. Пить её будет более безопасно, если предварительно её очистить."

