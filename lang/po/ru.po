msgstr[0] "Свиток Луча Маны"
msgstr[1] "Свитка Луча Маны"
msgstr[2] "Свитков Луча Маны"
msgstr[3] "Свитки Луча Маны"

#. ~ Description for {'str': 'Scroll of Mana Beam', 'str_pl': 'Scrolls of Mana
#. Beam'}
