msgstr "Корни и лианы усыхают и отмирают."

#: lang/json/effects_from_json.py
msgid "Root Impale"
msgstr "Пронзающие Корни"

#. ~ Apply message for effect(s) 'Root Impale'.
#: lang/json/effects_from_json.py
