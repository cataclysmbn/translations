msgstr "Часть вашего тела (%s) покрывается пузырями от сильной жары."

#. ~ Miss message for effect(s) 'Blisters'.
#: lang/json/effects_from_json.py
msgid "Your blisters distract you"
msgstr "Ваши волдыри отвлекают вас"

#: lang/json/effects_from_json.py
msgid "Itchy skin"
msgstr "Кожный зуд"

#: lang/json/effects_from_json.py
