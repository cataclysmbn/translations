#. %1$s: Damage text (e.g. "bruised"). %2$s: burn adjectives (e.g. "burnt").
#. %3$s: tool modifier text (e.g. "atomic"). %4$s: vehicle part text (e.g.
#. "3.8-Liter"). $5$s: main item text (e.g. "apple"). %6s: tags (e.g. "(wet)
#. (poor fit)").
#: src/item.cpp
#, c-format
msgid "%1$s%2$s%3$s%4$s%5$s%6$s"
msgstr "%1$s%2$s%3$s%4$s%5$s%6$s"

#. ~ %s is an item name. This style is used to denote items with notes.
#: src/item.cpp
#, c-format
msgid "*%s*"
msgstr "*%s*"

#. ~ This is a string to display the selected and total amount of money in a
#. stack of cash cards.
#. ~ %1$s is the display name of cash cards.
#. ~ %2$s is the total amount of money.
#. ~ %3$s is the selected amount of money.
#. ~ Example: "cash cards $15.35 of $20.48"
#: src/item.cpp
#, c-format
msgctxt "cash card and money"
msgid "%1$s %3$s of %2$s"
msgstr "%1$s %3$s из %2$s"

