"dandelion petals."
msgstr "Несброженное вино из одуванчиков. Липкая смесь воды, сахара, дрожжей и лепестков одуванчика."

#: lang/json/COMESTIBLE_from_json.py
msgid "pine wine must"
msgstr "сосновый муст"

#. ~ Description for pine wine must
#: lang/json/COMESTIBLE_from_json.py
