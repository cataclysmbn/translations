#: lang/json/vehicle_part_from_json.py
msgid "automated vortex accelerator"
msgstr "автоматизированный вихревой ускоритель"

#: lang/json/vehicle_part_from_json.py
msgid "vortex bolter turret"
msgstr "турель с вихревым болтомётом"

#: lang/json/vehicle_part_from_json.py
msgid "automated vortex bolter"
msgstr "автоматизированный вихревой болтомет"

#: lang/json/vehicle_part_from_json.py
