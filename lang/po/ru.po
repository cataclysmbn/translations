msgstr "Вы перевариваете %s  и получаете %d единиц энергии."

#: src/consumption.cpp
#, c-format
msgid "You digest your %s and recharge %d points of energy."
msgstr "Вы перевариваете %s  и получаете %d единиц энергии."

#: src/consumption.cpp
#, c-format
msgid "<npcname> digests a %s and recharges %d point of energy."
