#: lang/json/GENERIC_from_json.py
msgid "Scroll of Ice Shield"
msgid_plural "Scrolls of Ice Shield"
msgstr[0] "Свиток Ледяного Щита"
msgstr[1] "Свитка Ледяного Щита"
msgstr[2] "Свитков Ледяного Щита"
msgstr[3] "Свитки Ледяного Щита"

#. ~ Description for {'str': 'Scroll of Ice Shield', 'str_pl': 'Scrolls of Ice
