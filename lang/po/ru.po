msgstr[3] "электрический аккумулятор"

#. ~ Description for rechargeable battery
#: lang/json/MAGAZINE_from_json.py
msgid ""
"This surprisingly heavy battery is not very energy-dense, but can be "
"recharged."
msgstr "Этот на удевление тяжолый аккумулятор обладает низкой энергоемкостью, но может быть перезаряжен."

