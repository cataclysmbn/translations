msgstr "Толстая броня из меха. Тёплая и удобная."

#: lang/json/ARMOR_from_json.py
msgid "leather body armor"
msgid_plural "leather body armors"
msgstr[0] "кожаная броня для туловища"
msgstr[1] "кожаных брони для туловища"
msgstr[2] "кожаных бронь для туловища"
msgstr[3] "кожаная броня для туловища"

#. ~ Description for leather body armor
#: lang/json/ARMOR_from_json.py
msgid "Thick leather body armor.  Light and comfortable."
msgstr "Толстая броня для туловища из кожи. Лёгкая и удобная."

#: lang/json/ARMOR_from_json.py
