msgstr "топливный насос"

#. ~ Description for fuel pump
#: lang/json/fault_from_json.py
msgid "Required to pump gasoline from a vehicles tank."
msgstr "Требуется для выкачивания бензина из бензобака автомобиля."

#: lang/json/fault_from_json.py lang/json/terrain_from_json.py
msgid "water pump"
msgstr "водяной насос"

#. ~ Description for water pump
#: lang/json/fault_from_json.py
msgid "Required to pump water to an external radiator or heatsink."
msgstr "Требуется для подачи воды на внешний радиатор или теплоотвод."

