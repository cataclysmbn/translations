msgid "You turned off your RC car."
msgstr "Вы выключили РУ машинку."

#: src/iuse.cpp
msgid "beep"
msgstr "биип"

#: src/iuse.cpp
msgid "Take control of RC car"
msgstr "Управлять машинкой на РУ"

#: src/iuse.cpp
msgid "Stop controlling RC car"
msgstr "Прекратить управление машинкой на РУ"

#: src/iuse.cpp
msgid "What to do with radio control?"
msgstr "Что сделать с радиоуправлением?"

#: src/iuse.cpp
msgid "Press blue button"
msgstr "Нажать на синюю кнопку"

#: src/iuse.cpp
msgid "Press green button"
msgstr "Нажать на зелёную кнопку"

#: src/iuse.cpp
msgid "Press red button"
msgstr "Нажать на красную кнопку"

#: src/iuse.cpp
msgid "No active RC cars on ground and in range."
msgstr "На земле и в зоне приёма нет активных машинок на РУ."

#: src/iuse.cpp
msgid "You take control of the RC car."
msgstr "Вы управляете машинкой на РУ."

#: src/iuse.cpp
#, c-format
msgid ""
"The %s in your inventory would explode on this signal.  Place it down before"
" sending the signal."
msgstr ""
"%s в вашем инвентаре взорвётся, если послать этот сигнал. Лучше положить на "
"землю, а уж потом посылать сигнал."

#: src/iuse.cpp
#, c-format
msgid ""
"The %1$s in your %2$s would explode on this signal.  Place it down before "
"sending the signal."
msgstr ""
"%1$s в вашем %2$s взорвётся, если послать этот сигнал. Лучше положить на "
"землю, перед отправкой сигнала."

#: src/iuse.cpp
msgid "This vehicle's security system has locked you out!"
msgstr "Система безопасности автомобиля заперла вас!"

#: src/iuse.cpp
msgid "You trigger the alarm!"
msgstr "Вы активируете тревогу!"

#: src/iuse.cpp
msgid "You quickly bypass the security system!"
msgstr "Вы быстро обходите систему безопасности!"

