msgstr[1] "Свитка Побега"
msgstr[2] "Свитков Побега"
msgstr[3] "Свитки Побега"

#. ~ Description for {'str': 'Scroll of Escape', 'str_pl': 'Scrolls of
#. Escape'}
#. ~ Description for Escape
#: lang/json/GENERIC_from_json.py lang/json/SPELL_from_json.py
msgid ""
"Teleports you in a random direction a medium distance, to help escape your "
"foes in dangerous situations."
msgstr ""
"Телепортирует вас в случайном направлении на среднее расстояние, чтобы "
"помочь вам сбежать от противников в опасной ситуации."

#: lang/json/GENERIC_from_json.py
msgid "Scroll of Cat's Grace"
msgid_plural "Scrolls of Cat's Grace"
msgstr[0] "Свиток Кошачьей Грации"
msgstr[1] "Свитка Кошачьей Грации"
msgstr[2] "Свитков Кошачьей Грации"
msgstr[3] "Свитки Кошачьей Грации"

#. ~ Description for {'str': "Scroll of Cat's Grace", 'str_pl': "Scrolls of
#. Cat's Grace"}
