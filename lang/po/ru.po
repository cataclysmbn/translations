msgstr "ТЫ ТОЖЕ СЛЫШИШЬ ГОЛОСА?"

#. ~ Message for SPELL 'Artifact Teleglow'
#: lang/json/SPELL_from_json.py src/iuse.cpp
msgid "You feel unhinged."
msgstr "Вы расстроены."

