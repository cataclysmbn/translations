#: lang/json/TOOL_ARMOR_from_json.py
msgid "filter mask"
msgid_plural "filter masks"
msgstr[0] "респиратор"
msgstr[1] "респиратора"
msgstr[2] "респираторов"
msgstr[3] "респиратор"

#. ~ Description for filter mask
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"A mask that straps over your mouth and nose and filters air.  Protects from "
"smoke, dust, and other contaminants quite well.  It must be prepared before "
"use."
msgstr ""
"Респиратор. Хорошо защищает от пыли, дыма и других загрязнений. Он должен "
"быть подготовлен перед использованием."

#: lang/json/TOOL_ARMOR_from_json.py
