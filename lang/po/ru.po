msgstr[3] "Barrett M107A1"

#: lang/json/gun_from_json.py
msgid ""
"A large, shoulder-fired, .50 caliber anti-materiel rifle.  Its large size, "
"recoil, and noise is offset by its damage and range."
msgstr "Крупнокалиберная снайперская винтовка калибра .50. Её большие размеры, отдача и шум с лихвой перекрываются убойной силой и дальностью стрельбы."

#: lang/json/gun_from_json.py
