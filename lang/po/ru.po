#: lang/json/effects_from_json.py
msgid "Vaccinated"
msgstr "Вакцинирован"

#. ~ Description of effect 'Vaccinated'.
#: lang/json/effects_from_json.py
msgid "You have been vaccinated for the flu recently."
msgstr "Вы были недавно привиты от гриппа."

#: lang/json/effects_from_json.py
msgid "RX12 Healing Comedown"
msgstr "Спад эффекта лечения RX12"

#. ~ Description of effect 'RX12 Healing Comedown'.
#. ~ Description of effect 'Adrenaline Comedown'.
#: lang/json/effects_from_json.py
msgid "You feel completely drained."
msgstr "Вы чувствуете себя истощённым."

#: lang/json/effects_from_json.py
msgid "RX12 Healing Rush"
msgstr "Прилив эффекта лечения RX12"

#. ~ Description of effect 'RX12 Healing Rush'.
#: lang/json/effects_from_json.py
msgid "You feel the rush of stimulants in your body!"
msgstr "Вы чувствуете прилив сил от стимулятора!"

#. ~ Apply message for effect(s) 'RX12 Healing Comedown, RX12 Healing Rush'.
#: lang/json/effects_from_json.py
msgid "You feel a rush as the chemicals flow through your body!"
msgstr "Вы чувствуете, как химикаты текут внутри вашего тела!"

#. ~ Decay message for effect(s) 'RX12 Healing Comedown, RX12 Healing Rush'.
#: lang/json/effects_from_json.py
msgid "The jet injector's chemicals wear off.  You feel AWFUL!"
msgstr ""
"Действие эффекта введённых стимуляторов прекращается. Вы УЖАСНО себя "
"чувствуете!"

#: lang/json/effects_from_json.py
msgid "RX11 Stimulant Comedown"
msgstr "Спад эффекта стимулятора RX11"

#. ~ Description of effect 'RX11 Stimulant Comedown'.
#: lang/json/effects_from_json.py
msgid "You feel sluggish and slow."
msgstr "Вы чувствуете себя вялым и медлительным."

#: lang/json/effects_from_json.py
msgid "RX11 Stimulant Rush"
msgstr "Прилив эффекта стимулятора RX11"

#. ~ Description of effect 'RX11 Stimulant Rush'.
#: lang/json/effects_from_json.py
msgid "An intense surge of stimulants pulses through your body."
msgstr "Интенсивная волна стимуляторов проходит через ваше тело."

#. ~ Apply message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "You feel an intense surge of stimulants pulse through your body!"
msgstr ""
"Вы чувствуете, как интенсивная волна стимуляторов проходит через ваше тело!"

#. ~ Decay message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "The stimulant combo is wearing off.  You feel sluggish."
msgstr "Эффект стимуляторов заканчивается. Вы чувствуете себя вялым."

#: lang/json/effects_from_json.py
msgid "Adrenaline Comedown"
msgstr "Спад адреналина"

#: lang/json/effects_from_json.py
msgid "Adrenaline Rush"
msgstr "Выброс адреналина"

#. ~ Description of effect 'Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel the rush of adrenaline in your body!"
msgstr "Вы чувствуете прилив сил от адреналина!"

#. ~ Apply message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel a surge of adrenaline!"
msgstr "Вы ощущаете прилив адреналина!"

#. ~ Miss message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your comedown throws you off."
msgstr "Отходняк мешает вам целиться."

#. ~ Decay message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your adrenaline rush wears off.  You feel AWFUL!"
msgstr "Выброс адреналина прекратился. Вы УЖАСНО себя чувствуете!"

#: lang/json/effects_from_json.py
msgid "Mycus Respite"
msgstr "Передышка микус"

#. ~ Description of effect 'Mycus Respite'.
#: lang/json/effects_from_json.py
msgid ""
"Our fibers are stretched near breaking.  Local power diverted to regenerate."
msgstr ""
"Наши нити растянуты до предела. Местная энергия перенаправлена на "
"регенерацию."

#: lang/json/effects_from_json.py
msgid "Mycus Wrath"
msgstr "Ярость микус"

#. ~ Description of effect 'Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Our enemies are near, and violent action is imminent.  We are turgid."
msgstr "Наши враги рядом, жестокость неизбежна. Мы разбухаем."

#. ~ Apply message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Mycal wrath fills our fibers, and we grow turgid."
msgstr "Ярость микус наполняет наши нити. Мы разбухаем."

#. ~ Decay message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "We require repose; our fibers are nearly spent..."
msgstr "Нам требуется передышка; наши нити практически иссякли…"

#: lang/json/effects_from_json.py
msgid "Meth comedown"
msgstr "Отходняк от мета"

#: lang/json/effects_from_json.py
msgid "High on Meth"
msgstr "Под кайфом от мета"

#: lang/json/effects_from_json.py src/bionics.cpp
msgid "Nicotine"
msgstr "Никотин"

#: lang/json/effects_from_json.py
msgid "You had a puff or two."
msgstr "Вы сделали пару затяжек."

#: lang/json/effects_from_json.py
msgid "You smoked too much."
msgstr "Вы курили слишком много."

#: lang/json/effects_from_json.py
msgid "High"
msgstr "Кайф"

#. ~ Description of effect 'High'.
#: lang/json/effects_from_json.py
msgid "You are high as a kite."
msgstr "Вы под кайфом."

#. ~ Apply message for effect(s) 'High'.
#. ~ Apply message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#: lang/json/effects_from_json.py
msgid "You feel lightheaded."
msgstr "Вы чувствуете головокружение."

#: lang/json/effects_from_json.py
msgid ""
"That critter's jumping around like a jitterbug!  It needs to mellow out."
msgstr ""
"То существо дёргается вокруг как будто в нервном припадке! Это должно "
"пройти."

#: lang/json/effects_from_json.py
msgid "Contact Lenses"
msgstr "Контактные линзы"

#. ~ Description of effect 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You are wearing contact lenses."
msgstr "Вы носите контактные линзы."

#. ~ Apply message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You can see more clearly."
msgstr "У вас более ясное зрение."

#. ~ Remove message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "Your vision starts to blur."
msgstr "Ваше зрение расплывается."

#: lang/json/effects_from_json.py
msgid "Tipsy"
msgstr "Подвыпивший"

#. ~ Description of effect 'Tipsy'.
#: lang/json/effects_from_json.py
msgid "You drank some alcohol.  You feel warm inside."
msgstr "Вы выпили немного алкоголя и чувствуете теплоту внутри."

#: lang/json/effects_from_json.py
msgid "Drunk"
msgstr "Пьяный"

#. ~ Description of effect 'Drunk'.
#: lang/json/effects_from_json.py
msgid "You drank alcohol.  Party on!"
msgstr "Вы выпили алкоголь. Играй, гармонь!"

#: lang/json/effects_from_json.py
msgid "Trashed"
msgstr "Сильно пьяный"

#. ~ Description of effect 'Trashed'.
#: lang/json/effects_from_json.py
msgid "You drank lots of alcohol.  Are those white mice?"
msgstr "Вы выпили много алкоголя. Это что, белые мыши?"

#: lang/json/effects_from_json.py
msgid "Wasted"
msgstr "Пьяный вдрызг"

#. ~ Description of effect 'Wasted'.
#: lang/json/effects_from_json.py
msgid ""
"You drank unholy amounts of alcohol.  It's the end of the world, what do you"
" care?"
msgstr "Вы безбожно напились. Это же конец света, кому какое дело?"

#: lang/json/effects_from_json.py
msgid "Dead Drunk"
msgstr "Насмерть пьяный"

#. ~ Description of effect 'Dead Drunk'.
#: lang/json/effects_from_json.py
msgid ""
"You embalmed yourself alive with so much alcohol, that even zombies will "
"leave your dead body alone."
msgstr ""
"Вы настолько проспиртовались заживо, что даже зомби оставят в покое ваше "
"мёртвое тело."

#. ~ Miss message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#. ~ Miss message for effect(s) 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You feel woozy."
msgstr "Вы чувствуете себя пьяным."

#: lang/json/effects_from_json.py
msgid "You can't look away from the faultline..."
msgstr "Вы не можете отвести взгляд от разлома…"

#: lang/json/effects_from_json.py
msgid "Feared"
msgstr "Испуганный"

#. ~ Description of effect 'Feared'.
#: lang/json/effects_from_json.py
msgid "You have been paralyzed by the fear."
msgstr "Вы парализованы страхом."

#: lang/json/effects_from_json.py
msgid "Asthma"
msgstr "Астма"

#: lang/json/effects_from_json.py
msgid "Heavy Asthma"
msgstr "Тяжёлая астма"

#: lang/json/effects_from_json.py
msgid ""
"You suffer from a respiratory disorder that makes breathing difficult.\n"
"An asthma attack can occur from time to time, so have your inhaler nearby."
msgstr ""
"Вы страдаете от респираторного расстройства, из-за которого тяжело дышать.\n"
"Время от времени могут случаться приступы, так что держите ингалятор под рукой."

#. ~ Apply message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy
#. Asthma, Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You can't breathe… asthma attack!"
msgstr "Не вдохнуть… Приступ астмы!"

#. ~ Miss message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy Asthma,
#. Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You're winded."
msgstr "Вам скучно."

#: lang/json/effects_from_json.py
msgid "The ceiling collapses on you!"
msgstr "На вас обрушился потолок!"

#: lang/json/effects_from_json.py
msgid "Took anticonvulsant drugs"
msgstr "Принятое противосудорожное"

#. ~ Description of effect 'Took anticonvulsant drugs'.
#: lang/json/effects_from_json.py
msgid ""
"You took anticonvulsant drugs some time ago and you might still be under its influence.\n"
"Prescription note says its effect duration may vary, so your estimate may be inaccurate."
msgstr ""
"Некоторое время назад вы приняли противосудорожное средство и до сих пор можете быть под его влиянием.\n"
"В инструкции говорится, что длительность эффекта может быть различной, поэтому ваши подсчёты могут быть неточными."

#: lang/json/effects_from_json.py
msgid "Relaxation gas"
msgstr "Расслабляющий газ"

#. ~ Description of effect 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid ""
"You are thoroughly relaxed and don't feel like moving.  Fighting?  Too much "
"effort."
msgstr ""
"Вы слишком расслаблены и не хотите двигаться. Бой? Слишком много усилий."

#. ~ Apply message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "You inhale sweetish gas."
msgstr "Вы вдыхаете сладковатый газ."

#. ~ Remove message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "The slackness leaves your muscles."
msgstr "Вялость уходит из ваших мышц."

#: lang/json/effects_from_json.py
msgid "Experiencing Datura"
msgstr "Под влиянием дурмана"

#. ~ Description of effect 'Experiencing Datura'.
#: lang/json/effects_from_json.py
msgid "Buy the ticket, take the ride.  The datura has you now."
msgstr "Ну, была не была. Теперь вы во власти дурмана."

#: lang/json/effects_from_json.py
msgid "Grabbed"
msgstr "Схвачен"

#. ~ Description of effect 'Grabbed'.
#: lang/json/effects_from_json.py
msgid ""
"You have been grabbed by an attack.\n"
"You are being held in place, and dodging and blocking are very difficult."
msgstr ""
"Вас схватили во время атаки.\n"
"Вы задержаны на месте, а уклоняться и блокировать удары очень тяжело."

#: lang/json/effects_from_json.py
msgid "Grabbing"
msgstr "Захват"

#. ~ Description of effect 'Grabbing'.
#: lang/json/effects_from_json.py
msgid "Grabbing another creature and holding them in place."
msgstr "Захват и удержание другого существа."

#: lang/json/effects_from_json.py
msgid "Lacking Sleep"
msgstr "Недостаток сна"

#. ~ Description of effect 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You haven't slept in a while, and it shows."
msgstr "Вы уже довольно долго не спали, и это заметно."

#. ~ Apply message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You are too physically tired to function well."
msgstr "Вы слишком устали физически для нормального функционирования."

#. ~ Miss message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You don't have energy to fight."
msgstr "У вас нет энергии драться."

#: lang/json/effects_from_json.py
msgid "You lie down to go to sleep..."
msgstr "Вы ложитесь спать…"

#: lang/json/effects_from_json.py src/mutation_data.cpp
msgid "You fall asleep."
msgstr "Вы засыпаете."

#: lang/json/effects_from_json.py
msgid "You wake up."
msgstr "Вы просыпаетесь."

#: lang/json/effects_from_json.py
msgid "Under operation"
msgstr "Под операцией"

#. ~ Description of effect 'Under operation'.
#: lang/json/effects_from_json.py
msgid "You are being operated on.  Try to stay still."
msgstr "Вас сейчас оперируют. Постарайтесь лежать спокойно."

#: lang/json/effects_from_json.py
msgid "Playing an instrument"
msgstr "Игра на инструменте"

#. ~ Description of effect 'Playing an instrument'.
#: lang/json/effects_from_json.py
msgid ""
"You're playing an instrument.\n"
"Focusing on playing music distracts you, slowing you down."
msgstr ""
"Вы играете на инструменте.\n"
"Сосредоточение на игре отвлекает и замедляет вас."

#: lang/json/effects_from_json.py
msgid "Corroding"
msgstr "Разъедание"

#. ~ Description of effect 'Corroding'.
#. ~ Apply message for effect(s) 'Corroding'.
#: lang/json/effects_from_json.py
msgid "You're covered in acid!"
msgstr "Вы покрыты кислотой!"

#: lang/json/effects_from_json.py
msgid "Zapped"
msgstr "Удар током"

#. ~ Description of effect 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You've been zapped with electricity and are barely able to move!"
msgstr "Вас ударило током, и вы едва можете передвигаться!"

#. ~ Apply message for effect(s) 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You're zapped!"
msgstr "Вас ударило током!"

#: lang/json/effects_from_json.py
msgid "Hypocalcemia"
msgstr "Гипокальциемия"

#: lang/json/effects_from_json.py
msgid "Weak bones"
msgstr "Слабые кости"

#: lang/json/effects_from_json.py
msgid "Brittle bones"
msgstr "Хрупкие кости"

#: lang/json/effects_from_json.py
msgid ""
"A lack of calcium in your diet will make your bones progressively weaker."
msgstr "Дефицит кальция в вашем организме делает ваши кости слабыми."

#. ~ Apply message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones are becoming more brittle."
msgstr "Ваши кости становятся хрупкими."

#. ~ Remove message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones regain their usual strength."
msgstr "Ваши кости обрели обычную прочность."

#. ~ Decay message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your calcium deficiency is nearly resolved."
msgstr "Кальций в организме приходит в норму."

#. ~ Decay message for effect(s) 'Hypocalcemia, Weak bones, Brittle bones'.
#: lang/json/effects_from_json.py
msgid "Your bones become stronger as your calcium deficiency improves."
msgstr ""
"Ваши кости становятся сильнее, поскольку кальций в организме приходит в "
"норму."

#: lang/json/effects_from_json.py
msgid "Iron deficiency"
msgstr "Дефицит железа"

#: lang/json/effects_from_json.py
msgid "Early anemia"
msgstr "Ранняя анемия"

#: lang/json/effects_from_json.py
msgid "Anemia"
msgstr "Анемия"

#: lang/json/effects_from_json.py
msgid ""
"A lack of iron in your diet will result in progressively worsening anemia."
msgstr ""
"Дефицит железа в вашей диете привёдет к постоянно усиливающейся анемии."

#. ~ Apply message for effect(s) 'Iron deficiency, Early anemia, Anemia'.
#: lang/json/effects_from_json.py
msgid "You begin feeling increasingly tired and listless."
msgstr "Вы начинаете чувствовать себя всё более усталым и апатичным."

#. ~ Remove message for effect(s) 'Iron deficiency, Early anemia, Anemia'.
#: lang/json/effects_from_json.py
msgid "You no longer feel anemic."
msgstr "Вы больше не страдаете от анемии."

#. ~ Decay message for effect(s) 'Iron deficiency, Early anemia, Anemia'.
#: lang/json/effects_from_json.py
msgid "Your iron deficiency is nearly resolved."
msgstr "Дефицит железа практически устранён."

#. ~ Decay message for effect(s) 'Iron deficiency, Early anemia, Anemia'.
#: lang/json/effects_from_json.py
msgid "Your feel stronger as your anemia starts to improve."
msgstr "Вы чувствуете себя сильнее, поскольку анемия идёт на убыль."

#: lang/json/effects_from_json.py
msgid "VitA deficiency"
msgstr "Дефицит витамина А"

#: lang/json/effects_from_json.py
msgid "Poor vision"
msgstr "Плохое зрение"

#: lang/json/effects_from_json.py
msgid "Night blindness"
msgstr "Ночная слепота"

#: lang/json/effects_from_json.py
msgid ""
"A lack of vitamin A in your diet will progressively worsen your vision."
msgstr ""
"Дефицит витамина А в вашей диете приведёт к постоянному ухудшению зрения."

#. ~ Apply message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "You start struggling to make out the finer details."
msgstr "Вы начинаете с трудом разбирать мелкие детали."

#. ~ Remove message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your normal visual acuity returns."
msgstr "К вам вернулась обычная острота зрения."

#. ~ Decay message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your vitamin A deficiency is nearly resolved."
msgstr "Дефицит витамина А практически устранён."

#. ~ Decay message for effect(s) 'VitA deficiency, Poor vision, Night
#. blindness'.
#: lang/json/effects_from_json.py
msgid "Your vision improves as your Vitamin A deficiency improves."
msgstr ""
"Ваше зрение приходит в норму, поскольку дефицит витамина А идёт на убыль."

#: lang/json/effects_from_json.py
msgid "B12 deficiency"
msgstr "Дефицит В12"

#: lang/json/effects_from_json.py
msgid "Slow healing"
msgstr "Медленное лечение"

#: lang/json/effects_from_json.py
msgid "No healing"
msgstr "Нет лечения"

#: lang/json/effects_from_json.py
msgid "A lack of vitamin B12 in your diet will affect your ability to heal."
msgstr ""
"Дефицит витамина В12 в вашей диете повлияет на вашу способность к заживлению"
" ран."

#. ~ Apply message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Simple wounds are starting to concern you more than usual."
msgstr "Простые раны начинают беспокоить вас больше обычного."

#. ~ Remove message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your wounds now heal normally."
msgstr "Ваши раны будут заживать как обычно."

#. ~ Decay message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your vitamin B12 deficiency is starting to resolve."
msgstr "Дефицит витамина В12 начинает устраняться."

#. ~ Decay message for effect(s) 'B12 deficiency, Slow healing, No healing'.
#: lang/json/effects_from_json.py
msgid "Your ability to heal returns as your Vitamin B12 deficiency improves."
msgstr ""
"Ваша способность к заживлению ран возвращается в норму, поскольку дефицит "
"витамина В12 идёт на убыль."

#: lang/json/effects_from_json.py
msgid "Early scurvy"
msgstr "Ранняя цинга"

#: lang/json/effects_from_json.py
msgid "Scurvy"
msgstr "Цинга"

#: lang/json/effects_from_json.py
msgid "Bad Scurvy"
msgstr "Сильная цинга"

#: lang/json/effects_from_json.py
msgid ""
"A lack of vitamin C in your diet will result in progressively worse symptoms"
" of scurvy."
msgstr ""
"Дефицит витамина С в вашей диете приведёт к прогрессирующим симптомам цинги."

#. ~ Apply message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "You start to develop symptoms of scurvy."
msgstr "У вас начала развиваться цинга."

#. ~ Remove message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy has resolved."
msgstr "Вы излечились от цинги."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your vitamin C deficiency is starting to resolve."
msgstr "Дефицит витамина С начинает устраняться."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy lessens as your Vitamin C deficiency improves."
msgstr "Цинга начинает проходить, поскольку дефицит витамина С идёт на убыль."

#: lang/json/effects_from_json.py
msgid "Hypervitaminosis"
msgstr "Гипервитаминоз"

#. ~ Description of effect 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "An excess of vitamins has badly affected your metabolism."
msgstr "Избыток витаминов очень плохо повлиял на ваш метаболизм."

#. ~ Apply message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes unstable."
msgstr "Ваш метаболизм стал нестабильным."

#. ~ Remove message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes more stable."
msgstr "Ваш метаболизм стал более стабильным."

#: lang/json/effects_from_json.py
msgid "Concerning symptoms"
msgstr "Беспокоящие симптомы"

#. ~ Description of effect 'Concerning symptoms'.
#: lang/json/effects_from_json.py
msgid "Your muscles keep twitching strangely."
msgstr "Ваши мышцы продолжают спазмировать."

#: lang/json/effects_from_json.py
msgid "Unnerving symptoms"
msgstr "Тревожные симптомы"

#. ~ Description of effect 'Unnerving symptoms'.
#: lang/json/effects_from_json.py
msgid ""
"Your nervous system is malfunctioning, almost like it's being torn apart "
"from the inside."
msgstr ""
"Ваша нервная система работает со сбоями, почти как будто она разрывается "
"изнутри."

#: lang/json/effects_from_json.py
msgid "Gross food"
msgstr "Ужасная еда"

#. ~ Description of effect 'Gross food'.
#: lang/json/effects_from_json.py
msgid "The food you eat is disgusting."
msgstr "Еда, которую вы едите, отвратительна."

#: lang/json/effects_from_json.py
msgid "Demoralizing food"
msgstr "Унылая еда"

#. ~ Description of effect 'Demoralizing food'.
#: lang/json/effects_from_json.py
msgid "Eating nothing but disgusting rations is starting to get you down."
msgstr "Питание ничем другим, кроме отвратительной пищи, вас расстраивает."

#: lang/json/effects_from_json.py
msgid "Depressing food"
msgstr "Депрессивная еда"

#. ~ Description of effect 'Depressing food'.
#: lang/json/effects_from_json.py
msgid ""
"Sure, you survived, but what kind of survival is this, eating these "
"disgusting rations day in and day out?"
msgstr ""
"Конечно, вы живы, но разве это жизнь — есть отвратительную пищу изо дня в "
"день?"

#: lang/json/effects_from_json.py
msgid "Lit up"
msgstr "Освещён"

#. ~ Description of effect 'Lit up'.
#: lang/json/effects_from_json.py
msgid "You are carrying a light and can't hide well."
msgstr "Вы несёте источник света и поэтому не можете спрятаться."

#: lang/json/effects_from_json.py
msgid "Started recovery"
msgstr "Началось восстановление"

#: lang/json/effects_from_json.py
msgid "Recovering"
msgstr "Восстановление"

#: lang/json/effects_from_json.py
msgid "Mostly recovered"
msgstr "Заживает"

#: lang/json/effects_from_json.py
msgid "This damaged limb is slowly regaining its functions."
msgstr "Повреждённая конечность медленно восстанавливает свои функции."

#: lang/json/effects_from_json.py
msgctxt "physically"
msgid "Disabled"
msgstr "Отключено"

#. ~ Description of effect '{'ctxt': 'physically', 'str': 'Disabled'}'.
#: lang/json/effects_from_json.py
msgid "This limb is damaged beyond use and may require a splint to recover."
msgstr ""
"Конечность сильно повреждена, для её восстановления может потребоваться "
"шина."

#. ~ Apply message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py lang/json/snippet_from_json.py
msgid "Your limb breaks!"
msgstr "Ваша конечность ломается!"

#. ~ Remove message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py
msgid "The broken limb has mended."
msgstr "Сломанная конечность восстановилась."

#: lang/json/effects_from_json.py
msgid "Milked"
msgstr "Подоено"

#. ~ Description of effect 'Milked'.
#: lang/json/effects_from_json.py
msgid "The creature has been partially or fully milked."
msgstr "Это существо было частично или полностью подоено."

#: lang/json/effects_from_json.py
msgid "Painkillers"
msgstr "Болеутоляющие"

#. ~ Description of effect 'Painkillers'.
#: lang/json/effects_from_json.py
msgid ""
"You are under the influence of analgesic substances to relieve pain, but "
"they may numb you a bit."
msgstr ""
"Вы находитесь под действием анальгетических веществ, купирующих боль. Они "
"также могут вызвать небольшое онемение."

#: lang/json/effects_from_json.py
msgid "Happy"
msgstr "Счастлив"

#. ~ Description of effect 'Happy'.
#: lang/json/effects_from_json.py
msgid "Life is good."
msgstr "Жизнь хороша."

#: lang/json/effects_from_json.py
msgid "Joyful"
msgstr "Радостный"

#. ~ Description of effect 'Joyful'.
#: lang/json/effects_from_json.py
msgid "Oh what a day!  What a lovely day!"
msgstr "Жить, как говорится, хорошо!"

#: lang/json/effects_from_json.py
msgid "Elated"
msgstr "Восторг"

#. ~ Description of effect 'Elated'.
#: lang/json/effects_from_json.py
msgid "I'm on top of the world, baby!"
msgstr "Я летаю, я в раю!"

#: lang/json/effects_from_json.py
msgid "Unhappy"
msgstr "Несчастлив"

#. ~ Description of effect 'Unhappy'.
#: lang/json/effects_from_json.py
msgid "You are not content with your life."
msgstr "Вы недовольны жизнью."

#: lang/json/effects_from_json.py
msgid "Sad"
msgstr "Грустный"

#. ~ Description of effect 'Sad'.
#: lang/json/effects_from_json.py
msgid "This is not what you planned for your life."
msgstr "Вы не так планировали провести свою жизнь."

#: lang/json/effects_from_json.py
msgid "Depressed"
msgstr "Подавленный"

#. ~ Description of effect 'Depressed'.
#: lang/json/effects_from_json.py
msgid "When will all your suffering end?"
msgstr "Когда уже закончатся эти страдания?"

#. ~ Miss message for effect(s) 'Unhappy, Unhappy, Unhappy, Unhappy, Unhappy,
#. Sad, Sad, Sad, Sad, Sad, Depressed'.
#: lang/json/effects_from_json.py
msgid "What's the point of fighting?"
msgstr "Какой смысл бороться?"

#: lang/json/effects_from_json.py src/bionics.cpp
msgid "Irradiated"
msgstr "Облучённый"

#. ~ Description of effect 'Irradiated'.
#: lang/json/effects_from_json.py
msgid "You suffer symptoms of a radiation sickness that weakens your body."
msgstr "Вы страдаете от лучевой болезни, ослабляющей ваше тело."

#. ~ Miss message for effect(s) 'Irradiated'.
#: lang/json/effects_from_json.py
msgid "Radiation weakens you."
msgstr "Радиация ослабляет вас."

#: lang/json/effects_from_json.py
msgid "Stimulants"
msgstr "Стимуляторы"

#. ~ Description of effect 'Stimulants'.
#: lang/json/effects_from_json.py
msgid "You're very jittery and pumped up, probably from some stimulants."
msgstr ""
"Вас всего трясёт, вы как будто на иголках, возможно, из-за стимуляторов."

#: lang/json/effects_from_json.py
msgid "Depressants"
msgstr "Депрессанты"

#. ~ Description of effect 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You are under the influence of depressants, and in a bit of a daze."
msgstr "Вы находитесь под действием депрессантов, как будто в прострации."

#: lang/json/effects_from_json.py
msgid "Stimulant Overdose"
msgstr "Передозировка стимуляторов"

#. ~ Description of effect 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid ""
"You can't sit still as you feel your heart pounding out of your chest.  You "
"probably overdosed on those stims."
msgstr ""
"Ваше сердце готово выпрыгнуть из груди. Не стоило перебарщивать со "
"стимуляторами."

#. ~ Miss message for effect(s) 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid "You shake with the excess stimulation."
msgstr "Вас трясёт от избытка стимуляторов."

#: lang/json/effects_from_json.py
msgid "Took weak antibiotic"
msgstr "Принятый слабый антибиотик"

#. ~ Description of effect 'Took weak antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed mild antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Некоторое время назад вы приняли слабый антибиотик для борьбы с инфекцией.\n"
"Если вы чувствуете, что излечение всё не наступает, вы можете принять ещё одну дозу, но остерегайтесь передозировки."

#: lang/json/effects_from_json.py
msgid "Took antibiotic"
msgstr "Принятый антибиотик"

#. ~ Description of effect 'Took antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Некоторое время назад вы приняли антибиотик для борьбы с инфекцией.\n"
"Если вы чувствуете, что излечение всё не наступает, вы можете принять ещё одну дозу, но остерегайтесь передозировки."

#: lang/json/effects_from_json.py
msgid "Took strong antibiotic"
msgstr "Принятый сильный антибиотик"

#. ~ Description of effect 'Took strong antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed prescription-grade antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Некоторое время назад вы приняли сильный антибиотик для борьбы с инфекцией.\n"
"Если вы чувствуете, что излечение всё не наступает, вы можете принять ещё одну дозу, но остерегайтесь передозировки."

#: lang/json/effects_from_json.py
msgid "Panacea"
msgstr "панацея"

#. ~ Description of effect 'Panacea'.
#: lang/json/effects_from_json.py
msgid "You feel incredible! You could take on the world!"
msgstr "Вы чувствуете себя невероятно! Вы можете покорить мир!"

#: lang/json/effects_from_json.py
msgid "Soothed stomach"
msgstr "Успокоенный желудок"

#. ~ Description of effect 'Soothed stomach'.
#: lang/json/effects_from_json.py
msgid "You are under the effects of a stomach soother."
msgstr "Вы приняли средство от изжоги."

#: lang/json/effects_from_json.py
msgid "Discharge"
msgstr "Разряд"

#. ~ Description of effect 'Discharge'.
#: lang/json/effects_from_json.py
msgid "You've been recently affected by an electromagnetic pulse."
msgstr "Вы попали под влияние электромагнитного импульса."

#: lang/json/effects_from_json.py
msgid "Supercharged"
msgstr "Сверхзаряд"

#. ~ Description of effect 'Supercharged'.
#: lang/json/effects_from_json.py
msgid "You've been struck by lightning, and feel… different."
msgstr "В вас ударила молния, и теперь вы чувствуете себя… Другим."

#: lang/json/effects_from_json.py
msgid "Grown of Fusion"
msgstr "Рост в Слиянии"

#. ~ Description of effect 'Grown of Fusion'.
#: lang/json/effects_from_json.py
msgid ""
"AI effect to increase stats after fusing with another critter. 1 stack means"
" one absorbed max_hp."
msgstr ""
"Эффект для ИИ для увеличения характеристики при слиянии с другим существом. "
"Один стек обозначает одно поглощение max_hp."

#: lang/json/effects_from_json.py
msgid "Stinking air"
msgstr "Зловонный воздух"

#. ~ Description of effect 'Stinking air'.
#: lang/json/effects_from_json.py
msgid "The air in here smells like vinegar and mold."
msgstr "Воздух здесь неприятно пахнет кислой плесенью."

#: lang/json/effects_from_json.py
msgid "Disorienting air"
msgstr "Дезориентирующий воздух"

#. ~ Description of effect 'Disorienting air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It makes you feel soft-headed"
" and confused."
msgstr ""
"Воздух здесь пахнет кислой плесенью. От него у вас кружится голова и вы "
"дезориентированы."

#: lang/json/effects_from_json.py
msgid "Smothering air"
msgstr "Удушающий воздух"

#. ~ Description of effect 'Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It is closing in and "
"smothering you, making it impossible to think clearly."
msgstr ""
"Воздух здесь пахнет кислой плесенью. Он наполняет и душит вас, не оставляя "
"шанса мыслить трезво."

#. ~ Apply message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold, and hurts your lungs a bit."
msgstr ""
"Воздух здесь пахнет кислой плесенью, от него немного побаливают легкие."

#. ~ Miss message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid "You feel groggy in this sweltering, foul air."
msgstr "Вы чувствуете слабость в этом душном грязном воздухе."

#: lang/json/effects_from_json.py
msgid "Covered in fetid goop"
msgstr "Покрыт зловонной жижей"

#. ~ Description of effect 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid ""
"The feeling of the goop slowly sliding on your skin revulses you and the "
"smell makes you gag."
msgstr ""
"Ощущение жижи, медленно стекающей по коже, заставляет вас содрогаться, а от "
"запаха тошнит."

#. ~ Apply message for effect(s) 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid "You're disgusted by the goop."
msgstr "Жижа вызывает у вас отвращение."

#: lang/json/effects_from_json.py
msgid "Magnesium Supplements"
msgstr "препарат магния"

#. ~ Description of effect 'Magnesium Supplements'.
#: lang/json/effects_from_json.py
msgid ""
"You took some magnesium supplements.  These will help with sleep "
"deprivation."
msgstr ""
"Вы приняли препарат магния. Эти таблетки помогают справиться с недостатком "
"сна."

#: lang/json/effects_from_json.py
msgid "Religious Offense"
msgstr "Религиозное Оскорбление"

#. ~ Description of effect 'Religious Offense'.
#: lang/json/effects_from_json.py
msgid ""
"AI tag used when you offended an NPC with a specific conversation option.  "
"This is a bug if you have it."
msgstr ""
"Тэг ИИ, когда вы оскорбили NPC определённой опцией в диалоге. Если вы видите"
" это у себя — это баг."

#: lang/json/effects_from_json.py src/character.cpp src/player.cpp
msgid "Full"
msgstr "Сытый"

#. ~ Description of effect 'Full'.
#: lang/json/effects_from_json.py
msgid "This beggar in the refugee center has had something to eat recently."
msgstr "Этот нищий в центре беженцев недавно поел."

#: lang/json/effects_from_json.py
msgid "Insulted"
msgstr "Оскорблён"

#. ~ Description of effect 'Insulted'.
#: lang/json/effects_from_json.py
msgid "Oh, you went there."
msgstr "О, дошло и до этого."

#. ~ Description of effect 'Mana Fatigue'.
#: lang/json/effects_from_json.py
msgid "You are exhausted from channeling a lot of mana."
msgstr "Вы истощены большим объемом направленной маны."

#. ~ Apply message for effect(s) 'Mana Fatigue'.
#: lang/json/effects_from_json.py
