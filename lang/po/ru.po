msgid_plural "EMP hacks"
msgstr[0] "дрон ЭМИ-граната"
msgstr[1] "дрона ЭМИ-гранаты"
msgstr[2] "дронов ЭМИ-гранат"
msgstr[3] "дроны ЭМИ-гранаты"

#. ~ Description for {'str': 'EMP hack'}
#: lang/json/MONSTER_from_json.py
msgid ""
"An automated kamikaze drone, this small quadcopter robot appears to have an "
"EMP grenade inside."
msgstr ""
"Автоматический дрон-камикадзе. Небольшой квадрокоптер, по-видимому с ЭМИ-"
"гранатой внутри."

#: lang/json/MONSTER_from_json.py
