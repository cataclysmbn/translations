#: lang/json/recipe_from_json.py
msgid "We should survey the base site and set up a bulletin board."
msgstr "Нам нужно обследовать место под базу и установить доску объявлений."

#: lang/json/recipe_from_json.py
msgid "basic survey"
msgstr "первичная разведка"

#: lang/json/recipe_from_json.py
msgid "We should survey the roof top and set up a bulletin board."
msgstr "Нам нужно обследовать крышу и установить доску объявлений."

#: lang/json/recipe_from_json.py
msgid ""
"Now that we have some cover, we should build a fireplace in the northeast "
"shack."
msgstr ""
"Теперь у нас есть укрытие, и нам нужно поставить камин в северовосточной "
"хижине."

#: lang/json/recipe_from_json.py
msgid "northeast fireplace"
msgstr "северо-восточный камин"

#: lang/json/recipe_from_json.py
msgid ""
"Now that we have some cover, we should set up a brazier in the northeast "
"shack."
msgstr ""
"Теперь у нас есть укрытие, и нам нужно поставить жаровню в северовосточной "
"хижине."

#: lang/json/recipe_from_json.py
msgid "northeast brazier"
msgstr "северо-восточный мангал"

#: lang/json/recipe_from_json.py
msgid ""
"Now that we have some cover, we should build a stove in the northeast shack."
msgstr ""
"Теперь у нас есть укрытие, и нам нужно поставить печку в северовосточной "
"хижине."

#: lang/json/recipe_from_json.py
msgid "northeast stove"
msgstr "северо-восточная печка"

#: lang/json/recipe_from_json.py
msgid "A straw bed in the northeast shack will make sleeping easier."
msgstr "На соломенной кровати в северовосточной хижине будет легче уснуть."

#: lang/json/recipe_from_json.py
msgid "northeast straw bed"
msgstr "северо-восточная соломенная кровать"

