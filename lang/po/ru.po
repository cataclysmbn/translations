msgstr "Этот предмет можно использовать для общения посредством радиоволн."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"This piece of clothing is designed to keep you <info>dry</info> in the rain."
msgstr ""
"Этот предмет одежды помогает вам остаться <info>сухим</info> во время дождя."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
