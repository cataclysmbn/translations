msgstr[0] "Свиток Инеевого Взрыва"
msgstr[1] "Свитка Инеевого Взрыва"
msgstr[2] "Свитков Инеевого Взрыва"
msgstr[3] "Свитки Инеевого Взрыва"

#. ~ Description for {'str': 'Scroll of Hoary Blast', 'str_pl': 'Scrolls of
#. Hoary Blast'}
