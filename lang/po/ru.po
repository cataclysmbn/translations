#. ~ 'open' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The bolts fall open!"
msgstr "Болты выпущены!"

#. ~ 'pull' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "You activate the security bolt release..."
msgstr "Вы активировали болты обеспечения безопасности…"

#. ~ 'close' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The bridge extends."
msgstr "Мост вытянут."

#. ~ 'fail' action message of some gate object.
#: lang/json/gates_from_json.py
msgid "The bridge can't be extended!"
msgstr "Мост нельзя вытянуть!"

#. ~ 'open' action message of some gate object.
