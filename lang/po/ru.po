msgstr[1] "золотых скрипки"
msgstr[2] "золотых скрипок"
msgstr[3] "золотая скрипка"

#. ~ Description for {'str': 'golden fiddle', 'str_pl': 'golden fiddles'}
#: lang/json/TOOL_from_json.py
