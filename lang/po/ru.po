msgstr[3] "начос с мясом"

#. ~ Description for nachos with meat
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Salted corn chips, now with meat.  Could probably use some cheese, though."
msgstr "Солёные чипсы из кукурузы, теперь с мясом! Можно добавить немного сыра."

#: lang/json/COMESTIBLE_from_json.py
msgid "niño nachos"
msgid_plural "niño nachos"
msgstr[0] "начос Нино"
msgstr[1] "начос Нино"
msgstr[2] "начос Нино"
msgstr[3] "начос Нино"

#. ~ Description for niño nachos
#: lang/json/COMESTIBLE_from_json.py
