"ближнем бою или стукнуть кого-нибудь."

#: lang/json/GENERIC_from_json.py
msgid "Scroll of Frost Armor"
msgid_plural "Scrolls of Frost Armor"
msgstr[0] "Свиток Ледяной Брони"
msgstr[1] "Свитка Ледяной Брони"
msgstr[2] "Свитков Ледяной Брони"
msgstr[3] "Свитки Ледяной Брони"

#. ~ Description for {'str': 'Scroll of Frost Armor', 'str_pl': 'Scrolls of
