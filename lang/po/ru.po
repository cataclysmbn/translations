msgid "Spontaneous teleport."
msgstr "Спонтанно телепортируется."

#: src/player_hardcoded_effects.cpp
msgctxt "memorial_female"
msgid "Spontaneous teleport."
msgstr "Спонтанно телепортируется."

#: src/player_hardcoded_effects.cpp
