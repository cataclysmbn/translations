msgstr "Не вступай в бой, если твоей жизни не угрожает опасность."

#: lang/json/talk_topic_from_json.py
msgid "Attack enemies that get too close."
msgstr "Нападай на врагов, которые подобрались слишком близко."

#: lang/json/talk_topic_from_json.py
