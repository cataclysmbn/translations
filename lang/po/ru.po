msgstr[1] "бейсбольных биты"
msgstr[2] "бейсбольных бит"
msgstr[3] "бейсбольная бита"

#. ~ Description for baseball bat
#: lang/json/GENERIC_from_json.py
msgid "A sturdy wood bat.  Makes a great melee weapon."
msgstr "Прочная деревянная бита. Великолепное оружие ближнего боя."

#: lang/json/GENERIC_from_json.py
msgid "aluminum bat"
msgid_plural "aluminum bats"
msgstr[0] "алюминиевая бита"
msgstr[1] "алюминиевых биты"
msgstr[2] "алюминиевых бит"
msgstr[3] "алюминиевая бита"

#. ~ Description for aluminum bat
#: lang/json/GENERIC_from_json.py
msgid ""
"An aluminum baseball bat, lighter than a wooden bat and a little easier to "
"swing as a result."
msgstr ""
"Алюминиевая бейсбольная бита. Легче чем деревянная и, как следствие, ей "
"легче махать."

#: lang/json/GENERIC_from_json.py
