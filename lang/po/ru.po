#. ~ Description for scabbard
#: lang/json/ARMOR_from_json.py
msgid ""
"A large, adjustable sheath for holding swords and other large blades.  "
"Activate to sheathe/draw a weapon."
msgstr ""
"Большие регулируемые ножны для ношения мечей и других больших клинков. "
"Активируйте, чтобы вложить/достать оружие."

#: lang/json/ARMOR_from_json.py
msgid "sheath"
msgid_plural "sheathes"
msgstr[0] "ножны"
msgstr[1] "ножен"
msgstr[2] "ножен"
msgstr[3] "ножны"

#. ~ Description for sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather sheath for holding knives and other small blades.  It is easy to "
"use without much practice.  Activate to sheathe/draw a weapon."
msgstr ""
"Кожаные ножны для ножей и других маленьких клинков. Активируйте, чтобы "
"вложить/достать оружие."

#: lang/json/ARMOR_from_json.py
msgid "spear strap"
msgid_plural "spear straps"
msgstr[0] "перевязь для копья"
msgstr[1] "перевязи для копья"
msgstr[2] "перевязей для копья"
