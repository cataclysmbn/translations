msgstr[2] "комбинезонов"
msgstr[3] "комбинезон"

#. ~ Description for jumpsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved jumpsuit; similar to those worn by prisoners.  "
"Provides decent storage and is not very encumbering."
msgstr ""
"Тонкий комбинезон с длинными рукавами, похож на те, которые носят "
"заключённые. Даёт достаточно места для хранения и не сильно стесняет "
"движения."

#: lang/json/ARMOR_from_json.py
