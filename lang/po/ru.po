msgid_plural "Hub 01 jumpsuits"
msgstr[0] "комбинезон Центра 01"
msgstr[1] "комбинезона Центра 01"
msgstr[2] "комбинезонов Центра 01"
msgstr[3] "комбинезоны Центра 01"

#. ~ Description for Hub 01 jumpsuit
#: lang/json/ARMOR_from_json.py
msgid "A brown jumpsuit worn by the staff of Hub 01."
msgstr "Коричневый комбинезон, который носит персонал Центра 01."

#: lang/json/ARMOR_from_json.py
