#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart but you dodge it."
msgstr "%s выстрелил в вас дротиком, но вы уворачиваетесь от него!"

#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart into you!"
msgstr "%s выстрелил в вас дротиком!"

#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart at you, but misses!"
msgstr "%s выстреливает в вас дротиком, но промахивается!"

#: src/monattack.cpp
#, c-format
msgid "The %s shoots a dart but it bounces off your armor."
msgstr "%s выстрелил в вас дротиком, но он отскакивает от вашей брони!"

#: src/monattack.cpp
#, c-format
msgid "The %1$s feeds an %2$s and it grows!"
msgstr "%1$s съедает %2$s и растёт!"

#: src/monattack.cpp
#, c-format
msgid "The %s lays an egg!"
msgstr "%s откладывает яйцо!"

#: src/monattack.cpp
#, c-format
msgid "The %s tends nearby eggs, and they hatch!"
msgstr "%s обрабатывает яйца, и они вылупляются!"

#: src/monattack.cpp
msgid "a terrible shriek!"
msgstr "ужасающий крик!"

#: src/monattack.cpp
#, c-format
msgid "The %s begins shrieking!"
msgstr "%s начинает визжать!"

#: src/monattack.cpp
msgid "a piercing wail!"
