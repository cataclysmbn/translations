msgstr "Помогает запустить двигатель в условиях низких температур."

#: lang/json/fault_from_json.py
msgid "immobiliser"
msgstr "иммобилайзер"

#. ~ Description for immobiliser
#: lang/json/fault_from_json.py
msgid "Prevents starting of the vehicle without the appropriate key."
msgstr "Не даёт завести двигатель машины без правильного ключа."

#: lang/json/fault_from_json.py lang/json/terrain_from_json.py
msgid "diesel pump"
msgstr "дизельная колонка"

#. ~ Description for diesel pump
#: lang/json/fault_from_json.py
msgid "Required to pump and pressurise diesel from a vehicles tank."
msgstr "Требуется для подкачки дизеля из топливного бака автомобиля и нагнетания давления."

#. ~ Description for air filter
#: lang/json/fault_from_json.py
msgid ""
"An expired filter reduces fuel efficiency and increases smoke production."
msgstr "Выработавший ресурс фильтр снижает эффективность топлива и увеличивает количества дыма."

#: lang/json/fault_from_json.py
msgid "fuel filter"
msgstr "топливный фильтр"

#. ~ Description for fuel filter
#: lang/json/fault_from_json.py
msgid ""
"An expired filter reduces performance and increases the chance of backfires."
msgstr "Выработавший ресурс фильтр снижает производительность двигателя и увеличивает шанс проскоков пламени."

#: lang/json/fault_from_json.py
