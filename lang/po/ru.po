msgstr[2] "острых камней"
msgstr[3] "острый камень"

#. ~ Description for sharp rock
#: lang/json/GENERIC_from_json.py
msgid ""
"A rock with sharp edges, that can be used as a butchering tool, if nothing "
"else is available.  Makes a passable melee weapon."
msgstr "Камень с острыми краями, можно использовать для разделки, если больше под рукой ничего нет. Вполне сносное оружие ближнего боя."

#: lang/json/GENERIC_from_json.py
