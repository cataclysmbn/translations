msgid "A blast of concentrated magical power that obliterates a large area."
msgstr ""
"Взрыв сосредоточенной магической энергии, уничтожающий всё в большой "
"области."

#: lang/json/GENERIC_from_json.py
msgid "Scroll of Mana Bolt"
msgid_plural "Scrolls of Mana Bolt"
msgstr[0] "Свиток Удара Маны"
msgstr[1] "Свитка Удара Маны"
msgstr[2] "Свитков Удара Маны"
msgstr[3] "Свитки Удара Маны"

