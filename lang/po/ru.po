msgstr[3] "керамический осколок"

#. ~ Description for ceramic shard
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken ceramic shard.  It is heavy and has a somewhat sharp edge, but it's"
" too irregular to cut properly."
msgstr "Сломанный керамический осколок. Он тяжёл и имеет довольно острые края, но они слишком неровные, чтобы ими можно было успешно резать."

#: lang/json/GENERIC_from_json.py
