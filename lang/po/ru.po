msgstr "Это занимает вашу <info>внешнюю ауру</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#: lang/json/json_flag_from_json.py
msgid ""
"This gear is equipped with an accurate barometer (which is used to measure "
