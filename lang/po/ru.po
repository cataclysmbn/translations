#: lang/json/overmap_terrain_from_json.py lang/json/terrain_from_json.py
msgid "open air"
msgstr "открытое место"

#: lang/json/overmap_terrain_from_json.py lang/json/terrain_from_json.py
msgid "solid rock"
msgstr "сплошной камень"

#: lang/json/overmap_terrain_from_json.py
