msgstr "Разведчик"

#. ~ Profession (male Operator Recon) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid "The only easy day was yesterday."
msgstr "Единственный лёгкий день был вчера."

#: lang/json/professions_from_json.py
