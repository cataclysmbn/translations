#: lang/json/BOOK_from_json.py
msgid "The Guru Granth Sahib"
msgid_plural "copies of The Guru Granth Sahib"
msgstr[0] "«Гуру Грантх Сахиб»"
msgstr[1] "«Гуру Грантх Сахиб»"
msgstr[2] "«Гуру Грантх Сахиб»"
msgstr[3] "«Гуру Грантх Сахиб»"

